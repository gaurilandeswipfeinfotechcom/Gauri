                            {
                                @Html.AntiForgeryToken()

                                <div class="hr-card-body pf-card-body">

                                    <div class="row gx-1 gy-0">

                                        @for (int i = 0; i < pfCard.Settings.Count; i++)
                                        {
                                            var setting = pfCard.Settings[i];

                                            <div class="col-12 col-md-6">

                                                <div class="pf-field pf-dependent-field">

                                                    <!-- SETTING NAME -->
                                                    <label class="form-label d-block">
                                                        @setting.DisplayName
                                                    </label>

                                                    <!-- SETTINGS ID -->
                                                    <input type="hidden"
                                                           name="settings[@i].SettingsId"
                                                           value="@setting.SettingsId" />

