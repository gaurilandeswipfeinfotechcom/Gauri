                                                                   @(setting.IsApplicable == "Yes" ? "checked" : "") />

                                                            <span class="slider"></span>

                                                        </label>

                                                        <!-- APPLY DATE -->
                                                        <input type="date"
                                                               name="settings[@i].ApplyDate"
                                                               class="form-control pf-date"
                                                               value="@(setting.ApplyDate.HasValue
