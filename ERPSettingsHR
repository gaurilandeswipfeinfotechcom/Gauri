     /* ================================
         STATUTORY DEDUCTION CARDS
         PF / ESIC / PT
         ================================ */

     .settings-form > .d-flex {
         width: 100%;
         gap: 12px;
     }

         .settings-form > .d-flex > div[style*="flex: 1"] {
             min-width: 0;
             flex: 1 1 0 !important;
         }


     /* =========================================
         PF / ESIC / PT - FIRST ROW
         ========================================= */

     .statutory-cards-row {
         display: grid;
         grid-template-columns: repeat(3, minmax(0, 1fr));
         gap: 12px;
         width: 100%;
         max-width: 100%;
         box-sizing: border-box;
     }

     .statutory-card-item {
         width: 100%;
         min-width: 0;
         max-width: 100%;
         box-sizing: border-box;
     }

         .statutory-card-item .hr-card {
             width: 100%;
             max-width: 100%;
             min-width: 0;
             box-sizing: border-box;
             margin: 0;
         }


     /* TDS SECOND ROW */

     .tds-row {
         display: flex;
         width: 100%;
         gap: 12px;
         margin-top: 12px;
     }

     .tds-card-item {
         flex: 1 1 0;
         min-width: 0;
     }

         .tds-card-item .hr-card {
             width: 100%;
         }


     /* =====================================================
         TDS CARD - INNER FIELD SPACING
         ===================================================== */

     .tds-card {
         width: 100%;
         height: 230px;
         box-sizing: border-box;
     }

         .tds-card .hr-card-body {
             width: 100%;
             padding: 8px 12px 10px;
             box-sizing: border-box;
         }


         /* TDS setting rows */

         .tds-card .setting-row {
             display: flex;
             align-items: center;
             width: 100%;
             min-height: 30px;
             margin: 0 0 3px 0;
             padding: 0;
             box-sizing: border-box;
         }


         /* TDS labels */

         .tds-card .setting-label {
             display: block;
             flex: 0 0 120px;
             width: 120px;
             margin: 0;
             padding: 0;
             font-size: 11px;
             font-weight: 600;
             color: #344054;
             white-space: nowrap;
         }


         /* TDS value fields */

         .tds-card .card-value {
             flex: 0 0 85px;
             width: 85px;
             height: 27px;
             margin-left: 4px;
             padding: 3px 6px;
             border: 1px solid #D7DFEA;
             border-radius: 8px;
             font-size: 11px;
             text-align: right;
             box-sizing: border-box;
         }


         /* =====================================================
         TDS TOGGLE
         ===================================================== */

         .tds-card .card-toggle {
             display: none;
         }

         .tds-card .toggle-label {
             flex: 0 0 auto;
             margin: 0 6px 0 4px;
             padding: 0;
             cursor: pointer;
         }

         .tds-card .toggle-switch {
             display: block;
             position: relative;
             width: 36px;
             height: 19px;
             background: #ccc;
             border-radius: 20px;
             transition: .3s;
         }

             .tds-card .toggle-switch:before {
                 content: "";
                 position: absolute;
                 width: 15px;
                 height: 15px;
                 left: 2px;
                 top: 2px;
                 background: #fff;
                 border-radius: 50%;
                 transition: .3s;
             }

         .tds-card .card-toggle:checked + .toggle-label .toggle-switch {
             background: #4376c0;
         }

             .tds-card .card-toggle:checked + .toggle-label .toggle-switch:before {
                 transform: translateX(17px);
             }



