    <script>
        $(document).on("change", ".card-toggle", function () {

            var targetId = $(this).data("target");

            var value = $(this).is(":checked")
                ? "Yes"
                : "No";

            $("#" + targetId).val(value);
        });
        function editSetting(button) {

            var id = button.getAttribute("data-id");
            var module = button.getAttribute("data-module");
            var displayName = button.getAttribute("data-displayname");
            var formula = button.getAttribute("data-formula");
            var value = button.getAttribute("data-value");
            var isApplicable = button.getAttribute("data-isapplicable");
            var applyDate = button.getAttribute("data-applydate");
            // Put values into form
            document.getElementById("SettingsId").value = id;
            document.getElementById("Module").value = module;
            document.getElementById("DisplayName").value = displayName;
            document.getElementById("Formula").value = formula;
            document.getElementById("Value").value = value;
            // APPLY DATE
            document.getElementById("ApplyDate").value = applyDate;
            // Set Yes/No
            document.getElementById("IsApplicable").value = isApplicable;
            // Set toggle
            document.getElementById("IsApplicableToggle").checked =
                isApplicable === "Yes";
            // Change ADD button to UPDATE
            document.getElementById("saveButton").innerHTML = "✓ UPDATE";

            // Add Cancel button
            if (!document.getElementById("cancelButton")) {

                var cancelButton = document.createElement("button");

                cancelButton.type = "button";
                cancelButton.id = "cancelButton";
                cancelButton.className = "btn cancel-btn";
                cancelButton.innerHTML = "Cancel";

                cancelButton.onclick = function () {
                    clearForm();
                };

                document.getElementById("saveButton")
                    .parentNode
                    .appendChild(cancelButton);
            }

            // Scroll to top
            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        }


        function clearForm() {

            document.getElementById("SettingsId").value = "0";

            document.getElementById("Module").value = "";

            document.getElementById("DisplayName").value = "";
            document.getElementById("Formula").value = "";
            document.getElementById("Value").value = "";
            document.getElementById("IsApplicable").value = "No";
            document.getElementById("IsApplicableToggle").checked = false;
            document.getElementById("saveButton").innerHTML = "+ ADD";

            var cancelButton = document.getElementById("cancelButton");

            if (cancelButton) {
                cancelButton.remove();
            }

            // Clear validation messages
            var errors = document.getElementsByClassName("validation-error");

            for (var i = 0; i < errors.length; i++) {
                errors[i].innerHTML = "";
            }
        }
        $("#IsApplicableToggle").on("change", function () {

            if ($(this).is(":checked")) {
                $("#IsApplicable").val("Yes");
            }
            else {
                $("#IsApplicable").val("No");
            }

        });
    </script>


