    function GeneratedItemsTable1() {

        if (orderItems1.length > 0) {

            var k = 1;
            var $table = $('<table/>');
            $table.append('<thead><tr><th>Sr.No.</th> <th>Account Group Name</th><th>Amount</th><th>Narration</th><th>Actions</th></tr></thead>');
            var $tbody = $('<tbody/>');
            var Accname;
            $.each(orderItems1, function (i, val) {


                $.ajax({
                    url: '@Url.Action("GetIAccountGroupName")',
                    data: { "AccountGroupId": val.AccountGroupId },
                    type: "POST",
                    dataType: "json",
                    async: false,
                    success: function (data) {

                        if (data.length > 0) {

                            Gname = data[0].GroupName;
                        }
                    }
                });

                var $row = $('<tr/>');
                $row.append($('<td style="text-align:center"/>').html(k));
                $row.append($('<td style="text-align:left"/>').html(Gname));
                $row.append($('<td style="text-align:right"/>').html(val.Amount));
                $row.append($('<td style="text-align:left"/>').html(val.Narration));

                var $remove = $('<a href="#" title="Remove"><i class="material-icons text-danger">close</i></a>');
                $remove.click(function (e) {
                    e.preventDefault();
                    orderItems1.splice(i, 1);
                    GeneratedItemsTable1();

                });
                var $Edit = $('<a href="#" title="Edit"><i class="material-icons">edit_note</i></a>');
                $Edit.click(function (e) {

                    $.ajax({
                        url: '@Url.Action("GetCodeByAccGroupName")',
                        data: { "AGName": $(this).parent().parent().children(':nth-child(2)').text() },
                        type: "POST",
                        dataType: "json",

                        success: function (data) {

                            if (data.length > 0) {


                                $('#AccGroupId').val(data[0].GroupId);



                            }
                        }
                    });
                    $('#Amount').val($(this).parent().parent().children(':nth-child(3)').text());
                    $('#Narration').val($(this).parent().parent().children(':nth-child(4)').text());
                    $("#add1").attr('value', 'Update');

                    index = $(this).closest("tr").index();
                });

                var $actionTd = $('<td style="text-align:center" />');
                $actionTd.append($Edit).append(' ').append($remove);
                $row.append($actionTd);
                $tbody.append($row);
                k++;
            });
            console.log("current", orderItems1);
            $table.append($tbody);
            $('#orderItems1').html($table);
        }
        else {
            $('#orderItems1').html('');
        }
    }

