         function AddProduct( nm) {

            if (nm == "Add")
            {
                //Check validation of order item
                var isAllValid = true;

                if ($('#ItemID').val().trim() == '') {
                    $('#ItemID').siblings('span.error').css('visibility', 'visible');
                    $('#ItemID').focus();
                    isAllValid = false;
                    $("#reqitem").html('<span style="color:red">Item Name Required</span>');
                    $("#reqitem").show();


                }
                else {
                    $('#ItemID').siblings('span.error').css('visibility', 'hidden');
                    $("#reqitem").html("");
                    $("#reqitem").hide();
                }
                if ($('#Quantity').val().trim() == '') {
                    $('#Quantity').siblings('span.error').css('visibility', 'visible');
                    $('#Quantity').focus();
                    isAllValid = false;
                    $("#reqqty").html('<span style="color:red">Quantity Required</span>');
                    $("#reqqty").show();

                }
                else {
                    $('#Quantity').siblings('span.error').css('visibility', 'hidden');
                    $("#reqqty").html("");
                    $("#reqqty").hide();
                    var qty = /^[0-9]*$/;
                    if ($('#Quantity').val().match(qty)) {
                        $('#Quantity').siblings('span.error').css('visibility', 'hidden');
                        $("#regqty").html("");
                        $("#regqty").hide();
                        $("#reqqty").html("");
                        $("#reqqty").hide();

                    }
                    else {
                        $('#Quantity').siblings('span.error').css('visibility', 'visible');

                        $("#regqty").html('<span style="color:red">Enter Valid Quantity</span>');
                        isAllValid = false;
                        $("#regqty").show();
                        $("#reqqty").html("");
                        $("#reqqty").hide();

                    }

                }

                if (isAllValid) {
                    var k;
                    for (k = 0; k < orderItems.length; k++) {
                        if (orderItems[k].ItemID.toString() == $('#ItemID').val().trim()) {
                            alert("Item Already Exist In List");
                            $('#ItemID').val('').focus();
                            //$('#ItemCode').val('');
                            $('#Quantity').val('');
                            isAllValid = false;
                        }
                    }
                }
                //Add item to list if valid
                if (isAllValid) {
                    orderItems.push({
                        PurIndentNo: $('#PurIndentNo').val().trim(),
                        ItemID: parseInt($('#ItemID').val().trim()),
                        Quantity: parseInt($('#Quantity').val().trim()),
                        ItemName: $('#ItemID option:selected').text().trim(),

                    });

                    //Clear fields
                    $('#ItemID').val('').focus();
                    //$('#ItemCode').val('');
                    $('#Quantity').val(1);


                //populate order items
                    GeneratedItemsTable();

                }



            }
            else {
                if (nm == "Update") {
                    var orderItemsnew = [];
                    orderItemsnew = orderItems;


                    orderItemsnew[index]["ItemID"] = $('#ItemID').val().trim();
