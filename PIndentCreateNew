             $.ajax({
        url: '@Url.Action("GetCPInfo")',
        data: { "AddressTitleID": code },
        type: "POST",
        dataType: "json",
        success: function (result) {
            const vdata1 = result.d1; // Contact person data
            const vdata2 = result.d2; // Address

            console.log("Contact data:", vdata1);

            $("#Address").prop("disabled", false).val(vdata2[0]?.Address || "").prop("disabled", true);

            // Clear dropdowns
            $("#ContactPersonName").empty();
            $("#OfficeMobileNo").empty();
            $("#OfficeEmailId").empty();

            const addedMobiles = new Set();
            const addedEmails = new Set();

            let defaultMobile = "";
            let defaultEmail = "";
            let defaultCountryCode = "";
            let defaultPersonalEmail = "";

            $.each(vdata1, function (i, data) {
                const fullName = `${data.Title} ${data.FirstName} ${data.MiddleName ? data.MiddleName + ' ' : ''}${data.LastName}`;

                // Append contact person
                $("#ContactPersonName").append($('<option>', {
                    value: fullName,
                    text: fullName,
                    selected: data.DefaultPerson === "Y"
                }));

                if (data.DefaultPerson === "Y") {
                    defaultMobile = data.OfficeMobileNo;
                    defaultEmail = data.OfficeEmailId;
                    defaultCountryCode = data.CountryCode;
                    defaultPersonalEmail = data.PersonalEmailID;
                }

                // Add Office Mobile
                if (data.OfficeMobileNo && !addedMobiles.has(data.OfficeMobileNo)) {
                    $("#OfficeMobileNo").append($('<option>', {
                        value: data.OfficeMobileNo,
                        text: data.OfficeMobileNo
                    }));
                    addedMobiles.add(data.OfficeMobileNo);
                }

                // Add Office Email
                if (data.OfficeEmailId && !addedEmails.has(data.OfficeEmailId)) {
                    $("#OfficeEmailId").append($('<option>', {
                        value: data.OfficeEmailId,
                        text: data.OfficeEmailId
                    }));
                    addedEmails.add(data.OfficeEmailId);
                }
            });

            // Set default values
            if (defaultMobile) $("#OfficeMobileNo").val(defaultMobile);
            if (defaultEmail) $("#OfficeEmailId").val(defaultEmail);
            if (defaultCountryCode) {
                $("#CountryCode1").val(defaultCountryCode);
                $("#CountryCode2").val(defaultCountryCode);
            }
            if (defaultPersonalEmail) {
                $("#PersonalEmailID").val(defaultPersonalEmail);
            }
        },
        error: function (response) {
            alert("Error: " + response.responseText);
        }
    });



    }

