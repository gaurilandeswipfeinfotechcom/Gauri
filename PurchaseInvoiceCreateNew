
@model ERPEntities.PurchaseInvoice

@{
    ViewBag.Title = "Create1";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}


<style>

    .view-toggle {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

        .view-toggle > span {
            margin: 0;
        }

    /* Toggle */
    .switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 22px;
        flex-shrink: 0;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        inset: 0;
        cursor: pointer;
        background-color: #ccc;
        transition: 0.3s;
        border-radius: 22px;
    }

        .slider::before {
            content: "";
            position: absolute;
            width: 16px;
            height: 16px;
            left: 3px;
            top: 3px;
            background: white;
            transition: 0.3s;
            border-radius: 50%;
        }

    .switch input:checked + .slider {
        background-color: #2196f3;
    }

        .switch input:checked + .slider::before {
            transform: translateX(18px);
        }


    /* =========================================================
         PAGE
         ========================================================= */

    .purchase-page {
        background: #f4f6f9;
        padding: 0px;
    }


    /* =========================================================
         COMMON CARD
         ========================================================= */

    .purchase-card {
        background: #fff;
        border: 1px solid #dce1e7;
        border-radius: 6px;
        box-shadow: 0 2px 7px rgba(0,0,0,.08);
        overflow: hidden;
        padding-top: 2px;
    }

    .purchase-card-header {
        height: 30px;
        padding: 0px 7px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 0;
        color: #172b7a;
        font-size: 15px;
        font-weight: 600;
        background: #fff;
    }

        .purchase-card-header i {
            color: #0085c8;
            font-size: 20px;
            vertical-align: middle;
            margin-right: 6px;
        }

    .purchase-card-body {
        padding: 0px 5px 5px 5px;
    }


    /* =========================================================
         TOP PURCHASE INVOICE DETAILS
         ========================================================= */

    .purchase-invoice-card {
        width: 100%;
        margin-bottom: 0px;
    }

    .purchase-search-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 100px;
        gap: 18px;
        align-items: end;
    }

    .purchase-field label {
        display: block;
        color: #172b7a;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 0px;
    }

    .purchase-field select,
    .purchase-field input {
        width: 100%;
        height: 35px;
        border: 1px solid #ccd3dd;
        border-radius: 4px;
        padding: 4px 8px;
        font-size: 13px;
        box-sizing: border-box;
    }

    .search-btn {
        background: linear-gradient(135deg, #20BED0, #1B247D);
        height: 35px;
        border: none;
        border-radius: 4px;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .search-btn:hover {
            background: linear-gradient(135deg, #1B247D, #20BED0);
            color: #ffffff;
        }

        .search-btn i {
            font-size: 16px;
            vertical-align: middle;
        }

    /* =========================================================
         VENDOR DETAILS
         ========================================================= */

    .vendor-card {
        min-width: 0;
    }

    .vendor-field {
        display: flex;
        gap: 10px;
        font-size: 11px;
    }

        .vendor-field label {
            display: block;
            color: #172b7a;
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .vendor-field input,
        .vendor-field select,
        .vendor-field textarea {
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #ccd3dd;
            border-radius: 4px;
            font-size: 12px;
            padding: 5px 7px;
            background: #fff;
        }

        .vendor-field input,
        .vendor-field select {
            height: 33px;
        }

        .vendor-field textarea {
            height: 55px;
            resize: none;
        }

            .vendor-field input:disabled,
            .vendor-field textarea:disabled {
                background: #f5f6f7;
                color: #555;
            }


    /* =========================================================
         ITEM + ACCOUNT GROUP CARD
         ========================================================= */

    .item-account-card {
        min-width: 0;
    }

    .inner-card {
        border: 1px solid #dce2e8;
        border-radius: 5px;
        overflow: hidden;
        margin-bottom: 0px;
    }

        .inner-card:last-child {
            margin-bottom: 0;
        }

    .inner-card-header {
        min-height: 35px;
        padding: 7px 10px;
        background: #f6f8fa;
        border-bottom: 1px solid #dce2e8;
        color: #172b7a;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .inner-card-header i {
            color: #0085c8;
            font-size: 17px;
            vertical-align: middle;
        }


    /* =========================================================
         ADD ITEM
         ========================================================= */


    .add-item-btn {
        background: linear-gradient(135deg, #20BED0, #1B247D);
        color: #ffffff;
        border: none;
        border-radius: 4px;
        padding: 5px 9px;
        font-size: 11px;
        cursor: pointer;
    }

        .add-item-btn:hover {
            background: linear-gradient(135deg, #1B247D, #20BED0);
            color: #ffffff;
        }


        .add-item-btn i {
            color: white;
            font-size: 14px;
        }


    /* =========================================================
         ITEM TABLE
         ========================================================= */

    .item-table-container {
        max-height: 235px;
        overflow-y: auto;
        overflow-x: auto;
    }

    .item-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

        .item-table th {
            background: #fafbfc;
            color: #172b7a;
            font-weight: 600;
            padding: 7px 5px;
            border-bottom: 1px solid #ddd;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .item-table td {
            padding: 7px 5px;
            border-bottom: 1px solid #eee;
            color: #333;
            white-space: nowrap;
        }

    .no-items {
        text-align: center;
        color: #999;
        padding: 30px 5px !important;
    }

    .item-action {
        border: none;
        background: transparent;
        padding: 1px;
        cursor: pointer;
    }

        .item-action i {
            font-size: 17px;
        }

    .edit-item {
        color: #0085c8;
    }

    .delete-item {
        color: #dc3545;
    }


    /* =========================================================
         ACCOUNT GROUP
         ========================================================= */

    .account-body {
        padding: 10px;
    }

    .account-field {
        margin-bottom: 8px;
    }

        .account-field label {
            display: block;
            color: #172b7a;
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .account-field select,
        .account-field input {
            width: 100%;
            height: 32px;
            box-sizing: border-box;
            border: 1px solid #ccd3dd;
            border-radius: 4px;
            padding: 4px 7px;
            font-size: 12px;
        }

    .account-add-btn {
        width: 100%;
        height: 32px;
        border: none;
        border-radius: 4px;
        background: #198754;
        color: white;
        font-size: 11px;
        font-weight: 600;
    }


    /* =========================================================
         COURIER + CALCULATION
         ========================================================= */

    .courier-card {
        min-width: 0;
    }

    .courier-section {
        padding: 0px;
    }

    .courier-field {
        margin-bottom: 10px;
    }

    .courier-section .vendor-field,
    .courier-section .courier-field {
        min-width: 0;
        margin-bottom: 10px;
    }

        .courier-section .vendor-field label,
        .courier-section .courier-field > label {
            display: block;
            color: #172B7A;
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 5px;
        }
    /* Payment Term dropdown uses full width */

    .courier-section .courier-payment-field {
        display: block !important;
        width: 100%;
        margin-bottom: 5px;
    }

        .courier-section .courier-payment-field label {
            display: block !important;
            margin-bottom: 5px;
        }

        .courier-section .courier-payment-field select {
            display: block;
            width: 100%;
        }

    .courier-modes-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 2px;
    }

        .courier-modes-row .courier-mode-field {
            min-width: 0;
            margin-bottom: 0;
        }

        .courier-modes-row .radio-row {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 8px;
        }

            .courier-modes-row .radio-row label {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                margin: 0;
                white-space: nowrap;
                font-size: 11px;
                font-weight: 400;
                color: #445064;
                cursor: pointer;
            }

            .courier-modes-row .radio-row input[type="radio"] {
                margin: 0;
                accent-color: #1B247D;
            }

    .courier-section .form-control {
        width: 100%;
        height: 32px !important;
        box-sizing: border-box;
        border: 1px solid #CCD6E2;
        border-radius: 6px;
        font-size: 12px;
        margin-top: 0 !important;
    }

    .courier-field label {
        display: block;
        color: #172b7a;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .courier-field select {
        width: 100%;
        height: 33px;
        border: 1px solid #ccd3dd;
        border-radius: 4px;
        padding: 4px 7px;
        font-size: 12px;
    }

    .radio-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

        .radio-row label {
            font-size: 11px;
            color: #444;
            font-weight: normal;
            cursor: pointer;
        }


    /* =========================================================
         CALCULATION
         ========================================================= */

    .calculation-title {
        color: #172b7a;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 10px;
    }

        .calculation-title i {
            color: #0085c8;
            font-size: 17px;
            vertical-align: middle;
        }


    .calculation-row {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 5px;
        margin-bottom: 12px;
    }

        .calculation-row label {
            font-size: 11px;
            color: #172b7a;
            white-space: normal;
            text-align: left;
        }

        .calculation-row input {
            width: 100%;
            height: 20px;
            box-sizing: border-box;
            border: 1px solid #ccd3dd;
            border-radius: 4px;
            text-align: right;
            padding: 1px 7px;
            font-size: 12px;
        }


        .calculation-row.total {
            border-top: 1px solid #ddd;
            margin-top: 10px;
            padding-top: 10px;
        }

            .calculation-row.total label {
                color: #172b7a;
                font-size: 13px;
                font-weight: 700;
            }

            .calculation-row.total input {
                background: #e7e9f4;
                border-color: #d3d6ee;
                color: #087f3e;
                font-size: 14px;
                font-weight: 700;
            }


    /* =========================================================
         FOOTER
         ========================================================= */

    .invoice-footer {
        margin-top: 15px;
        padding: 12px 15px;
        background: #fff;
        border: 1px solid #dce1e7;
        border-radius: 6px;
        box-shadow: 0 2px 7px rgba(0,0,0,.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .upload-title {
        display: block;
        color: #172b7a;
        font-size: 12px;
        font-weight: 600;
    }

    .create-btn {
        border: none;
        background: linear-gradient(135deg, #20BED0, #1B247D);
        border-radius: 4px;
        padding: 9px 20px;
        color: #ffffff;
        font-weight: 600;
    }

        .create-btn:hover {
            background: linear-gradient(135deg, #1B247D, #20BED0);
            color: #ffffff;
        }

    /* =========================================================
         ITEM MODAL
         ========================================================= */

    .pi-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: rgba(0,0,0,.45);
        align-items: center;
        justify-content: center;
    }

        .pi-modal.show {
            display: flex;
        }

    .pi-modal-box {
        width: 600px;
        max-width: 95%;
        background: white;
        border-radius: 6px;
        box-shadow: 0 10px 40px rgba(0,0,0,.3);
    }

    .pi-modal-header {
        padding: 12px 16px;
        background: #172b7a;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .pi-modal-header h4 {
            margin: 0;
            font-size: 16px;
        }

    .modal-close {
        border: none;
        background: transparent;
        color: white;
        font-size: 25px;
        cursor: pointer;
    }

    .pi-modal-body {
        padding: 20px;
    }

    .modal-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .modal-field.full {
        grid-column: 1 / -1;
    }

    .modal-field label {
        display: block;
        color: #172b7a;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .modal-field input,
    .modal-field select {
        width: 100%;
        height: 36px;
        border: 1px solid #ccd3dd;
        border-radius: 4px;
        padding: 5px 8px;
        box-sizing: border-box;
    }


    /* Center Create and Close buttons in the footer */
    .modal-footer {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
    }

    .modal-save {
        border: none;
        border-radius: 4px;
        background: #198754;
        color: white;
        padding: 8px 18px;
    }


    /* =========================================================
         RESPONSIVE
         ========================================================= */

    @@media (max-width: 1000px) {

        .purchase-three-cards {
            grid-template-columns: 1fr 1fr;
        }
    }


    @@media (max-width: 800px) {

        .purchase-search-grid {
            grid-template-columns: 1fr;
        }

        .purchase-three-cards {
            grid-template-columns: 1fr;
        }

        .courier-card {
            grid-column: auto;
        }

        .invoice-footer {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .modal-grid {
            grid-template-columns: 1fr;
        }

        .modal-field.full {
            grid-column: auto;
        }
    }

    .erp-input,
    .erp-select {
        border: none;
        border-bottom: 1px solid #bbb;
        padding: 5px 4px;
        font-size: 13px;
        outline: none;
        background: transparent;
        min-width: 180px;
        transition: all 0.2s ease;
    }

        /* focus highlight */
        .erp-input:focus,
        .erp-select:focus {
            border-bottom: 2px solid #4a90e2;
        }


    /*.small-remove-btn {
         padding: 3px 8px;
         font-size: 11px;
         line-height: 1.2;
         border: none;
         border-radius: 4px;
         background-color: #dc3545;
         color: #fff;
         cursor: pointer;
     }

         .small-remove-btn:hover {
             background-color: #b02a37;
         }*/

    .input-error {
        border: 1px solid #dc3545 !important;
        background-color: #fff8f8;
    }

    .field-error {
        display: block;
        color: #dc3545;
        font-size: 12px;
        margin-top: 4px;
    }

    /* New CSS*/
    /* Purchase  Details - Row 1 */
    .purchase-search-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 15px;
        align-items: end;
    }

    /* Row 1: Vendor Name */
    .purchase-vendor-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 15px;
    }

    /* Row 2: All purchase details */
    .invoice-detail-grid {
        display: grid;
        grid-template-columns: 0.52fr 0.52fr 0.52fr 0.52fr 0.52fr 0.52fr;
        gap: 3px;
        margin-top: 0px;
        padding-top: 0px;
        border-top: 0;
    }

        .invoice-detail-grid .purchase-field input,
        .invoice-detail-grid .purchase-field select {
            width: 100%;
            min-width: 0;
            height: 35px;
            box-sizing: border-box;
            border: 0;
            border-radius: 4px;
            padding: 5px 8px;
            font-size: 12px;
        }

        .invoice-detail-grid .purchase-field label {
            display: block;
            color: #172b7a;
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 0px;
        }

    /* Responsive layout */
    @@media (max-width: 900px) {
        .invoice-detail-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .invoice-detail-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    .vendor-address-field {
        width: 100%;
    }

    .vendor-complete-address {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        align-items: center;
        min-height: 40px;
        padding: 10px 12px;
        border: 1px solid #ccd3dd;
        border-radius: 5px;
        background: #fff;
        color: #333;
        font-size: 12px;
        overflow-wrap: anywhere;
    }

        .vendor-complete-address span:not(:empty)::after {
            content: ",";
        }

        .vendor-complete-address span:last-child::after {
            content: "";
        }

    .vendor-contact-body {
        display: flex;
        flex-direction: column;
    }

    .vendor-contact-field {
        width: 100%;
    }

        .vendor-contact-field label {
            display: block;
            margin-bottom: 5px;
            color: #172b7a;
            font-size: 12px;
            font-weight: 600;
        }

        .vendor-contact-field .form-control {
            width: 100%;
            height: 35px;
            min-width: 0;
            box-sizing: border-box;
            border: 1px solid #ccd3dd;
            border-radius: 5px;
            font-size: 12px;
        }

    .office-contact-row {
        display: flex;
        gap: 8px;
    }

        .office-contact-row input {
            flex: 0 0 65px;
        }

        .office-contact-row select {
            flex: 1;
        }

    .purchase-three-cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        align-items: start;
        width: 100%;
        box-sizing: border-box;
    }

        .purchase-three-cards > * {
            width: 100%;
            min-width: 0;
            margin: 0;
            box-sizing: border-box;
        }

    .item-account-column,
    .calculation-column {
        min-width: 0;
        width: 100%;
    }

    .purchase-three-cards > .purchase-card {
        width: 100%;
        min-width: 0;
        margin: 0;
    }

    .item-account-card,
    .calculation-card {
        width: 100%;
        margin-top: 5px;
        box-sizing: border-box;
    }

    @@media (max-width: 900px) {
        .purchase-three-cards {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .purchase-three-cards {
            grid-template-columns: 1fr;
        }
    }

    /* All five calculation fields in one row */
    .calculation-card .purchase-card-body {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0px;
        align-items: start;
        padding: 0px 5px 3px 5px;
    }

    .calculation-card .calculation-row-group {
        display: contents;
    }

    .calculation-card .calculation-row {
        display: flex;
        flex: 1 1 0;
        min-width: 0;
        flex-direction: column;
        align-items: stretch;
        gap: 0px;
    }

        .calculation-card .calculation-row label {
            display: block;
            width: 100%;
            white-space: normal;
            text-align: left !important;
            margin: 0;
        }

        .calculation-card .calculation-row input {
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
        }

        .calculation-card .calculation-row,
        .calculation-card .calculation-row.total {
            width: 100%;
            min-width: 0;
            margin: 0;
            padding: 0;
            border: none;
        }

    .vendor-left-column {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
    }



    .courier-top-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 0px;
    }

        .courier-top-row .vendor-field {
            display: block;
            min-width: 0;
        }

            .courier-top-row .vendor-field label {
                margin-bottom: 0px;
            }

            .courier-top-row .vendor-field input,
            .courier-top-row .vendor-field select {
                width: 100%;
                height: 35px;
                box-sizing: border-box;
            }


    #accountTableBody td:nth-child(1) {
        text-align: left;
    }

    #accountTableBody td:nth-child(3) {
        text-align: left;
    }

    #accountTableBody td:nth-child(4) {
        text-align: left;
        white-space: nowrap;
    }

    #accountTableBody td:nth-child(5) {
        text-align: left;
    }

    #accountTableBody td:nth-child(6) {
        text-align: left;
        white-space: nowrap;
    }
    /* Vendor Contact dropdown display */
    .vendor-contact-card select,
    .vendor-contact-card .form-control {
        box-sizing: border-box;
        min-width: 0;
        height: 34px;
        font-size: 13px;
        line-height: normal;
        padding: 6px 10px;
        color: #445064;
        background-color: #fff;
    }

        /* Keep dropdown placeholder text visible */
        .vendor-contact-card select option {
            color: #445064;
            background-color: #fff;
        }

    .vendor-contact-body {
        gap: 0px;
    }
    /*.vendor-contact-card{
         height:280px;
     }*/
    /* Office Contact: country code + phone number */
    .office-contact-row {
        display: flex;
        align-items: stretch;
        gap: 8px;
