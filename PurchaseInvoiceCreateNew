    function handleFileChange() {
        var fileInput = document.getElementById('pdfInput');
        var previewButtonContainer = document.getElementById('previewButtonContainer');

        // Check if a file is selected
        if (fileInput.files.length > 0) {
            var fileSize = fileInput.files[0].size; // in bytes

            // Check if the file size is within the specified limits (10 KB to 300 KB)
            if (fileSize >= 10 * 1024 && fileSize <= 300 * 1024) {
                previewButtonContainer.style.display = 'block';
            } else {
                alert('File size must be between 10 KB and 300 KB.');
                // Clear the file input to prevent submission
                fileInput.value = '';
                previewButtonContainer.style.display = 'none';
            }
        } else {
            previewButtonContainer.style.display = 'none';
        }
    }


