        parseFloat(
            $("#modalAccountAmount").val()
        ) || 0;


    var GstRate =
        parseFloat(
            $("#modalAccountGSTRate").val()
        ) || 0;


    var Desc =
        $("#modalAccountNarration")
            .val()
            .trim();


    // ---------------------------------------------
    // VALIDATION
    // ---------------------------------------------

    if (!Accid) {

        alert("Please select Account Group.");

        $("#modalAccountGroup").focus();

        return;
    }


    if (Am <= 0) {

        alert("Please enter Amount.");

        $("#modalAccountAmount").focus();

        return;
    }


    // ---------------------------------------------
    // DUPLICATE CHECK
    // ---------------------------------------------

    var duplicate = false;

    $.each(orderItems1, function (i, item) {

        if (
            i !== editIndex &&
            parseInt(item.AccountGroupId) ===
            parseInt(Accid)
        ) {

            duplicate = true;

            return false;
        }

    });


    if (duplicate) {

        alert(
            "This Account Group has already been added."
        );

        return;
    }


    // ---------------------------------------------
    // IMPORTANT:
    // Get GST Rate again from server
    // ---------------------------------------------

    $.ajax({

        url: '@Url.Action("GetIAccountGroupName")',

        data: {
            AccountGroupId: Accid
        },

        type: "POST",

        dataType: "json",

        success: function (data) {

            if (!data || data.length === 0) {

                alert(
                    "Account Group details not found."
                );

                return;
            }


            var gstRate =
                parseFloat(data[0].GSTRate) || 0;


            var accountObject = {

                PurInvoiceNo:
                    $("#PurInvoiceNo")
                        .val()
                        .trim(),

                GroupName:
                    Accnm,

                GSTRate:
                    gstRate,

                Amount:
                    Am,

                AccountGroupId:
                    parseInt(Accid),

                Narration:
                    Desc
            };


            // -----------------------------------------
            // ADD
            // -----------------------------------------

            if (editIndex === -1) {

                orderItems1.push(
                    accountObject
                );
            }

            // -----------------------------------------
            // UPDATE
            // -----------------------------------------

            else {

                orderItems1[editIndex] =
                    accountObject;
            }


            // -----------------------------------------
            // UPDATE TOTAL
            // -----------------------------------------

            updateProductSubTotal();


            // -----------------------------------------
            // REFRESH TABLE
            // -----------------------------------------

            GeneratedItemsTable1();


            // -----------------------------------------
            // EXISTING CALCULATION LOGIC
            // -----------------------------------------

            if (
                $("#TermsOfDeliveryID").val() == 2
            ) {

                $("#FreightCharges").val(0);

                calculation();

            }
            else {

                $("#FreightCharges").val('');

            }


            // -----------------------------------------
            // CLOSE MODAL
            // -----------------------------------------

            closeAccountGroupModal();

        },

        error: function () {

            alert(
                "Unable to get Account Group details."
            );
        }

    });
}


