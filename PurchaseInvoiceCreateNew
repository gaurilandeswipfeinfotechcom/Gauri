/* =========================================================
   DATE FORMAT
   ========================================================= */

function formatDate(value) {

    if (!value) return "";

    var match = /\/Date\((\d+)\)\//.exec(value);

    if (!match) return value;

    var date = new Date(
        parseInt(match[1])
    );

    return date.getFullYear() +
        "-" +
        String(date.getMonth() + 1).padStart(2, "0") +
        "-" +
        String(date.getDate()).padStart(2, "0");
}


