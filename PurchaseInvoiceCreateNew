    function saveItemFromModal() {

        var index = parseInt($("#editIndex").val());

        var itemId = $("#modalItem").val();

        if (!itemId) {
            alert("Please select Item.");
            return;
        }

        var qty = parseFloat($("#modalQty").val()) || 0;

        if (qty <= 0) {
            alert("Please enter valid Quantity.");
            return;
        }


        // ==========================================
        // CHECK DUPLICATE ITEM
        // ==========================================

        for (var i = 0; i < orderItems.length; i++) {

            // If editing, don't compare with itself
            if (index >= 0 && i === index) {
                continue;
            }

            if (
                orderItems[i].ItemID != null &&
                orderItems[i].ItemID.toString() === itemId.toString()
            ) {

                alert("Item Already Exist In List");

                $("#modalItem").focus();

                return;
            }
        }


        // ==========================================
        // GET VALUES
        // ==========================================

        var applicableRate =
            parseFloat($("#modalApplicableRate").val()) || 0;


        var item = {

            PurInvoiceNo: $("#PurInvoiceNo").val().trim(),

            ItemID: itemId,

            ItemName:
                $("#modalItem option:selected").text().trim(),

            Quantity: qty,

            InQty: qty,

            UnitId:
                $("#modalUnit").val(),

            UnitName:
                $("#modalUnit option:selected").text().trim(),

            ItemCode:
                $("#modalItemCode").val().trim(),

            HSNCode:
                $("#modalHSNCode").val().trim(),

            GSTRate:
                parseFloat($("#modalGSTRate").val()) || 0,

            RatePerUnit:
                parseFloat($("#modalRatePerUnit").val()) || 0,

            ApplicableRate:
                applicableRate,

            Amount:
                parseFloat((qty * applicableRate).toFixed(2))
        };


        // ==========================================
        // UPDATE OR ADD
        // ==========================================

        if (index >= 0) {

            // UPDATE EXISTING ITEM
            orderItems[index] = item;

        } else {

            // ADD NEW ITEM
            orderItems.push(item);
        }


        // ==========================================
        // REFRESH
        // ==========================================

        renderItems();

        calculation();

        closeItemModal();
    }


