    $(document).ready(function () {
        $('#TaxInvoiceDate').change(function () {
            var taxInvoiceDate = new Date($(this).val());
            var selectedDate = new Date($(this).val());
            var currentDate = new Date();

            // Check if the selected date is in the future
            if (selectedDate > currentDate) {
                alert('Please select a date that is not in the future.');
                // Optionally, you can reset the date to the current date or do something else.
                $(this).val(currentDate.toISOString().split('T')[0]);
                return;
            }
            var month = (taxInvoiceDate.getMonth() + 1).toString().padStart(2, '0');
            var year = taxInvoiceDate.getFullYear();

            // Send an Ajax request to the server to get the last used number for the selected month and year
            $.ajax({
                type: 'GET',
                url: '/PurchaseInvoice/GetLastInvoiceNumberForMonthAndYear?month=' + month + '&year=' + year,
                success: function (response) {
                    var purchaseInvoiceNo = response;

                    // If the response is a number, format it to PIYYMMXX format
                    if (!isNaN(response)) {
                        var yearStr = year.toString().substr(-2);
                        purchaseInvoiceNo = 'PI' + yearStr + month + response.toString().padStart(4, '0');
                    }

                    $('#PurInvoiceNo').val(purchaseInvoiceNo);
                },
                error: function (xhr, status, error) {
                    // Handle error
                    console.error(xhr.responseText);
                }
            });
        });
    });



