  function GetVendorInfo(
    businessEntityId,
    selectedAddressId,
      selectedDesignationInfoId,
      selectedPurOrderNo
) {

    if (!businessEntityId) {
        return;
    }

    $.ajax({

        url: '@Url.Action("GetVendorInfo", "PurchaseInvoice")',

        type: 'POST',

        data: {
            businessEntityId: businessEntityId
        },

        dataType: 'json',

        success: function (addresses) {

            console.log("Vendor Addresses:", addresses);

            vendorAddressesList = addresses || [];

            // Load PO list for the selected vendor
            //LoadVendorPurchaseOrders(businessEntityId);

            LoadVendorPurchaseOrders(
                businessEntityId,
                selectedPurOrderNo
            );

            var ddl = $("#AddressTitleID");

            // Clear dropdown
            ddl.empty();

            // Default option
            ddl.append(
                $("<option>", {
                    value: "",
                    text: "Please Select"
                })
            );

            // =====================================================
            // ADD ALL ADDRESSES
            // =====================================================

            $.each(
                vendorAddressesList,
                function (_, address) {

                    ddl.append(
                        $("<option>", {
                            value: address.BusinessAddressId,
                            text: address.AddressTitle
                        })
                    );
                }
            );

            console.log(
                "Total vendor addresses:",
                vendorAddressesList.length
            );

            // =====================================================
            // NO ADDRESS
            // =====================================================

            if (!vendorAddressesList.length) {

                ClearVendorAddress();

                LoadContactPersons([]);

                return;
            }

            // =====================================================
            // DETERMINE ADDRESS TO SELECT
            // =====================================================

            var addressId = selectedAddressId;

            // No saved address -> first address
            if (!addressId) {

                addressId =
                    vendorAddressesList[0].BusinessAddressId;
            }

            // Check selected address belongs to vendor
            var addressExists =
                vendorAddressesList.some(function (x) {

                    return String(x.BusinessAddressId) ===
                           String(addressId);
                });

            // Invalid address -> first address
            if (!addressExists) {

                addressId =
                    vendorAddressesList[0].BusinessAddressId;
            }

            // =====================================================
            // SELECT ADDRESS
            // =====================================================

            ddl.val(addressId);

            // =====================================================
            // LOAD SELECTED ADDRESS
            // =====================================================

            LoadSelectedVendorAddress(
                addressId,
                selectedDesignationInfoId
            );
        },

        error: function (xhr) {

            console.log(
                "GetVendorInfo Error:",
                xhr.responseText
            );

            vendorAddressesList = [];

            $("#AddressTitleID").empty();

            $("#AddressTitleID").append(
                $("<option>", {
                    value: "",
                    text: "Please Select"
                })
            );

            ClearVendorAddress();
            //LoadVendorPurchaseOrders(businessEntityId);
            LoadContactPersons([]);
        }
    });
}


function LoadVendorPurchaseOrders(
    businessEntityId,
    selectedPurOrderNo
) {
    var ddl = $("#PurOrderNo");

    vendorPOsLoaded = false;
    vendorHasAvailablePOs = false;

    ddl.empty()
       .append($("<option>", {
           value: "",
           text: "Please Select PO"
       }))
       .prop("disabled", true)
       .prop("required", false);

    if (!businessEntityId) {
        return;
    }

    $.ajax({
        url: '@Url.Action("GetVendorPurchaseOrders", "PurchaseInvoice")',
        type: "POST",
        data: {
            businessEntityId: businessEntityId
        },
        dataType: "json",

        success: function (orders) {
            orders = orders || [];

            ddl.empty().append($("<option>", {
                value: "",
                text: "Please Select PO"
            }));

            $.each(orders, function (_, order) {
                ddl.append($("<option>", {
                    value: order.PurOrderNo,
                    text: order.PurOrderNo
                }));
            });

            // Preserve the PO selected before searching.
            if (selectedPurOrderNo) {
                var exists = orders.some(function (order) {
                    return String(order.PurOrderNo) ===
                           String(selectedPurOrderNo);
                });

                // Preserve an explicitly searched PO even if
                // it is absent from the eligible PO response.
                if (!exists) {
                    ddl.append($("<option>", {
                        value: selectedPurOrderNo,
                        text: selectedPurOrderNo
                    }));
                }

                ddl.val(String(selectedPurOrderNo));
            }

            vendorHasAvailablePOs = orders.length > 0;
            vendorPOsLoaded = true;

            ddl.prop("disabled", false);
            ddl.prop("required", vendorHasAvailablePOs);

            if (orders.length === 0 && !selectedPurOrderNo) {
                ddl.find("option:first").text(
                    "No PO available"
                );
                ddl.prop("disabled", true);
            }
        },

        error: function (xhr) {
            console.log(
                "GetVendorPurchaseOrders Error:",
                xhr.responseText
            );

            vendorPOsLoaded = false;
            vendorHasAvailablePOs = false;

            ddl.empty().append($("<option>", {
                value: "",
                text: "Unable to load POs. Please try again."
            }));

            ddl.prop("disabled", true);
            ddl.prop("required", false);

            alert("Unable to load purchase orders. Please try again.");
        }
    });
}


