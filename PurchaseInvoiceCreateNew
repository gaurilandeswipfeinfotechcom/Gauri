/* =========================================================
   CALCULATION
   ========================================================= */

    function calculation() {

        var subtotal = 0;
        var totalGST = 0;

        var freight =
            parseFloat($("#FreightCharges").val()) || 0;


        // ---------------------------------------------
        // PRODUCT + ACCOUNT GROUP SUBTOTAL
        // ---------------------------------------------

        $.each(orderItems || [], function (i, item) {

            var amount =
                parseFloat(item.Amount) || 0;

            var gstRate =
                parseFloat(item.GSTRate) || 0;

            subtotal += amount;

            // GST on product amount
            totalGST +=
                (amount * gstRate) / 100;
        });


        $.each(orderItems1 || [], function (i, item) {

            var amount =
                parseFloat(item.Amount) || 0;

            var gstRate =
                parseFloat(item.GSTRate) || 0;

            subtotal += amount;

            totalGST +=
                (amount * gstRate) / 100;
        });


        // ---------------------------------------------
        // PRODUCT SUB TOTAL
        // IMPORTANT:
        // Freight is NOT added here
        // ---------------------------------------------

        $("#ProductSubTotal").val(
            subtotal.toFixed(2)
        );


        // ---------------------------------------------
        // GST ON FREIGHT
        // ---------------------------------------------

        var freightGST = 0;

        if (freight > 0 && orderItems.length > 0) {

            // Use first item's GST rate
            var freightGSTRate =
                parseFloat(orderItems[0].GSTRate) || 0;

            freightGST =
                (freight * freightGSTRate) / 100;
        }

        totalGST += freightGST;


        // ---------------------------------------------
        // GST REGISTRATION
        // ---------------------------------------------

        var sgst = 0;
        var cgst = 0;
        var igst = 0;

        if (GSTRegistrationId == 4) {

            sgst = 0;
            cgst = 0;
            igst = 0;

        } else {

            var state =
                ($("#State").text() || "")
                    .trim()
                    .toUpperCase();

            if (state === "MAHARASHTRA") {

                sgst = totalGST / 2;
                cgst = totalGST / 2;

            } else {

                igst = totalGST;
            }
        }


        // ---------------------------------------------
        // SHOW GST
        // ---------------------------------------------

        $("#GSTTotal").val(
            totalGST.toFixed(2)
        );

        $("#SGST").val(
            sgst.toFixed(2)
        );

        $("#CGST").val(
            cgst.toFixed(2)
        );

        $("#IGST").val(
            igst.toFixed(2)
        );


        // ---------------------------------------------
        // TOTAL
        // ---------------------------------------------

        var total =
            subtotal +
            freight +
            sgst +
            cgst +
            igst;


        // ---------------------------------------------
        // ROUND OFF
        // ---------------------------------------------

        var roundedTotal =
            Math.floor(total + 0.5);

        var roundOff =
