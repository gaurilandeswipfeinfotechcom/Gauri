function saveAccountGroup() {

    var editIndex =
        parseInt(
            $("#accountGroupEditIndex").val()
        );


    var Accid =
        $("#modalAccountGroup").val();


    var Accnm =
        $("#modalAccountGroup option:selected")
            .text()
            .trim();


