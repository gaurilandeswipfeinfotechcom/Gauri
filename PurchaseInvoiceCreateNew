            roundOff.toFixed(2)
        );
    }


/* =========================================================
   ROUNDING
   ========================================================= */

function customRound(value) {

    value =
        parseFloat(value) || 0;

    var floor =
        Math.floor(value);

    var decimal =
        value - floor;

    return decimal > 0.5
        ? floor + 1
        : floor;
}


/* =========================================================
   NUMBER FORMAT
   ========================================================= */

function money(value) {

    return (
        parseFloat(value) || 0
    ).toFixed(2);
}


