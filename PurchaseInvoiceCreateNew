    function GetModalItemDetails(itemId) {

    if (!itemId || itemId === "") {

        $("#modalItemCode").val("");
        $("#modalHSNCode").val("");
        $("#modalGSTRate").val("");
        $("#modalRatePerUnit").val("");
        $("#modalApplicableRate").val("");
        $("#modalAmount").val("");

        return;
    }

    $.ajax({
        url: '@Url.Action("GetCode")',
        type: "POST",
        dataType: "json",
        data: {
            ItemID: itemId
        },
        success: function (data) {

            if (data && data.length > 0) {

                var item = data[0];

                // Item details
                $("#modalItemCode").val(item.ItemCode || "");
                $("#modalHSNCode").val(item.HSNCode || "");
                $("#modalGSTRate").val(item.GSTRate || "");
                $("#modalRatePerUnit").val(
                    parseFloat(item.RatePerUnit || 0).toFixed(2)
                );
                $("#modalUnit").val(item.unit);
                // Get discount
                var discount = parseFloat($("#Discount").val()) || 0;

                var rate = parseFloat(item.RatePerUnit) || 0;

                // Calculate applicable rate
                var applicableRate = rate;

                if (discount > 0) {
                    applicableRate = rate * (1 - discount / 100);
                }

                applicableRate = parseFloat(applicableRate.toFixed(2));

                $("#modalApplicableRate").val(
                    applicableRate.toFixed(2)
                );

                // Calculate amount
                calculateModalAmount();
            }
            else {

                $("#modalItemCode").val("");
                $("#modalHSNCode").val("");
                $("#modalGSTRate").val("");
                $("#modalRatePerUnit").val("");
                $("#modalApplicableRate").val("");
                $("#modalAmount").val("");

                alert("Item details not found.");
            }
        },
        error: function (xhr, status, error) {

            console.log("GetCode Error:", error);

            alert("Unable to fetch item details.");
        }
    });
}


