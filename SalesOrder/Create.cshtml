            data: { "PerMobile": code },
            type: "POST",
            dataType: "json",

            success: function (result) {

                $("#ContactPersonName").val("Please Select");
                $("#OfficeMobileNo").val("Please Select");
                $("#OfficeEmailId").val("Please Select");
                //$("#PersonalEmailID").val("Please Select");
                $("#CountryCode1").val(result[0].CountryCode);
                $("#CountryCode2").val(result[0].CountryCode);
                if (result.d1[0].MiddleName == null || result.d1[0].MiddleName == '')
                    $("#ContactPersonName").val(result.d1[0].Title + " " + result.d1[0].FirstName + " " + result.d1[0].LastName);
                else
                    $("#ContactPersonName").val(result.d1[0].Title + " " + result.d1[0].FirstName + " " + result.d1[0].MiddleName + " " + result.d1[0].LastName);

                $("#OfficeMobileNo").val(result[0].OfficeMobileNo);
                $("#OfficeEmailId").val(result[0].OfficeEmailId);

                //$("#PersonalEmailID").val(result[0].PersonalEmailID);
                $("#CPDesignation").val(result[0].CPDesignation);

            },
            error: function (reponse) {

                alert("error : " + reponse);
            }
        });
    }

    function GetCPDetailsByPeremail(code) {

        $.ajax({
            url: '@Url.Action("GetCPDetailsByPeremail")',
            data: { "PerEmail": code },
            type: "POST",
            dataType: "json",
            // contentType: "application/json; charset=utf-8",
            success: function (result) {

                $("#ContactPersonName").val("Please Select");
                $("#OfficeMobileNo").val("Please Select");
                $("#OfficeEmailId").val("Please Select");
                $("#PersonalMobileNo").val("Please Select");

                $("#CountryCode1").val(result[0].CountryCode);
                $("#CountryCode2").val(result[0].CountryCode);
                if (result.d1[0].MiddleName == null || result.d1[0].MiddleName == '')
                    $("#ContactPersonName").val(result.d1[0].Title + " " + result.d1[0].FirstName + " " + result.d1[0].LastName);
                else
                    $("#ContactPersonName").val(result.d1[0].Title + " " + result.d1[0].FirstName + " " + result.d1[0].MiddleName + " " + result.d1[0].LastName);

                $("#OfficeMobileNo").val(result[0].OfficeMobileNo);


                $("#OfficeEmailId").val(result[0].OfficeEmailId);
                //$("#PersonalMobileNo").val(result[0].PersonalMobileNo);
                $("#CPDesignation").val(result[0].CPDesignation);

            },
            error: function (reponse) {

                alert("error : " + reponse);
            }
        });
    }

    function checkAdd(code) {
        if (code == "No")
        {
            $("#shippAddress").show();
        }
        else
        {
            $("#ShippingAddress").val('');
            $("#shippAddress").hide();

        }

    }

    /////punchuation marks after space and before remove space
    $(document).ready(function () {
        $('#ShippingAddress').keyup(function () {
            str = this.value.replace(/(?=\S)[,.!?:;)](?=\S)/g, '$& ');

            str1 = this.value.replace(/\s+([,.!?:;)])/g, "$1");
            str2 = this.value.replace(/(?=\S)[&](?=\S)/g, ' & ', '$& ');
            str3 = this.value.replace(/\b[(]/g, ' (', "(");
            str4 = this.value.replace(/(?=\S)[-](?=\S)/g, ' - ', '$& ');
            str5 = this.value.replace(/(?=\S)[/](?=\S)/g, ' / ', '$& ');


            if (str != this.value) this.value = str;
            else
                if (str1 != this.value) this.value = str1;
                else
                    if (str2 != this.value) this.value = str2;
                    else
                        if (str3 != this.value) this.value = str3;
                        else
                            if (str4 != this.value) this.value = str4;
                            else
                                if (str5 != this.value) this.value = str5;

        });
    });



    $(document).ready(function () {
        $('#ShippingAddress').change(function () {

            var a = $(this).val();

            this.value = this.value.replace(/\w\S*/g, function (a) { return a.charAt(0).toUpperCase() + a.substr(1).toLowerCase(); });

        });
    });


    ///textbox starting remove blank space
    $(function () {
        $('#ShippingAddress').blur(function () {
            $(this).val(
                $.trim($(this).val())
            );
        });
    });
</script>


