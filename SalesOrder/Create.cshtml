    //check rate

    function checkratetype(code) {
            $.ajax({
            url: '@Url.Action("GetCourierDetails")',
            data: '{CourierID: "' + $("#CourierID").val().trim() + '",Cityname: "' + cityname + '",Statename: "' + statename + '"}',
            type: "POST",
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            async: false,
            success: function (r) {


                var data = r.d1;
                var RatePerKG = 0.0;
                var RatePerKG1 = 0.0;
                var RatePerKG2 = 0.0;

                var data2 = r.d2;

                if (r.d2 != "")
                    RatePerKG = parseFloat(data2[0].RatePerKg);

                var data3 = r.d3;

                if (r.d3 != "")
                    RatePerKG1 = parseFloat(data3[0].RatePerKg);

                var data4 = r.d4;
                if (r.d2 == "" && r.d3 == "")//select other rate
                {
                    RatePerKG2 = parseFloat(data4[0].RatePerKg);

                }

                if (data.length > 0) {

                    var CourierAmount = 0.00;
                    var NetAmountWithGST = 0.00;
                    var TotalCourierAmount = 0.00;
                    var CourierFuelCharges = 0.00;
                    var FOVCharges = 0.00;
                    var NetCourierAmount = 0.00;

                    var FinalCourierAmount = 0.00;
                    var FreightCharges = 0.00;
                    var RoundOffFreight = 0.00;
                    $("#FreightCharges").attr("readonly", false);
                    $("#GSTTotal").attr("readonly", false);
                    $("#SGST").attr("readonly", false);
                    $("#CGST").attr("readonly", false);
                    $("#IGST").attr("readonly", false);
                    $("#TotalAmount").attr("readonly", false);
                    $("#RoundOffAmount").attr("readonly", false);
                    $("#DocketCharges").attr("readonly", false);
                    $("#FuelCharges").attr("readonly", false);
                    $("#OtherCharges").attr("readonly", false);
                    $("#CODCharges").attr("readonly", false);
                    $("#FOV").attr("readonly", false);

                    if ($("#TermsOfDeliveryID").val() == 2 || $("#TermsOfDeliveryID").val() == 3) {

                        RoundOffFreight = 0.00;

                    }
                   else if (code == "Air Rate") {

                        $("#AirRate").val(data[0].AirRate);

                        var w = $("#TotalWeightInKg").val();

                        // Calculate basic air freight
                        CourierAmount = parseFloat(w) * parseFloat(data[0].AirRate);

                        // Add Docket Charges and Other Charges
                        TotalCourierAmount = CourierAmount
                            + parseFloat(data[0].DocketCharges)
                            + parseFloat(data[0].OtherCharges);

                        // Add COD Charges only for TermsOfDeliveryID = 4
                        if ($("#TermsOfDeliveryID").val() == 4) {
                            TotalCourierAmount = TotalCourierAmount
                                + parseFloat(data[0].CODCharges);
                        }

                        // Fuel Charges (same as Surface Rate)
                        CourierFuelCharges =
                            (TotalCourierAmount * data[0].FuelCharges) / 100;

                        // FOV Charges (same as Surface Rate)
                        FOVCharges =
                            (TotalCourierAmount * data[0].FOVPercent) / 100;

                        // Net Courier Amount
                        NetCourierAmount =
                            TotalCourierAmount + CourierFuelCharges + FOVCharges;

                        // Apply Minimum Amount
                        if (NetCourierAmount < parseFloat(data[0].MinimumAmount)) {
                            NetCourierAmount = parseFloat(data[0].MinimumAmount);
                        }

                        // Final Freight Charges
                        FreightCharges = NetCourierAmount;

                        // Apply existing Freight Round Off
                        RoundOffFreight = FreightRoundOff(FreightCharges);
                    }
                    else if (code == "Surface Rate") {
                        if (r.d2 == "" && r.d3 == "" && r.d4 == "" && $("#CourierID").val() != 6) {

                            alert("Courier Rate Not Exist");
                            return;
                        }
                        var w = $("#TotalWeightInKg").val();

                        if (RatePerKG != 0)
                            RatePerKG = RatePerKG;
                        else if (RatePerKG1 != 0)
                            RatePerKG = RatePerKG1;
                        else
                            RatePerKG = RatePerKG2;

                        $("#SurfaceRate").val(RatePerKG);
                        CourierAmount = parseFloat(w) * parseFloat(RatePerKG);

                        var TotalCourierAmount = CourierAmount + data[0].DocketCharges + data[0].OtherCharges;

                        if ($("#TermsOfDeliveryID").val() == 4) {
                            TotalCourierAmount = TotalCourierAmount + data[0].CODCharges;
                        }

                        var CourierFuelCharges = (TotalCourierAmount * data[0].FuelCharges) / 100;

                        var FOVCharges = (TotalCourierAmount * data[0].FOVPercent) / 100;

                        var NetCourierAmount = TotalCourierAmount + CourierFuelCharges + FOVCharges;
                        if (NetCourierAmount < parseFloat(data[0].MinimumAmount)) {
                            NetCourierAmount = parseFloat(data[0].MinimumAmount);

                        }

                        var FreightCharges = NetCourierAmount;

                        var RoundOffFreight = FreightRoundOff(FreightCharges);

                    }


                    $("#FreightCharges").val(Math.round(RoundOffFreight, 2));
                    $("#FreightCharges").attr("readonly", true);

                    var psubfr = parseFloat($("#ProductSubTotal").val()) + parseFloat($("#FreightCharges").val());

                    var GstAmount = ((psubfr * grate) / 100).toFixed(2);
                    //$("#GSTTotal").val(GstAmount);
                    $("#GSTTotal").attr("readonly", true);
                    console.log('gst registartion Id' + GSTRegistrationId);
                    if (GSTRegistrationId === 6 || GSTRegistrationId === 7 || GSTRegistrationId === 8) {
                        var SGST = 0.00;
                        var CGST = 0.00;
                        var IGST = 0.00;

                        $("#CGST").val(CGST);
                        $("#SGST").val(SGST);
                        $("#IGST").val(IGST);


                    }

                    else if (statename == "MAHARASHTRA") {

                        var SGST = (((psubfr * 18) / 100) / 2).toFixed(2);
                        $("#SGST").val(SGST);
                        $("#SGST").attr("readonly", true);

                        var CGST = (((psubfr * 18) / 100) / 2).toFixed(2);
                        $("#CGST").val(CGST);
                        $("#CGST").attr("readonly", true);

                        var IGST = 0.00;
                        $("#IGST").val(IGST);
                        $("#IGST").attr("readonly", true);


                    }
                    else {

                        var SGST = 0.00;
                        $("#SGST").val(SGST);
                        $("#SGST").attr("readonly", true);

                        var CGST = 0.00;
                        $("#CGST").val(CGST);
                        $("#CGST").attr("readonly", true);

                        var IGST = GstAmount;
                        $("#IGST").val(IGST);
                        $("#IGST").attr("readonly", true);


                    }

                    var GstAmount = parseFloat(SGST) + parseFloat(CGST) + parseFloat(IGST);
                    console.log(GstAmount);
                    $("#GSTTotal").val(GstAmount);

                    var TotalAmount = (parseFloat($("#ProductSubTotal").val()) + GstAmount + parseFloat(RoundOffFreight)).toFixed(2);


                    var TotalAmountroundoff = (TotalAmount % 1 === 0.5)
                        ? (TotalAmount - 0.5).toFixed(2)   // keep .50 as is (round down)
                        : Math.round(TotalAmount).toFixed(2);

                    $("#TotalAmount").val(TotalAmount);
                    $("#TotalAmount").attr("readonly", true);

                    $("#RoundOffAmount").val(TotalAmountroundoff);
                    $("#RoundOffAmount").attr("readonly", true);


                    $("#DocketCharges").val(Math.round(data[0].DocketCharges, 2));
                    $("#DocketCharges").attr("readonly", true);

                    $("#FuelCharges").val(Math.round(CourierFuelCharges, 2));
