                    if ($("#TermsOfDelivery").val() == "COD")
                        $("#CODCharges").val(Math.round(data[0].CODCharges, 2));
                    else
                        $("#CODCharges").val(0);
                    $("#CODCharges").attr("readonly", true);

                    $("#FOV").val(Math.round(FOVCharges, 2));
                    $("#FOV").attr("readonly", true);


                }
            }
        });


    }

    function FreightRoundOff(freight) {

        freight = Math.trunc(freight);
        var freightCharge = parseInt(freight);
        var freightMOD = freightCharge % 100;

        freightCharge = parseInt(freightCharge / 100);

        if (freightMOD == 0)
            freightCharge = freightCharge * 100;
        else if (freightMOD <= 25)
            freightCharge = (freightCharge * 100) + 25;
        else if (freightMOD <= 50)
            freightCharge = (freightCharge * 100) + 50;
        else if (freightMOD <= 75)
            freightCharge = (freightCharge * 100) + 75;
        else if (freightMOD <= 100)
            freightCharge = (freightCharge * 100) + 100;

        return freightCharge;
    }

    function myFunction(id) {
        var input = document.getElementById(id);
        var maxLength = parseInt(input.getAttribute("maxlength"));
        var currentLength = input.value.length;
        var warningSpan = document.getElementById("ShipAdd");

        if (currentLength >= maxLength) {
            warningSpan.innerText = "Maximum 200 characters allowed.";
            warningSpan.style.color = "red";
        } else {
            warningSpan.innerText = "";
        }
    }

