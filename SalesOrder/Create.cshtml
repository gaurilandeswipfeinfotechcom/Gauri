    function customRound(amount) {
        // Check if the decimal part is .50 or .5
        let decimalPart = amount % 1;  // Get the decimal part
        if (decimalPart === 0.5 || decimalPart === 0.50) {
            return Math.floor(amount);  // Round down
        }
        return Math.round(amount);  // Default rounding for other cases
    }




