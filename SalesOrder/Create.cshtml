    .slider {
        position: absolute;
        cursor: pointer;
        background-color: #ccc;
        transition: 0.4s;
        border-radius: 34px;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
    }

        /* Circle (roller) */
        .slider:before {
            position: absolute;
            content: "";
            height: 22px;
            width: 22px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: 0.4s;
            border-radius: 50%;
        }

