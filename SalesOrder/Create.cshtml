                                    @Html.TextBox("Discount", null, new { @class = "form-control  bg-light fs-4 pl-3 input-text-box", style = "text-align:right;height:35px" })
                                </div>
                                <div class="col-lg-3 col-sm-6 p-3">
                                    <label id="label">Terms Of Delivery :</label>

                                    <div class="form-group row">
                                        @Html.DropDownList("TermsOfDeliveryID", (IEnumerable<SelectListItem>)ViewBag.TermsOfDeliveryID, "Please Select", new { @style = "height:35px;", @class = "form-control  bg-light fs-4 pl-3 input-text-box" })

                                    </div>
                                </div>
                                <div class="col-lg-6 p-3 col-sm-6 mb-3">
                                    <label id="label">Payment Term :</label>

                                    <div class="form-group row">
                                        @Html.DropDownList("PaymentTermID", (IEnumerable<SelectListItem>)ViewBag.PaymentTermID, "Please Select", new { style = "height:35px;", @class = "form-control bg-light fs-4 pl-3 input-text-box" })

                                    </div>
                                </div>
                                <div class="col-lg-4 col-sm-6 p-3">
                                    <label id="label">Shipping Address Same As Billing Address :</label>
                                    <div class="form-check">
                                        <label class="form-check-label" style="color: #0077B3; font-size: small">
                                            <input class="form-check-input" checked type="radio" name="ShippAdd" value="Yes" id="ShippAddYes" onchange="checkAdd(this.value);"> Yes
                                            <span class="circle" style="background-color:#fff">
                                                <span class="check"></span>
                                            </span>
                                        </label>

                                        <label class="form-check-label" style="color: #0077B3; font-size: small">
                                            <input class="form-check-input" type="radio" name="ShippAdd" value="No" id="ShippAddNo" onchange="checkAdd(this.value);"> No
                                            <span class="circle" style="background-color:#fff">
                                                <span class="check"></span>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-8" id="shippAddress">
                                    <label id="label"> Shipping Address :</label>
                                    @Html.EditorFor(model => model.ShippingAddress, new { htmlAttributes = new { placeholder = "Shipping Address", @onkeyup = "myFunction(this.id)", @maxlength = "200", @class = "form-control fs-4 pl-3 input-text-box" } })
                                    <span id="ShipAdd"></span>
                                </div>
                            </div>
                        </fieldset>
                        <fieldset class="dshapefieldset">
                            <p class="field-heading pt-3">
                                <i class="material-icons">double_arrow</i>
                                Item Details
                            </p>
                            <div class="form-group row">
                                <div class="col-lg-6 p-3">
                                    <label id="label">Item Name :</label>
                                    <div class="form-group row">
                                        @Html.DropDownList("ItemID", (IEnumerable<SelectListItem>)ViewBag.ItemID, "Please Select", new { @onchange = "GetCode(this.value);", @class = "form-control fs-4 pl-3 dropdown-textbox", style = "height:35px;margin-top:-3px" })

                                    </div><br /><br />
                                    <span id="reqitem" class="fs-5"></span>
                                </div>
                                <div class="col-lg-2 col-sm-5 p-3">
                                    <label id="label">ItemCode :</label>
                                    @Html.TextBox("ItemCode", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", style = "height:35px" })
                                    <span class="error">Item name required</span>
                                </div>
                                <div class="col-lg-2 col-sm-5 p-3">
                                    <label id="label">Quantity :</label>
                                    @Html.TextBox("Quantity", null, new { @type = "number", @class = "form-control fs-4 pl-3 input-text-box", @Value = "1", style = "height:35px" })
                                    <span id="reqqty"></span>
                                    <span id="regqty"></span>
                                </div>
                                <div class="col-lg-2 col-sm-2 pt-3">
                                    <div class="form-group">
                                        <input type="button" id="add" value="Add" name="add" class=" btn btn-success btn-round search-bttn custo-inner" style="outline-style: none;" onclick="AddProduct(this.value);" />
                                    </div>
                                </div>
                            </div>

                            <div class="">
                                <div id="orderItems" class="tablecontainer table-responsive" style="background-color:#fff">
                                </div>
                                <label></label>
                            </div>
                        </fieldset>
                        <fieldset class="dshapefieldset">
                            <p class="field-heading pt-3">
                                <i class="material-icons">double_arrow</i>
                                Courier Services
                            </p>
                            <div class="form-group row">
                                <div class="col-md-4 p-3">
                                    <label id="label">Courier Name :</label>

                                    <div class="form-group">
                                        @Html.DropDownList("CourierID", (IEnumerable<SelectListItem>)ViewBag.CourierID, "Please Select", new
                                           { @class = "form-control fs-4 pl-3 dropdown-textbox", @onchange = "OtherCourier();", style = "height:35px;margin-top:-5px" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 p-3">
                                    <label id="label">Dispatch Mode :</label>
                                    <div class="form-check">
                                        <label class="form-check-label" id="label">
                                            <input class="form-check-input" type="radio" name="SendType" value="By Hand" id="ByHand" onchange="checksendtype(this.value);"> By Hand
                                            <span class="circle" style="background-color:#fff">
                                                <span class="check"></span>
                                            </span>
                                        </label>

                                        <label class="form-check-label" id="label">
                                            <input class="form-check-input" type="radio" name="SendType" value="By Courier" id="ByCourier" onchange="checksendtype(this.value);"> By Courier
                                            <span class="circle" style="background-color:#fff">
                                                <span class="check"></span>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-6 p-3">
                                    <label id="label">Transport Mode :</label>

                                    <div class="form-check">
                                        <label class="form-check-label" id="label">
                                            <input class="form-check-input" type="radio" name="RateType" value="Air Rate" id="AirRate" onchange="checkratetype(this.value);">By Air
                                            <span class="circle" style="background-color:#fff">
                                                <span class="check"></span>
                                            </span>
                                        </label>

                                        <label class="form-check-label" id="label">
                                            <input class="form-check-input" type="radio" name="RateType" value="Surface Rate" id="SurfaceRate" onchange="checkratetype(this.value);">By Surface
                                            <span class="circle" style="background-color:#fff">
                                                <span class="check"></span>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">Total Weight  <br />In Kg :</label>

                                    @Html.EditorFor(model => model.TotalWeightInKg, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 bg-light input-text-box", style = "text-align:right;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.TotalWeightInKg, "", new { @class = "text-danger" })

                                </div>
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">Docket <br /> Charges :</label>
                                    @Html.EditorFor(model => model.DocketCharges, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 bg-light input-text-box", style = "text-align:right;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.DocketCharges, "", new { @class = "text-danger" })
                                </div>

                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">Fuel  <br />Charges :</label>
                                    @Html.EditorFor(model => model.FuelCharges, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 bg-light input-text-box", style = "text-align:right;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.FuelCharges, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">Other <br /> Charges :</label>
                                    @Html.EditorFor(model => model.OtherCharges, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 bg-light input-text-box", style = "text-align:right;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.OtherCharges, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">COD  <br />Charges :</label>
                                    @Html.EditorFor(model => model.CODCharges, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 bg-light input-text-box", style = "text-align:right;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.CODCharges, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">FOV  <br />Charges :</label>
                                    @Html.EditorFor(model => model.FOV, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 bg-light input-text-box", style = "text-align:right;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.FOV, "", new { @class = "text-danger" })
                                </div>

                            </div>
                        </fieldset>
                        <fieldset class="dshapefieldset">
                            <div class="form-group row">
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">Product Sub Total :</label>
                                    @Html.EditorFor(model => model.ProductSubTotal, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", style = "text-align:right;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.ProductSubTotal, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">Freight Charges:</label>
                                    @Html.EditorFor(model => model.FreightCharges, new { htmlAttributes = new { @class = "form-control bg-light  fs-4 pl-3 input-text-box", style = "text-align:right;height:35px", @onchange = "calbyother();" } })
                                    @Html.ValidationMessageFor(model => model.FreightCharges, "", new { @class = "text-danger" })

                                </div>
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">IGST :</label>
                                    @Html.EditorFor(model => model.IGST, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 bg-light input-text-box", style = "text-align:right;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.IGST, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">CGST :</label>
                                    @Html.EditorFor(model => model.CGST, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 bg-light input-text-box", style = "text-align:right;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.CGST, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">SGST :</label>
                                    @Html.EditorFor(model => model.SGST, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 bg-light input-text-box", style = "text-align:right;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.SGST, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-2 col-sm-6 p-3">
                                    <label id="label">Total Amount :</label>
                                    @Html.TextBox("RoundOffAmount", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @readonly = "readonly", style = "text-align:right;height:35px" })
                                </div>
                            </div>
                        </fieldset>
                        <fieldset class="dshapefieldset">
                            @*<label id="label">Specific Instructions by Customer :</label>*@
                            <label id="label">
                                Specific Instructions by Customer
                                <span class="info-badge" title="Mention any special requirements like customization, delivery needs, or extra details.">i</span>
                            </label>
                            <div class="form-group row">
                                <div class="col-lg-12">
                                    @Html.TextAreaFor(model => model.Note, new { rows = 2, cols = 250, maxlength = "250", @class = "form-control fs-4 pl-3 input-text-box" })
                                    @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-lg-2">
                                    @Html.EditorFor(model => model.GSTTotal, new { htmlAttributes = new { @class = "form-control input-text-box", style = "display: none;height:35px" } })
                                    @Html.ValidationMessageFor(model => model.GSTTotal, "", new { @class = "text-danger" })

                                </div>
                                <div class="col-lg-4">
                                    @Html.TextBox("TotalAmount", null, new { @class = "form-control fs-4 pl-3 input-text-box", style = "display: none;height:35px" })
                                </div>
                            </div>
                        </fieldset>

                        <div class="form-group row ">
                            <div class="col-md-2 col-lg-2 p-4">
                                <input type="button" id="submit" value="Create" class=" btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="SaveSO();" />
                            </div>
                            <div class="col-md-2 col-lg-2 p-4">
                                <input type="button" value="Back" class=" btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="location.href='@Url.Action("Index","SalesOrder")'" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
}


<script>
    $(document).ready(function () {

        /*module button*/
        $.ajax({
            url: '/Settings/GetAllColors',
            type: 'GET',
            success: function (colors) {
                // Example: Apply Inner Button colors
                var bgColor5 = colors.InnerButtonColor; // inner
                var fontColor5 = colors.InnerButtonFontColor; // inner text

                // Example for all preview boxes (optional)
                $('.custo-inner').css('background', bgColor5);//  inner
                $('.custo-inner').css('color', fontColor5);// inner text
            },
            error: function () {
                console.error("Failed to load color settings.");
            }
        });

    });
</script>
