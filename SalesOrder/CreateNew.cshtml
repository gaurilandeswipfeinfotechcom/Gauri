    function GetCPDetailsByOffemail(code) {

        $.ajax({
            url: '@Url.Action("GetCPDetailsByOffemail")',
            data: { "OffEmail": code },
            type: "POST",
            dataType: "json",

            success: function (result) {

                $("#ContactPersonName").val("Please Select");
                $("#OfficeMobileNo").val("Please Select");

                if (result.d2 == true) {
                    $("#CountryCode1").val(result.d1[0].CountryCode);
                    $("#CountryCode2").val(result.d1[0].CountryCode);
                    $("#ContactPersonName").val(fullName(result.d1[0]));
                    $("#OfficeMobileNo").val(result.d1[0].OfficeMobileNo);
                }
                else {
                    $("#OfficeMobileNo").val(result.d1[0].OfficeMobileNo);
                }
                $("#CPDesignation").val(result.d1 && result.d1[0] ? result.d1[0].CPDesignation : "");
            },
            error: function (reponse) { alert("error : " + reponse); }
        });
    }

    /* =========================================================
       SHIPPING ADDRESS
       ========================================================= */
    function checkAdd(code) {
        if (code == "No") {
            $("#shippAddress").show();
        }
        else {
            $("#ShippingAddress").val('');
            $("#ShipAdd").html('');
            $("#shippAddress").hide();
        }
    }

    $(document).ready(function () {

        // punctuation spacing while typing
        $('#ShippingAddress').keyup(function () {
            var v = this.value;
            var fixes = [
                v.replace(/(?=\S)[,.!?:;)](?=\S)/g, '$& '),
                v.replace(/\s+([,.!?:;)])/g, "$1"),
                v.replace(/(?=\S)[&](?=\S)/g, ' & '),
                v.replace(/\b[(]/g, ' ('),
                v.replace(/(?=\S)[-](?=\S)/g, ' - '),
                v.replace(/(?=\S)[\/](?=\S)/g, ' / ')
            ];
            for (var i = 0; i < fixes.length; i++) {
                if (fixes[i] != v) { this.value = fixes[i]; break; }
            }

            // length warning
            var max = parseInt(this.getAttribute("maxlength"));
            if (max && this.value.length >= max) {
                $("#ShipAdd").html('<span style="color:red">Maximum ' + max + ' characters allowed.</span>').show();
            } else {
                $("#ShipAdd").html('');
            }
        });

        // capitalise each word
        $('#ShippingAddress').change(function () {
            this.value = this.value.replace(/\w\S*/g, function (a) { return a.charAt(0).toUpperCase() + a.substr(1).toLowerCase(); });
        });

        // trim spaces
        $('#ShippingAddress').blur(function () {
            $(this).val($.trim($(this).val()));
        });
    });

    /* =========================================================
       ITEMS
       ========================================================= */
    // recalculates sub total, weight and then freight / GST / total
    function refreshTotals() {
        var subtot = 0, totalWeight = 0, i;
        for (i = 0; i < orderItems.length; i++) {
            subtot += parseFloat(orderItems[i]["Amount"].toString());
            totalWeight += (toNum(orderItems[i]["WeightPerUnit"]) + toNum(orderItems[i]["WeightOfPackingBox"])) * parseInt(orderItems[i]["Quantity"].toString(), 10);
        }
        $("#ProductSubTotal").val(subtot);
        $("#TotalWeightInKg").val(Math.round(totalWeight));

        var st = fv('SendType');
        if (!st) return;
        checksendtype(st);
        OtherCourier();
        calbyother();
        if (st === 'By Courier' && $('#CourierID').val() && $('#CourierID').val() != 6 && fv('RateType')) {
            checkratetype(fv('RateType'));
        }
    }

    function AddProduct(nm) {

        var quan;

        itid = fv('ItemID');
        itnm = $('#ItemID option:selected').text().trim();
        quan = parseInt(fv('Quantity'));

        if (nm == "Add") {

            var isAllValid = true;
            if (fv('ItemID') == '') {
                $('#ItemID').focus();
                isAllValid = false;
                setErr('#reqitem', 'Item Name Required');
            }
            else {
                $("#reqitem").html("").hide();
            }

            if (fv('Quantity') == '') {
                $('#Quantity').focus();
                isAllValid = false;
                setErr('#reqqty', 'Quantity Required');
            }
            else {
                $("#reqqty").html("").hide();
                if (/^[0-9]*$/.test(fv('Quantity'))) {
                    $("#regqty").html("").hide();
                }
                else {
                    setErr('#regqty', 'Enter Valid Quantity');
                    isAllValid = false;
                }
            }

            if (isAllValid) {
                for (var k = 0; k < orderItems.length; k++) {
                    if (orderItems[k].ItemID.toString() == itid) {
                        alert("Item Already Exist In List");
                        $('#ItemID').val('').focus();
                        $('#ItemCode').val('');
                        $('#Quantity').val('');
                        isAllValid = false;
                    }
                }
            }

            if (isAllValid) {
                $.ajax({
                    url: '@Url.Action("GetCode")',
                    data: { "ItemID": itid, "AddressTitleId": fv('AddressTitleID') },
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        if (data.length > 0) {

                            for (var i = 0; i < data.length; i++) {
                                var irate = data[i].RatePerUnit;
                                var apprate = data[i].hasPreferredItem
                                    ? parseFloat(irate).toFixed(2)
                                    : parseFloat(irate * (1 - toNum($("#Discount").val()) / 100)).toFixed(2);
                                var amt = (parseFloat(apprate) * quan).toFixed(2);

                                orderItems.push({
                                    SaleOrderNo: fv('SaleOrderNo'),
                                    ItemID: parseInt(itid),
                                    ItemName: itnm,
                                    Quantity: quan,
                                    ItemCode: data[i].ItemCode,
                                    HSNCode: data[i].HSNCode,
                                    HSNClassification: data[i].HSNClassification,
                                    GSTRate: data[i].GSTRate,
                                    RatePerUnit: data[i].RatePerUnit,
                                    ApplicableRate: apprate,
                                    Amount: amt,
                                    WeightPerUnit: data[i].WeightPerUnit,
                                    WeightOfPackingBox: data[i].WeightOfPackingBox,
                                    MfgClosingQuantity: quan
                                });
                            }
                            GeneratedItemsTable();
                            refreshTotals();
                        }
                    }
                });

                $('#ItemID').val('').focus();
                $('#ItemCode').val('');
                $('#Quantity').val(1);
            }
        }
        else if (nm == "Update") {
            var qtyNew = parseInt($('#Quantity').val());

            $.ajax({
                url: '@Url.Action("GetCode")',
                data: { "ItemID": itid, "AddressTitleId": fv('AddressTitleID') },
                type: "POST",
                dataType: "json",
                success: function (data) {
                    if (data.length > 0) {
                        var irate = data[0].RatePerUnit, apprate;

                        if (data[0].hasPreferredItem) {
                            apprate = parseFloat(irate).toFixed(2);
                        } else if (toNum($("#Discount").val()) != 0) {
                            apprate = (parseFloat(irate) * (1 - toNum($("#Discount").val()) / 100)).toFixed(2);
                        } else {
                            apprate = parseFloat(irate).toFixed(2);
                        }

                        var row = orderItems[index];
                        row["ItemID"] = itid;
                        row["Quantity"] = qtyNew;
                        row["MfgClosingQuantity"] = qtyNew;
                        row["ApplicableRate"] = apprate;
                        row["Amount"] = (apprate * qtyNew).toFixed(2);
                        row["ItemName"] = data[0].ItemName;
                        row["ItemCode"] = data[0].ItemCode;
                        row["HSNCode"] = data[0].HSNCode;
                        row["HSNClassification"] = data[0].HSNClassification;
                        row["RatePerUnit"] = data[0].RatePerUnit;
                        row["WeightPerUnit"] = data[0].WeightPerUnit;
                        row["WeightOfPackingBox"] = data[0].WeightOfPackingBox;
                        row["GSTRate"] = data[0].GSTRate;

                        GeneratedItemsTable();
                        refreshTotals();
                    }
                }
            });

            $("#add").val('Add');
            $('#ItemID').val('');
            $('#ItemCode').val('');
            $('#Quantity').val(1);
        }
    }

    function GetCode(code) {

        $.ajax({
            url: '@Url.Action("GetCode")',
            data: { "ItemID": code, "AddressTitleId": fv('AddressTitleID') },
            type: "POST",
            dataType: "json",

            success: function (data) {
                if (data.length > 0) {
                    $("#ItemCode").val(data[0].ItemCode);
                    $("#ItemCode").attr("readonly", true);
                }
            }
        });
    }

    function GeneratedItemsTable() {

        if (orderItems.length > 0) {
            var $list = $('<div class="eq-qlist"/>');

            $.each(orderItems, function (i, val) {

                var iname = val.ItemName;
                $.ajax({
                    url: '@Url.Action("GetIName")',
                    data: { "ItmID": val.ItemID },
                    type: "POST",
                    dataType: "json",
                    async: false,
                    success: function (data) {
                        if (data.length > 0) { iname = data[0].ItemName; }
                    }
                });
                var rowIdx = i;
                var $row = $('<div class="eq-qitem"/>');
                $row.append($('<div class="eq-qitem-name"/>').text(iname));
                var $meta = $('<div class="eq-qitem-meta"/>');
                $meta.append('<span><b>Qty:</b> ' + val.Quantity + '</span>');
                $meta.append('<span><b>Code:</b> ' + (val.ItemCode || '') + '</span>');
                $meta.append('<span><b>HSN:</b> ' + (val.HSNCode || '') + '</span>');
                $meta.append('<span><b>GST:</b> ' + val.GSTRate + '%</span>');
                $meta.append('<span><b>Rate:</b> ' + val.RatePerUnit + '</span>');
                $meta.append('<span><b>App.Rate:</b> ' + val.ApplicableRate + '</span>');
                $meta.append('<span><b>Amt:</b> ' + val.Amount + '</span>');
                $row.append($meta);

                var $remove = $('<button type="button" class="eq-mini" title="Remove">X</button>');
                $remove.click(function (e) {
                    e.preventDefault();
                    orderItems.splice(rowIdx, 1);
                    GeneratedItemsTable();
                    refreshTotals();
                });

                var $Edit = $('<button type="button" class="eq-mini" title="Edit">EDIT</button>');
                $Edit.click(function (e) {
                    e.preventDefault();
                    $('#ItemID').val(val.ItemID);
                    $('#ItemCode').val(val.ItemCode);
                    $('#Quantity').val(val.Quantity);
                    $("#add").val('Update');
                    index = rowIdx;
                });

                var $actions = $('<div class="eq-qitem-actions"/>');
                $actions.append($Edit).append($remove);
                $row.append($actions);

                $list.append($row);
            });
            $('#orderItems').html($list);
        }
        else {
            $('#orderItems').html('');
        }
    }

    /* =========================================================
       COURIER / DISPATCH / CALCULATION
       ========================================================= */
    // dropdown arrow buttons (Dispatch / Transport mode)
    function changeDropdownOption(dropdownId, direction) {
        var dropdown = document.getElementById(dropdownId);
        if (!dropdown || dropdown.disabled || dropdown.options.length === 0) return;

        var nextIndex = dropdown.selectedIndex + direction;
        if (nextIndex < 0 || nextIndex >= dropdown.options.length) return;

        dropdown.selectedIndex = nextIndex;
        dropdown.dispatchEvent(new Event("change", { bubbles: true }));
    }

    // courier dropdown changed
    function onCourierChange() {
        OtherCourier();
        if (fv('SendType') === 'By Courier' && $('#CourierID').val() && $('#CourierID').val() != 6 && fv('RateType')) {
            checkratetype(fv('RateType'));
        }
    }

    // OTHER COURIER (id 6): freight is typed by the user, no transport mode
    function OtherCourier() {
        if ($("#CourierID").val() == 6) {
            $("#RateType").prop("disabled", true);
            $("#FreightCharges").attr("readonly", false);
            $("#FreightCharges").val(0);
            calbyother();
        }
        else {
            $("#RateType").prop("disabled", fv('SendType') === 'By Hand');
        }
    }

    function calbyother() {
        if ($("#CourierID").val() == 6) {

            $("#FreightCharges").attr("readonly", false);

            var psubfr = parseFloat($("#ProductSubTotal").val()) + parseFloat($("#FreightCharges").val());

            var GstAmount = ((psubfr * grate) / 100).toFixed(2);
            $("#GSTTotal").val(GstAmount);

            var SGST, CGST, IGST;
            if (statename == "MAHARASHTRA") {
                SGST = (((psubfr * grate) / 100) / 2).toFixed(2);
                CGST = (((psubfr * grate) / 100) / 2).toFixed(2);
                IGST = 0.00;
            }
            else {
                SGST = 0.00;
                CGST = 0.00;
                IGST = GstAmount;
            }
            $("#SGST").val(SGST);
            $("#CGST").val(CGST);
            $("#IGST").val(IGST);

            var TotalAmount = (parseFloat($("#ProductSubTotal").val()) + parseFloat(GstAmount) + parseFloat($("#FreightCharges").val())).toFixed(2);
            $("#TotalAmount").val(TotalAmount);

            var TotalAmountroundoff = (TotalAmount % 1 === 0.5)
                ? (TotalAmount - 0.5).toFixed(2)
                : Math.round(TotalAmount).toFixed(2);
            $("#RoundOffAmount").val(TotalAmountroundoff);

            $("#DocketCharges, #FuelCharges, #OtherCharges, #CODCharges, #FOV").val(0);
        }
    }

    // Dispatch mode changed (By Courier / By Hand)
    function checksendtype(code) {
        if (code == "By Hand") {

            $("#CourierID").val('').prop("disabled", true);
            $("#RateType").prop("disabled", true);

            var RoundOffFreight = 0.0;
            $("#FreightCharges").val(RoundOffFreight).prop("readonly", true);

            var psubfr = parseFloat($("#ProductSubTotal").val()) + RoundOffFreight;
            var GstAmount = ((psubfr * grate) / 100).toFixed(2);
            $("#GSTTotal").val(GstAmount);

            var SGST, CGST, IGST;
            if (statename == "MAHARASHTRA") {
                SGST = (((psubfr * grate) / 100) / 2).toFixed(2);
                CGST = (((psubfr * grate) / 100) / 2).toFixed(2);
                IGST = 0.00;
            }
            else {
                SGST = 0.00;
                CGST = 0.00;
                IGST = GstAmount;
            }
            $("#SGST").val(SGST);
            $("#CGST").val(CGST);
            $("#IGST").val(IGST);

            var TotalAmount = (parseFloat($("#ProductSubTotal").val()) + parseFloat(GstAmount) + RoundOffFreight).toFixed(2);
            var TotalAmountroundoff = (TotalAmount % 1 === 0.5)
                ? (TotalAmount - 0.5).toFixed(2)
                : Math.round(TotalAmount).toFixed(2);

            $("#TotalAmount").val(TotalAmount);
            $("#RoundOffAmount").val(TotalAmountroundoff);

            $("#DocketCharges, #FuelCharges, #OtherCharges, #CODCharges, #FOV").val(0);
        }
        else if (code == "By Courier") {
            $("#CourierID").prop("disabled", false);
            $("#RateType").prop("disabled", $("#CourierID").val() == 6);
        }
    }

    // Transport mode changed: freight, GST and total are recalculated from the courier rates
    function checkratetype(code) {

        if (!$("#CourierID").val()) return;

        $.ajax({
            url: '@Url.Action("GetCourierDetails")',
            data: '{CourierID: "' + $("#CourierID").val().trim() + '",Cityname: "' + cityname + '",Statename: "' + statename + '"}',
            type: "POST",
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            async: false,
            success: function (r) {

                var data = r.d1;
                var RatePerKG = 0.0;
                var RatePerKG1 = 0.0;
                var RatePerKG2 = 0.0;

                if (r.d2 != "") RatePerKG = parseFloat(r.d2[0].RatePerKg);
                if (r.d3 != "") RatePerKG1 = parseFloat(r.d3[0].RatePerKg);

                if (r.d2 == "" && r.d3 == "" && r.d4 != "" && r.d4 != null) {   // select other rate
                    RatePerKG2 = parseFloat(r.d4[0].RatePerKg);
                }

                if (data.length > 0) {

                    var CourierAmount = 0.00;
                    var TotalCourierAmount = 0.00;
                    var CourierFuelCharges = 0.00;
                    var FOVCharges = 0.00;
                    var NetCourierAmount = 0.00;
                    var FreightCharges = 0.00;
                    var RoundOffFreight = 0.00;

                    $("#FreightCharges").attr("readonly", false);

                    // Free Delivery / To Pay: no freight
                    if ($("#TermsOfDeliveryID").val() == 2 || $("#TermsOfDeliveryID").val() == 3) {
                        RoundOffFreight = 0.00;
                    }
                    else if (code == "Air Rate") {

                        $("#AirRate").val(data[0].AirRate);

                        var w = $("#TotalWeightInKg").val();

                        CourierAmount = parseFloat(w) * parseFloat(data[0].AirRate);

                        TotalCourierAmount = CourierAmount
                            + parseFloat(data[0].DocketCharges)
                            + parseFloat(data[0].OtherCharges);

                        // COD charges only for TermsOfDeliveryID = 4
                        if ($("#TermsOfDeliveryID").val() == 4) {
                            TotalCourierAmount = TotalCourierAmount + parseFloat(data[0].CODCharges);
                        }

                        CourierFuelCharges = (TotalCourierAmount * data[0].FuelCharges) / 100;
                        FOVCharges = (TotalCourierAmount * data[0].FOVPercent) / 100;

                        NetCourierAmount = TotalCourierAmount + CourierFuelCharges + FOVCharges;

                        if (NetCourierAmount < parseFloat(data[0].MinimumAmount)) {
                            NetCourierAmount = parseFloat(data[0].MinimumAmount);
                        }

                        FreightCharges = NetCourierAmount;
                        RoundOffFreight = FreightRoundOff(FreightCharges);
                    }
                    else if (code == "Surface Rate") {
                        if (r.d2 == "" && r.d3 == "" && r.d4 == "" && $("#CourierID").val() != 6) {
                            alert("Courier Rate Not Exist");
                            return;
                        }
                        var w2 = $("#TotalWeightInKg").val();

                        if (RatePerKG != 0)
                            RatePerKG = RatePerKG;
                        else if (RatePerKG1 != 0)
                            RatePerKG = RatePerKG1;
                        else
                            RatePerKG = RatePerKG2;

                        $("#SurfaceRate").val(RatePerKG);
                        CourierAmount = parseFloat(w2) * parseFloat(RatePerKG);

                        TotalCourierAmount = CourierAmount + data[0].DocketCharges + data[0].OtherCharges;

                        if ($("#TermsOfDeliveryID").val() == 4) {
                            TotalCourierAmount = TotalCourierAmount + data[0].CODCharges;
                        }

                        CourierFuelCharges = (TotalCourierAmount * data[0].FuelCharges) / 100;
                        FOVCharges = (TotalCourierAmount * data[0].FOVPercent) / 100;

                        NetCourierAmount = TotalCourierAmount + CourierFuelCharges + FOVCharges;
                        if (NetCourierAmount < parseFloat(data[0].MinimumAmount)) {
                            NetCourierAmount = parseFloat(data[0].MinimumAmount);
                        }

                        FreightCharges = NetCourierAmount;
                        RoundOffFreight = FreightRoundOff(FreightCharges);
                    }

                    $("#FreightCharges").val(Math.round(RoundOffFreight));
                    $("#FreightCharges").attr("readonly", true);

                    var psubfr = parseFloat($("#ProductSubTotal").val()) + parseFloat($("#FreightCharges").val());

                    var GstAmount0 = ((psubfr * grate) / 100).toFixed(2);
                    var SGST, CGST, IGST;

                    if (GSTRegistrationId === 6 || GSTRegistrationId === 7 || GSTRegistrationId === 8) {
                        SGST = 0.00;
                        CGST = 0.00;
                        IGST = 0.00;
                    }
                    else if (statename == "MAHARASHTRA") {
                        SGST = (((psubfr * 18) / 100) / 2).toFixed(2);
                        CGST = (((psubfr * 18) / 100) / 2).toFixed(2);
                        IGST = 0.00;
                    }
                    else {
                        SGST = 0.00;
                        CGST = 0.00;
                        IGST = GstAmount0;
                    }
                    $("#SGST").val(SGST);
                    $("#CGST").val(CGST);
                    $("#IGST").val(IGST);

                    var GstAmount = parseFloat(SGST) + parseFloat(CGST) + parseFloat(IGST);
                    $("#GSTTotal").val(GstAmount);

                    var TotalAmount = (parseFloat($("#ProductSubTotal").val()) + GstAmount + parseFloat(RoundOffFreight)).toFixed(2);

                    var TotalAmountroundoff = (TotalAmount % 1 === 0.5)
                        ? (TotalAmount - 0.5).toFixed(2)
                        : Math.round(TotalAmount).toFixed(2);

                    $("#TotalAmount").val(TotalAmount);
                    $("#RoundOffAmount").val(TotalAmountroundoff);

                    $("#DocketCharges").val(Math.round(data[0].DocketCharges));
                    $("#FuelCharges").val(Math.round(CourierFuelCharges));
                    $("#OtherCharges").val(Math.round(data[0].OtherCharges));

                    if ($("#TermsOfDeliveryID").val() == 4)
                        $("#CODCharges").val(Math.round(data[0].CODCharges));
                    else
                        $("#CODCharges").val(0);

                    $("#FOV").val(Math.round(FOVCharges));
                }
            }
        });
    }

    function FreightRoundOff(freight) {

        freight = Math.trunc(freight);
        var freightCharge = parseInt(freight);
        var freightMOD = freightCharge % 100;

        freightCharge = parseInt(freightCharge / 100);

        if (freightMOD == 0)
            freightCharge = freightCharge * 100;
        else if (freightMOD <= 25)
            freightCharge = (freightCharge * 100) + 25;
        else if (freightMOD <= 50)
            freightCharge = (freightCharge * 100) + 50;
        else if (freightMOD <= 75)
            freightCharge = (freightCharge * 100) + 75;
        else if (freightMOD <= 100)
            freightCharge = (freightCharge * 100) + 100;

        return freightCharge;
    }

    /* =========================================================
       SAVE SALES ORDER
       ========================================================= */
    function SaveSO() {

        var ok = true;
        function fail(focusSel, errSel, msg) {
            if (ok && focusSel) $(focusSel).focus();
            setErr(errSel, msg);
            ok = false;
        }
        $('#reqquo, #reqpon, #reqpod, #reqmrd, #reqcon, #errorPMobile11, #reqEm, #ShipAdd, #reqdisp, #reqitems').html('').hide();

        if (orderItems.length == 0) fail('#ItemID', '#reqitems', 'Please add order items');

        if ($('input[name=ShippAdd]:checked').val() == "No" && fv('ShippingAddress') == "") {
            fail('#ShippingAddress', '#ShipAdd', 'Enter Shipping Address');
        }

        if (fv('QuotationNo') == '') fail('#QuotationNo', '#reqquo', 'Quotation No Required');
        if (fv('CustomerPoNo') == '') fail('#CustomerPoNo', '#reqpon', 'Purchase Order No Required');
        if (fv('PurchaseOrderDate') == '') fail('#PurchaseOrderDate', '#reqpod', 'Purchase Order Date Required');
        if (fv('MaterialRequiredDate') == '') fail('#MaterialRequiredDate', '#reqmrd', 'Material Required Date Required');

        var cp = fv('ContactPersonName');
        if (cp == '' || cp == 'Please Select') fail('#ContactPersonName', '#reqcon', 'Required Contact Person');

        var mob = fv('OfficeMobileNo');
        if (mob == '' || mob == 'Please Select') fail('#OfficeMobileNo', '#errorPMobile11', 'Enter Office MobileNo');

        var em = fv('OfficeEmailId');
        if (em == '' || em == 'Please Select') fail('#OfficeEmailId', '#reqEm', 'Required OfficeEmailId');

        var stype = fv('SendType'), rtype = '', counm = '', couid = '';
        if (stype == "By Courier") {
            couid = fv('CourierID');
            counm = $.trim($('#CourierID option:selected').text());
            if (couid == '') fail('#CourierID', '#reqdisp', 'Select Courier');
            else if (couid != 6) {
                rtype = fv('RateType');
                if (rtype == '') fail('#RateType', '#reqdisp', 'Select Transport Mode');
            }
        }

        if (!ok) return;

        var SOItems = [];
        for (var i = 0; i < orderItems.length; i++) {
            SOItems.push({
                SaleOrderNo: fv('SaleOrderNo'),
                ItemId: orderItems[i]["ItemID"],
                ItemName: orderItems[i]["ItemName"],
                Quantity: orderItems[i]["Quantity"].toString(),
                ApplicableRate: orderItems[i]["ApplicableRate"],
                Amount: orderItems[i]["Amount"].toString(),
                ItemCode: orderItems[i]["ItemCode"] ? orderItems[i]["ItemCode"].toString() : "",
                HSNCode: orderItems[i]["HSNCode"] ? orderItems[i]["HSNCode"].toString() : "",
                RatePerUnit: orderItems[i]["RatePerUnit"].toString(),
                WeightPerUnit: orderItems[i]["WeightPerUnit"].toString(),
                WeightOfPackingBox: orderItems[i]["WeightOfPackingBox"].toString(),
                GSTRate: orderItems[i]["GSTRate"].toString(),
                SalesClosingQuantity: 0,
                MfgClosingQuantity: orderItems[i]["Quantity"].toString()
            });
        }

        var designinfoid;
        $.ajax({
            url: '@Url.Action("GetDesignInfoId")',
            data: { "ContactPerson": $('#ContactPersonName').val(), "OffEmail": $('#OfficeEmailId').val(), "OffMobile": $('#OfficeMobileNo').val(), "Lid": $('#LedgerID').val(), "AddID": $('#AddressTitleID').val() },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {
                if (data.length > 0) { designinfoid = data[0].DesignationInfoID; }
            }
        });

        var sdate = new Date();
        var data = {
            SaleOrderNo: fv('SaleOrderNo'),
            SaleOrderDate: sdate.toDateString(),
            QuotationNo: fv('QuotationNo'),
            CustomerPoNo: fv('CustomerPoNo'),
            CustomerPoDate: fv('PurchaseOrderDate'),
            EntityName: $.trim($('#LedgerID option:selected').text()),
            AddressTitle: fv('AddressTitle'),
            Address: fv('Address'),
            LandMark: fv('LandMark'),
            Locality: fv('Locality'),
            Taluka: fv('Taluka'),
            District: fv('District'),
            Pincode: fv('Pincode1'),
            State: fv('State'),
            Country: fv('Country'),
            MaterialRequiredDate: fv('MaterialRequiredDate'),
            MatReqPeriodId: '',
            TermsOfDelivery: $.trim($('#TermsOfDeliveryID option:selected').text()),
            TermsOfDeliveryId: fv('TermsOfDeliveryID'),
            DiscountPercent: fv('Discount'),
            PaymentTerm: $.trim($('#PaymentTermID option:selected').text()),
            ContactPersonName: cp,
            OfficeMobileNo: mob,
            OfficeEmailId: em,
            TotalWeightInKg: fv('TotalWeightInKg'),
            SendType: stype,
            TransporterName: counm,
            RateType: rtype,
            AirRate: fv('AirRate'),
            SurfaceRate: fv('SurfaceRate'),
            DesignationInfoId: designinfoid,
            TotalAmount: fv('TotalAmount'),
            RoundOffTotalAmount: fv('RoundOffAmount'),
            ProductSubTotal: fv('ProductSubTotal'),
            FreightCharges: fv('FreightCharges'),
            GSTTotal: fv('GSTTotal'),
            SGST: fv('SGST'),
            CGST: fv('CGST'),
            IGST: fv('IGST'),
            DocketCharges: fv('DocketCharges'),
            FuelCharges: fv('FuelCharges'),
            OtherCharges: fv('OtherCharges'),
            CODCharges: fv('CODCharges'),
            FOV: fv('FOV'),
            UserId: fv('UserId'),
            CountryCode: fv('CountryCode1'),
            TransporterId: couid,
            CPDesignation: fv('CPDesignation'),
            Note: fv('Note'),
            StatusId: 3,
            ShippingAddSameAsBillAdd: $('input[name=ShippAdd]:checked').val(),
            ShippingAddress: fv('ShippingAddress'),
            SalesItem: SOItems
        };

        $('#createsubmit').prop('disabled', true);

        $.ajax({
            url: '/SalesOrder/SaveOrder',
            type: "POST",
            data: JSON.stringify(data),
            dataType: "JSON",
            contentType: "application/json",
            success: function (d) {
                if (d.success === true) {
                    alert(d.responseText);
                    window.location.href = '/SaleOrderReport.aspx';
                }
                else {
                    alert(d.responseText);
                    $('#createsubmit').prop('disabled', false);
                }
            },
            error: function () {
                alert('Error. Please try again.');
                $('#createsubmit').prop('disabled', false);
            }
        });
    }
</script>

