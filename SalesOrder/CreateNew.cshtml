    var orderItems = [];
    var index;
    var itid, itnm;

    var grate, statename, cityname, GSTRegistrationId;

    /* =========================================================
       HELPERS
       ========================================================= */
    function fv(id) { return ($('#' + id).val() || '').toString().trim(); }

    function toNum(x) { var n = parseFloat(x); return isNaN(n) ? 0 : n; }

    function fmtDate(d) {
        function pad(s) { return (s < 10) ? '0' + s : s; }
        return [pad(d.getDate()), pad(d.getMonth() + 1), d.getFullYear()].join('/');
    }

    // "/Date(1735516800000)/" -> Date
    function parseMsDate(s) {
        var m = /\/Date\((-?\d+)\)\//.exec(s || '');
        return m ? new Date(parseInt(m[1], 10)) : null;
    }

    function fullName(d) {
        return d.Title + " " + d.FirstName + (d.MiddleName ? " " + d.MiddleName : "") + " " + d.LastName;
    }

    function setErr(sel, msg) { $(sel).html('<span style="color:red">' + msg + '</span>').show(); }

    // shows street address + locality, taluka, district, state, pincode as one text
    function refreshAddr() {
        var parts = ["#Address", "#Locality", "#Taluka", "#District", "#State", "#Pincode1"], out = [];
        for (var i = 0; i < parts.length; i++) {
            var v = ($(parts[i]).val() || "").toString().trim();
            if (v !== "") out.push(v);
        }
        $("#AddressView").val(out.join(", "));
    }

    /* =========================================================
       SEARCH BY QUOTATION NUMBER
       ========================================================= */
    $(document).ready(function () {
        // auto search when the quotation dropdown already has a value
        var q = fv('QuotationNo');
        if (q !== "" && q !== "Please Select") {
            GetDetailsByQuoNo();
        }
    });

    function GetDetailsByQuoNo() {

        $('#orderItems').empty();
        orderItems = [];

        var qno = fv('QuotationNo');
        if (qno === '') {
            setErr('#reqquo', 'Quotation No Required');
            return;
        }
        $('#reqquo').html('').hide();

        $.ajax({
            url: '/SalesOrder/GetDetailsByQuoNo/',
            data: JSON.stringify({ Quono: qno }),
            dataType: "json",
            type: "POST",
            contentType: "application/json; charset=utf-8",
            success: function (result) {

                var r = result && result[0];
                if (!r) { alert('Quotation details not found.'); return; }

                $('#orderItems').empty();
                orderItems = [];

                var qd = parseMsDate(r.QuoteDate);
                if (qd) $("#QuotationDate").val(fmtDate(qd));

                var ed = parseMsDate(r.EnquiryDate);
                if (ed) $("#EnquiryDate").val(fmtDate(ed));

                // company, address, contact
                $("#LedgerID").val(r.LedgerID);
                GetCompanyInfo($("#LedgerID").val());

                $("#AddressTitleID").val(r.AddressTitleID);
                GetAddrCPInfoDirect($("#AddressTitleID").val());

                $("#Address").val(r.Address);
                $("#Pincode1").val(r.Pincode);
                $("#State").val(r.State);
                $("#AddressTitle").val(r.AddressTitle);
                $("#LandMark").val(r.LandMark);
                $("#Locality").val(r.Locality);
                $("#Taluka").val(r.Taluka);
                $("#District").val(r.District);
                $("#Country").val(r.Country);

                // fields that come from the quotation and cannot be changed here
                $("#TermsOfDeliveryID").val(r.TermsOfDeliveryID).prop("disabled", true);
                $("#PaymentTermID").val(r.PaymentTermID).prop("disabled", true);
                $("#Discount").val(r.DiscountPercent).prop("disabled", true);
                $("#EnquiryNo").val(r.EnquiryNo);
                $("#Note").val(r.Note);

                statename = r.State;
                cityname = r.Taluka;
                refreshAddr();

                // items
                var pro = r.pro || [];
                if (pro.length) grate = pro[0].GSTRate;
                var disc = toNum($("#Discount").val());

                for (var i = 0; i < pro.length; i++) {
                    var p = pro[i], apprate, amt;
                    if (p.hasPreferredItem) {
                        apprate = p.RatePerUnit;
                        amt = (p.RatePerUnit * p.Quantity).toFixed(2);
                    } else {
                        apprate = (disc === 0)
                            ? toNum(p.RatePerUnit).toFixed(2)
                            : (p.RatePerUnit * (1 - disc / 100)).toFixed(2);
                        amt = (apprate * p.Quantity).toFixed(2);
                    }
                    orderItems.push({
                        SaleOrderNo: fv('SaleOrderNo'),
                        ItemID: p.ItemID,
                        ItemName: p.ItemName,
                        Quantity: p.Quantity,
                        ItemCode: p.ItemCode,
                        HSNCode: p.HSNCode,
                        HSNClassification: p.HSNClassification,
                        GSTRate: p.GSTRate,
                        RatePerUnit: p.RatePerUnit,
                        ApplicableRate: apprate,
                        Amount: amt,
                        WeightPerUnit: p.WeightPerUnit,
                        WeightOfPackingBox: p.WeightOfPackingBox
                    });
                }

                GeneratedItemsTable();

                var subtot = 0, weight = 0;
                for (i = 0; i < orderItems.length; i++) {
                    subtot += parseFloat(orderItems[i]["Amount"].toString());
                    weight += (toNum(orderItems[i]["WeightPerUnit"]) + toNum(orderItems[i]["WeightOfPackingBox"])) * parseInt(orderItems[i]["Quantity"].toString(), 10);
                }
                $("#ProductSubTotal").val(subtot);
                $("#TotalWeightInKg").val(Math.round(weight));

                // dispatch mode, courier, transport mode as saved in the quotation
                applyDispatch(r.SendType, r.RateType, r.CourierID);

                if (r.SendType) {
                    checksendtype(r.SendType);
                    OtherCourier();
                    if ($("#CourierID").val() == 6) $("#FreightCharges").val(r.FreightCharges);
                    calbyother();
                    if (r.SendType === 'By Courier' && $("#CourierID").val() != 6 && fv('RateType')) {
                        checkratetype(fv('RateType'));
                    }
                }
            },
            error: function (response) { alert('Error: ' + response.responseText); }
        });
    }

    // Dispatch Mode / Transport Mode are dropdowns (#SendType / #RateType)
    function applyDispatch(sendType, rateType, courierId) {
        if (sendType === 'By Hand') {
            $('#SendType').val('By Hand');
            $('#CourierID').val('').prop('disabled', true);
            $('#RateType').prop('disabled', true);
        }
        else if (sendType === 'By Courier') {
            $('#SendType').val('By Courier');
            $('#CourierID').val(courierId).prop('disabled', false);
            if (rateType) $('#RateType').val(rateType);
            $('#RateType').prop('disabled', false);
        }
    }

    /* =========================================================
       COMPANY / ADDRESS / CONTACT
       ========================================================= */
    function GetCompanyInfo(code) {

        $.ajax({
            url: '@Url.Action("GetCompanyInfo")',
            data: { "LedgerID": code },
            type: "POST",
            dataType: "json",
            async: false,

            success: function (result) {

                $("#AddressTitleID").html("");

                $.each(result.d1, function (i, data) {
                    $('<option>', { value: data.AddressTitleID, text: data.AddressTitleID })
                        .html(data.AddressTitle).appendTo("#AddressTitleID");
                });
                var a = $("#AddressTitleID").val();

                $.ajax({
                    url: '@Url.Action("getAddressInfo")',
                    data: '{add: "' + a + '"}',
                    type: "POST",
                    dataType: "json",
                    async: false,
                    contentType: "application/json; charset=utf-8",

                    success: function (result1) {
                        if (result1.length > 0) {
                            var vdata = result1;

                            $("#Address").val(vdata[0].Address);
                            $("#State").val(vdata[0].State);
                            $("#Pincode1").val(vdata[0].Pincode);
                            $("#Locality").val(vdata[0].Locality);
                            $("#Taluka").val(vdata[0].Taluka);
                            $("#Country").val(vdata[0].Country);
                            $("#District").val(vdata[0].District);

                            statename = vdata[0].State;
                            cityname = vdata[0].Taluka;
                            GSTRegistrationId = vdata[0].GSTRegistrationId;
                        }
                    },
                    failure: function (response) { alert(response.responseText); },
                    error: function (response) { alert(response.responseText); }
                });
            },
            error: function (reponse) { alert("error : " + reponse); }
        });

        refreshAddr();
    }

    function GetAddrCPInfoDirect(code) {

        var a = $("#AddressTitleID").val();

        $.ajax({
            url: '@Url.Action("getAddressInfo")',
            data: '{add: "' + a + '"}',
            type: "POST",
            dataType: "json",
            async: false,
            contentType: "application/json; charset=utf-8",

            success: function (result1) {
                if (result1.length > 0) {
                    var vdata = result1;

                    $("#Address").val(vdata[0].Address);
                    $("#AddressTitle").val(vdata[0].AddressTitle);
                    $("#LandMark").val(vdata[0].LandMark);
                    $("#Locality").val(vdata[0].Locality);
                    $("#Taluka").val(vdata[0].Taluka);
                    $("#District").val(vdata[0].District);
                    $("#Pincode1").val(vdata[0].Pincode);
                    $("#State").val(vdata[0].State);
                    $("#Country").val(vdata[0].Country);
                    GSTRegistrationId = vdata[0].GSTRegistrationId;
                    statename = vdata[0].State;
                    cityname = vdata[0].Taluka;
                }
            },
            failure: function (response) { alert(response.responseText); },
            error: function (response) { alert(response.responseText); }
        });

        $.ajax({
            url: '@Url.Action("GetCPInfo")',
            data: { "AddressTitleID": code },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (result) {
                var vdata1 = result.d1;
                var vdata3 = result.d3;

                // Contact Person dropdown
                $("#ContactPersonName").html("");
                $.each(vdata1, function (i, data) {
                    var nm = fullName(data);
                    $('<option>', { value: nm, text: nm }).appendTo("#ContactPersonName");
                });

                // Country code and designation from the first person (default)
                if (vdata1.length > 0) {
                    $("#CountryCode1").val(vdata1[0].CountryCode);
                    $("#CountryCode2").val(vdata1[0].CountryCode);
                    $("#CPDesignation").val(vdata1[0].CPDesignation);
                }

                // Office mobile numbers and emails
                $("#OfficeMobileNo").html("");
                $("#OfficeEmailId").html("");
                $.each(vdata3, function (j, data) {
                    if (data.OfficeMobileNo != null) {
                        $('<option>', { value: data.OfficeMobileNo, text: data.OfficeMobileNo }).appendTo("#OfficeMobileNo");
                    }
                    if (data.OfficeEmailId != null) {
                        $('<option>', { value: data.OfficeEmailId, text: data.OfficeEmailId }).appendTo("#OfficeEmailId");
                    }
                });
            },
            error: function (response) { alert("Error: " + response.responseText); }
        });

        refreshAddr();
    }

    function GetCPDetails(code) {

        $.ajax({
            url: '@Url.Action("GetCPDetails")',
            data: { "ContactPersonName": code, "LedgerID": $("#LedgerID").val(), "AddressTitleID": $("#AddressTitleID").val() },
            type: "POST",
            dataType: "json",
            async: false,

            success: function (result) {
                $("#CountryCode1").val(result[0].CountryCode);
                $("#CountryCode2").val(result[0].CountryCode);
                $("#OfficeMobileNo").val(result[0].OfficeMobileNo);
                $("#OfficeEmailId").val(result[0].OfficeEmailId);
                $("#CPDesignation").val(result[0].CPDesignation);
            },
            error: function (reponse) { alert("error : " + reponse); }
        });
    }

    function GetCPDetailsByOffmobno(code) {

        $.ajax({
            url: '@Url.Action("GetCPDetailsByOffmobno")',
            data: { "OffMobile": code },
            type: "POST",
            dataType: "json",
            async: false,

            success: function (result) {

                $("#ContactPersonName").val("Please Select");
                $("#OfficeEmailId").val("Please Select");
                if (result.d2 == true) {
                    $("#CountryCode1").val(result.d1[0].CountryCode);
                    $("#CountryCode2").val(result.d1[0].CountryCode);
                    $("#OfficeEmailId").val(result.d1[0].OfficeEmailId);
                    $("#ContactPersonName").val(fullName(result.d1[0]));
                }
                else {
                    $("#OfficeEmailId").val(result.d1[0].OfficeEmailId);
                }
                $("#CPDesignation").val(result.d1 && result.d1[0] ? result.d1[0].CPDesignation : "");
            },
            error: function (reponse) { alert("error : " + reponse); }
        });
