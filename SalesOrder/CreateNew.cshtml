        min-height: 40px !important;
        resize: none;
        line-height: 15px;
        padding: 3px 8px !important;
        background: #f3f5f8 !important;
    }

    .eq-inline {
        display: flex;
        gap: 5px;
        align-items: flex-end;
    }

        .eq-inline > .eq-field {
            flex: 1;
            min-width: 0;
        }

    .eq-code {
        flex: 0 0 54px !important;
    }

    /* radio group (shipping address) */
    .eq-radios {
        display: flex;
        gap: 12px;
        align-items: center;
        height: 28px;
    }

    .eq-radio {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin: 0;
        color: #0077B3;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }

        .eq-radio input[type=radio] {
            width: 14px;
            height: 14px;
            margin: 0;
            position: static;
            opacity: 1;
        }

    /* buttons */
    .eq-btn {
        width: auto;
        border: none;
        background: linear-gradient(135deg, #20BED0, #1B247D);
        border-radius: 4px;
        padding: 5px 16px;
        color: #fff;
        font-weight: 600;
        font-size: 12.5px;
        cursor: pointer;
    }

        .eq-btn:hover {
            opacity: .92;
        }

        .eq-btn:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .eq-btn-sm {
        padding: 4px 12px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
    }

        .eq-btn-sm i.material-icons {
            font-size: 16px;
            margin: 0;
            color: #fff;
        }

    .eq-footer {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin: 6px auto 0;
    }

    /* item add row + item list */
    .eq-item-add {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 100px 70px auto;
        gap: 8px;
        align-items: end;
    }

        .eq-item-add .eq-btn {
            height: 28px;
            padding: 3px 14px;
        }

    .eq-items {
        margin-top: 6px;
        flex: 0 0 auto;
        min-height: 0;
        overflow: visible;
        background: #fff;
    }

    #orderItems:empty {
        display: none;
    }

    .eq-qitem {
        position: relative;
        background: #f8fbff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 5px 8px;
        margin-bottom: 5px;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
    }

    .eq-qitem-name {
        font-weight: 700;
        font-size: 13px;
        color: #222;
        padding-right: 96px;
        overflow-wrap: anywhere;
    }

    .eq-qitem-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 2px 14px;
        margin-top: 2px;
        font-size: 12px;
        color: #222;
    }

        .eq-qitem-meta b {
            color: #172b7a;
        }

    .eq-qitem-actions {
        position: absolute;
        top: 5px;
        right: 6px;
        display: flex;
        gap: 4px;
    }

    .eq-mini {
        border: 1px solid #8a8f98;
        background: #f1f3f5;
        color: #172b7a;
        border-radius: 3px;
        padding: 1px 9px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        line-height: 18px;
    }

        .eq-mini:hover {
            background: #e2e6ea;
        }

    /* validation messages (the script writes into these spans) */
    span.error {
        display: none;
    }

    .eq-field > span[id], #reqdisp, #reqitems {
        display: block;
        font-size: 11px;
        line-height: 13px;
    }

        .eq-field > span[id]:empty, #reqdisp:empty, #reqitems:empty {
            display: none;
        }

    .info-badge {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        font-size: 11px;
        font-weight: 600;
        background-color: #6c757d;
        color: white;
        cursor: pointer;
        margin-left: 6px;
    }

        .info-badge:hover {
            background-color: #adb5bd;
        }

    .ui-widget {
        font-size: 12px !important;
    }

    textarea::placeholder {
        color: #999;
        font-size: 12.5px;
    }

    /* ---------- Delivery Instructions card ---------- */
    .quotation-delivery-four-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        width: 100%;
        align-items: end;
    }

        .quotation-delivery-four-row .eq-field,
        .quotation-delivery-four-row .courier-field {
            min-width: 0;
            width: 100%;
        }

    .quotation-delivery-charges {
        margin-top: 8px;
    }

    .courier-mode-field label {
        display: block;
        font-size: 11.5px;
        font-weight: 600;
        color: #172b7a;
        margin: 0 0 1px;
        line-height: 13px;
    }

    .mode-dropdown-wrapper {
        position: relative;
        display: block;
        width: 100%;
    }

        .mode-dropdown-wrapper select {
            width: 100%;
            height: 28px;
            padding: 1px 32px 1px 8px;
            border: 1px solid #cfd6df;
            border-radius: 4px;
            font-size: 12.5px;
            appearance: none;
            -webkit-appearance: none;
            box-sizing: border-box;
        }

            .mode-dropdown-wrapper select:disabled {
                background: #f3f5f8;
                color: #222;
                opacity: 1;
            }

    .mode-arrow-buttons {
        position: absolute;
        top: 1px;
        right: 2px;
        bottom: 1px;
        width: 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        z-index: 5;
        background: #fff;
    }

        .mode-arrow-buttons button {
            flex: 1;
            width: 100%;
            min-height: 0;
            padding: 0;
            margin: 0;
            border: none;
            background: transparent;
            color: #333;
            font-size: 9px;
            line-height: 1;
            cursor: pointer;
        }

    @@media (max-width: 1100px) {
        .eq-main {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @@media (max-width: 700px) {
        .eq-g6 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

            .eq-g6 .eq-s2, .eq-g6 .eq-s3 {
                grid-column: 1 / -1;
            }

        .eq-g3 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .eq-search-row {
            flex-wrap: wrap;
        }

        .eq-item-add {
            grid-template-columns: 1fr 1fr;
        }

            .eq-item-add > :first-child {
                grid-column: 1 / -1;
            }

        .quotation-delivery-four-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    .eq-so-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 8px 3px;
        align-items: start;
    }
    .company-details-head {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 20px;
    }

    .company-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .company-title-inline {
        display: flex;
        align-items: center;
        width: 220px;
    }

        .company-title-inline select {
            width: 100%;
            height: 30px;
        }
    .eq-field.eq-s2 {
        display: flex;
        align-items: center;
        gap: 20px;
    }

        .eq-field.eq-s2 > label {
            margin-bottom: 0;
            white-space: nowrap;
        }

        .eq-field.eq-s2 .eq-radios {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .eq-field.eq-s2 .eq-radio {
            margin-bottom: 0;
            white-space: nowrap;
        }
    .contact-details-head {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 20px;
    }

    .contact-details-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .contact-person-inline {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 520px;
    }

    .contact-field-icon {
        font-size: 20px;
        color: #0085c8;
        flex-shrink: 0;
    }

    .contact-person-inline select {
        width: 100%;
        height: 25px;
    }
    .contact-input-row {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
    }

        .contact-input-row > .contact-field-icon {
            flex-shrink: 0;
            font-size: 20px;
            color: #0085c8;
        }

        .contact-input-row .eq-inline {
            flex: 1;
            min-width: 0;
        }

        .contact-input-row > select {
            flex: 1;
            min-width: 0;
        }
    /* Remove gaps only between right-side cards */
    .eq-main > .eq-col:last-child {
        gap: 0 !important;
    }

        .eq-main > .eq-col:last-child > .eq-card {
            margin-bottom: 0 !important;
        }
    /* Increase Payment Term and Company Name widths */
    .eq-so-grid .payment-term-field {
        grid-column: span 3;
    }

    .eq-so-grid .company-name-field {
        grid-column: span 3;
    }
    /* Delivery Instructions heading and Other Terms in one row */
    .delivery-instructions-head {
        display: flex;
        align-items: center;
        justify-content: flex-start !important;
        gap: 15px;
    }

    .delivery-heading {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .other-field {
        display: flex;
        align-items: center;
        gap: 5px;
        width: 220px;
        margin-left: 0;
    }

        .other-field i.material-icons {
            color: #0085c8;
            font-size: 18px;
            flex-shrink: 0;
        }

        .other-field input {
            width: 100%;
            height: 26px;
            min-width: 0;
            font-size: 12px;
        }
    .item-details-card {
        min-height: 160px;
    }

        .item-details-card .eq-card-body {
            padding-bottom: 15px;
        }
    .eq-search-company-field {
        flex: 0 1 460px;
        min-width: 0;
    }
    .eq-search-company-field {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 0 1 630px;
        min-width: 0;
    }

        .eq-search-company-field label {
            margin: 0;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .eq-search-company-field select {
            flex: 1;
            min-width: 0;
            width: 100%;
        }
    #PurchaseOrderDate,
    #MaterialRequiredDate {
        padding-left: 2px !important;
        padding-right: 0px !important;
    }
    /* Space above Search button and Company Name dropdown */
    /* Space above all three controls */
    .eq-search-row .eq-field,
    .eq-search-row #btnsearch,
    .eq-search-company-field select {
        margin-top: 8px;
    }
</style>

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="purchase-breadcrumb">
            <h4 class="route-path1">Sales</h4>

            <h4 class="route-path2" onclick="location.href='@Url.Action("Index", "SalesOrder")'">
                Sales Order
            </h4>

            <h4 class="route-path2">
                Create
            </h4>

            <div class="view-toggle">
                <span>Switch to Form</span>
                <label class="switch">
                    <input type="checkbox" id="viewToggle">
                    <span class="slider round"></span>
                </label>
            </div>
        </div>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="eq-page">

        @* model bound fields used by the save code *@
        <div style="display:none;">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.AddressTitle)
            @Html.HiddenFor(model => model.LandMark)
            @Html.HiddenFor(model => model.Country)
            @Html.HiddenFor(model => model.AirRate)
            @Html.HiddenFor(model => model.SurfaceRate)
            @Html.HiddenFor(model => model.StatusId)
            @Html.HiddenFor(model => model.CPDesignation)
            @Html.EditorFor(model => model.UserId, new { htmlAttributes = new { @class = "form-control", style = "display: none;" } })
            @Html.EditorFor(model => model.GSTTotal, new { htmlAttributes = new { @class = "form-control", style = "display: none;" } })
            @Html.TextBox("TotalAmount", null, new { @class = "form-control", style = "display: none;" })
            @Html.TextBox("Locality", null, new { style = "display:none;" })
            @Html.TextBox("Taluka", null, new { style = "display:none;" })
            @Html.TextBox("Pincode1", null, new { style = "display:none;" })
            @Html.TextBox("District", null, new { style = "display:none;" })
            @Html.TextBox("State", null, new { style = "display:none;" })
        </div>

        @* ===================== ROW 1 : SEARCH (full width, one block) ===================== *@
        <div class="eq-card">
            <div class="eq-card-body">
                <div class="eq-search-row">
                    <label class="eq-search-label">Search by Quotation Number</label>
                    <div class="eq-field">
                        @Html.DropDownList("QuotationNo", (IEnumerable<System.Web.Mvc.SelectListItem>)ViewBag.QuotationNo, new { @class = "eq-input" })
                        <span id="reqquo"></span>
                    </div>
                    <button type="button" id="btnsearch" name="btnsearch" class="eq-btn eq-btn-sm" onclick="GetDetailsByQuoNo();">
                        <i class="material-icons">search</i> Search
                    </button>
                    <div class="eq-search-company-field">
                        <label class="eq-search-label">Company Name</label>
                        @Html.DropDownList("LedgerID", (IEnumerable<SelectListItem>)ViewBag.BusinessEntityId, "Please Select", new { @class = "eq-input", @disabled = "disabled" })
                    </div>

                </div>
            </div>
        </div>

        @* ===================== ROW 2 : LEFT / RIGHT ===================== *@
        <div class="eq-main">

            @* ---------- LEFT COLUMN ---------- *@
            <div class="eq-col">

                @* ---- 1. SALES ORDER DETAILS ---- *@
                <div class="eq-card">
                    <div class="eq-card-head">
                        <span><i class="material-icons">feed</i>Sales Order Details</span>
                    </div>
                    <div class="eq-card-body">
                        @*<div class="eq-grid eq-g3">*@
                        <div class="eq-grid eq-so-grid">
                            <div class="eq-field">
                                <label>Sale Order No.</label>
                                @Html.EditorFor(model => model.SaleOrderNo, new { htmlAttributes = new { @class = "eq-input", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.SaleOrderNo, "", new { @class = "text-danger" })
                            </div>
                            <div class="eq-field">
                                <label>Sale Order Date</label>
                                @Html.TextBox("SaleOrderDate", null, new { @class = "eq-input", @readonly = "readonly" })
                                @Html.ValidationMessageFor(model => model.SaleOrderDate, "", new { @class = "text-danger" })
                            </div>
                            <div class="eq-field">
                                <label>Pur. Order No.</label>
                                @Html.EditorFor(model => model.CustomerPoNo, new { htmlAttributes = new { @class = "eq-input" } })
                                <span id="reqpon"></span>
                            </div>
                            <div class="eq-field">
                                <label>Pur. Order Date</label>
                                @Html.TextBox("PurchaseOrderDate", null, new { @class = "eq-input", @type = "date" })
                                <span id="reqpod"></span>
                            </div>
                            <div class="eq-field">
                                <label>Material Req Date</label>
                                @Html.EditorFor(model => model.MaterialRequiredDate, "{0:dd/MM/yyyy}", new { htmlAttributes = new { @class = "eq-input", @type = "date" } })
                                <span id="reqmrd"></span>
                            </div>
                            <div class="eq-field">
                                <label>Quotation Date</label>
                                @Html.TextBox("QuotationDate", null, new { @class = "eq-input", @readonly = "readonly" })
                            </div>
                            <div class="eq-field">
                                <label>Enquiry No.</label>
                                @Html.TextBox("EnquiryNo", null, new { @class = "eq-input", @readonly = "readonly" })
                            </div>
                            <div class="eq-field">
                                <label>Enquiry Date</label>
                                @Html.TextBox("EnquiryDate", null, new { @class = "eq-input", @readonly = "readonly" })
                            </div>
                            <div class="eq-field">
                                <label>Discount</label>
                                @Html.TextBox("Discount", null, new { @class = "eq-input eq-num" })
                            </div>
                            <div class="eq-field payment-term-field">
                                <label>Payment Term</label>
                                @Html.DropDownList("PaymentTermID", (IEnumerable<SelectListItem>)ViewBag.PaymentTermID, "Please Select", new { @class = "eq-input" })
                            </div>
                            @*<div class="eq-field company-name-field">
                                <label>Company Name</label>
                                @Html.DropDownList("LedgerID", (IEnumerable<SelectListItem>)ViewBag.BusinessEntityId, "Please Select", new { @class = "eq-input", @disabled = "disabled" })
                            </div>*@
                        </div>
                    </div>
                </div>
                @* ---- 4. ITEM DETAILS ---- *@
            <div class="eq-card item-details-card">
                <div class="eq-card-head">
                    <span><i class="material-icons">inventory_2</i>Item Details</span>
                </div>
                <div class="eq-card-body">
                    <div class="eq-item-add">
                        <div class="eq-field">
                            <label>Item Name</label>
                            @Html.DropDownList("ItemID", (IEnumerable<SelectListItem>)ViewBag.ItemID, "Please Select", new { @onchange = "GetCode(this.value);", @class = "eq-input" })
                            <span id="reqitem"></span>
                        </div>
                        <div class="eq-field">
                            <label>Item Code</label>
                            @Html.TextBox("ItemCode", null, new { placeholder = "Code", @class = "eq-input" })
                        </div>
                        <div class="eq-field">
                            <label>Quantity</label>
                            @Html.TextBox("Quantity", null, new { @type = "number", @class = "eq-input eq-num", @Value = "1" })
                            <span id="reqqty"></span>
                            <span id="regqty"></span>
                        </div>
                        <div>
                            <input type="button" id="add" value="Add" name="add" class="eq-btn" onclick="AddProduct(this.value);" />
                        </div>
                    </div>
                    <div id="orderItems" class="tablecontainer table-responsive eq-items"></div>
                    <span id="reqitems"></span>
                </div>
            </div>
                @* ---- 7. SPECIFIC INSTRUCTIONS ---- *@
                <div class="eq-card">
                    <div class="eq-card-head">
                        <span>
                            <i class="material-icons">description</i>Specific Instructions by Customer
                            <span class="info-badge" title="Mention any special requirements like customization, delivery needs, or extra details.">i</span>
                        </span>
                    </div>
                    <div class="eq-card-body">
                        <div class="eq-field">
                            @Html.TextAreaFor(model => model.Note, new { rows = 1, maxlength = "250", @class = "eq-input", style = "height:45px; min-height:45px;" })
                            @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

               
            </div>

            @* ---------- RIGHT COLUMN ---------- *@
        <div class="eq-col">

            @* ---- 2. COMPANY DETAILS ---- *@
            <div class="eq-card">
                <div class="eq-card-head company-details-head">
                    <span class="company-heading">
                        <i class="material-icons">business</i>Address
                    </span>
                    <div class="company-title-inline">
                        <select class="eq-input"
                                id="AddressTitleID"
                                name="AddressTitleID"
                                onchange="GetAddrCPInfoDirect(this.value);">
                            <option value="">Please Select</option>
                        </select>
                        <span id="reqaddr"></span>
                    </div>

                </div>

           
                <div class="eq-card-body">
                    <div class="eq-grid eq-g3">    
                        @*<div class="eq-field">*@
                            @*<label>Add. Title</label>*@
                            <!--<select class="eq-input" id="AddressTitleID" name="AddressTitleID" onchange="GetAddrCPInfoDirect(this.value);">
                                <option value="">Please Select</option>
                            </select>
                            <span id="reqaddr"></span>
                        </div>-->
                        <div class="eq-field eq-full">
                            @*<label>Address</label>*@
                            <textarea id="AddressView" rows="2" class="eq-input eq-addr" placeholder="Address" readonly="readonly"></textarea>
                            <textarea id="Address" rows="1" maxlength="150" style="display:none;"></textarea>
                        </div>
                        <div class="eq-field eq-s2">
                            <label>Shipping Address Same As Billing Address</label>
                            <div class="eq-radios">
                                <label class="eq-radio"><input type="radio" name="ShippAdd" value="Yes" id="ShippAddYes" checked onchange="checkAdd(this.value);"> Yes</label>
                                <label class="eq-radio"><input type="radio" name="ShippAdd" value="No" id="ShippAddNo" onchange="checkAdd(this.value);"> No</label>
                            </div>
                        </div>
                        <div class="eq-field eq-full" id="shippAddress">
                            <label>Shipping Address</label>
                            @Html.EditorFor(model => model.ShippingAddress, new { htmlAttributes = new { placeholder = "Shipping Address", @maxlength = "200", @class = "eq-input" } })
                            <span id="ShipAdd"></span>
                        </div>
                    </div>
                </div>
            </div>
            @* ---- 3. CONTACT DETAILS ---- *@
        <div class="eq-card">
            <div class="eq-card-head contact-details-head">
                <span class="contact-details-heading">
                    <i class="material-icons">contacts</i>Contact Details
                </span>

                <div class="contact-person-inline">
                    <i class="material-icons contact-field-icon">person</i>
                    <select class="eq-input" id="ContactPersonName" name="ContactPersonName" onchange="GetCPDetails(this.value);">
                        <option value="Please Select">Please Select</option>
                    </select>
                </div>
                <span id="reqcon"></span>
            </div>
            <div class="eq-card-body">

                <div class="eq-grid eq-g2">
                    <!-- OFFICE CONTACT -->
                    <div class="eq-field">
                        <div class="contact-input-row">
                            <i class="material-icons contact-field-icon">call</i>
                            @*<label>Office Contact</label>*@
                            <div class="eq-inline">
                                <div class="eq-field eq-code">
                                    @Html.TextBox("CountryCode1", null, new { @class = "eq-input", disabled = "true" })
                                </div>
                                <div class="eq-field">
                                    <select class="eq-input" id="OfficeMobileNo" name="OfficeMobileNo" onchange="GetCPDetailsByOffmobno(this.value);">
                                        <option value="Please Select">Please Select</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                            <span id="errorOMobile"></span>
                            <span id="emailerrorOMobile"></span>
                            <span id="errorPMobile11"></span>
                            <span id="emailerrorOMobile11"></span>
                        </div>
                    <div class="eq-field">
                        <div class="contact-input-row">
                            @*<label>Office Email</label>*@
                            <i class="material-icons contact-field-icon">email</i>
                            <select class="eq-input" id="OfficeEmailId" name="OfficeEmailId" onchange="GetCPDetailsByOffemail(this.value);">
                                <option value="Please Select">Please Select</option>
                            </select>
                        </div>
                            <span id="reqEm"></span>
                        </div>
                    </div>
            </div>
        </div>

            @* ---- 5. DELIVERY INSTRUCTIONS ---- *@
            <div class="eq-card">
                <div class="eq-card-head delivery-instructions-head">
                    <span class="delivery-heading">
                    <i class="material-icons">local_shipping</i>
                    Delivery Instructions
                    </span>

                    <div class="other-field">
                        <i class="material-icons">local_shipping</i>
                        <input type="text"
                               id="Other"
                               name="Other"
                               class="form-control"
                               placeholder="Other terms" />
                    </div>
                </div>

                    <div class="eq-card-body">

                        <div class="quotation-delivery-four-row">
                            <div class="eq-field">
                                <label>Transporter</label>
                                @Html.DropDownList("CourierID",
                                    (IEnumerable<SelectListItem>)ViewBag.CourierID,
                                    "Please Select",
                                    new { @class = "eq-input", @onchange = "onCourierChange();" })
                            </div>

                            <div class="eq-field">
                                <label>Terms Of Delivery</label>
                                @Html.DropDownList("TermsOfDeliveryID",
                                    (IEnumerable<SelectListItem>)ViewBag.TermsOfDeliveryID,
                                    "Please Select",
                                    new { @class = "eq-input" })
                            </div>

                            <!-- DISPATCH MODE -->
                            <div class="courier-field courier-mode-field">
                                <label for="SendType">Dispatch Mode:</label>
                                <div class="mode-dropdown-wrapper">
                                    <select id="SendType" name="SendType" onchange="checksendtype(this.value);">
                                        <option value="By Courier">Courier</option>
                                        <option value="By Hand">Hand</option>
                                    </select>
                                    <div class="mode-arrow-buttons">
                                        <button type="button" onclick="changeDropdownOption('SendType', -1)" title="Previous option">@*▲*@ &#9650;</button>
                                        <button type="button" onclick="changeDropdownOption('SendType', 1)" title="Next option">@*▼*@&#9660;</button>
                                    </div>
                                </div>
                            </div>

                            <!-- TRANSPORT MODE -->
                            <div class="courier-field courier-mode-field">
                                <label for="RateType">Transport Mode:</label>
                                <div class="mode-dropdown-wrapper">
                                    <select id="RateType" name="RateType" onchange="checkratetype(this.value);">
                                        <option value="Surface Rate">Surface</option>
                                        <option value="Air Rate">Air</option>
                                    </select>
                                    <div class="mode-arrow-buttons">
                                        <button type="button" onclick="changeDropdownOption('RateType', -1)" title="Previous option">&#9650;@*▲*@</button>
                                        <button type="button" onclick="changeDropdownOption('RateType', 1)" title="Next option"> &#9660;@*▼*@</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <span id="reqdisp"></span>

                        <!-- COURIER CHARGES -->
                        <div class="eq-grid eq-g6 quotation-delivery-charges">
                            <div class="eq-field">
                                <label title="Total Weight In Kg">Weight (Kg)</label>
                                @Html.EditorFor(model => model.TotalWeightInKg, new { htmlAttributes = new { @class = "eq-input eq-num", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.TotalWeightInKg, "", new { @class = "text-danger" })
                            </div>
                            <div class="eq-field">
                                <label title="Docket Charges">Docket</label>
                                @Html.EditorFor(model => model.DocketCharges, new { htmlAttributes = new { @class = "eq-input eq-num", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.DocketCharges, "", new { @class = "text-danger" })
                            </div>
                            <div class="eq-field">
                                <label title="Fuel Charges">Fuel</label>
                                @Html.EditorFor(model => model.FuelCharges, new { htmlAttributes = new { @class = "eq-input eq-num", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.FuelCharges, "", new { @class = "text-danger" })
                            </div>
                            <div class="eq-field">
                                <label title="Other Charges">Other</label>
                                @Html.EditorFor(model => model.OtherCharges, new { htmlAttributes = new { @class = "eq-input eq-num", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.OtherCharges, "", new { @class = "text-danger" })
                            </div>
                            <div class="eq-field">
                                <label title="COD Charges">COD</label>
                                @Html.EditorFor(model => model.CODCharges, new { htmlAttributes = new { @class = "eq-input eq-num", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.CODCharges, "", new { @class = "text-danger" })
                            </div>
                            <div class="eq-field">
                                <label title="FOV Charges">FOV</label>
                                @Html.EditorFor(model => model.FOV, new { htmlAttributes = new { @class = "eq-input eq-num", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.FOV, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

            @* ---- 6. CALCULATION ---- *@
            <div class="eq-card">
                <div class="eq-card-head">
                    <span><i class="material-icons">calculate</i>Calculation</span>
                </div>
                <div class="eq-card-body">
                    <div class="eq-grid eq-g6">
                        <div class="eq-field">
                            <label>Sub Total</label>
                            @Html.EditorFor(model => model.ProductSubTotal, new { htmlAttributes = new { @class = "eq-input eq-num", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.ProductSubTotal, "", new { @class = "text-danger" })
                        </div>
                        <div class="eq-field">
                            <label>Freight</label>
                            @Html.EditorFor(model => model.FreightCharges, new { htmlAttributes = new { @class = "eq-input eq-num", @onchange = "calbyother();", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.FreightCharges, "", new { @class = "text-danger" })
                        </div>
                        <div class="eq-field">
                            <label>IGST</label>
                            @Html.EditorFor(model => model.IGST, new { htmlAttributes = new { @class = "eq-input eq-num", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.IGST, "", new { @class = "text-danger" })
                        </div>
                        <div class="eq-field">
                            <label>CGST</label>
                            @Html.EditorFor(model => model.CGST, new { htmlAttributes = new { @class = "eq-input eq-num", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.CGST, "", new { @class = "text-danger" })
                        </div>
                        <div class="eq-field">
                            <label>SGST</label>
                            @Html.EditorFor(model => model.SGST, new { htmlAttributes = new { @class = "eq-input eq-num", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.SGST, "", new { @class = "text-danger" })
                        </div>
                        <div class="eq-field">
                            <label>Total Amount</label>
                            @Html.TextBox("RoundOffAmount", null, new { @class = "eq-input eq-num", @readonly = "readonly" })
                        </div>
                    </div>
                </div>
            </div>


        </div>
        </div>

        <div class="eq-footer">
            <button type="button" id="createsubmit" class="eq-btn" onclick="SaveSO();">
                <i class="material-icons" style="font-size:16px; vertical-align:middle;">save</i> Create
            </button>
            <button type="button" class="eq-btn" onclick="location.href='@Url.Action("Index", "SalesOrder")'">
                <i class="material-icons" style="font-size:16px; vertical-align:middle;">close</i> Back
            </button>
        </div>
    </div>}

<script>
    $(document).ready(function () {

        /*module button*/
        $.ajax({
            url: '/Settings/GetAllColors',
            type: 'GET',
            success: function (colors) {
                $('.custo-inner').css('background', colors.InnerButtonColor);
                $('.custo-inner').css('color', colors.InnerButtonFontColor);
            },
            error: function () {
                console.error("Failed to load color settings.");
            }
        });

    });</script>