    var orderItems = [];
    $(window).load(function () {

        var b = '@Session["LoginUserId"]';
        //var b = 26;
        $.ajax({
            url: '@Url.Action("GetInfo")',
            data: { "userId": b },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {

                if (data.length > 0) {

                    for (var i = 0; i < data.length; i++) {

                        if (data[i].FormName == "SalesOrder") {

                            if (data[i].Edit == "Y") {

                                $('#EditSalesOrder').show();
                                break;
                            }
                            else {

                                $('#EditSalesOrder').hide();
                                break;
                            }

                        }
                        else {

                            $('#EditSalesOrder').hide();
                        }

                        if (data[i].FormName == "SalesOrderApproval") {

                            if (data[i].Create == "Y") {

                                $('#submitSlesApproval').show();
                                break;
                            }
                            else {

                                $('#submitSlesApproval').hide();
                                break;
                            }

                        }
                        else {

                            $('#submitSlesApproval').hide();
                        }

                }

                }

            }
        });


        /*$('#submitSlesApproval').hide();*/
        var urlcurrent = $(location).attr('href');

        urlcurrent = unescape(urlcurrent);
        var i = urlcurrent.split("=");


        $.ajax({

            url: '@Url.Action("SOList")',
            data: { "sono": i[1] },

            type: "POST",
            dataType: "json",
            async: false,
            success: function (resultso) {

                if (resultso[0].QuotationNo == "" || resultso[0].QuotationNo == null) {

                    $.ajax({

                        url: '@Url.Action("DirectProductList")',
                        data: { "sono": i[1] },

                        type: "POST",
                        dataType: "json",
                        async: false,
                        success: function (result) {

                            var i;
                            for (i = 0; i < result.length; i++) {
                                orderItems.push({
                                    SrNo: i + 1,

                                    ItemName: result[i].ItemName,

                                    Quantity: result[i].Quantity,
                                    ItemCode: result[i].ItemCode,
                                    HSNCode: result[i].HSNCode,
                                    HSNClassification: result[i].HSNClassification,
                                    GSTRate: result[i].GSTRate,
                                    RatePerUnit: result[i].RatePerUnit,
                                    ApplicableRate: result[i].ApplicableRate,
                                    Amount: result[i].Amount,

                                });
                            }

                            GeneratedItemsTable();
                            $("#EnquiryNo").attr("disabled", false);
                            $("#EnquiryNo").val("Not Applicable");
                            $("#EnquiryNo").attr("disabled", true);

                            $("#QuotationNo").val("Not Applicable");
                            $("#QuotationNo").attr("disabled", true);


                        },
                        error: function (reponse) {
                            alert("error : " + reponse);
                        }
                    });
                }

                else {
                    $.ajax({

                        url: '@Url.Action("DirectProductList")',
                        data: { "sono": i[1] },

                        type: "POST",
                        dataType: "json",
                        success: function (result) {

                            var i;
                            for (i = 0; i < result.length; i++) {
                                orderItems.push({
                                    SrNo: i + 1,
                                    ItemName: result[i].ItemName,

                                    Quantity: result[i].Quantity,
                                    ItemCode: result[i].ItemCode,
                                    HSNCode: result[i].HSNCode,
                                    HSNClassification: result[i].HSNClassification,
                                    GSTRate: result[i].GSTRate,
                                    RatePerUnit: result[i].RatePerUnit,
                                    ApplicableRate: result[i].ApplicableRate,
                                    Amount: result[i].Amount,


                                });
                            }

                            GeneratedItemsTable();

                        },
                        error: function (reponse) {
                            alert("error : " + reponse);
                        }
                    });
                }

                console.log("Approval.....", resultso[0].IsApproved);
                if (resultso[0].IsApproved == "Yes") {

                    $('#submitSlesApproval').hide();
                }
                //else {
                //    $('#submitSlesApproval').show();
                //}

                if (resultso[0].IsApproved != "Yes" || resultso[0].IsApproved == null) {

                    //approval();
                    $('#submitSlesApproval').show();
                }

                $("#CountryCode1").val(resultso[0].CountryCode);
                $("#CountryCode2").val(resultso[0].CountryCode);

                if (resultso[0].ShippingAddSameAsBillAdd == "Yes") {
                    $("#shippAddress").hide();
                    $('input:radio[name="SendType"]').filter('[value="Yes"]').attr('checked', true);

                }
                else if (resultso[0].ShippingAddSameAsBillAdd == "No") {
                    $("#shippAddress").show();
                    $('input:radio[name="ShippAdd"]').filter('[value="No"]').attr('checked', true);
                    $("#ShippingAddress").val(resultso[0].ShippingAddress);



                }
                if (resultso[0].SendType == "By Hand") {
                    $("#CourierName option:eq(0)").attr('selected', true)


                    $('input:radio[name="SendType"]').filter('[value="By Hand"]').attr('checked', true);

                }
                else if (resultso[0].SendType == "By Courier") {

                    $("input:radio[name=RateType]").attr("disabled", false);

                    $('input:radio[name="SendType"]').filter('[value="By Courier"]').attr('checked', true);

                }

                if (resultso[0].RateType == "Air Rate") {

                    $('input:radio[name="RateType"]').filter('[value="Air Rate"]').attr('checked', true);

                }
                else if (resultso[0].RateType == "Surface Rate") {

                    $('input:radio[name="RateType"]').filter('[value="Surface Rate"]').attr('checked', true);

                }
            }

        });

    });

    function GeneratedItemsTable() {

        if (orderItems.length > 0) {
            var $table = $('<table/>');

            $table.append('<thead><tr><th>No.</th><th>Item Name</th><th>Qty.</th><th>Item Code</th><th>HSN</th><th>GST</th><th>Rate</th><th>Appl. Rate</th><th>Amount</th></tr></thead>');
            var $tbody = $('<tbody/>');
            $.each(orderItems, function (i, val) {
                var $row = $('<tr/>');

                $row.append($('<td style="text-align:center"/>').html(val.SrNo));
                $row.append($('<td style="text-align:left"/>').html(val.ItemName));
                $row.append($('<td style="text-align:center"/>').html(val.Quantity));
                $row.append($('<td style="text-align:center"/>').html(val.ItemCode));
                $row.append($('<td style="text-align:center"/>').html(val.HSNCode));
                $row.append($('<td style="text-align:right"/>').html(val.GSTRate));
                $row.append($('<td style="text-align:right"/>').html(val.RatePerUnit));
                $row.append($('<td style="text-align:right"/>').html(val.ApplicableRate));
                $row.append($('<td style="text-align:right"/>').html(val.Amount));
                $tbody.append($row);

                $tbody.append($row);
            });
            console.log("current", orderItems);
            $table.append($tbody);
            $('#orderItems').html($table);
        }
        else {
            $('#orderItems').html('');
        }
    }

    function Resend() {

        $.ajax({

            url: '@Url.Action("Resend")',

            data: { "sno": $("#SaleOrderNo").val() },
            type: "POST",
            //dataType: "json",
            success: function (result) {

                window.location.href = '/SaleOrderReport.aspx';
                //}

            },
            error: function (reponse) {
                alert("error : " + reponse);
            }
        });

    }
</script>

