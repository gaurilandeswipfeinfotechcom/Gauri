    function ResendSO() {

        if (!confirm('Resend this sales order?')) return;

        $('#btnResend').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("Resend")',
            data: { "sno": fv('SaleOrderNo') },
            type: "POST",
            success: function () {
                window.location.href = '/SaleOrderReport.aspx';
            },
            error: function (reponse) {
                alert("error : " + reponse.responseText);
                $('#btnResend').prop('disabled', false);
            }
        });
    }
