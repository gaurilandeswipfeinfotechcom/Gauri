            font-size: 18px;
            vertical-align: middle;
            margin-right: 5px;
        }

    .eq-card-body {
        padding: 0px 10px 7px;
    }

    .eq-grid {
        display: grid;
        gap: 0px 8px;
        align-items: start;
    }

    .eq-g2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .eq-g3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .eq-g6 {
        grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .eq-s2 {
        grid-column: span 2;
    }

    .eq-s3 {
        grid-column: span 3;
    }

    .eq-full {
        grid-column: 1 / -1;
    }

    .eq-field {
        min-width: 0;
    }

        .eq-field > label, .eq-label {
            display: block;
            color: #172b7a;
            font-size: 11.5px;
            font-weight: 600;
            margin: 0 0 1px;
            line-height: 13px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .eq-field input[type=text], .eq-field input[type=number], .eq-field input[type=date], .eq-field select, .eq-field textarea, .eq-input {
            width: 100%;
            height: 28px;
            padding: 1px 8px;
            border: 1px solid #cfd6df;
            border-radius: 4px;
            font-size: 12.5px;
            background: #fff;
            box-sizing: border-box;
