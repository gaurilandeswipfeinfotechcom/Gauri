@model ERPEntities.SalesProcessing

@{ ViewBag.Title = "Sales Order";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml"; }

<script src="http://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link rel="stylesheet" href="//code.jquery.com/ui/1.13.1 /themes/smoothness/jquery-ui.css">

<link href="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css"
      rel="Stylesheet" type="text/css" />

<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>
<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="Stylesheet" type="text/css" />

<link href="~/Content/ERPStyle.css" rel="stylesheet" />
<script>

    /* =========================================================
       STATE
       ========================================================= */
    var orderItems = [];
    var index;
    var itid, itnm;

    var grate, statename, cityname, GSTRegistrationId;
    var Status;                 // StatusId of the saved order (posted back on update)
    var SO = {};                // header row from SOList
    var quoted = false;         // order was created from a quotation

    // permissions (filled by loadPermissions)
    var canEdit = false;        // FormName "SalesOrder"         + Edit   = Y
    var canApprove = false;     // FormName "SalesOrderApproval" + Create = Y
    var canEditTerms = false;   // FormName "BusinessTerms"      + Edit   = Y
    var isApproved = false;

    var SONO = '@Model.SaleOrderNo';
    if (!SONO) {
        var qm = /[?&]sono=([^&]+)/i.exec(location.search);
        SONO = qm ? decodeURIComponent(qm[1]) : '';
    }

    /* =========================================================
       HELPERS
       ========================================================= */
    function fv(id) { return ($('#' + id).val() || '').toString().trim(); }

    function toNum(x) { var n = parseFloat(x); return isNaN(n) ? 0 : n; }

    function str(x) { return (x === null || x === undefined) ? '' : x.toString(); }

    // "/Date(1735516800000)/" -> Date
    function parseMsDate(s) {
        var m = /\/Date\((-?\d+)/.exec(s || '');
        return m ? new Date(parseInt(m[1], 10)) : null;
    }

    // Date -> yyyy-MM-dd (value format of <input type="date">)
    function toInputDate(d) {
        function pad(s) { return (s < 10) ? '0' + s : s; }
        return [d.getFullYear(), pad(d.getMonth() + 1), pad(d.getDate())].join('-');
    }

    function fullName(d) {
        return d.Title + " " + d.FirstName + (d.MiddleName ? " " + d.MiddleName : "") + " " + d.LastName;
    }

    function setErr(sel, msg) { $(sel).html('<span style="color:red">' + msg + '</span>').show(); }

    function setIf(sel, v) { if (v !== undefined && v !== null && v !== '') $(sel).val(v); }

    // select a dropdown option only when it exists
    function setIfOption(sel, v) {
        if (v === undefined || v === null || v === '') return;
        var found = false;
        $(sel + ' option').each(function () { if (this.value == v) { found = true; return false; } });
        if (found) $(sel).val(v);
    }

    // shows street address + locality, taluka, district, state, pincode as one text
    function refreshAddr() {
        var parts = ["#Address", "#Locality", "#Taluka", "#District", "#State", "#Pincode1"], out = [];
        for (var i = 0; i < parts.length; i++) {
            var v = ($(parts[i]).val() || "").toString().trim();
            if (v !== "") out.push(v);
        }
        $("#AddressView").val(out.join(", "));
    }

    /* =========================================================
       PERMISSIONS / VIEW MODE
       ========================================================= */
    function loadPermissions() {
        $.ajax({
            url: '@Url.Action("GetInfo")',
            data: { "userId": '@Session["LoginUserId"]' },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {
                $.each(data || [], function (i, p) {
                    if (p.FormName === "SalesOrder" && p.Edit === "Y") canEdit = true;
                    if (p.FormName === "SalesOrderApproval" && p.Create === "Y") canApprove = true;
                    if (p.FormName === "BusinessTerms" && p.Edit === "Y") canEditTerms = true;
                });
            },
            error: function () { canEdit = false; canApprove = false; canEditTerms = false; }
        });
    }

    // view only: every input / dropdown inside the cards is locked
    function lockView() {
        if (canEdit) return;
        $('.eq-card input, .eq-card select, .eq-card textarea').not('[type=hidden]').prop('disabled', true);
    }

    function applyMode() {
        $('#crumbMode').text(canEdit ? 'Edit' : 'View');
        if (!canEdit) {
            $('.eq-page').addClass('eq-view');
            $('#modeBadge').show();
            lockView();
        }
    }

    function showApprovalState() {
        isApproved = (SO.IsApproved === 'Yes');
        $('#statusBadge')
            .text(isApproved ? 'Approved' : 'Pending Approval')
            .removeClass('so-ok so-pending')
            .addClass(isApproved ? 'so-ok' : 'so-pending')
            .show();
        if (canApprove && !isApproved) $('#btnApprove').show(); else $('#btnApprove').hide();
    }

    /* =========================================================
       LOAD SALES ORDER
       ========================================================= */
    $(document).ready(function () {
        loadPermissions();
        applyMode();
        loadSalesOrder();
    });

    function loadSalesOrder() {

        if (!SONO) { alert('Sales order number not found.'); return; }

        $.ajax({
            url: '@Url.Action("SOList")',
            data: { "sono": SONO },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (res) {

                var h = res && res[0];
                if (!h) { alert('Sales order not found.'); return; }

                SO = h;
                quoted = !(h.QuotationNo === "" || h.QuotationNo === null || h.QuotationNo === undefined);
                $('#QuotationNo').val(quoted ? h.QuotationNo : 'Not Applicable');
                showApprovalState();

                $.ajax({
                    url: quoted ? '@Url.Action("SalesOrderProductList")' : '@Url.Action("SalesOrderwithoueQuotation")',
                    data: { "sono": SONO },
                    type: "POST",
                    dataType: "json",
                    async: false,
                    success: function (result) {
                        if (result && result[0]) fillFromResult(result[0]);
                        else alert('Sales order details not found.');
                    },
                    error: function (response) { alert("Error: " + response.responseText); }
                });
            },
            error: function (response) { alert("Error: " + response.responseText); }
        });
    }

    function fillFromResult(r) {

        $('#orderItems').empty();
        orderItems = [];
        Status = r.StatusId;

        // company, address, contact
        $("#LedgerID").val(r.LedgerID);
        GetCompanyInfo(r.LedgerID, true);

        $("#AddressTitleID").val(r.AddressTitleID);
        GetAddrCPInfoDirect(r.AddressTitleID);

        Getcontactinfo(r.DesignationInfoID);
        var cp = $("#ContactPersonName").val();
        if (cp) GetCPDetails(cp);
        setIfOption('#OfficeMobileNo', r.OfficeMobileNo || SO.OfficeMobileNo);
        setIfOption('#OfficeEmailId', r.OfficeEmailId || SO.OfficeEmailId);
        setIf('#CountryCode1', SO.CountryCode);

        // saved address snapshot
        setIf('#Address', r.Address);
        setIf('#AddressTitle', r.AddressTitle);
        setIf('#LandMark', r.LandMark);
        setIf('#Locality', r.Locality);
        setIf('#Taluka', r.Taluka);
        setIf('#District', r.District);
        setIf('#Pincode1', r.Pincode);
        setIf('#State', r.State);
        setIf('#Country', r.Country);
        statename = r.State;
        cityname = r.Taluka;
        refreshAddr();

        // dates
        var md = parseMsDate(r.MaterialRequiredDate);
        if (md) $("#MaterialRequiredDate").val(toInputDate(md));
        var pd = parseMsDate(r.PurchaseOrderDate);
        if (pd) $("#PurchaseOrderDate").val(toInputDate(pd));

        // terms
        $("#DiscountPercent").val(r.DiscountPercent);
        $("#PaymentTermID").val(r.PaymentTermID);
        $("#TermsOfDeliveryID").val(r.TermsOfDeliveryID);
        $("#Note").val(r.Note);

        // shipping address
        var sameAs = r.ShippingAddSameAsBillAdd || SO.ShippingAddSameAsBillAdd;
        if (sameAs === "No") {
            $("#ShippAddNo").prop("checked", true);
            $("#shippAddress").show();
            $("#ShippingAddress").val(r.ShippingAddress || SO.ShippingAddress);
        } else {
            $("#ShippAddYes").prop("checked", true);
            $("#shippAddress").hide();
        }

        // dispatch / courier / transport mode
        var st = r.SendType || SO.SendType;
        var rt = r.RateType || SO.RateType;
        applyDispatch(st, rt, r.CourierID);

        var pro = r.pro || [];
        if (pro.length) grate = pro[0].GSTRate;

        if (canEdit) {

            // editable: items come from the order, totals are recalculated
            for (var i = 0; i < pro.length; i++) {
                var p = pro[i], apprate, amt;
                if (quoted) {
                    apprate = p.RatePerUnit;
                    amt = (p.RatePerUnit * p.Quantity).toFixed(2);
                } else {
                    var disc = toNum($("#DiscountPercent").val());
                    apprate = (disc === 0)
                        ? toNum(p.RatePerUnit).toFixed(2)
                        : (p.RatePerUnit * (1 - disc / 100)).toFixed(2);
                    amt = (apprate * p.Quantity).toFixed(2);
                }
                orderItems.push({
                    SaleOrderNo: fv('SaleOrderNo'),
                    ItemID: p.ItemID,
                    ItemName: p.ItemName,
                    Quantity: p.Quantity,
                    ItemCode: p.ItemCode,
                    HSNCode: p.HSNCode,
                    HSNClassification: p.HSNClassification,
                    GSTRate: p.GSTRate,
                    RatePerUnit: p.RatePerUnit,
                    ApplicableRate: apprate,
                    Amount: amt,
                    WeightPerUnit: p.WeightPerUnit,
                    WeightOfPackingBox: p.WeightOfPackingBox,
                    SalesClosingQuantity: p.SalesClosingQuantity,
                    MfgClosingQuantity: p.MfgClosingQuantity,
                    ApprovalStatusId: p.ApprovalStatusId
                });
            }
            GeneratedItemsTable();
            recalcSubtotalAndWeight();

            var sendType = fv('SendType');
            if (sendType) {
                checksendtype(sendType);
                OtherCourier();
                if ($("#CourierID").val() == 6) $("#FreightCharges").val(r.FreightCharges);
                calbyother();
                if (sendType === 'By Courier' && $("#CourierID").val() && $("#CourierID").val() != 6 && fv('RateType')) {
                    checkratetype(fv('RateType'));
                }
            }

            // Terms of Delivery and Discount need the BusinessTerms edit right
            $('#TermsOfDeliveryID, #DiscountPercent').prop('disabled', !canEditTerms);
            // company can only be changed on orders without a quotation
            $('#LedgerID').prop('disabled', quoted);
            $('#PaymentTermID').prop('disabled', true);
        }
        else {
            // view only: items and totals are shown exactly as saved
            loadViewItems();
        }

        lockView();
    }

    // view only: saved items with their saved rate and amount
    function loadViewItems() {
        $.ajax({
            url: '@Url.Action("DirectProductList")',
            data: { "sono": SONO },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (result) {
                for (var i = 0; i < result.length; i++) {
                    orderItems.push({
                        ItemName: result[i].ItemName,
                        Quantity: result[i].Quantity,
                        ItemCode: result[i].ItemCode,
                        HSNCode: result[i].HSNCode,
                        HSNClassification: result[i].HSNClassification,
                        GSTRate: result[i].GSTRate,
                        RatePerUnit: result[i].RatePerUnit,
                        ApplicableRate: result[i].ApplicableRate,
                        Amount: result[i].Amount
                    });
                }
                GeneratedItemsTable();
            },
            error: function (response) { alert("Error: " + response.responseText); }
        });
    }

    // Dispatch Mode / Transport Mode are dropdowns (#SendType / #RateType)
    function applyDispatch(sendType, rateType, courierId) {
        if (sendType === 'By Hand') {
            $('#SendType').val('By Hand');
            $('#CourierID').val('').prop('disabled', true);
            $('#RateType').prop('disabled', true);
        }
        else if (sendType === 'By Courier') {
            $('#SendType').val('By Courier');
            $('#CourierID').val(courierId).prop('disabled', false);
            if (rateType) $('#RateType').val(rateType);
            $('#RateType').prop('disabled', false);
        }
    }

    /* =========================================================
       COMPANY / ADDRESS / CONTACT
       ========================================================= */
    // fills the address title dropdown; keep = true leaves the address / contact for the caller to load
    function GetCompanyInfo(code, keep) {

        $.ajax({
            url: '@Url.Action("GetCompanyInfo")',
            data: { "LedgerID": code },
            type: "POST",
            dataType: "json",
            async: false,

            success: function (result) {
                $("#AddressTitleID").html("");
                $.each(result.d1, function (i, data) {
                    $('<option>', { value: data.AddressTitleID, text: data.AddressTitleID })
                        .html(data.AddressTitle).appendTo("#AddressTitleID");
                });
                if (!keep) GetAddrCPInfoDirect($("#AddressTitleID").val());
            },
            error: function (reponse) { alert("error : " + reponse); }
        });
    }

    // company dropdown changed by the user (orders without quotation only)
    function onCompanyChange(code) {
        if (!code) return;
        GetCompanyInfo(code, false);
    }

    function GetAddrCPInfoDirect(code) {

        var a = $("#AddressTitleID").val();

        $.ajax({
            url: '@Url.Action("getAddressInfo")',
            data: '{add: "' + a + '"}',
            type: "POST",
            dataType: "json",
            async: false,
            contentType: "application/json; charset=utf-8",

            success: function (result1) {
                if (result1.length > 0) {
                    var vdata = result1;

                    $("#Address").val(vdata[0].Address);
                    $("#AddressTitle").val(vdata[0].AddressTitle);
                    $("#LandMark").val(vdata[0].LandMark);
                    $("#Locality").val(vdata[0].Locality);
                    $("#Taluka").val(vdata[0].Taluka);
                    $("#District").val(vdata[0].District);
                    $("#Pincode1").val(vdata[0].Pincode);
                    $("#State").val(vdata[0].State);
                    $("#Country").val(vdata[0].Country);
                    GSTRegistrationId = vdata[0].GSTRegistrationId;
                    statename = vdata[0].State;
                    cityname = vdata[0].Taluka;
                }
            },
            failure: function (response) { alert(response.responseText); },
            error: function (response) { alert(response.responseText); }
        });

        $.ajax({
            url: '@Url.Action("GetCPInfo")',
            data: { "AddressTitleID": code },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (result) {
                var vdata1 = result.d1;
                var vdata3 = result.d3;

                // Contact Person dropdown
                $("#ContactPersonName").html("");
                $.each(vdata1, function (i, data) {
                    var nm = fullName(data);
                    $('<option>', { value: nm, text: nm }).appendTo("#ContactPersonName");
                });

                // Country code and designation from the first person (default)
                if (vdata1.length > 0) {
                    $("#CountryCode1").val(vdata1[0].CountryCode);
                    $("#CountryCode2").val(vdata1[0].CountryCode);
                    $("#CPDesignation").val(vdata1[0].CPDesignation);
                }

                // Office mobile numbers and emails
                $("#OfficeMobileNo").html("");
                $("#OfficeEmailId").html("");
                $.each(vdata3, function (j, data) {
                    if (data.OfficeMobileNo != null) {
                        $('<option>', { value: data.OfficeMobileNo, text: data.OfficeMobileNo }).appendTo("#OfficeMobileNo");
                    }
                    if (data.OfficeEmailId != null) {
                        $('<option>', { value: data.OfficeEmailId, text: data.OfficeEmailId }).appendTo("#OfficeEmailId");
                    }
                });
            },
            error: function (response) { alert("Error: " + response.responseText); }
        });

        refreshAddr();
    }

    // selects the saved contact person of the order
    function Getcontactinfo(code) {
        $.ajax({
            url: '@Url.Action("GetCPInfoSelectd")',
            data: { "Desinfoid": code },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (result) {
                var vdata1 = result.d1;
                if (vdata1 && vdata1.length > 0) {
                    $("#ContactPersonName").val(fullName(vdata1[0]));
                }
            },
            error: function (reponse) { alert("error : " + reponse); }
        });
    }

    function GetCPDetails(code) {

        $.ajax({
            url: '@Url.Action("GetCPDetails")',
            data: { "ContactPersonName": code, "LedgerID": $("#LedgerID").val(), "AddressTitleID": $("#AddressTitleID").val() },
            type: "POST",
            dataType: "json",
            async: false,

            success: function (result) {
                $("#CountryCode1").val(result[0].CountryCode);
                $("#CountryCode2").val(result[0].CountryCode);
                $("#OfficeMobileNo").val(result[0].OfficeMobileNo);
                $("#OfficeEmailId").val(result[0].OfficeEmailId);
                $("#CPDesignation").val(result[0].CPDesignation);
            },
            error: function (reponse) { alert("error : " + reponse); }
        });
    }

    function GetCPDetailsByOffmobno(code) {

        $.ajax({
            url: '@Url.Action("GetCPDetailsByOffmobno")',
            data: { "OffMobile": code },
            type: "POST",
            dataType: "json",
            async: false,

            success: function (result) {

                $("#ContactPersonName").val("Please Select");
                $("#OfficeEmailId").val("Please Select");
                if (result.d2 == true) {
                    $("#CountryCode1").val(result.d1[0].CountryCode);
                    $("#CountryCode2").val(result.d1[0].CountryCode);
                    $("#OfficeEmailId").val(result.d1[0].OfficeEmailId);
                    $("#ContactPersonName").val(fullName(result.d1[0]));
                }
                else {
                    $("#OfficeEmailId").val(result.d1[0].OfficeEmailId);
                }
                $("#CPDesignation").val(result.d1 && result.d1[0] ? result.d1[0].CPDesignation : "");
            },
            error: function (reponse) { alert("error : " + reponse); }
        });
    }

    function GetCPDetailsByOffemail(code) {

        $.ajax({
            url: '@Url.Action("GetCPDetailsByOffemail")',
            data: { "OffEmail": code },
            type: "POST",
            dataType: "json",

            success: function (result) {

                $("#ContactPersonName").val("Please Select");
                $("#OfficeMobileNo").val("Please Select");

                if (result.d2 == true) {
                    $("#CountryCode1").val(result.d1[0].CountryCode);
                    $("#CountryCode2").val(result.d1[0].CountryCode);
                    $("#ContactPersonName").val(fullName(result.d1[0]));
                    $("#OfficeMobileNo").val(result.d1[0].OfficeMobileNo);
                }
                else {
                    $("#OfficeMobileNo").val(result.d1[0].OfficeMobileNo);
                }
                $("#CPDesignation").val(result.d1 && result.d1[0] ? result.d1[0].CPDesignation : "");
            },
            error: function (reponse) { alert("error : " + reponse); }
        });
    }

    /* =========================================================
       SHIPPING ADDRESS
       ========================================================= */
    function checkAdd(code) {
        if (code == "No") {
            $("#shippAddress").show();
        }
        else {
            $("#ShippingAddress").val('');
            $("#ShipAdd").html('');
            $("#shippAddress").hide();
        }
    }

    $(document).ready(function () {

        // punctuation spacing while typing
        $('#ShippingAddress').keyup(function () {
            var v = this.value;
            var fixes = [
                v.replace(/(?=\S)[,.!?:;)](?=\S)/g, '$& '),
                v.replace(/\s+([,.!?:;)])/g, "$1"),
                v.replace(/(?=\S)[&](?=\S)/g, ' & '),
                v.replace(/\b[(]/g, ' ('),
                v.replace(/(?=\S)[-](?=\S)/g, ' - '),
                v.replace(/(?=\S)[\/](?=\S)/g, ' / ')
            ];
            for (var i = 0; i < fixes.length; i++) {
                if (fixes[i] != v) { this.value = fixes[i]; break; }
            }

            // length warning
            var max = parseInt(this.getAttribute("maxlength"));
            if (max && this.value.length >= max) {
                $("#ShipAdd").html('<span style="color:red">Maximum ' + max + ' characters allowed.</span>').show();
            } else {
                $("#ShipAdd").html('');
            }
        });

        // capitalise each word
        $('#ShippingAddress').change(function () {
            this.value = this.value.replace(/\w\S*/g, function (a) { return a.charAt(0).toUpperCase() + a.substr(1).toLowerCase(); });
        });

        // trim spaces
        $('#ShippingAddress').blur(function () {
            $(this).val($.trim($(this).val()));
        });
    });

    /* =========================================================
       ITEMS
       ========================================================= */
    function recalcSubtotalAndWeight() {
        var subtot = 0, totalWeight = 0, i;
        for (i = 0; i < orderItems.length; i++) {
            subtot += parseFloat(orderItems[i]["Amount"].toString());
            totalWeight += (toNum(orderItems[i]["WeightPerUnit"]) + toNum(orderItems[i]["WeightOfPackingBox"])) * parseInt(orderItems[i]["Quantity"].toString(), 10);
        }
        $("#ProductSubTotal").val(subtot.toFixed(2));
        $("#TotalWeightInKg").val(Math.round(totalWeight));
    }

    // recalculates sub total, weight and then freight / GST / total
    function refreshTotals() {
        recalcSubtotalAndWeight();

        var st = fv('SendType');
        if (!st) return;
        checksendtype(st);
        OtherCourier();
        calbyother();
        if (st === 'By Courier' && $('#CourierID').val() && $('#CourierID').val() != 6 && fv('RateType')) {
            checkratetype(fv('RateType'));
        }
    }

    function AddProduct(nm) {

        var quan;

        itid = fv('ItemID');
        itnm = $('#ItemID option:selected').text().trim();
        quan = parseInt(fv('Quantity'));

        if (nm == "Add") {

            var isAllValid = true;
            if (fv('ItemID') == '') {
                $('#ItemID').focus();
                isAllValid = false;
                setErr('#reqitem', 'Item Name Required');
            }
            else {
                $("#reqitem").html("").hide();
            }

            if (fv('Quantity') == '') {
                $('#Quantity').focus();
                isAllValid = false;
                setErr('#reqqty', 'Quantity Required');
            }
            else {
                $("#reqqty").html("").hide();
                if (/^[0-9]*$/.test(fv('Quantity'))) {
                    $("#regqty").html("").hide();
                }
                else {
                    setErr('#regqty', 'Enter Valid Quantity');
                    isAllValid = false;
                }
            }

            if (isAllValid) {
                for (var k = 0; k < orderItems.length; k++) {
                    if (orderItems[k].ItemID.toString() == itid) {
                        alert("Item Already Exist In List");
                        $('#ItemID').val('').focus();
                        $('#ItemCode').val('');
                        $('#Quantity').val('');
                        isAllValid = false;
                    }
                }
            }

            if (isAllValid) {
                $.ajax({
                    url: '@Url.Action("GetCode")',
                    data: { "ItemID": itid, "AddressTitleId": fv('AddressTitleID') },
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        if (data.length > 0) {

                            for (var i = 0; i < data.length; i++) {
                                var irate = data[i].RatePerUnit;
                                var apprate = data[i].hasPreferredItem
                                    ? parseFloat(irate).toFixed(2)
                                    : parseFloat(irate * (1 - toNum($("#DiscountPercent").val()) / 100)).toFixed(2);
                                var amt = (parseFloat(apprate) * quan).toFixed(2);

                                orderItems.push({
                                    SaleOrderNo: fv('SaleOrderNo'),
                                    ItemID: parseInt(itid),
                                    ItemName: itnm,
                                    Quantity: quan,
                                    ItemCode: data[i].ItemCode,
                                    HSNCode: data[i].HSNCode,
                                    HSNClassification: data[i].HSNClassification,
                                    GSTRate: data[i].GSTRate,
                                    RatePerUnit: data[i].RatePerUnit,
                                    ApplicableRate: apprate,
                                    Amount: amt,
                                    WeightPerUnit: data[i].WeightPerUnit,
                                    WeightOfPackingBox: data[i].WeightOfPackingBox,
                                    SalesClosingQuantity: 0,
                                    MfgClosingQuantity: quan
                                });
                            }
                            GeneratedItemsTable();
                            refreshTotals();
                        }
                    }
                });

                $('#ItemID').val('').focus();
                $('#ItemCode').val('');
                $('#Quantity').val(1);
            }
        }
        else if (nm == "Update") {
            var qtyNew = parseInt($('#Quantity').val());

            $.ajax({
                url: '@Url.Action("GetCode")',
                data: { "ItemID": itid, "AddressTitleId": fv('AddressTitleID') },
                type: "POST",
                dataType: "json",
                success: function (data) {
                    if (data.length > 0) {
                        var irate = data[0].RatePerUnit, apprate;

                        if (data[0].hasPreferredItem) {
                            apprate = parseFloat(irate).toFixed(2);
                        } else if (toNum($("#DiscountPercent").val()) != 0) {
                            apprate = (parseFloat(irate) * (1 - toNum($("#DiscountPercent").val()) / 100)).toFixed(2);
                        } else {
                            apprate = parseFloat(irate).toFixed(2);
                        }

                        var row = orderItems[index];
                        row["ItemID"] = itid;
                        row["Quantity"] = qtyNew;
                        row["MfgClosingQuantity"] = qtyNew;
                        row["ApplicableRate"] = apprate;
                        row["Amount"] = (apprate * qtyNew).toFixed(2);
                        row["ItemName"] = data[0].ItemName;
                        row["ItemCode"] = data[0].ItemCode;
                        row["HSNCode"] = data[0].HSNCode;
                        row["HSNClassification"] = data[0].HSNClassification;
                        row["RatePerUnit"] = data[0].RatePerUnit;
                        row["WeightPerUnit"] = data[0].WeightPerUnit;
                        row["WeightOfPackingBox"] = data[0].WeightOfPackingBox;
                        row["GSTRate"] = data[0].GSTRate;

                        GeneratedItemsTable();
                        refreshTotals();
                    }
                }
            });

            $("#add").val('Add');
            $('#ItemID').val('');
            $('#ItemCode').val('');
            $('#Quantity').val(1);
        }
    }

    function GetCode(code) {

        $.ajax({
            url: '@Url.Action("GetCode")',
            data: { "ItemID": code, "AddressTitleId": fv('AddressTitleID') },
            type: "POST",
            dataType: "json",

            success: function (data) {
                if (data.length > 0) {
                    $("#ItemCode").val(data[0].ItemCode);
                    $("#ItemCode").attr("readonly", true);
                }
            }
        });
    }

    function GeneratedItemsTable() {

        if (orderItems.length > 0) {
            var $list = $('<div class="eq-qlist"/>');

            $.each(orderItems, function (i, val) {

                var iname = val.ItemName;
                if (val.ItemID !== undefined && val.ItemID !== null) {
                    $.ajax({
                        url: '@Url.Action("GetIName")',
                        data: { "ItmID": val.ItemID },
                        type: "POST",
                        dataType: "json",
                        async: false,
                        success: function (data) {
                            if (data.length > 0) { iname = data[0].ItemName; }
                        }
                    });
                }
                var rowIdx = i;
                var $row = $('<div class="eq-qitem"/>');
                $row.append($('<div class="eq-qitem-name"/>').text(iname));
                var $meta = $('<div class="eq-qitem-meta"/>');
                $meta.append('<span><b>Qty:</b> ' + val.Quantity + '</span>');
                $meta.append('<span><b>Code:</b> ' + (val.ItemCode || '') + '</span>');
                $meta.append('<span><b>HSN:</b> ' + (val.HSNCode || '') + '</span>');
                $meta.append('<span><b>GST:</b> ' + val.GSTRate + '%</span>');
                $meta.append('<span><b>Rate:</b> ' + val.RatePerUnit + '</span>');
                $meta.append('<span><b>App.Rate:</b> ' + val.ApplicableRate + '</span>');
                $meta.append('<span><b>Amt:</b> ' + val.Amount + '</span>');
                $row.append($meta);

                // Edit / Remove only when the user has edit access
                if (canEdit) {
                    var $remove = $('<button type="button" class="eq-mini" title="Remove">X</button>');
                    $remove.click(function (e) {
                        e.preventDefault();
                        orderItems.splice(rowIdx, 1);
                        GeneratedItemsTable();
                        refreshTotals();
                    });

                    var $Edit = $('<button type="button" class="eq-mini" title="Edit">EDIT</button>');
                    $Edit.click(function (e) {
                        e.preventDefault();
                        $('#ItemID').val(val.ItemID);
                        $('#ItemCode').val(val.ItemCode);
                        $('#Quantity').val(val.Quantity);
                        $("#add").val('Update');
                        index = rowIdx;
                    });

                    var $actions = $('<div class="eq-qitem-actions"/>');
                    $actions.append($Edit).append($remove);
                    $row.append($actions);
                }

                $list.append($row);
            });
            $('#orderItems').html($list);
        }
        else {
            $('#orderItems').html('');
        }
    }

    /* =========================================================
       COURIER / DISPATCH / CALCULATION
       ========================================================= */
    // dropdown arrow buttons (Dispatch / Transport mode)
    function changeDropdownOption(dropdownId, direction) {
        var dropdown = document.getElementById(dropdownId);
        if (!dropdown || dropdown.disabled || dropdown.options.length === 0) return;

        var nextIndex = dropdown.selectedIndex + direction;
        if (nextIndex < 0 || nextIndex >= dropdown.options.length) return;

        dropdown.selectedIndex = nextIndex;
        dropdown.dispatchEvent(new Event("change", { bubbles: true }));
    }

    // courier dropdown changed
    function onCourierChange() {
        OtherCourier();
        if (fv('SendType') === 'By Courier' && $('#CourierID').val() && $('#CourierID').val() != 6 && fv('RateType')) {
            checkratetype(fv('RateType'));
        }
    }

    // OTHER COURIER (id 6): freight is typed by the user, no transport mode
    function OtherCourier() {
        if ($("#CourierID").val() == 6) {
            $("#RateType").prop("disabled", true);
            $("#FreightCharges").attr("readonly", false);
            $("#FreightCharges").val(0);
            calbyother();
        }
        else {
            $("#RateType").prop("disabled", fv('SendType') === 'By Hand');
        }
    }

    function calbyother() {
        if ($("#CourierID").val() == 6) {

            $("#FreightCharges").attr("readonly", false);

            var psubfr = parseFloat($("#ProductSubTotal").val()) + parseFloat($("#FreightCharges").val());

            var GstAmount = ((psubfr * grate) / 100).toFixed(2);
            $("#GSTTotal").val(GstAmount);

            var SGST, CGST, IGST;
            if (statename == "MAHARASHTRA") {
                SGST = (((psubfr * grate) / 100) / 2).toFixed(2);
                CGST = (((psubfr * grate) / 100) / 2).toFixed(2);
                IGST = 0.00;
            }
            else {
                SGST = 0.00;
                CGST = 0.00;
                IGST = GstAmount;
            }
            $("#SGST").val(SGST);
            $("#CGST").val(CGST);
            $("#IGST").val(IGST);

            var TotalAmount = (parseFloat($("#ProductSubTotal").val()) + parseFloat(GstAmount) + parseFloat($("#FreightCharges").val())).toFixed(2);
            $("#TotalAmount").val(TotalAmount);

            var TotalAmountroundoff = (TotalAmount % 1 === 0.5)
                ? (TotalAmount - 0.5).toFixed(2)
                : Math.round(TotalAmount).toFixed(2);
            $("#RoundOffAmount").val(TotalAmountroundoff);

            $("#DocketCharges, #FuelCharges, #OtherCharges, #CODCharges, #FOV").val(0);
        }
    }

    // Dispatch mode changed (By Courier / By Hand)
    function checksendtype(code) {
        if (code == "By Hand") {

            $("#CourierID").val('').prop("disabled", true);
            $("#RateType").prop("disabled", true);

            var RoundOffFreight = 0.0;
            $("#FreightCharges").val(RoundOffFreight).prop("readonly", true);

            var psubfr = parseFloat($("#ProductSubTotal").val()) + RoundOffFreight;
            var GstAmount = ((psubfr * grate) / 100).toFixed(2);
            $("#GSTTotal").val(GstAmount);

            var SGST, CGST, IGST;
            if (statename == "MAHARASHTRA") {
                SGST = (((psubfr * grate) / 100) / 2).toFixed(2);
                CGST = (((psubfr * grate) / 100) / 2).toFixed(2);
                IGST = 0.00;
            }
            else {
                SGST = 0.00;
                CGST = 0.00;
                IGST = GstAmount;
            }
            $("#SGST").val(SGST);
            $("#CGST").val(CGST);
            $("#IGST").val(IGST);

            var TotalAmount = (parseFloat($("#ProductSubTotal").val()) + parseFloat(GstAmount) + RoundOffFreight).toFixed(2);
            var TotalAmountroundoff = (TotalAmount % 1 === 0.5)
                ? (TotalAmount - 0.5).toFixed(2)
                : Math.round(TotalAmount).toFixed(2);

            $("#TotalAmount").val(TotalAmount);
            $("#RoundOffAmount").val(TotalAmountroundoff);

            $("#DocketCharges, #FuelCharges, #OtherCharges, #CODCharges, #FOV").val(0);
        }
        else if (code == "By Courier") {
            $("#CourierID").prop("disabled", false);
            $("#RateType").prop("disabled", $("#CourierID").val() == 6);
        }
    }

    // Transport mode changed: freight, GST and total are recalculated from the courier rates
    function checkratetype(code) {

        if (!$("#CourierID").val()) return;

        $.ajax({
            url: '@Url.Action("GetCourierDetails")',
            data: '{CourierID: "' + $("#CourierID").val().trim() + '",Cityname: "' + cityname + '",Statename: "' + statename + '"}',
            type: "POST",
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            async: false,
            success: function (r) {

                var data = r.d1;
                var RatePerKG = 0.0;
                var RatePerKG1 = 0.0;
                var RatePerKG2 = 0.0;

                if (r.d2 != "") RatePerKG = parseFloat(r.d2[0].RatePerKg);
                if (r.d3 != "") RatePerKG1 = parseFloat(r.d3[0].RatePerKg);

                if (r.d2 == "" && r.d3 == "" && r.d4 != "" && r.d4 != null) {   // select other rate
                    RatePerKG2 = parseFloat(r.d4[0].RatePerKg);
                }

                if (data.length > 0) {

                    var CourierAmount = 0.00;
                    var TotalCourierAmount = 0.00;
                    var CourierFuelCharges = 0.00;
                    var FOVCharges = 0.00;
                    var NetCourierAmount = 0.00;
                    var FreightCharges = 0.00;
                    var RoundOffFreight = 0.00;

                    $("#FreightCharges").attr("readonly", false);

                    // Free Delivery / To Pay: no freight
                    if ($("#TermsOfDeliveryID").val() == 2 || $("#TermsOfDeliveryID").val() == 3) {
                        RoundOffFreight = 0.00;
                    }
                    else if (code == "Air Rate") {

                        $("#AirRate").val(data[0].AirRate);

                        var w = $("#TotalWeightInKg").val();

                        CourierAmount = parseFloat(w) * parseFloat(data[0].AirRate);

                        TotalCourierAmount = CourierAmount
                            + parseFloat(data[0].DocketCharges)
                            + parseFloat(data[0].OtherCharges);

                        // COD charges only for TermsOfDeliveryID = 4
                        if ($("#TermsOfDeliveryID").val() == 4) {
                            TotalCourierAmount = TotalCourierAmount + parseFloat(data[0].CODCharges);
                        }

                        CourierFuelCharges = (TotalCourierAmount * data[0].FuelCharges) / 100;
                        FOVCharges = (TotalCourierAmount * data[0].FOVPercent) / 100;

                        NetCourierAmount = TotalCourierAmount + CourierFuelCharges + FOVCharges;

                        if (NetCourierAmount < parseFloat(data[0].MinimumAmount)) {
                            NetCourierAmount = parseFloat(data[0].MinimumAmount);
                        }

                        FreightCharges = NetCourierAmount;
                        RoundOffFreight = FreightRoundOff(FreightCharges);
                    }
                    else if (code == "Surface Rate") {
                        if (r.d2 == "" && r.d3 == "" && r.d4 == "" && $("#CourierID").val() != 6) {
                            alert("Courier Rate Not Exist");
                            return;
                        }
                        var w2 = $("#TotalWeightInKg").val();

                        if (RatePerKG != 0)
                            RatePerKG = RatePerKG;
                        else if (RatePerKG1 != 0)
                            RatePerKG = RatePerKG1;
                        else
                            RatePerKG = RatePerKG2;

                        $("#SurfaceRate").val(RatePerKG);
                        CourierAmount = parseFloat(w2) * parseFloat(RatePerKG);

                        TotalCourierAmount = CourierAmount + data[0].DocketCharges + data[0].OtherCharges;

                        if ($("#TermsOfDeliveryID").val() == 4) {
                            TotalCourierAmount = TotalCourierAmount + data[0].CODCharges;
                        }

                        CourierFuelCharges = (TotalCourierAmount * data[0].FuelCharges) / 100;
                        FOVCharges = (TotalCourierAmount * data[0].FOVPercent) / 100;

                        NetCourierAmount = TotalCourierAmount + CourierFuelCharges + FOVCharges;
                        if (NetCourierAmount < parseFloat(data[0].MinimumAmount)) {
                            NetCourierAmount = parseFloat(data[0].MinimumAmount);
                        }

                        FreightCharges = NetCourierAmount;
                        RoundOffFreight = FreightRoundOff(FreightCharges);
                    }

                    $("#FreightCharges").val(Math.round(RoundOffFreight));
                    $("#FreightCharges").attr("readonly", true);

                    var psubfr = parseFloat($("#ProductSubTotal").val()) + parseFloat($("#FreightCharges").val());

                    var GstAmount0 = ((psubfr * grate) / 100).toFixed(2);
                    var SGST, CGST, IGST;

                    if (GSTRegistrationId === 6 || GSTRegistrationId === 7 || GSTRegistrationId === 8) {
                        SGST = 0.00;
                        CGST = 0.00;
                        IGST = 0.00;
                    }
                    else if (statename == "MAHARASHTRA") {
                        SGST = (((psubfr * 18) / 100) / 2).toFixed(2);
                        CGST = (((psubfr * 18) / 100) / 2).toFixed(2);
                        IGST = 0.00;
                    }
                    else {
                        SGST = 0.00;
                        CGST = 0.00;
                        IGST = GstAmount0;
                    }
                    $("#SGST").val(SGST);
                    $("#CGST").val(CGST);
                    $("#IGST").val(IGST);

                    var GstAmount = parseFloat(SGST) + parseFloat(CGST) + parseFloat(IGST);
                    $("#GSTTotal").val(GstAmount);

                    var TotalAmount = (parseFloat($("#ProductSubTotal").val()) + GstAmount + parseFloat(RoundOffFreight)).toFixed(2);

                    var TotalAmountroundoff = (TotalAmount % 1 === 0.5)
                        ? (TotalAmount - 0.5).toFixed(2)
                        : Math.round(TotalAmount).toFixed(2);

                    $("#TotalAmount").val(TotalAmount);
                    $("#RoundOffAmount").val(TotalAmountroundoff);

                    $("#DocketCharges").val(Math.round(data[0].DocketCharges));
                    $("#FuelCharges").val(Math.round(CourierFuelCharges));
                    $("#OtherCharges").val(Math.round(data[0].OtherCharges));

                    if ($("#TermsOfDeliveryID").val() == 4)
                        $("#CODCharges").val(Math.round(data[0].CODCharges));
                    else
                        $("#CODCharges").val(0);

                    $("#FOV").val(Math.round(FOVCharges));
                }
            }
        });
    }

    function FreightRoundOff(freight) {

        freight = Math.trunc(freight);
        var freightCharge = parseInt(freight);
        var freightMOD = freightCharge % 100;

        freightCharge = parseInt(freightCharge / 100);

        if (freightMOD == 0)
            freightCharge = freightCharge * 100;
        else if (freightMOD <= 25)
            freightCharge = (freightCharge * 100) + 25;
        else if (freightMOD <= 50)
            freightCharge = (freightCharge * 100) + 50;
        else if (freightMOD <= 75)
            freightCharge = (freightCharge * 100) + 75;
        else if (freightMOD <= 100)
            freightCharge = (freightCharge * 100) + 100;

        return freightCharge;
    }

    /* =========================================================
       UPDATE SALES ORDER  (edit access only)
       ========================================================= */
    function UpdateSalesOrder() {

        if (!canEdit) return;

        var ok = true;
        function fail(focusSel, errSel, msg) {
            if (ok && focusSel) $(focusSel).focus();
            setErr(errSel, msg);
            ok = false;
        }
        $('#reqpon, #reqpod, #reqmrd, #reqcon, #errorPMobile11, #reqEm, #ShipAdd, #reqdisp, #reqitems').html('').hide();

        if (orderItems.length == 0) fail('#ItemID', '#reqitems', 'Please add order items');

        if ($('input[name=ShippAdd]:checked').val() == "No" && fv('ShippingAddress') == "") {
            fail('#ShippingAddress', '#ShipAdd', 'Enter Shipping Address');
        }

        if (fv('CustomerPoNo') == '') fail('#CustomerPoNo', '#reqpon', 'Purchase Order No Required');
        if (fv('PurchaseOrderDate') == '') fail('#PurchaseOrderDate', '#reqpod', 'Purchase Order Date Required');
        if (fv('MaterialRequiredDate') == '') fail('#MaterialRequiredDate', '#reqmrd', 'Material Required Date Required');

        var cp = fv('ContactPersonName');
        if (cp == '' || cp == 'Please Select') fail('#ContactPersonName', '#reqcon', 'Select Contact Person');

        var mob = fv('OfficeMobileNo');
        if (mob == '' || mob == 'Please Select') fail('#OfficeMobileNo', '#errorPMobile11', 'Enter Office MobileNo');

        var em = fv('OfficeEmailId');
        if (em == '' || em == 'Please Select') fail('#OfficeEmailId', '#reqEm', 'Select OfficeEmailId');

        var stype = fv('SendType'), rtype = '', counm = '', couid = '';
        if (stype == "By Courier") {
            couid = fv('CourierID');
            counm = $.trim($('#CourierID option:selected').text());
            if (couid == '') fail('#CourierID', '#reqdisp', 'Select Courier');
            else if (couid != 6) {
                rtype = fv('RateType');
                if (rtype == '') fail('#RateType', '#reqdisp', 'Select Transport Mode');
            }
        }

        if (!ok) return;

        var SOItems = [];
        for (var i = 0; i < orderItems.length; i++) {
            var it = orderItems[i];
            SOItems.push({
                SaleOrderNo: fv('SaleOrderNo'),
                ItemID: it["ItemID"],
                ItemName: it["ItemName"],
                Quantity: str(it["Quantity"]),
                ApplicableRate: it["ApplicableRate"],
                Amount: str(it["Amount"]),
                ItemCode: str(it["ItemCode"]),
                HSNCode: str(it["HSNCode"]),
                HSNClassification: str(it["HSNClassification"]),
                RatePerUnit: str(it["RatePerUnit"]),
                WeightPerUnit: str(it["WeightPerUnit"]),
                WeightOfPackingBox: str(it["WeightOfPackingBox"]),
                GSTRate: str(it["GSTRate"]),
                SalesClosingQuantity: (it["SalesClosingQuantity"] === null || it["SalesClosingQuantity"] === undefined) ? '0' : it["SalesClosingQuantity"].toString(),
                MfgClosingQuantity: str(it["Quantity"]),
                ApprovalStatusId: it["ApprovalStatusId"]
            });
        }

        var designinfoid;
        $.ajax({
            url: '@Url.Action("GetDesignInfoId")',
            data: { "ContactPerson": $('#ContactPersonName').val(), "OffEmail": $('#OfficeEmailId').val(), "OffMobile": $('#OfficeMobileNo').val(), "Lid": $('#LedgerID').val(), "AddID": $('#AddressTitleID').val() },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {
                if (data.length > 0) { designinfoid = data[0].DesignationInfoID; }
            }
        });

        var sdate = new Date();
        var data = {
            BusinessAddressId: fv('AddressTitleID'),
            SaleOrderNo: fv('SaleOrderNo'),
            SaleOrderDate: sdate.toDateString(),
            CustomerPoNo: fv('CustomerPoNo'),
            CustomerPoDate: fv('PurchaseOrderDate'),
            EntityName: $.trim($('#LedgerID option:selected').text()),
            AddressTitle: $.trim($('#AddressTitleID option:selected').text()),
            Address: fv('Address'),
            LandMark: fv('LandMark'),
            Locality: fv('Locality'),
            Taluka: fv('Taluka'),
            District: fv('District'),
            Pincode: fv('Pincode1'),
            State: fv('State'),
            Country: fv('Country'),
            MaterialRequiredDate: fv('MaterialRequiredDate'),
            TermsOfDelivery: $.trim($('#TermsOfDeliveryID option:selected').text()),
            TermsOfDeliveryId: fv('TermsOfDeliveryID'),
            DiscountPercent: fv('DiscountPercent'),
            PaymentTerm: $.trim($('#PaymentTermID option:selected').text()),
            PaymentTermId: fv('PaymentTermID'),
            ContactPersonName: cp,
            OfficeMobileNo: mob,
            OfficeEmailId: em,
            TotalWeightInKg: fv('TotalWeightInKg'),
            TransporterName: counm,
            SendType: stype,
            RateType: rtype,
            AirRate: fv('AirRate'),
            SurfaceRate: fv('SurfaceRate'),
            TotalAmount: fv('TotalAmount'),
            CountryCode: fv('CountryCode1'),
            RoundOffTotalAmount: fv('RoundOffAmount'),
            ProductSubTotal: fv('ProductSubTotal'),
            FreightCharges: fv('FreightCharges'),
            GSTTotal: fv('GSTTotal'),
            SGST: fv('SGST'),
            CGST: fv('CGST'),
            IGST: fv('IGST'),
            DocketCharges: fv('DocketCharges'),
            FuelCharges: fv('FuelCharges'),
            OtherCharges: fv('OtherCharges'),
            CODCharges: fv('CODCharges'),
            FOV: fv('FOV'),
            DesignationInfoId: designinfoid,
            TransporterId: couid,
            StatusId: Status,
            CPDesignation: fv('CPDesignation'),
            Note: fv('Note'),
            ShippingAddSameAsBillAdd: $('input[name=ShippAdd]:checked').val(),
            ShippingAddress: fv('ShippingAddress'),
            SalesItem: SOItems
        };

        $('#btnUpdate').prop('disabled', true);

        $.ajax({
            url: '/SalesOrder/UpdateSalesOrder',
            type: "POST",
            data: JSON.stringify(data),
            dataType: "JSON",
            contentType: "application/json",
            success: function (d) {
                if (d.status == true || d.success === true) {
                    alert('Successfully done');
                    window.location.href = '/SaleOrderReport.aspx';
                }
                else {
                    alert('Failed');
                    $('#btnUpdate').prop('disabled', false);
                }
            },
            error: function () {
                alert('Error. Please try again.');
                $('#btnUpdate').prop('disabled', false);
            }
        });
    }

    /* =========================================================
       APPROVE / RESEND  (moved from the old Details page)
       ========================================================= */
    function ApproveSO() {

        if (!confirm('Approve this sales order?')) return;

        var data = {
            SaleOrderNo: fv('SaleOrderNo'),
            UserApprovalId: fv('UserApprovalId'),
            StatusId: 19
        };

        $('#btnApprove').prop('disabled', true);

        $.ajax({
