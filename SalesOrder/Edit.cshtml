        margin-top: 0;
        margin-bottom: 5px;
    }

        .purchase-breadcrumb .route-path1,
        .purchase-breadcrumb .route-path2 {
            font-size: 14px;
            font-weight: 600;
            font-family: Helvetica, sans-serif;
