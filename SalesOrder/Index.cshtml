                if (data.length > 0) {

                    for (var i = 0; i < data.length; i++) {

                        if (data[i].FormName == "SalesOrder") {

                            if (data[i].Create == "Y") {

                                $('#CreateSalesOrder').show();
                            }
                            else {

                                $('#CreateSalesOrder').hide();
                            }
                        }

                    }

                }
                if (data.length > 0) {

                    for (var i = 0; i < data.length; i++) {

                        if (data[i].FormName == "TaxInvoice") {

                            if (data[i].Create == "Y") {

                                $('#CreateTaxInvoice').show();
                            }
                            else {

                                $('#CreateTaxInvoice').hide();
                            }
                        }

                    }

                }

            }
        });
    });

