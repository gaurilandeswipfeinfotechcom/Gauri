    function searchSalesOrderNo(id) {
        var txt = document.getElementById(id);
        //txt.value = txt.value.replace(/\w\S*/g, function (txt) { return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase(); });

        // var txt = document.getElementById(id);
        //alert("hi");
        $.ajax({
            url: '/SalesOrder/AutocompleteSalesOrderNo/',
            data: { "searchByText": txt.value, "sortBy": $('#SortByColumnName').val() },
            type: "POST",
            dataType: "json",

            success: function (data) {
                $('#json-datalistSalesOrderNo').empty();
                var jsonOptions = data;
                var dataList = document.getElementById('json-datalistSalesOrderNo');

                jsonOptions.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = item;
                    dataList.appendChild(option);
                });
            },
            error: function (xhr, status, error) {
                alert(xhr.responseText);
            }
        });
    } //end of searchSalesOrderNo

    function validate() {
        if ($('#SearchByText').val() != "") {
            $('#SortByColumnName').val('SalesOrderNo');

        }
        else if ($('#SortByColumnName').val() != "SalesOrderNo") {
            $('#SearchSalesOrderNo').val('');
        }
    }
    function funPageNoClicked(requestedPgNo) {

        $("#isPageNavigationRequested").val("true");
        $("#RequestedPageNumber").val(requestedPgNo);
        event.preventDefault();
        $("#Sales_Order_List").submit();
    }
      @*$(function () {
        $("#Search").click(function () {
            $("#RequestedPageNumber").val(1); // Reset to first page on search
            $("#isPageNavigationRequested").val("false");
        });

        $("#Search").click(function () {
            var requestedPageNumber = parseInt($("#Page").val());
            if (!isNaN(requestedPageNumber) && requestedPageNumber > 0 && requestedPageNumber <= @Model.PageCount) {
                funPageNoClicked(requestedPageNumber);
            }
        });
    });*@

    $(function () {
        $("#Search").click(function () {
            $("#isPageNavigationRequested").val("false");
        });
    });
    //function openEditForm(editFormUrl) {
    //    var editTab = window.open(editFormUrl, '_blank');

    //    // Listen for the edit tab closure
    //    editTab.onbeforeunload = function () {
    //        // Refresh the index page when the edit tab is closed
    //        location.reload();
    //    };
    //}

    function showInvoiceAndPrint(element) {
    var mfgJournalNo = $(element).data("mfgjournalno");

    // Step 1: Call the controller action to set the session
    $.ajax({
        url: '@Url.Action("Prints")',
        type: 'POST',
        data: { sono: mfgJournalNo },
        success: function (response) {
            if (response.success) {
                // Step 2: Load the report page into iframe
                $('#invoiceIframe').attr('src', '/SalesOrderReportPrint.aspx');

                // Step 3: Open modal
                openModal('invoiceModal', 'purchaseModalOverlay');
            } else {
                alert("Error: Unable to set session.");
            }
        },
        error: function () {
            alert('An error occurred while setting the session for the report.');
        }
    });
}


// Function to open the modal
function openModal(modalId, overlayId) {
    document.getElementById(modalId).style.display = "block";
    document.getElementById(overlayId).style.display = "block";
}

// Function to close the modal
function closeModal(modalId) {
    document.getElementById(modalId).style.display = "none";
    document.getElementById(modalId + "Overlay").style.display = "none";
}
</script>

