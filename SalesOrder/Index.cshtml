<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="d-flex" style="margin-top:-20px">
            <h4 class="route-path1">Sales </h4>
            <h4 class=" route-path2" onclick="location.href='@Url.Action("Index","SalesOrder")'">Sales Order</h4>
        </div>
        <br />
        <div class="position-absolute top-0 end-0 d-flex p-1">
            <i class="material-icons fs-2" style="color:midnightblue">file_copy</i>
            <span class="fs-5">- Create Tax Invoice</span>
        </div>

        <div class="panel panel-default outer-main-container">
            <div class="form-group row main-heading">

                <div class="col-lg-9 d-flex ">
                    <i class="material-icons" style="font-size: 32px; margin-right: 10px;">integration_instructions</i>
                    Sales Order List
                </div>
                <div class="col-lg-3">
                    <input type="button" id="CreateSalesOrder" value="Create" class="btn btn-success btn-round create-bttn  custo-inner" style="font-size:small;outline:none;" onclick="location.href = '@Url.Action("CreateNew", "SalesOrder")'" />
                </div>

            </div>

            <div class="panel-body">
                @Html.TextBox("details", null, new { @onkeyup = "myFunction(this.id)", @class = "form-control", style = "display: none;" })
                @Html.TextBox("Edit", null, new { @onkeyup = "myFunction(this.id)", @class = "form-control", style = "display: none;" })
                @using (Html.BeginForm("Index", "SalesOrder", FormMethod.Post, new { id = "Sales_Order_List" }))
                {
                    <div class="panel panel-success search-rectangle" style="margin-top:-15px">
                        <div class="panel-body">
                            <div class="form-group row" style="margin-top:-15px">
                                <div class="col-lg-2 col-md-4 p-3">
                                    <label id="label" class="mt-4">Search By :</label>
                                    <div class="form-group row">
                                        @Html.DropDownListFor(m => m.SortByColumnName, new List<SelectListItem>
                                                                 {
                                                                  new SelectListItem{ Text="Sales Order No.", Value = "SalesOrderNo" },
                                                                  new SelectListItem{ Text="Quotation No.", Value = "QuotationNo" },
                                                                  new SelectListItem { Text="Company Name", Value ="CompanyName"},
                                                                  new SelectListItem { Text="Status", Value ="Status"},
                                                                 }, new { @class = "form-control dropdown-textbox ", style = "height:35px;" })
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-8 p-3">
                                    <label id="label" class="mt-4">Find :</label>

                                    @Html.TextBoxFor(m => m.SearchByText, null, new
                               {
                                   @class = "form-control input-text-box fs-4",
                                   @style = "height:35px;",
                                   @oninput = "searchSalesOrderNo(this.id)",
                                   @list = "json-datalistSalesOrderNo",

                               })
                                    <datalist id="json-datalistSalesOrderNo"></datalist>

                                </div>
                                <div class="col-lg-4 row p-3">
                                    <div class="col-md-4 p-3 ">
                                        <label id="label">Sort:</label>
                                        <div class="form-group row">
                                            @Html.DropDownListFor(m => m.OrderByType,
                                           new List<SelectListItem> { new SelectListItem { Text = "Z-A", Value = "Z-A" },
                                               new SelectListItem { Text = "A-Z", Value = "A-Z" }, },
                                           new { @class = "form-control dropdown-textbox ", style = "height:35px;" })
                                        </div>
                                    </div>

                                    <div class="col-md-4 p-3">
                                        <label id="label">Records:</label>
                                        @Html.TextBoxFor(m => m.RecordsPerPage, null, new
                                   {
                                            @class = "form-control input-text-box fs-4",
                                       style = "height:35px"
                                        })
                                    </div>
                                    <div class="col-md-4 p-3">
                                        <label id="label">Page No. :</label>
                                        @Html.TextBox("Page", null, new
                                   {
                                       @class = "form-control input-text-box fs-4",
                                       style = "height:35px",
                                       @id = "Page"
                                   })
                                    </div>
                                </div>

                                <div class="col-lg-2 mt-5 ">
                                    <button type="submit" id="Search" value="Search" name="Search" style="outline: none" class="btn btn-success btn-round search-bttn custo-inner">
                                        Search<i class="material-icons" style="font-size: 20px;padding-left:15px">search</i>
                                    </button>

                                </div>

                            </div>
                            @*<div class="form-group row" style="margin-top:-15px">
                                    <div class="col-md-6 col-lg-3">
                                        <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 ">Sale Order Date :</label>
                                        @Html.CheckBoxFor(m => m.SalesOrderDate, true)
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 ">Purchase Order No :</label>
                                        @Html.CheckBoxFor(m => m.PurchaseOrderNo, true)
                                    </div>
                                    <div class="col-md-6 col-lg-3">
                                        <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 ">Purchase Order Date : </label>
                                        @Html.CheckBoxFor(m => m.PurchaseOrderDate, true)
                                    </div>

                                    <div class="col-md-6 col-lg-3">
                                        <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 ">Company Name: </label>
                                        @Html.CheckBoxFor(m => m.CompanyName, true)
                                    </div>
                                </div>*@

                        </div>
                    </div>
                    <div class="panel panel-success" style="box-shadow:inset 4px 4px 4px gray;border-radius:10px">
                        <div class="panel-body">
                            <div class="table-responsive">
                                <table class="table ">
                                    <tr style=" border-bottom: 10px solid #fff; font-size: small">
                                        <th width="3%" style="border-right: 2px solid #fff">
                                            No.
                                        </th>
                                        <th width="8%" style=" border-right: 2px solid #fff">
                                            SO. No.
                                        </th>
                                        @if (Model.SalesOrderDate == true)
                                        {
                                            <th width="10%" style=" border-right: 2px solid #fff">
                                                SO. Date
                                            </th>
                                        }
                                        <th width="8%" style=" border-right: 2px solid #fff">
                                            Qtn. No.
                                        </th>
                                        @if (Model.CustomerPoNo == true)
                                        {
                                            <th width="11%" style="border-right: 2px solid #fff">
                                                PO. No.
                                            </th>
                                        }
                                        @if (Model.CustomerPoDate == true)
                                        {
                                            <th width="8%" style=" border-right: 2px solid #fff">
                                                PO. Date
                                            </th>
                                        }
                                        @if (Model.EntityName == true)
                                        {
                                            <th width="16%" style=" border-right: 2px solid #fff">
                                                Company Name
                                            </th>
                                        }
                                        <th width="8%" style=" border-right: 2px solid #fff">
                                            Total Amount
                                        </th>

                                        <th width="8%" style=" border-right: 2px solid #fff">
                                            Status
                                        </th>

                                        <th width="10%" style=" border-right: 2px solid #fff">
                                            Reference Date
                                        </th>
                                        <th width="10%">
                                            Action
                                        </th>
                                    </tr>
                                    @{ int sno = (Model.RequestedPageNumber - 1) * Model.RecordsPerPage + 1;
                                        foreach (var item in Model.EnquirySearchedList)
                                        {


                                            <tr>
                                                <td style="text-align:center">
                                                    @sno
                                                    @{ sno++; }
                                                </td>

                                                <td style="text-align:center">
                                                    @Html.DisplayFor(modelItem => item.SaleOrderNo)
                                                </td>


                                                @if (Model.SalesOrderDate == true)
                                                {
                                                    <td style="text-align:center">
                                                        @Convert.ToString(string.Format("{0:dd/MM/yyyy HH:mm }", item.SaleOrderDate))

                                                    </td>
                                                }
                                                @if (item.QuoteNo == null)

                                                {
                                                    <td style="text-align:center">N.A.</td>
                                                }
                                                else
                                                {
                                                    <td style="text-align:center">
                                                        @Html.DisplayFor(modelItem => item.QuoteNo)
                                                    </td>
                                                }
                                                @if (Model.CustomerPoNo == true)
                                                {
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.PurchaseOrderNo)
                                                    </td>
                                                }
                                                @if (Model.CustomerPoDate == true)
                                                {
                                                    <td style="text-align:center">
                                                        @Convert.ToString(string.Format("{0:dd/MM/yyyy}", item.CustomerPoDate))

                                                    </td>
                                                }
                                                @if (Model.EntityName == true)
                                                {
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.EntityName)
                                                    </td>
                                                }
                                                <td style="text-align:right">
                                                    @Math.Round(Convert.ToDouble(item.TotalAmount), 0)

                                                </td>

                                                @if (item.Status == "Partly Dispatched" || item.Status == "Partly Assembly Scheduled" || item.Status == "Partly Ready For Dispatched" || item.Status == "Approved For Assembly")
                                                {
                                                    <td style="text-align:center">
                                                        @Html.DisplayFor(modelItem => item.Status)
                                                        <span id="CreateTaxInvoice" title="Create Tax Invoice" style=" color: midnightblue; cursor: pointer; padding-left: 30%">
                                                            <i class="material-icons"
                                                               onclick="location.href = '@Url.Action("Create", "TaxInvoice",new { Sono = item.SaleOrderNo }, null )'">file_copy</i>
                                                        </span>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td style="text-align:center">
                                                        @Html.DisplayFor(modelItem => item.Status)
                                                    </td>
                                                }

                                                <td style="text-align:center">

                                                    @Convert.ToString(string.Format("{0:dd/MM/yyyy}", item.AssemblyDate))
                                                </td>
                                                <td>
                                                    <div style="text-align:center">
                                                        @*@if (Model.AllowEdit == true)
                                                            {
                                                                <span><i class="glyphicon glyphicon-edit" id="click" title="Edit" onclick="location.href = '@Url.Action("Edit", new { sono = item.SaleOrderNo })'"></i></span>
                                                            }
                                                            else
                                                            {
                                                                <span><i class="glyphicon glyphicon-edit" style="display:none" title="Edit" onclick="location.href = '@Url.Action("edit", new { sono = item.SaleOrderNo })'"></i></span>
                                                            }*@
                                                        @if (Model.AllowDetails == true || Model.AllowEdit == true)
                                                        {
                                                            <span><i class="glyphicon glyphicon-list" title="Details" onclick="location.href = '@Url.Action("Edit",new {sono = item.SaleOrderNo })'"></i></span>
                                                        }
                                                        else
                                                        {
                                                            <span><i class="glyphicon glyphicon-list" style="display:none" title="Details" onclick="location.href = '@Url.Action("Edit",new {sono = item.SaleOrderNo })'"></i></span>
                                                        }

                                                        <span>
                                                            <i class="glyphicon glyphicon-print" title="View Sales Order"
                                                               @*data-id="@item.SaleOrderID"*@
                                                               data-mfgjournalno="@item.SaleOrderNo"
                                                               onclick="showInvoiceAndPrint(this)">
                                                            </i>
                                                        </span>
                                                    </div>
                                                </td>
                                            </tr>

                                        }
                                        // Show message if no records are found
                                        if (!Model.EnquirySearchedList.Any())
                                        {
                                            <tr>
                                                <td colspan="11" class="text-center">No records found.</td>
                                            </tr>
                                        }

                                    }
                                </table>
                            </div>
                        </div>
                    </div>
                    <button id="goBackButton" class="btn btn-success  back-arrow-bttn" style="display:none">
                        <i class="material-icons" style="font-size: 20px;padding-right:15px">arrow_back</i>Back
                    </button>


                    <div class="table-responsive p-2">
                        <table align="center">
                            <tr class="page">
                                @if (Model.PageCount > 1)
                                {
                                    @Html.HiddenFor(m => m.PageCount)
                                    <td>
                                        @if (Model.RequestedPageNumber > 1)
                                        {
                                            <a id="FirstPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-right: 5px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica "
                                               onclick='funPageNoClicked(1);'>First</a>
                                        }
                                    </td>

                                    <td>
                                        @if (Model.RequestedPageNumber > 1)
                                        {
                                            <a id="PreviousPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-right: 10px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica"
                                               onclick='funPageNoClicked(@Model.RequestedPageNumber - 1);'><b><</b></a>
                                        }
                                    </td>

                                    {
                                        int startPage;
                                        int endPage;

                                        if (Model.PageCount <= 10)
                                        {
                                            startPage = 1;
                                            endPage = Model.PageCount;
                                        }
                                        else
                                        {
                                            if (Model.RequestedPageNumber <= 6)
                                            {
                                                startPage = 1;
                                                endPage = 10;
                                            }
                                            else if (Model.RequestedPageNumber >= Model.PageCount - 4)
                                            {
                                                startPage = Model.PageCount - 9;
                                                endPage = Model.PageCount;
                                            }
                                            else
                                            {
                                                startPage = Model.RequestedPageNumber - 5;
                                                endPage = Model.RequestedPageNumber + 4;
                                            }
                                        }

                                        for (int pgno = startPage; pgno <= endPage; pgno++)
                                        {
                                            <td>
                                                <a id="PageNo" href="#" class="btn btn-secondary btn-round @(pgno == Model.RequestedPageNumber ? "active" : "")" onclick='funPageNoClicked(@pgno);'>@pgno.ToString()</a>
                                            </td>
                                        }
                                    }

                                    <td>
                                        @if (Model.RequestedPageNumber < Model.PageCount)
                                        {
                                            <a id="NextPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-left: 10px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica"
                                               onclick='funPageNoClicked(@Model.RequestedPageNumber + 1);'><b>></b></a>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.RequestedPageNumber < Model.PageCount)
                                        {
                                            <a id="LastPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-left: 5px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica"
                                               onclick='funPageNoClicked(@Model.PageCount);'>Last</a>
                                        }
                                    </td>
                                }
                                @Html.HiddenFor(x => x.isPageNavigationRequested)
                                @Html.HiddenFor(x => x.RequestedPageNumber)
                            </tr>
                        </table>
                    </div>

                    {
