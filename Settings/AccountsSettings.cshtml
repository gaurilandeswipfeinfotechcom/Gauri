    <script>
        // Get references to the input elements and the result element
        var val1Input = document.getElementById("Val1");
        var val2Input = document.getElementById("Val2");
        var resultInput = document.getElementById("Result");
        var subtractButton = document.getElementById("subtractButton");
        var columnRadio = document.getElementById("ColumnRadio");
        var withoutRadio = document.getElementById("WithoutRadio");

        // Add an event listener to the subtractButton
        subtractButton.addEventListener("click", function () {
            // Parse the values as numbers
            var val1 = parseFloat(val1Input.value);
            var val2 = parseFloat(val2Input.value);

            // Check if both inputs are valid numbers
            if (!isNaN(val1) && !isNaN(val2)) {
                // Perform subtraction
                var result = val1 - val2;

                // Check the selected radio button
                if (columnRadio.checked) {
                    // If "Column" radio button is selected, format result with a minus sign
                    resultInput.value = result < 0 ? "(" + "-" + Math.abs(result) + ")" : result;
                }
                else if (columnRadio.checked) {
                    // If "Column" radio button is selected, format result with a minus sign
                    resultInput.value = result < 0 ? "(" + "-" + Math.abs(result) + ")" : result;
                }
                else {
                    // If "Without" radio button is selected, display the normal result
                    resultInput.value = result;
                }
            } else {
                // Display an error message if inputs are not valid numbers
