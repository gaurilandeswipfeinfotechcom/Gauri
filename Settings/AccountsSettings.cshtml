@helper CheckRow(string labelText)
{
    <div class="setting-row">

        <!-- Label -->
        <label class="setting-label">
            @Html.Raw(labelText)
        </label>

        <!-- Toggle -->
        <div class="toggle-wrapper">
            <label class="switch">

                <input type="checkbox"
                       onchange="updateToggleText(this)" />

                <span class="slider"></span>

            </label>

            <span class="toggle-text">No</span>
        </div>

    </div>
}

