<script>
    $(document).ready(function () {

        /*module button*/
        $.ajax({
            url: '/Settings/GetAllColors',
            type: 'GET',
            success: function (colors) {
                // Example: Apply Inner Button colors
                var bgColor = colors.ModuleButtonColor; // module buttons
                var fontColor = colors.ModuleButtonFontColor; // module buttons
                var bgColor1 = colors.ModuleDropdownBgColor; // module dropdown
                var fontColor1 = colors.ModuleDropdownFontColor; // module dropdown
                var bgColor2 = colors.SidebarBgColor; // sidebar
                var bgColor3 = colors.HeaderBgColor; // header
                var fontColor3 = colors.HeaderFontColor; // header text
                var bgColor4 = colors.FooterBgColor; // footer
                var fontColor4 = colors.FooterFontColor; // footer text
                var bgColor5 = colors.InnerButtonColor; // inner
                var fontColor5 = colors.InnerButtonFontColor; // inner text

                // Example for all preview boxes (optional)
                $('.custo-module').css('background', bgColor);// module buttons
                $('.custo-module').css('color', fontColor);// module buttons
                $('.custo-drop').css('background', bgColor1);// module dropdown
                $('.custo-dropt').css('color', fontColor1);// module dropdown
                $('.custo-sidebar').css('background', bgColor2);// module dropdown
                $('.custo-head').css('background', bgColor3);//  header
                $('.custo-headt').css('color', fontColor3);// header text
                $('.custo-foot').css('background', bgColor4);//  footer
                $('.custo-foott').css('color', fontColor4);// footer text
                $('.custo-inner').css('background', bgColor5);//  inner
                $('.custo-inner').css('color', fontColor5);// inner text
            },
            error: function () {
                console.error("Failed to load color settings.");
            }
        });

    });
</script>

