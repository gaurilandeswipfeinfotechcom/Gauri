
@model ERPEntities.ThemeSetting
@{
    ViewBag.Title = "Theme Settings";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}



<style>
    .preview-box {
        padding: 5px 10px;
        border-radius: 4px;
        margin-left: 10px;
        border: 1px solid #ccc;
        display: inline-block;
        min-width: 80px;
        text-align: center;
    }

    .pagefix {
        margin-top: -22px;
        margin-bottom: -20px
    }

    .material-icons {
        font-size: 35px;
        margin-right: 10px;
    }

    .resetbtn {
        border-radius: 20px;
        font-size: large;
        padding-right: 15px;
        max-height: 40px;
        float: right;
        margin-top: -36px;
        margin-right: 10px
    }

    .zoom {
        transition: transform .1s;
    }

        .zoom:hover {
            -ms-transform: scale(1.5); /* IE 9 */
            -webkit-transform: scale(1.5); /* Safari 3-8 */
            transform: scale(1.02);
        }

    .cardbox {
        border-radius: 10px;
        box-shadow: 0 6px 15px rgb(0 0 0 / 39%);
        background-color: #fff;
        width: 100%;
        overflow: hidden; /* Prevents content from spilling out */
        box-sizing: border-box;
        min-height: 250px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1rem;
        text-align: center;
    }

    .setting-name {
        font-family: 'poppins',sans-serif;
        color: midnightblue;
        text-transform: uppercase;
        text-align: center;
        overflow: hidden;
        padding-inline: 0;
        overflow-wrap: break-word;
    }

    .demo-module {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-image: linear-gradient(to right bottom, rgb(239,240,243), rgb(229,230,235));
        box-shadow: 5px 5px 6px #bfc3cf, -5px -5px 6px #fff;
        color: midnightblue;
        height: 40px;
        width: 60%;
        padding: 0 10px;
        border-radius: 15px;
        font-family: Verdana, sans-serif;
        border: none;
        font-size: large;
        margin-inline: 20%;
        overflow: hidden;
        white-space: nowrap;
    }

        .demo-module .icon {
            margin-right: 8px;
            display: flex;
            align-items: center;
        }

        .demo-module .text {
            flex: 1; /* Takes available space */
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

        .demo-module .caret {
            margin-left: 8px;
        }

    .demo-drop {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-radius: 0 10px 10px 10px;
        background-image: linear-gradient(to right,rgba(198,219,244,0.7),white,white,white,white,white,white,rgba(198,219,244,0.7));
        box-shadow: 5px 0px 5px lightgray;
        color: midnightblue;
        height: 40px;
        width: 60%;
        padding: 0 10px;
        font-family: Verdana, sans-serif;
        border: none;
        font-size: large;
        margin-inline: 20%;
        overflow: hidden;
        white-space: nowrap;
    }

        .demo-drop .icon {
            margin-right: 8px;
            display: flex;
            align-items: center;
        }

        .demo-drop .text {
            flex: 1; /* Takes available space */
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

    .demo-side {
        background-color: rgb(240, 240, 240);
        box-shadow: 4px 8px 8px rgba(0, 0, 0, 0.2);
        border-radius: 0 0 15px 0;
        height: 60px;
        border: none;
        width: 70%
    }

    .demo-head {
        background-image: linear-gradient(to left, lightblue, white);
        box-shadow: 0px 8px 8px rgba(0, 0, 0, 0.2);
        height: 50px;
        border: none;
        width: 95%
    }

        .demo-head .text {
            flex: 1; /* Takes available space */
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
            font-weight: bold;
            color: midnightblue;
            font-size: x-large;
        }

    .demo-foot {
        background-color: #e0f7fa;
        box-shadow: 0 -4px 8px rgba(0, 0, 0, 0.2);
        height: 50px;
        border: none;
        width: 95%
    }

        .demo-foot .text {
            flex: 1; /* Takes available space */
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
            color: black;
            font-size: large;
        }


    .create-bttn {
        border-radius: 10px;
        font-size: small;
    }

    label {
        font-size: large;
        padding-right: 10%
    }
</style>



