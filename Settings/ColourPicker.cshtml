<script>
    $(document).ready(function () {
        $.ajax({
            url: '/Settings/GetThemeColors', // This should return all colors as JSON
            type: 'GET',
            success: function (colors) {
                for (const key in colors) {
                    if (colors.hasOwnProperty(key)) {
                        $('#' + key).val(colors[key]);
                    }
                }
            },
            error: function () {
                console.error("Failed to load theme colors.");
            }
        });
    });


</script>


<script>
    function updatePreview(bgId, fontId, previewId) {
        const bg = $('#' + bgId).val();
        const font = $('#' + fontId).val();
        $('#' + previewId).css({
            'background-color': bg,
            'color': font
        });
    }

    $(document).ready(function () {
        // Set initial previews
        updatePreview('InnerButtonColor', 'InnerButtonFontColor', 'InnerButtonPreview');
        updatePreview('ModuleButtonColor', 'ModuleButtonFontColor', 'ModuleButtonPreview');
        updatePreview('ModuleDropdownBgColor', 'ModuleDropdownFontColor', 'ModuleDropdownPreview');
        updatePreview('SidebarBgColor', 'ModuleDropdownFontColor', 'SidebarPreview'); // Use any text color you want here
        updatePreview('HeaderBgColor', 'HeaderFontColor', 'HeaderPreview');
        updatePreview('FooterBgColor', 'FooterFontColor', 'FooterPreview');

        // Bind on change
        $('#InnerButtonColor, #InnerButtonFontColor').on('input', function () {
            updatePreview('InnerButtonColor', 'InnerButtonFontColor', 'InnerButtonPreview');
        });

        $('#ModuleButtonColor, #ModuleButtonFontColor').on('input', function () {
            updatePreview('ModuleButtonColor', 'ModuleButtonFontColor', 'ModuleButtonPreview');
        });

        $('#ModuleDropdownBgColor, #ModuleDropdownFontColor').on('input', function () {
            updatePreview('ModuleDropdownBgColor', 'ModuleDropdownFontColor', 'ModuleDropdownPreview');
        });

        $('#SidebarBgColor, #ModuleDropdownFontColor').on('input', function () {
            updatePreview('SidebarBgColor', 'ModuleDropdownFontColor', 'SidebarPreview');
        });

        $('#HeaderBgColor, #HeaderFontColor').on('input', function () {
            updatePreview('HeaderBgColor', 'HeaderFontColor', 'HeaderPreview');
        });

        $('#FooterBgColor, #FooterFontColor').on('input', function () {
            updatePreview('FooterBgColor', 'FooterFontColor', 'FooterPreview');
        });
    });
</script>


<script>
    $(document).ready(function () {
        // Reset button click handler
        $('#resetColorsBtn').on('click', function () {
            if (confirm("Are you sure you want to reset all color settings?")) {
                $.ajax({
                    url: '/Settings/ResetAllColors',
                    type: 'POST',
                    success: function (response) {
                        alert("All colors have been reset.");
                        if (response.success) {
                            window.reload(); //  Proper page reload
                            window.location.href = '/Settings/ColourPicker';
                        }
                    },
                    error: function () {
                        alert("Error occurred while resetting colors.");
                    }
                });
            }
        });
    });
</script>


