@model ERPEntities.ValidationsSettingDetails
@{
    ViewBag.Title = "HumanResourceSettings";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}

<style>

    .switch {
        position: relative;
        display: inline-block;
        width: 45px;
        height: 22px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #ccc;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 2px;
            bottom: 2px;
            background: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background: #4376c0;
    }

        input:checked + .slider:before {
            transform: translateX(22px);
        }

    .settings-container {
        display: flex;
        background: white;
        border: 1px solid #ccc;
        min-height: 600px;
    }

    h4 {
        font-size: 18px;
        color: #00209cde;
        margin-top: -1%;
    }

    .left-menu {
        width: 250px;
        background: #f7f7f7;
        border-right: 1px solid #ddd;
        color: #000000;
    }

        .left-menu ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .left-menu li {
            padding: 12px;
            cursor: pointer;
            border-bottom: 1px solid #ddd;
        }

            .left-menu li:hover {
                background: #e9f0ff;
            }

    .menu-list {
        list-style: none;
        padding: 15px;
        margin: 0;
    }

        .menu-list li {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            margin-bottom: 10px;
            border-radius: 10px;
            cursor: pointer;
            color: #444;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .menu-list li i {
                color: #4376c0;
                font-size: 16px;
                width: 20px;
            }

            .menu-list li:hover {
                background: #eef4ff;
                transform: translateX(4px);
            }

            .menu-list li.active {
                background: linear-gradient(90deg, #052a5f,#83cdc6 /*#4a90ff*/ );
                color: white;
                box-shadow: 0px 4px 10px rgba(13,110,253,0.2);
            }

                .menu-list li.active i {
                    color: white;
                }

    .right-panel {
        flex: 1;
        padding: 20px;
    }

    .setting-row {
        display: grid;
        grid-template-columns: 70% 30%;
        margin-bottom: 10px;
        align-items: center;
    }

        .setting-row label {
            font-size: 13px;
        }

        .setting-row select,
        .setting-row input {
            height: 30px;
            padding: 5px;
        }

    .settings-section {
        display: none;
    }

    .active-section {
        display: block;
    }

    .preview-box {
        background: #f2f6ff;
        padding: 10px;
        margin-top: 15px;
    }

    /*.save-btn {
        margin-top: 20px;
        width: 100%;
        height: 40px;
        background: linear-gradient(90deg, #052a5f,#83cdc6*/ /*#4a90ff*/ /*);
        color: white;
        border: none;
    }*/

    label {
        color: #000000;
    }

    select {
        color: #000000;
    }

    .setting-label i {
        color: #4376c0; /* blue icons */
        margin-right: 8px;
        font-size: 14px;
    }

    .setting-row label i,
    h4 i {
        color: #4376c0 !important;
        margin-right: 8px;
    }

    .toggle-wrapper {
        display: flex;
        align-items: flex-start; /* moves Yes/No slightly upward */
        gap: 8px;
        margin-top: -2px;
    }

    .toggle-text {
        font-size: 13px;
        font-weight: 600;
        color: #555;
        min-width: 25px;
    }

    select {
        width: 41%;
    }

    /* =========================================================
   SETTINGS ROUTE PATH
   ========================================================= */

    .route-path1 {
        clip-path: polygon( 0% 0%, 85% 0%, 100% 50%, 85% 100%, 0% 100% );
        background-color: #003399;
        color: white;
        padding: 5px 13px 5px 5px;
        margin: 0;
        font-size: 18px;
    }

    .route-path2 {
        cursor: pointer;
        color: white;
        clip-path: polygon( 89% 0%, 100% 50%, 89% 100%, 0% 100%, 11% 50%, 0% 0% );
        background-color: #003399;
        padding: 5px 15px;
        margin: 0;
        font-size: 18px;
    }

    .route-path3 {
        color: white;
        clip-path: polygon( 89% 0%, 100% 50%, 89% 100%, 0% 100%, 11% 50%, 0% 0% );
        background-color: #003399;
        padding: 5px 15px;
        margin: 0;
        font-size: 18px;
    }

</style>

<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pagefix">

    <div class="d-flex">

        <h4 class="route-path1">
            Admin
        </h4>

        <h4 class="route-path2"
            onclick="location.href='@Url.Action("Index","Settings")'">
            Setting
        </h4>

        <h4 class="route-path3">
            Human Resources
        </h4>

    </div>

    <br />

</div>

