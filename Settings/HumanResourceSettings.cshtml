<script>

    var salaryHeads = [];

    $("#btnAdd").click(function () {

        var salaryHead = $("#SalaryHeadName").val();
        var type = $("#Type").val();
        var category = $("#Category").val();
        var calcType = $("#CalculationType").val();
        var formula = $("#Formula").val();

        // Add current salary head to array
        if (salaryHead != "") {
            salaryHeads.push(salaryHead);
        }

        $("#salaryHeadTable tbody").append(
            "<tr>" +
            "<td>" + salaryHead + "</td>" +
            "<td>" + type + "</td>" +
            "<td>" + category + "</td>" +
            "<td>" + calcType + "</td>" +
            "<td>" + formula + "</td>" +
            "<td><button class='btn btn-danger btnDelete'>Delete</button></td>" +
            "</tr>"
        );

        $("#SalaryHeadName").val("");
        $("#Type").val("");
        $("#Category").val("");
        $("#CalculationType").val("");
        $("#Formula").empty();
        $("#formulaSection").hide();

    });

    $("#CalculationType").change(function () {

        if ($(this).val() == "Formula") {

            $("#formulaSection").show();

            $("#Formula").empty();

            $("#Formula").append('<option value="">Select</option>');

            $.each(salaryHeads, function (i, item) {

                $("#Formula").append(
                    '<option value="' + item + '">' + item + '</option>'
                );

            });

        }
        else {
            $("#formulaSection").hide();
        }

    });
    $(document).on("click", ".btnDelete", function () {
        $(this).closest("tr").remove();
    });
</script>

