<script>

    function updateToggleText(toggle) {

        let text = toggle.closest(".toggle-wrapper")
            .querySelector(".toggle-text");

        text.innerText = toggle.checked ? "Yes" : "No";
    }

    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll(".switch input").forEach(function (toggle) {

            updateToggleText(toggle);

            toggle.addEventListener("change", function () {

                updateToggleText(this);

                // ESIC hidden field update
                if (this.id === "esicToggle") {

                    document.getElementById("IsESICApplicable").value =
                        this.checked ? "true" : "false";
                }

                // PF hidden field update (if using same toggle for PF)
                if (this.id === "pfToggle") {

                    document.getElementById("IsPFApplicable").value =
                        this.checked ? "true" : "false";
                }

            });

        });

    });

</script>