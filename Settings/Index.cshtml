        <h4 style="cursor: pointer; color: white; clip-path: polygon(89% 0%, 100% 50%, 89% 100%, 0% 100%, 11% 50%, 0% 0%); background-color: #003399; padding: 5px 15px 5px 15px; " onclick="location.href='@Url.Action("Index","Settings")'">Setting</h4>
    </div>
    <br />
    <div class="panel panel-default outer-main-container">
