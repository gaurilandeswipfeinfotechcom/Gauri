@*
    <!DOCTYPE html>
    <html>
    <head>
        <style>
            body {
                font-family: Arial, sans-serif;
            }

            /* Form container */
            .form-container {
                max-width: 500px;
                margin: 50px auto; /* Center the container */
                padding: 20px;
                border: 1px solid #ddd;
                border-radius: 10px;
                background-color: lightcyan;
            }

            /* Headings */
            h3 {
                font-size: 24px;
                font-weight: 600;
                margin: 20px 0;
                text-align: center;
            }

            /* Labels */
            label {
                color: black;
                font-weight: bold;
            }

            /* Input fields */
            /*input[type="text"], select {
                width: 100%;
                padding: 10px;
                border: 1px solid #ddd;
                border-radius: 5px;*/
            /*margin-bottom: 10px;*/
            /*font-size: 16px;
            }*/

            /* Radio group */
            .radio-group {
                padding-top: 10px;
            }

                .radio-group input[type="radio"] {
                    cursor: pointer;
                    margin-right: 5px;
                }

            /* Validation message */
            #validationMessage {
                color: red;
                font-size: 14px;
            }
        </style>
    </head>
    <body>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-container">
            <h3><b>Item Master</b></h3>
            <div class="radio-group">
                <label>Item Location</label>
                <br />
                @Html.HiddenFor(model => model.SettingDetailID)
                <div class="form-group row">
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.ItemLocation, (SelectList)ViewBag.ItemLocationList, "Select Item Location", new { @class = "form-control", @id = "ItemLocation", @style = "height:35px" })
                        @Html.ValidationMessageFor(model => model.ItemLocation, "", new { @class = "text-danger" })
                    </div>
                </div>
                <br />
                <label>Manufacturing Journal NO.</label>
                <br />
                <div class="form-group row">
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.MfgJournalNo, (SelectList)ViewBag.MfgJournalNoList, "Select Manufacturing Journal No", new { @class = "form-control", @style = "height:35px" })
                        @Html.ValidationMessageFor(model => model.MfgJournalNo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <br />
                <label>Bill Of Material No.</label>
                <br />
                <div class="form-group row">
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.BomNo, (SelectList)ViewBag.BOMNoList, "Select Bill Of Material No", new { @class = "form-control", @style = "height:35px" })
                        @Html.ValidationMessageFor(model => model.BomNo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <br />
                <label>StockJournal No.</label>
                <br />
                <div class="form-group row">
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.StockJournalNo, (SelectList)ViewBag.StockJournalNoList, "Select Bill Of Material No", new { @class = "form-control", @style = "height:35px" })
                        @Html.ValidationMessageFor(model => model.StockJournalNo, "", new { @class = "text-danger" })
                    </div>
                </div>


                <script>
                    function validateAndConvertToUpperCase(input) {
                        var inputValue = input.value.toUpperCase();
                        var regex = /^[A-Z]$/;

                        if (!regex.test(inputValue)) {
                            input.value = '';
                        } else {
                            input.value = inputValue;
                        }
                    }
                </script>
                <br />
                <label>PreFix For AC Motors</label>

                <div class="form-group row">
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.PriFixForACMotors, new { @class = "form-control", @style = "height:35px", @oninput = "validateAndConvertToUpperCase(this)", @maxlength = "1" })
                        @Html.ValidationMessageFor(model => model.PriFixForACMotors, "", new { @class = "text-danger" })
                    </div>
                </div>

                <label>PreFix For Gear Boxes</label>

                <div class="form-group row">
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.PriFixForGearBoxes, new { @class = "form-control", @style = "height:35px", @oninput = "validateAndConvertToUpperCase(this)", @maxlength = "1" })
                        @Html.ValidationMessageFor(model => model.PriFixForGearBoxes, "", new { @class = "text-danger" })
                    </div>
                </div>

                <label>PreFix For PMDC Motors</label>

                <div class="form-group row">
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.PriFixForPMDCMotors, new { @class = "form-control", @style = "height:35px", @oninput = "validateAndConvertToUpperCase(this)", @maxlength = "1" })
                        @Html.ValidationMessageFor(model => model.PriFixForPMDCMotors, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="form-group row pt-4">
                    <div class="col">
                        <input type="submit" value="Save" class="btn btn-info" />
                    </div>
                </div>
            </div>
            </div>
        }
    </body>
    </html>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function () {
            $("#ItemLocation").change(function () {
                var selectedLocation = $(this).val();
                // Store the selected location in a cookie
                document.cookie = "selectedLocation=" + selectedLocation + "; path=/Item/Create";

            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('ItemLocation').on('click', function () {
                if ($(this).is(':checked')) {
                    // Get the value of the selected radio button
                    var validationValue = $(this).val();

                    // Set the validation pattern for the textbox based on the selected radio button value
                    $('#Name').attr('pattern', '^' + getValidationPattern(validationValue) + '$');
                    $('#Name').val(''); // Clear the input field
                    $('#validationMessage').text(''); // Clear any previous validation message
                } else {
                    // If no radio button is selected, remove the pattern attribute and clear the validation message
                    $('#Name').removeAttr('pattern');
                    $('#validationMessage').text('');
                }
            });

            // Add an oninput event listener to the input field
            $('#Name').on('input', function () {
                // Get the value of the input
                var inputValue = $(this).val();

                // Convert the input value to uppercase
                inputValue = inputValue.toUpperCase();

                // Set the uppercase value back to the input field
                $(this).val(inputValue);

                // Check if the input matches the pattern
                if (!this.checkValidity()) {
                    // Display a message indicating that the input does not match the selected validation pattern
                    $('#validationMessage').text('Input does not match the selected validation pattern.');
                } else {
                    // Clear the validation message if the input matches the pattern
                    $('#validationMessage').text('');
                }
            });

            function getValidationPattern(validationValue) {
                // Define the regular expression pattern based on the selected radio button value
                var pattern = '';

                if(validationValue === '1') {
                    pattern = '[A-Za-z][0-9][A-Za-z][0-9]';
                }
                if (validationValue === '2') {
                    pattern = '[A-Za-z][A-Za-z][0-9][A-Za-z][A-Za-z][0-9]';
                }
                if (validationValue === '3') {
                    pattern = '[0-9][A-Za-z][0-9][A-Za-z]';
                }
                if (validationValue === '4') {
                    pattern = '[0-9][A-Za-z][A-Za-z][0-9][A-Za-z][A-Za-z]';
                }

                return pattern;
            }
        });
    </script>*@


