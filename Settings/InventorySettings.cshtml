         width: 41%;
     }

     .switch {
         position: relative;
         display: inline-block;
         width: 45px;
         height: 22px;
     }

         .switch input {
             opacity: 0;
             width: 0;
             height: 0;
         }

     .slider {
         position: absolute;
         cursor: pointer;
         top: 0;
         left: 0;
         right: 0;
         bottom: 0;
         background: #ccc;
         transition: .4s;
         border-radius: 34px;
     }

         .slider:before {
             position: absolute;
             content: "";
             height: 18px;
             width: 18px;
             left: 2px;
             bottom: 2px;
             background: white;
             transition: .4s;
             border-radius: 50%;
         }

     input:checked + .slider {
         background: #4376c0;
     }

         input:checked + .slider:before {
             transform: translateX(22px);
         }

