@helper CheckRow(string labelText)
{
    <div class="setting-row">
        <label class="setting-label">
            @Html.Raw(labelText)
        </label>

        <div class="toggle-wrapper">
            <label class="switch">
                <input type="checkbox" checked onchange="updateToggleText(this)">
                <span class="slider"></span>
            </label>

            <span class="toggle-text">Yes</span>
        </div>
    </div>
}


<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 pagefix">

    <div class="d-flex">

        <h4 class="route-path1">
            Admin
        </h4>

        <h4 class="route-path2"
            onclick="location.href='@Url.Action("Index","Settings")'">
            Setting
        </h4>

        <h4 class="route-path3">
            Inventory
        </h4>

    </div>

    <br />

</div>




@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="settings-container">

        <div class="left-menu">

            <ul class="menu-list">
                <li class="active" onclick="showSection('general',this)">
                    <i class="fa fa-cogs"></i> General
                </li>

                <li onclick="showSection('display',this)">
                    <i class="fa fa-cubes"></i> Stock Display
                </li>

                <li onclick="showSection('itemconfig',this)">
                    <i class="fa fa-tags"></i> Item Config
                </li>

                <li onclick="showSection('prefix',this)">
                    <i class="fa fa-hashtag"></i> Prefix
                </li>

                <li onclick="showSection('transaction',this)">
                    <i class="fa fa-exchange-alt"></i> Transaction
                </li>


            </ul>

        </div>
        <!-- RIGHT PANEL -->
        <div class="right-panel">

            <!-- GENERAL -->
            <div id="general" class="settings-section active-section inventory-settings-card">

