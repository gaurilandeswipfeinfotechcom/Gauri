                    @CheckRow("<i class='fa fa-exclamation-triangle'></i> Allow Negative Stock")

                    @CheckRow("<i class='fa fa-warehouse'></i> Enable Multi Warehouse")

                    @CheckRow("<i class='fa fa-barcode'></i> Enable Barcode")

                    @CheckRow("<i class='fa fa-layer-group'></i> Enable Batch Tracking")

                    @CheckRow("<i class='fa fa-fingerprint'></i> Enable Serial Number Tracking")

                </div>

                <!-- CARD FOOTER -->
                <div class="inventory-card-footer">
                    <button type="submit" class="save-btn inventory-save-btn">
                        <i class="fa fa-save"></i>
                        Save Settings
                    </button>
                </div>

