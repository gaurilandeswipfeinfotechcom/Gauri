<style>

    .settings-container {
        display: flex;
        background: white;
        border: 1px solid #ccc;
        min-height: 650px;
    }

    h4 {
        font-size: 18px;
        color: #00209cde;
        margin-top: -1%;
    }

    .left-menu {
        width: 250px;
        background: #f7f7f7;
        border-right: 1px solid #ddd;
        color: #000000;
    }

        .left-menu ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .left-menu li {
            padding: 12px;
            cursor: pointer;
            border-bottom: 1px solid #ddd;
        }

            .left-menu li:hover {
                background: #e9f0ff;
            }

    .menu-list {
        list-style: none;
        padding: 15px;
        margin: 0;
    }

        .menu-list li {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            margin-bottom: 10px;
            border-radius: 10px;
            cursor: pointer;
            color: #444;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .menu-list li i {
                color: #4376c0;
                font-size: 16px;
                width: 20px;
            }

            .menu-list li:hover {
                background: #eef4ff;
                transform: translateX(4px);
            }

            .menu-list li.active {
                background: linear-gradient(90deg, #052a5f,#83cdc6 /*#4a90ff*/ );
                color: white;
                box-shadow: 0px 4px 10px rgba(13,110,253,0.2);
            }

                .menu-list li.active i {
                    color: white;
                }

    .right-panel {
        flex: 1;
        padding: 20px;
    }

    .setting-row {
        display: grid;
        grid-template-columns: 70% 30%;
        margin-bottom: 10px;
        align-items: center;
    }

        .setting-row label {
            font-size: 13px;
        }

        .setting-row select,
