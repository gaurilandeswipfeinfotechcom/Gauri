        color: white;
        font-weight: 600;
        display: block;
        margin-left: auto;
        margin-right: auto;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.15);
    }

    label {
        color: #000000;
    }

    select {
        color: #000000;
