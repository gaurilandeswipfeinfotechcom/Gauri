        @helper CheckRow(string labelText)
        {
            <div class="setting-row">
                <label class="setting-label">@Html.Raw(labelText)</label>

                <div class="toggle-wrapper">
                    <label class="switch">
                        <input type="checkbox" checked onchange="updateToggleText(this)">
                        <span class="slider"></span>
                    </label>

                    <span class="toggle-text">Yes</span>
                </div>
            </div>
        }
        <div class="right-panel">



            <div id="general" class="settings-section active-section">
                <h4><i class="fa fa-cog"></i> General Sales Settings</h4>

                @CheckRow("<i class='fa fa-shopping-cart'></i> Enable Sales Order")
                @CheckRow("<i class='fa fa-file-text'></i> Enable Quotation")

                @CheckRow("<i class='fa fa-undo'></i> Enable Sales Return")
                @CheckRow("<i class='fa fa-credit-card'></i> Enable Credit Note")
                @CheckRow("<i class='fa fa-ban'></i> Allow Zero Value Invoice")
                @CheckRow("<i class='fa fa-pencil'></i> Enable Narration")
                @CheckRow("<i class='fa fa-file'></i> Optional Voucher")
                @CheckRow("<i class='fa fa-calculator'></i> Round Off Invoice")
                @CheckRow("<i class='fa fa-calendar'></i> Allow Back Date Entry")
            </div>

            <!-- INVOICE -->
            <div id="invoice" class="settings-section">
                <h4><i class="fa fa-file-invoice-dollar"></i> Invoice Settings</h4>

                @CheckRow("<i class='fa fa-print'></i> Print Invoice After Save")
                @CheckRow("<i class='fa-brands fa-whatsapp'></i> WhatsApp Invoice After Save")
                @CheckRow("<i class='fa fa-envelope'></i> Email Invoice After Save")
                @CheckRow("<i class='fa fa-wallet'></i> Show Customer Previous Balance")
                @CheckRow("<i class='fa fa-money-bill-wave'></i> Allow Partial Payment")
                @CheckRow("<i class='fa fa-calendar-days'></i> Enable Due Date")
                @CheckRow("<i class='fa fa-credit-card'></i> Auto Payment Entry")

                <div class="setting-row">
                    <label>
                        <i class="fa fa-hand-holding-dollar"></i> Default Payment Mode
                    </label>
                    <select>
                        <option>Cash</option>
                        <option>UPI</option>
                        <option>Bank</option>
                        <option>Credit</option>
                    </select>
                </div>
            </div>


            <!-- TAX -->
            <div id="tax" class="settings-section">
                <h4><i class="fa fa-percent"></i> Tax Settings</h4>

                @CheckRow("<i class='fa fa-receipt'></i> Enable GST")
                @CheckRow("<i class='fa fa-calculator'></i> Auto CGST/SGST")
                @CheckRow("<i class='fa fa-file-invoice'></i> Auto IGST")

                <div class="setting-row">
                    <label>
                        <i class="fa fa-sliders"></i> GST Type
                    </label>
                    <select>
                        <option>Inclusive</option>
                        <option>Exclusive</option>
                    </select>
                </div>
            </div>



            <div id="discount" class="settings-section">
                <h4><i class="fa fa-tags"></i> Discount Settings</h4>

                @CheckRow("<i class='fa fa-box'></i> Enable Item Discount")
                @CheckRow("<i class='fa fa-file-invoice-dollar'></i> Enable Bill Discount")

                <div class="setting-row">
                    <label>
                        <i class="fa fa-percent"></i> Discount Type
                    </label>
                    <select>
                        <option>% Percentage</option>
                        <option>Flat Amount</option>
                    </select>
                </div>

                <div class="setting-row">
                    <label>
                        <i class="fa fa-indian-rupee-sign"></i> Maximum Discount Limit
                    </label>
                    <input type="number" style="width:101px;" />
                </div>
            </div>



            <div id="numbering" class="settings-section">
                <h4><i class="fa fa-hashtag"></i> Sales Numbering</h4>

                <div class="setting-row">
                    <label>
                        <i class="fa fa-tag"></i> Prefix
                    </label>
                    <input type="text" id="prefix" value="SO" style="width:100px;" />
                </div>

                <div class="setting-row">
                    <label>
                        <i class="fa fa-sort-numeric-up"></i> Start Number
                    </label>
                    <input type="number" id="startNumber" value="1" style="width:100px;" />
                </div>

                <div class="setting-row">
                    <label>
                        <i class="fa fa-calendar-alt"></i> Year Type
                    </label>
                    <select>
                        <option>Financial Year</option>
                        <option>Calendar Year</option>
                    </select>
                </div>

                <div class="setting-row">
                    <label>
                        <i class="fa fa-ruler-horizontal"></i> Number Length
                    </label>
                    <input type="number" id="length" value="10" style="width:100px;" />
                </div>

                <div class="setting-row">
                    <label>
                        <i class="fa fa-arrows-left-right"></i> Position
                    </label>
                    <select>
                        <option>Prefix</option>
                        <option>Postfix</option>
                    </select>
                </div>

                @CheckRow("<i class='fa fa-calendar-check'></i> Include Year")
                @CheckRow("<i class='fa fa-rotate-right'></i> Reset Yearly")
                @CheckRow("<i class='fa fa-repeat'></i> Reset Monthly")

                <div class="preview-box col-lg-3" id="previewBox">
                    <i class="fa fa-eye"></i> Preview: SI26040001
                </div>
            </div>

            <!-- PRINT -->
            <div id="print" class="settings-section">
                <h4>Print Settings</h4>

                @CheckRow("Show Company Logo")
                @CheckRow("Show QR Code")
                @CheckRow("Show Terms & Conditions")
                @CheckRow("Print Duplicate Copy")
                @CheckRow("Print Transport Details")
                @CheckRow("Show Authorized Signature")
            </div>

            <!-- APPROVAL -->
            <div id="approval" class="settings-section">
                <h4>Approval Settings</h4>

                @CheckRow("Sales Approval Required")
                @CheckRow("Credit Limit Validation")
                @CheckRow("Manager Approval For Discount")

            </div>

            <button type="submit" class="save-btn">Save Settings</button>
        </div>
    </div>

}

