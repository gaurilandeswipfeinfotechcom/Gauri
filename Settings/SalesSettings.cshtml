<script>
    const discountToggle = document.getElementById("enableDiscount");
    const discountField = document.getElementById("discountField");
    const discountValue = document.getElementById("discountValue");
    const discountOutput = document.getElementById("discountOutput");

    // Default
    discountField.style.display = "none";

    // Toggle Logic
    discountToggle.addEventListener("change", function () {
        if (this.checked) {
            discountField.style.display = "block";
        } else {
            discountField.style.display = "none";
            discountValue.value = "";
        }
        updateDiscountPreview();
    });

    // Live Preview
    discountValue.addEventListener("input", updateDiscountPreview);

    function updateDiscountPreview() {
        let enabled = discountToggle.checked;
        let discount = parseFloat(discountValue.value) || 0;

        let amount = 1000;
        let finalAmount = amount;

        if (enabled) {
            finalAmount = amount - (amount * discount / 100);
        }

        discountOutput.innerHTML = `
            Discount: ${enabled ? discount + "%" : "Disabled"} <br>
            Final Amount: ₹ ${finalAmount}
        `;

        // Save locally
        localStorage.setItem("enableDiscount", enabled);
        localStorage.setItem("discountValue", discount);
    }

    // Load saved data
    window.addEventListener("load", function () {
        const savedToggle = localStorage.getItem("enableDiscount") === "true";
        const savedDiscount = localStorage.getItem("discountValue") || "";

        discountToggle.checked = savedToggle;
        discountField.style.display = savedToggle ? "block" : "none";
        discountValue.value = savedDiscount;

        updateDiscountPreview();
    });
</script>




<script>
    let counters = JSON.parse(localStorage.getItem("counters")) || {};

    // ✅ YEAR LOGIC (CY + FY)
    function getYearPart(selectedYear, format, type) {

        selectedYear = parseInt(selectedYear);

        if (type === "CY") {
            // Calendar Year
            return format == "2"
                ? selectedYear.toString().slice(-2)
                : selectedYear.toString();
        }

        if (type === "FY") {
            // Financial Year (Apr–Mar)
            let startYear = selectedYear - 1;
            let endYear = selectedYear;

            if (format == "2") {
                return startYear.toString().slice(-2) + "-" + endYear.toString().slice(-2);
            } else {
                return startYear + "-" + endYear;
            }
        }

        return "";
    }

    // KEY FOR COUNTER
    function getKey(prefix, year, reset) {
        return reset ? prefix + "_" + year : prefix;
    }



    function generateNumber() {

        let prefix = document.getElementById("prefix").value;

        let today = new Date();

        let yearFull = today.getFullYear();
        let month = today.getMonth() + 1;

        let position = document.getElementById("position").value;
        // YEAR (last 2 digits → 2026 = 26)
        let year = yearFull.toString().slice(-2);

        // MONTH (04 format)
        let monthPart = month.toString().padStart(2, "0");

        let startFrom = parseInt(document.getElementById("startFrom").value) || 1;
        let length = parseInt(document.getElementById("length").value) || 12;

        // KEY (separate counter per month)
        let key = prefix + "_" + year + "_" + monthPart;

        if (!counters[key]) counters[key] = startFrom;

        let count = counters[key];

        // BASE → QN2604
        let base = prefix + year + monthPart;

        let remaining = length - base.length;

        if (remaining <= 0) return "❌ Length too small";

        let numberPart = count.toString().padStart(remaining, "0");

        /*return base + numberPart;*/
        return position === "prefix"
            ? base + numberPart
            : numberPart + base;
    }





    function generateNext() {

        let prefix = document.getElementById("prefix").value;

        let today = new Date();
        let year = today.getFullYear().toString().slice(-2);
        let month = (today.getMonth() + 1).toString().padStart(2, "0");

        let startFrom = parseInt(document.getElementById("startFrom").value) || 1;

        let key = prefix + "_" + year + "_" + month;

        if (!counters[key]) counters[key] = startFrom;

        counters[key]++;
        localStorage.setItem("counters", JSON.stringify(counters));

        updatePreview();
    }







    // ✅ PREVIEW
    function updatePreview() {
        document.getElementById("preview").innerText =
            "Preview: " + generateNumber();
    }

    // ✅ SAVE SETTINGS
    function saveSettings() {
        localStorage.setItem("numberSettings", JSON.stringify({
            prefix: document.getElementById("prefix").value,
            yearType: document.getElementById("yearType").value,
            yearFormat: document.getElementById("yearFormat").value,
            includeYear: document.getElementById("includeYear").checked,
            position: document.getElementById("position").value,
            startFrom: document.getElementById("startFrom").value,
            length: document.getElementById("length").value,
            resetYearly: document.getElementById("resetYearly").checked,
            selectedYear: document.getElementById("selectedYear").value
        }));

        updatePreview();
    }

    // ✅ LOAD SETTINGS (FIXED)
    window.addEventListener("load", function () {

        let saved = JSON.parse(localStorage.getItem("numberSettings")) || {};

        document.getElementById("prefix").value = saved.prefix || "TI";
        document.getElementById("yearType").value = saved.yearType || "CY";
        document.getElementById("yearFormat").value = saved.yearFormat || "4";
        document.getElementById("includeYear").checked = saved.includeYear ?? true;
        document.getElementById("position").value = saved.position || "prefix";
        document.getElementById("startFrom").value = saved.startFrom || "1";
        document.getElementById("length").value = saved.length || "12";
        document.getElementById("resetYearly").checked = saved.resetYearly || false;
        document.getElementById("selectedYear").value =
            saved.selectedYear || new Date().getFullYear();

        updatePreview();

        // ✅ LIVE PREVIEW (FIXED PROPERLY)
        document.querySelectorAll("#prefix, #startFrom, #includeYear, #selectedYear, #yearFormat, #position, #length, #resetYearly, #yearType")
            .forEach(el => {
                el.addEventListener("input", updatePreview);
                el.addEventListener("change", updatePreview);
            });
    });
</script>-->



