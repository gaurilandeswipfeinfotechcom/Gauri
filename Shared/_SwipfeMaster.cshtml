    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const allToggles = document.querySelectorAll('[data-target]');

            allToggles.forEach(toggle => {
                toggle.addEventListener('click', function (e) {
                    const targetId = this.getAttribute('data-target');
                    const targetElement = document.getElementById(targetId);

                    // If it's a sub-collapse (nested), don't close parent dropdowns
                    const isSub = this.classList.contains('nav-sublink');

                    // Close unrelated collapses
                    document.querySelectorAll('.collapse').forEach(el => {
                        if (el.id !== targetId && (!isSub || el.classList.contains('sub-collapse'))) {
                            el.classList.remove('show');
                        }
                    });

                    // Toggle the current one
                    if (targetElement) {
                        targetElement.classList.toggle('show');
                    }
                });
            });
        });
    </script>

