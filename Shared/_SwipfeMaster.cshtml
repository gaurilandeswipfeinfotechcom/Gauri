        /* Slider */
        .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #ccc;
            border-radius: 34px;
            transition: 0.4s;
        }

            /* Sliding circle */
            .slider:before {
                content: "";
                position: absolute;
                height: 22px;
                width: 22px;
                left: 3px;
                bottom: 3px;
                background-color: white;
                border-radius: 50%;
                transition: 0.4s;
            }

        /* When checked → turn ON (blue) */
        input:checked + .slider {
            background-color: #2196F3;
        }

            /* Move the white circle to right */
            input:checked + .slider:before {
                transform: translateX(26px);
            }

