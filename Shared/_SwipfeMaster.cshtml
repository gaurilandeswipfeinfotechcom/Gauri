    <script>
        let bounceInterval;

        function startTextAnimation() {
            const letters = $(".text-loader span");
            let i = 0;

            clearInterval(bounceInterval);

            bounceInterval = setInterval(function () {
                letters.css("transform", "translateY(0)");
                $(letters[i]).css("transform", "translateY(-12px)");
                i = (i + 1) % letters.length;
            }, 120);
        }

        function stopTextAnimation() {
            clearInterval(bounceInterval);
            $(".text-loader span").css("transform", "translateY(0)");
        }

        function showLoader() {
            if ($("#globalLoader").is(":visible")) return;

            $("#globalLoader").show();
            startTextAnimation();
        }

        function hideLoader() {
            $("#globalLoader").hide();
            stopTextAnimation();
        }

        // AJAX only
        $(document).ajaxStart(function () {
            showLoader();
        });

        $(document).ajaxStop(function () {
            hideLoader();
        });

        $(document).ajaxError(function () {
            hideLoader();
        });

        // Show when leaving current page
        window.addEventListener("beforeunload", function () {
            showLoader();
        });

        // Hide immediately when new page is ready
        $(document).ready(function () {
            hideLoader();
        });

        $(window).on("load", function () {
            hideLoader();
        });
    </script>
