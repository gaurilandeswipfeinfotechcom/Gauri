    document.addEventListener("DOMContentLoaded", function () {
        const department = "@Session["Department"]";  // Getting the department from the session

        // Variable to store the home page URL
        let homeUrl = "/";  // Default fallback

        // Switch-case to assign the appropriate home URL based on the department
        switch (department.toLowerCase()) {
            case "accountant":
                homeUrl = "/AccountInfo/Index";  // Account page URL for Accountant
                break;
            case "admin":
                homeUrl = "/Dashboard/AdminDashboard";  // Admin page URL for Admin
                break;
            case "software":
                homeUrl = "/SalesDashboard/Dashboard";  // Software page URL for Software
                break;
            case "assembly":
                homeUrl = "/Dashboard/InventoryDashboard";  // Assembly page URL for Assembly
                break;
            case "production":
                homeUrl = "/Dashboard/ProductionDashboard";  // Production page URL for Production
                break;
            case "sales":
                homeUrl = "/SalesDashboard/Dashboard";  // Sales page URL for Sales
                break;
            case "purchase":
                homeUrl = "/PurchaseDashboard/Dashboard";  // Purchase page URL for Purchase
                break;
            case "store":
                homeUrl = "/Dashboard/InventoryDashboard";  // Store page URL for Purchase
                break;
            default:
                homeUrl = "/SwipfeHome/Index";  // Fallback URL if no department matches
        }

        // Add event listener to the home button
        const homeBtn = document.getElementById("homeBtn");
        if (homeBtn) {
            homeBtn.addEventListener("click", function () {
                window.location.href = homeUrl;  // Redirect to the department-specific home page
            });
        }
    });
    </script>


