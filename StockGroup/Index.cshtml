<script type="text/javascript">

    $(window).load(function () {

        var b = '@Session["LoginUserId"]';
        //var b = 9;
        $.ajax({
            url: '@Url.Action("GetInfo")',
            data: { "userId": b },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {

                if (data.length > 0) {

                    for (var i = 0; i < data.length; i++) {

                        if (data[i].FormName == "StockGroup") {

                        if (data[i].Create == "Y") {


                            $('#CreateStockGroup').show();
                        }
                        else {

                            $('#CreateStockGroup').hide();

                        }
                   }

                }

                }

            }
        });
    });


    function searchSGroupName(id) {
        var txt = document.getElementById(id);
        //txt.value = txt.value.replace(/\w\S*/g, function (txt) { return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase(); });

        // var txt = document.getElementById(id);
        //alert("hi");
        $.ajax({
            url: '/StockGroup/AutocompleteStockGroup/',
            data: { "searchByText": txt.value, "sortBy": $('#SortByColumnName').val() },
            type: "POST",
            dataType: "json",

            success: function (data) {
                $('#json-datalistSGroupName').empty();
                var jsonOptions = data;
                var dataList = document.getElementById('json-datalistSGroupName');

                jsonOptions.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = item;
                    dataList.appendChild(option);
                });
            },
            error: function (xhr, status, error) {
                alert(xhr.responseText);
            }
        });
    } //end of searchSalesOrderNo

    function validate() {
        if ($('#SearchByText').val() != "") {
            $('#SortByColumnName').val('SGroupName');

        }
        else if ($('#SortByColumnName').val() != "SGroupName") {
            $('#SearchSGroupName').val('');
        }
    }
    function funPageNoClicked(requestedPgNo) {
        $("#isPageNavigationRequested").val("true");
        $("#RequestedPageNumber").val(requestedPgNo);
        event.preventDefault();
        $("#StockGroup_List").submit();
    }
    $(function () {
        $("#Search").click(function () {
            $("#isPageNavigationRequested").val("false");
        });
    });
</script>

<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

<style>
    #label {
        font-size: 15px;
        color: #0077B3;
        font-weight: 500
    }

    .table tr {
        border: 2px solid #fff;
        background-color: #e5e6eb
    }

    .panel .panel-body .table tr td {
        background-color: #e5e6eb;
        border-right: 2px solid #fff;
        border-top: 5px solid #fff;
    }

    .panel .panel-body .table tr th {
        border-bottom: 5px solid #fff;
    }

    table td {
        font-size: 13px;
    }

    .panel .panel-body .table tr td:hover {
        background-color: floralwhite
    }

    td span {
        border: none;
        background: none;
        color: blue;
        font-size: 15px;
    }

        td span i:hover {
            transform: scale(1.3);
            color: Highlight;
        }


    td .glyphicon-edit {
        color: green;
    }

    td .glyphicon-list {
        color: blue;
        padding: 0px 4px;
    }
    td .glyphicon-trash {
        color: red;
        padding: 0px 4px;
    }

    .table tr th {
        text-align: center;
        background-color: lightblue;
        font-family: Helvetica, sans-serif;
        color: midnightblue;
    }

    td .glyphicon-print {
        color: blueviolet;
    }

    .pageno-btn {
        background-image: linear-gradient(to right,#35d3e1,midnightblue);
        outline-style: none;
        border: none;
        padding: 5px 10px 5px 10px;
        color: #fff;
        font-family: helvetica;
        text-decoration: none;
        border-radius: 4px
    }

    .page td a {
        font-size: 12px;
    }

    .route-path1 {
        cursor: pointer;
        clip-path: polygon(0% 0%, 90% 0%, 100% 50%, 90% 100%, 0% 100%);
        background-color: #003399;
        color: white;
        padding: 5px 15px 5px 5px
    }

    .route-path2 {
        cursor: pointer;
        color: white;
        clip-path: polygon(95% 0%, 100% 50%, 95% 100%, 0% 100%, 5% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
