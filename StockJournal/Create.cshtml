                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

     }


<script>
            $(document).ready(function () {
                $("#InItem, #OutItem").on("change", function () {
                    var inItemValue = $("#InItem").val();
                    var outItemValue = $("#OutItem").val();

                    if (inItemValue === outItemValue) {
                        alert("The MainItem and SubItem cannot be the same. Please select different values.");
                        // Reset the selection to "Please Select" or some other default value.
                        $("#InItem").val("Please Select");
                        $("#OutItem").val("Please Select");
                    }
                });
            });

              
</script>

<script>
            $(document).ready(function () {
                var isEditing = false;
                var editedRow = null;
                var itemIdToNameMapping = {}; // Mapping of itemId to itemName

                updateTotalAmount();
                updateTotalAmount2();

                $("#InItemType").val("Inward");
                $("#OutItemType").val("Outward");

                $("#addItemButton1").click(function () {
                    var itemId = $("#InItem").val();
                    var itemName = $("#InItem option:selected").text();

                    if (itemId === "") {
                        alert("Please select an item first.");
                        return;
                    }

                    var quantity = $("#InQuantity").val().trim();

                    if (quantity === "") {
                        alert("Quantity is required. Please fill it.");
                        return;
                    }

                    if (isEditing) {
                        isEditing = false;
                        $("#message").text("Please finish editing before adding a new item.");
                        return false;
                    }

                    var itemCode = $("#InItemCode").val();
                    var quantity = $("#InQuantity").val();
                    var rate = $("#InRate").val();

                    console.log("Rate of item " + rate);
                    //var amount = $("#InAmount").val();

                    var amount = quantity * rate;
                    var godownSub = $("#InGodown").val();
                    var inItemType = $("#InItemType").val();

                    var newRow = $("<tr>");
                    newRow.append("<td style='font-size:small'>" + itemName + "</td>");
                    newRow.append("<td style='font-size:small'>" + itemCode + "</td>");
                    newRow.append("<td style='text-align:center;font-size:small'>" + godownSub + "</td>");
                    newRow.append("<td style='text-align:center;font-size:small'>" + quantity + "</td>");
                    newRow.append("<td style='text-align:right;font-size:small'>" + rate + "</td>");
                    newRow.append("<td style='text-align:right;font-size:small'>" + amount + "</td>");
                    newRow.append("<td style='text-align:center;font-size:small'>" + inItemType + "</td>");

                    newRow.append("<td style='text-align:center'><i class='material-icons editItem'>edit_note<i> <i class='material-icons removeItem text-danger'>close<i></td>");

                    newRow.append("<input type='hidden' name='StockJournalNo' value='" + $("#StockJournalNo").val() + "' />");

                    if (editedRow !== null) {
                        editedRow.replaceWith(newRow);
                        editedRow = null;
                    } else {
                        $("#itemTable1 tbody").append(newRow);
                    }

                    itemIdToNameMapping[itemId] = itemName;
                    updateTotalAmount();
                    $("#InItem").val('');
                    $("#InQuantity").val('1');
                    $("#InItemCode").val('');
                    $("#InGodown").val('');
                    $("#InRate").val('');
                    $("#InAmount").val('');
                    $("#InItemType").val('Inward');

                    isEditing = false;
                });

                $("#addItemButton2").click(function () {
                    var itemId = $("#OutItem").val();
                    var itemName = $("#OutItem option:selected").text();

                    if (itemId === "") {
                        alert("Please select an item first.");
                        return;
                    }

                    var quantity = $("#OutQuantity").val().trim();

                    if (quantity === "") {
                        alert("Quantity is required. Please fill it.");
                        return;
                    }

                    if (isEditing) {
                        isEditing = false;
                        $("#message").text("Please finish editing before adding a new item.");
                        return false;
                    }

                    var itemCode = $("#OutItemCode").val();
                    var quantity = $("#OutQuantity").val();
                    var rate = $("#OutRate").val();
                    var amount = $("#OutAmount").val();
                    var godownSub = $("#OutGodown").val();
                    var outItemType = $("#OutItemType").val();

                    var newRow = $("<tr>");
                    newRow.append("<td style='font-size:small'>" + itemName + "</td>");
                    newRow.append("<td style='font-size:small'>" + itemCode + "</td>");
                    newRow.append("<td style='text-align:center;font-size:small'>" + godownSub + "</td>");
                    newRow.append("<td style='text-align:center;font-size:small'>" + quantity + "</td>");
                    newRow.append("<td style='text-align:right;font-size:small'>" + rate + "</td>");
                    newRow.append("<td style='text-align:right;font-size:small'>" + amount + "</td>");
                    newRow.append("<td style='text-align:center;font-size:small'>" + outItemType + "</td>");

                    newRow.append("<td style='text-align:center'><i class='material-icons editItem'>edit_note<i> <i class='material-icons removeItem text-danger'>close<i></td>");

                    newRow.append("<input type='hidden' name='StockJournalNo' value='" + $("#StockJournalNo").val() + "' />");

                    if (editedRow !== null) {
                        editedRow.replaceWith(newRow);
                        editedRow = null;
                    } else {
                        $("#itemTable2 tbody").append(newRow);
                    }

                    itemIdToNameMapping[itemId] = itemName;
                    updateTotalAmount2();
                    $("#OutItem").val('');
                    $("#OutQuantity").val('1');
                    $("#OutItemCode").val('');
                    $("#OutGodown").val('');
                    $("#OutRate").val('');
                    $("#OutAmount").val('');
                    $("#OutItemType").val('Outward');
                    isEditing = false;
                });

                $("#itemTable1").on("click", ".editItem", function () {
                    var row = $(this).closest("tr");
                    var cells = row.find("td");

                    var itemName = cells.eq(0).text();
                    var itemId = getSelectedItemId(itemName);

                    $("#InItem option").filter(function () {
                        return $(this).text() === itemName;
                    }).prop("selected", true);

                    $("#InItemCode").val(cells.eq(1).text());
                    $("#InGodown").val(cells.eq(2).text());
                    $("#InQuantity").val(cells.eq(3).text());
                    $("#InRate").val(cells.eq(4).text());
                    $("#InAmount").val(cells.eq(5).text());

                    editedRow = row;
                    isEditing = true;
                    updateTotalAmount();
                    return false;
                });
                $("#itemTable2").on("click", ".editItem", function () {
                    var row = $(this).closest("tr");
                    var cells = row.find("td");

                    var itemName = cells.eq(0).text();
                    var itemId = getSelectedItemId(itemName);

                    $("#OutItem option").filter(function () {
                        return $(this).text() === itemName;
                    }).prop("selected", true);

                    $("#OutItemCode").val(cells.eq(1).text());
                    $("#OutGodown").val(cells.eq(2).text());
                    $("#OutQuantity").val(cells.eq(3).text());
                    $("#OutRate").val(cells.eq(4).text());
                    $("#OutAmount").val(cells.eq(5).text());

                    editedRow = row;
                    isEditing = true;
                    updateTotalAmount2();
                    return false;
                });

                $("#itemTable1").on("click", ".removeItem", function () {
                    var row = $(this).closest("tr");
                    row.remove();
                    updateTotalAmount();
                    return false;
                });
                $("#itemTable2").on("click", ".removeItem", function () {
                    var row = $(this).closest("tr");
                    row.remove();
                    updateTotalAmount2();
                    return false;
                });

                $('#bomForm').submit(function (event) {
                    event.preventDefault();

                    // Assume createFunction returns a Promise
                    createFunction().then(function () {
                        console.log("createFunction completed successfully.");
                        SaveItemDetails("#itemTable1");
                        SaveItemDetails("#itemTable2");
                    });
                });

 function createFunction() {

    var formData = $('#bomForm').serialize();

    $.ajax({
        url: '@Url.Action("Create", "StockJournal")',
        type: 'POST',
        data: formData,
        success: function (data) {

            if (data.success) {

                alert(data.message);

                // If Inward table has rows
                if ($("#itemTable1 tbody tr").length > 0) {
                    SaveItemDetails("#itemTable1", "Inward");
                }

                // If Outward table has rows
                if ($("#itemTable2 tbody tr").length > 0) {
                    SaveItemDetails("#itemTable2", "Outward");
                }

            } else {
                alert(data.message);
            }
        }
    });
}


function SaveItemDetails(tableId, type) {

    var tableData = [];
    var stockJournalNo = $("#StockJournalNo").val();
    var stockJournalDate = $("#StockJournalDate").val(); // Get date

    $(tableId + " tbody tr").each(function () {

        var row = $(this);

        var itemName = row.find("td:eq(0)").text().trim();
        var itemId = getSelectedItemId(itemName);
        var godownName = row.find("td:eq(2)").text().trim();
        var quantity = parseFloat(row.find("td:eq(3)").text().trim()) || 0;
        var rate = parseFloat(row.find("td:eq(4)").text().trim()) || 0;
        var amount = parseFloat(row.find("td:eq(5)").text().trim()) || 0;

        var InQty = null;
        var OutQty = null;

        if (type === "Inward") {
            InQty = quantity;
        } else {
            OutQty = quantity;
        }

        tableData.push({
            ItemId: itemId,
            ItemName: itemName,
            GodownName: godownName,
            InQty: InQty,
            OutQty: OutQty,
            RatePerUnit: rate,
            Amount: amount,
            ItemType: type,
            VoucherNo: stockJournalNo,
            VoucherDate: stockJournalDate
        });

    });

    if (tableData.length === 0) return;

    $.ajax({
        url: '@Url.Action("SaveStockItems", "StockJournal")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(tableData),
        success: function (response) {
            if (response.success) {
                alert(response.message);
                window.location.href = '@Url.Action("Index", "StockJournal")';
            } else {
                alert(response.message);
            }
        }
    });
}


                function getSelectedItemId(itemName) {
                    for (var itemId in itemIdToNameMapping) {
                        if (itemIdToNameMapping[itemId] === itemName) {
                            return itemId;
                        }
                    }
                    return null;
                }



                function updateTotalAmount() {
                    var totalAmount = 0;

                    $("#itemTable1 tbody tr").each(function () {
                        var row = $(this);
                        var rate = parseFloat(row.find("td:eq(5)").text()); // Assuming the rate is numeric

                        if (!isNaN(rate)) {
                            totalAmount += rate;
                        }
                    });

                    $("#TotInAmount").val(totalAmount.toFixed(2));
                }
                function updateTotalAmount2() {
                    var totalAmount = 0;

                    $("#itemTable2 tbody tr").each(function () {
                        var row = $(this);
                        var rate = parseFloat(row.find("td:eq(5)").text()); // Assuming the rate is numeric

                        if (!isNaN(rate)) {
                            totalAmount += rate;
                        }
                    });

                    $("#TotOutAmount").val(totalAmount.toFixed(2));
                }
            });


            $(document).ready(function () {
                var rateInput = $("#InRate");
                var subQuantityInput = $("#InQuantity");
                var amountInput = $("#InAmount");

                function updateAmount() {
                    var rate = parseFloat(rateInput.val()) || 0;
                    var subQuantity = parseFloat(subQuantityInput.val()) || 0;
                    var amount = rate * subQuantity;
                    amountInput.val(amount.toFixed(2));
                }

                updateAmount();

                rateInput.on("input", updateAmount);
                subQuantityInput.on("input", updateAmount);
            });
            $(document).ready(function () {
                var rateInput = $("#OutRate");
