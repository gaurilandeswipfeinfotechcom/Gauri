                                        @Html.ValidationMessage("Discription", "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-sm-6 col-md-4 col-lg-4 col-xxl-3">
                                        <label id="label">Quantity :</label>
                                        @Html.TextBox("OutQuantity", "1", new
