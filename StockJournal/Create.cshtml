                                    <i class="material-icons">double_arrow</i>
                                    Outward Stock Item
                                </p>
                                <div class="form-group row px-3">
                                    <div class="col-md-12 ">
                                        <label id="label">Item Name :</label>
                                        <div class="form-group row mx-0 pb-5">

                                            @Html.DropDownList("OutItem", (IEnumerable<SelectListItem>)ViewBag.OutItem as SelectList, new
