@model ERPEntities.StockJournal

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}

<html>
<head>

    <script src="http://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
    <script src="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
    <link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

    <link href="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css"
          rel="Stylesheet" type="text/css" />

    <link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

    <script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>

    <style>
        #label {
            font-size: small;
            color: #0077B3;
        }

        h4 {
            font-size: 18px;
            padding: 10px 0;
            font-weight: 600;
        }

        .form-head h4 {
            padding: 10px 10px;
            font-size: 16px;
            font-weight: 600;
            background-color: #C1D5BD;
        }

        label {
            /*color: #3557B0;*/
            color: black;
        }

        .body-panel {
            border: 1px solid black;
            /*background-color: whitesmoke;*/
            margin-top: -10px;
            border-radius: 5px;
            background-color: floralwhite;
        }

        .submit-btn {
            display: inline-flex;
            padding: 7px;
        }

        .save-btn {
            padding-right: 5px;
        }

        .submit-btn button {
            border-radius: 30px;
            padding: 5px 5px;
        }

            .submit-btn button:hover {
                background-color: lightsalmon;
                transform: scale(1.1);
                color: white;
            }

        .save-btn input {
            /*border-radius: 30px;*/
            font-size: 12px;
        }

            .save-btn input:hover {
                background-color: Highlight;
                transform: scale(1.1);
            }

        fieldset {
            border: 1px solid #ddd !important;
            margin: 10px;
            /*max-width:0;*/
            padding: 5px;
            /* position:relative;*/
            padding-left: 10px !important;
            padding-right: 10px !important;
            background-color: whitesmoke;
        }

        legend {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 0px;
            width: 50%;
            /*color: #3557B0;*/
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 3px 5px 3px 20px;
            background-color: lavender;
        }

        span.error {
            display: block;
            visibility: hidden;
            color: red;
            font-size: 50px;
        }


        .tablecontainer table {
            width: 100%;
            border-collapse: collapse;
            border-top: 1px solid #BFAEAE;
            border-right: 1px solid #BFAEAE;
        }

        .tablecontainer th {
            border-bottom: 2px solid #BFAEAE !important;
            background-color: gainsboro;
            font-size: small;
            text-align: center;
            height: 30px;
        }

        .tablecontainer th, .tablecontainer td {
            /*text-align: left;*/
            border-left: 1px solid #BFAEAE;
            padding: 5px;
            border-bottom: 1px solid #BFAEAE;
            font-size: small;
        }

        .ui-widget {
            font-size: 12px !important;
        }

        .reqError {
            color: #ff0000; /*Red Color*/
            font-weight: bold;
            font-size: 16px;
        }
    </style>
</head>
<body>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.StockJournalNo)

        <div class="row ">
            <div class="main-panel col-xs-12 col-sm-12 col-md-12 col-lg-12 ">

                <div class="body-panel">
                    <div class="couriertitle text-center bg-info">
                        <h4>Stock Journal Updatation</h4>
                    </div>
                    <div class="">
                        <fieldset class="">
                            <legend class="">Stock Journal</legend>
                            <div class="form-group row">
                                <div class="col-lg-3">
                                    <label id="label">Stock Journal NO.</label>
                                    @Html.EditorFor(model => model.StockJournalNo, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.StockJournalNo, "", new { @class = "text-danger" })

                                </div>

                                <div class="col-lg-3">
                                    <label id="label">Stock Journal Date</label>
                                    @Html.EditorFor(model => model.StockJournalDate, new { htmlAttributes = new { @readonly = "true", @type = "date", @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.StockJournalDate, "", new { @class = "text-danger" })

                                </div>
                            </div>

                            <fieldset class="">
                                <legend class="">Inward Item Details</legend>



                                <input type="hidden" id="tableData1" name="tableData1" />
                                <table id="itemTable1" class="table table-bordered " style="background-color:cyan">
                                    <thead>
                                        <tr>
                                            <th><b>Item Name</b></th>
                                            <th><b>ItemCode</b></th>
                                            <th><b>Godown</b></th>
                                            <th><b>Quantity</b></th>
                                            <th><b>Rate</b></th>
                                            <th><b>Amount</b></th>
                                            <th><b>ItemType</b></th>

                                        </tr>
                                    </thead>
                                    <tbody style="background-color:lightcyan">
                                        <!-- Table rows will be added dynamically here -->
                                    </tbody>
                                </table>



                                <div class="form-group">
                                    <label id="label">Total In Amount</label>
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.TotInAmount, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control", @id = "TotInAmount" } })
                                        @Html.ValidationMessageFor(model => model.TotInAmount, "", new { @class = "text-danger" })
                                    </div>
                                </div>



                            </fieldset>

                            <fieldset class="">
                                <legend class="">Outward Item Details</legend>
                                <input type="hidden" id="tableData2" name="tableData2" />
                                <table id="itemTable2" class="table table-bordered " style="background-color:cyan">
                                    <thead>
                                        <tr>
                                            <th><b>Item Name</b></th>
                                            <th><b>ItemCode</b></th>
                                            <th><b>Godown</b></th>
                                            <th><b>Quantity</b></th>
                                            <th><b>Rate</b></th>
                                            <th><b>Amount</b></th>
                                            <th><b>ItemType</b></th>

                                        </tr>
                                    </thead>
                                    <tbody style="background-color:lightcyan">
                                        <!-- Table rows will be added dynamically here -->
                                    </tbody>
                                </table>




                                <div class="form-group">
                                    <label id="label">Total Out Amount</label>
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.TotOutAmount, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control", @id = "TotOutAmount" } })
                                        @Html.ValidationMessageFor(model => model.TotOutAmount, "", new { @class = "text-danger" })
                                    </div>
                                </div>


                            </fieldset>

                            <div class="form-group">
                                <label id="label">Remark</label>
                                <div class="col-md-8">

                                    @Html.EditorFor(model => model.Remark, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control mt-4", @style = "height:60px;" } })
                                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })

                                </div>
                            </div>



                        </fieldset>


                        <div class="form-group">
                            <div class="col-md-offset-1">

                                @using (Html.BeginForm())
                                {
                                    @Html.AntiForgeryToken()

                                    <input type="submit" value="Delete" id="deleteButton" class="btn btn-danger" style="border-radius:30px;"/>
                                    <input type="button" onclick="location.href = '@Url.Action("Index")'" value="Back to List" class="btn btn-success" style="border-radius:30px;" />

                                }



                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>



    }
</body>
</html>


<script>
    $(document).ready(function () {
        var isEditing = false;
        var editedRow = null;
        var itemIdToNameMapping = {}; // Mapping of itemId to itemName
        itemIdToNameMapping[item.ItemId] = item.ItemName;
        updateTotalAmount();
        updateTotalAmount2();

        $("#InItemType").val("Inward");
        $("#OutItemType").val("Outward");



function loadData() {
    var stockJournalNo = "@Model.StockJournalNo"; // Get the StockJournalNo from your model

    $.ajax({
        url: '/StockJournal/GetStockJournalItemDetails', // Replace 'YourControllerName' with the actual controller name
        type: 'GET',
        data: { stockJournalNo: stockJournalNo },
        success: function (data) {
            $.each(data.InwardItems, function (index, item) {
                itemIdToNameMapping[item.ItemId] = item.ItemName;
            });

            populateTable(data.InwardItems, "#itemTable1");
            populateTable(data.OutwardItems, "#itemTable2");
        },
        error: function () {
            alert("An error occurred while fetching data.");
        }
    });
}

loadData();

        function populateTable(data, tableId) {
            var table = $(tableId + " tbody");
            table.empty();

            $.each(data, function (index, item) {
                var newRow = $("<tr>");
                newRow.append("<td>" + (item.ItemName || "") + "</td>");
                newRow.append("<td>" + (item.ItemCode || "") + "</td>");
                newRow.append("<td>" + (item.GodownName || "") + "</td>");
                newRow.append("<td>" + (item.Quantity || 0) + "</td>");
                newRow.append("<td>" + (item.RatePerUnit || 0) + "</td>");
                newRow.append("<td>" + (item.Amount || 0) + "</td>");
                newRow.append("<td>" + (item.ItemType || "") + "</td>");

                newRow.append("<input type='hidden' name='ItemId' value='" + (item.ItemId || "") + "' />");
                newRow.append("<input type='hidden' name='StockJournalNo' value='" + ($("#StockJournalNo").val() || "") + "' />");

                table.append(newRow);

                // Store the mapping of itemId to itemName
                if (item.ItemId && item.ItemName) {
                    itemIdToNameMapping[item.ItemId] = item.ItemName;
                }

                updateTotalAmount();
                updateTotalAmount2();
            });
        }


        function updateItemNamesToIds() {
            // Convert all item names to item IDs and update the mapping for InwardItems
            $("#itemTable1 tbody tr").each(function () {
                var row = $(this);
                var itemName = row.find("td:eq(0)").text();
                var itemId = getSelectedItemId(itemName); // Get the ItemId for the ItemName

                // Update the input field with the corresponding item ID
                row.find("input[name='ItemId']").val(itemId);

                // Update the mapping
                itemIdToNameMapping[itemId] = itemName;
            });

            // Repeat the same for the second table (#itemTable2) for OutwardItems
            $("#itemTable2 tbody tr").each(function () {
                var row = $(this);
                var itemName = row.find("td:eq(0)").text();
                var itemId = getSelectedItemId(itemName);

                row.find("input[name='ItemId']").val(itemId);
                itemIdToNameMapping[itemId] = itemName;
            });
        }









        function getSelectedItemId(itemName) {
            for (var itemId in itemIdToNameMapping) {
                if (itemIdToNameMapping[itemId] === itemName) {
                    return itemId;
                }
            }
            return null;
        }



        function updateTotalAmount() {
            var totalAmount = 0;

            $("#itemTable1 tbody tr").each(function () {
                var row = $(this);
                var rate = parseFloat(row.find("td:eq(5)").text()); // Assuming the rate is numeric

                if (!isNaN(rate)) {
                    totalAmount += rate;
                }
            });

            $("#TotInAmount").val(totalAmount);
        }
        function updateTotalAmount2() {
            var totalAmount = 0;

            $("#itemTable2 tbody tr").each(function () {
                var row = $(this);
                var rate = parseFloat(row.find("td:eq(5)").text()); // Assuming the rate is numeric

                if (!isNaN(rate)) {
                    totalAmount += rate;
                }
            });

            $("#TotOutAmount").val(totalAmount);
        }



    });


</script>

<script>
    $(document).ready(function () {
        // Attach a click event handler to the delete button
        $("#deleteButton").click(function (e) {
            e.preventDefault(); // Prevent the default form submission

            // Display a confirmation dialog
            var confirmDelete = confirm("Are you sure you want to delete this Stock Journal?");

            if (confirmDelete) {
                // If the user confirms, submit the form
                $("form").submit();
            }
            // If the user cancels, do nothing
        });
    });
</script>
