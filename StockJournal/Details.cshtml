function loadData() {
    var stockJournalNo = "@Model.StockJournalNo"; // Get the StockJournalNo from your model
    var userHasEditPermission = false;

    $.ajax({
        url: '/StockJournal/GetStockJournalItemDetails', // Replace 'YourControllerName' with the actual controller name
        type: 'GET',
        data: { stockJournalNo: stockJournalNo },
        success: function (data) {
            $.each(data.InwardItems, function (index, item) {
                itemIdToNameMapping[item.ItemId] = item.ItemName;
            });

            // Fetch user access information
            //var b = 5; // Assuming this is the user's ID
            var b = '@Session["LoginUserId"]';
            $.ajax({
                url: '@Url.Action("GetInfo")',
                data: { "userId": b },
                type: "POST",
                dataType: "json",
                async: false,
                success: function (value) {
                    if (value.length > 0) {
                        for (var i = 0; i < value.length; i++) {
                            if (value[i].FormName == "StockJournal") {
                                if (value[i].Edit == "Y") {
                                    userHasEditPermission = true;
                                    $("#InwardRate, #OutwardRate, #InwardAmount, #OutwardAmount").css("display", "table-cell");
                                } else {
                                    userHasEditPermission = false;
                                    $("#InwardRate, #OutwardRate, #InwardAmount, #OutwardAmount").css("display", "none");
                                }
                                break;
                            }
                        }
                    }
                },
                error: function () {
                    alert("An error occurred while fetching user permissions.");
                }
            });

            populateTable(data.InwardItems, "#itemTable1", userHasEditPermission);
            populateTable(data.OutwardItems, "#itemTable2", userHasEditPermission);
        },
        error: function () {
            alert("An error occurred while fetching data.");
        }
    });
}


//loadData();

loadData();

        function populateTable(data, tableId, userHasEditPermission) {
            var table = $(tableId + " tbody");
            table.empty();

            $.each(data, function (index, item) {

                var quantity = 0;

                // Decide which quantity to show
                if (tableId === "#itemTable1") {
                    quantity = item.InQty || 0;
                } else if (tableId === "#itemTable2") {
                    quantity = item.OutQty || 0;
                }

                var newRow = $("<tr>");
                newRow.append("<td style='font-size:small'>" + (item.ItemName || "") + "</td>");
                newRow.append("<td style='font-size:small'>" + (item.ItemCode || "") + "</td>");
                newRow.append("<td style='font-size:small;text-align:center'>" + (item.GodownName || "") + "</td>");
                newRow.append("<td style='font-size:small;text-align:center'>" + (quantity) + "</td>");

                if (userHasEditPermission) {

                    $("#InwardRate, #OutwardRate, #InwardAmount, #OutwardAmount").css("display", "table-cell");
                    newRow.append("<td class='RateData' style='font-size:small;text-align:right'>" + (item.RatePerUnit || "") + "</td>");
                    newRow.append("<td class='AmountData' style='font-size:small;text-align:right'>" + (item.Amount || "") + "</td>");
                } else {

                    $("#InwardRate, #OutwardRate, #InwardAmount, #OutwardAmount").css("display", "none");
                    newRow.append("<td class='RateData' style='display:none;'>" + "" + "</td>");
                    newRow.append("<td class='AmountData' style='display:none;'>" + "" + "</td>");
                }

                newRow.append("<td style='font-size:small;text-align:center'>" + (item.ItemType || "") + "</td>");

                newRow.append("<input type='hidden' name='ItemId' value='" + (item.ItemId || "") + "' />");
                newRow.append("<input type='hidden' name='StockJournalNo' value='" + ($("#StockJournalNo").val() || "") + "' />");

                table.append(newRow);

                // Store the mapping of itemId to itemName
                if (item.ItemId && item.ItemName) {
                    itemIdToNameMapping[item.ItemId] = item.ItemName;
                }
            });

            //updateTotalAmount(/*tableId*/);
        }

