        background-color: lightblue;
        font-size: small;
        font-weight: normal;
        color: midnightblue;
        text-align: center;
        height: 30px;
    }

    .tablecontainer .table thead th {
        /*text-align: left;*/
        border-left: 2px solid #fff;
        padding: 5px;
        border-bottom: 2px solid #fff;
        font-size: small;
    }

    .tablecontainer .table tbody td {
        /*text-align: left;*/
        border-left: 2px solid #fff;
        padding: 5px;
