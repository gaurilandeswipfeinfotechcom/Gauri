<script>
    $(document).ready(function () {
        $("#InItem, #OutItem").on("change", function () {
            var inItemValue = $("#InItem").val();
            var outItemValue = $("#OutItem").val();

            if (inItemValue === outItemValue) {
                alert("The MainItem and SubItem cannot be the same. Please select different values.");
                // Reset the selection to "Please Select" or some other default value.
                $("#InItem").val("Please Select");
                $("#OutItem").val("Please Select");
            }
        });
    });
</script>




<script>
    $(document).ready(function () {
        var isEditing = false;
        var editedRow = null;
        var itemIdToNameMapping = {}; // Mapping of itemId to itemName
        itemIdToNameMapping[item.ItemId] = item.ItemName;
        updateTotalAmount();
        updateTotalAmount2();

        $("#InItemType").val("Inward");
        $("#OutItemType").val("Outward");



function loadData() {
    var stockJournalNo = "@Model.StockJournalNo"; // Get the StockJournalNo from your model

    $.ajax({
        url: '/StockJournal/GetStockJournalItemDetails', // Replace 'YourControllerName' with the actual controller name
        type: 'GET',
        data: { stockJournalNo: stockJournalNo },
        success: function (data) {
            $.each(data.InwardItems, function (index, item) {
                 itemIdToNameMapping[item.ItemId] = item.ItemName;
            });

                populateTable(data.InwardItems, "#itemTable1");
                populateTable(data.OutwardItems, "#itemTable2");
        },
        error: function () {
                alert("An error occurred while fetching data.");
        }
    });
}

loadData();

         function populateTable(data, tableId) {
            var table = $(tableId + " tbody");
            table.empty();

             $.each(data, function (index, item) {

                 var quantity = 0;

                 // Decide which quantity to show
                 if (tableId === "#itemTable1") {
                     quantity = item.InQty || 0;
                 } else if (tableId === "#itemTable2") {
                     quantity = item.OutQty || 0;
                 }

                var newRow = $("<tr>");
                newRow.append("<td style='font-size:small'>" + (item.ItemName || "") + "</td>");
                newRow.append("<td style='font-size:small'>" + (item.ItemCode || "") + "</td>");
                newRow.append("<td style='text-align:center;font-size:small'>" + (item.GodownName || "") + "</td>");
                 newRow.append("<td style='text-align:center;font-size:small'>" + quantity + "</td>");
                newRow.append("<td style='text-align:right;font-size:small'>" + (item.RatePerUnit || 0) + "</td>");
                newRow.append("<td style='text-align:right;font-size:small'>" + (item.Amount || 0) + "</td>");
                newRow.append("<td style='text-align:center;font-size:small'>" + (item.ItemType || "") + "</td>");
                newRow.append("<td style='text-align:center'><i class='material-icons editItem'>edit_note<i>  <i class='material-icons removeItem text-danger'>close<i></td>");

                newRow.append("<input type='hidden' name='ItemId' value='" + (item.ItemId || "") + "' />");
                newRow.append("<input type='hidden' name='StockJournalNo' value='" + ($("#StockJournalNo").val() || "") + "' />");

                table.append(newRow);

                // Store the mapping of itemId to itemName
                if (item.ItemId && item.ItemName) {
                    itemIdToNameMapping[item.ItemId] = item.ItemName;
                }

                updateTotalAmount();
                updateTotalAmount2();
            });
        }


        $("#addItemButton1").click(function () {
              var itemId = $("#InItem").val();
              var itemName = $("#InItem option:selected").text();

              if (itemId === "") {
                  alert("Please select an item first.");
                  return;
              }

              var quantity = $("#InQuantity").val().trim();

              if (quantity === "") {
                  alert("Quantity is required. Please fill it.");
                  return;
              }

              if (isEditing) {
                  isEditing = false;
              $("#message").text("Please finish editing before adding a new item.");
