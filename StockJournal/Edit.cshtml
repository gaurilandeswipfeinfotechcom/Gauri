    $('#bomForm').submit(function (event) {
        event.preventDefault();

        if (window.formSubmitted) return; // prevent multiple submissions
        window.formSubmitted = true;

        // Update ItemIds before saving
        updateItemNamesToIds();

        var stockJournalNo = $("#StockJournalNo").val();

        // Step 1: Delete existing items
        $.ajax({
            url: '@Url.Action("DeleteSJItems", "StockJournal")',
            type: 'POST',
            data: { StockJournalNo: stockJournalNo },
            success: function () {
                console.log("Existing BOMSubItems deleted.");

                // Step 2: Create/Update StockJournal
                createStockJournal().then(function () {
                    console.log("StockJournal updated.");

                    // If Inward table has rows
                    if ($("#itemTable1 tbody tr").length > 0) {
                        saveItemDetails("#itemTable1", "Inward");
                    }

                    // If Outward table has rows
                    if ($("#itemTable2 tbody tr").length > 0) {
                        saveItemDetails("#itemTable2", "Outward");
                    }


                    //// Step 3: Save item details for both tables sequentially
                    //saveItemDetails("#itemTable1").then(function () {
                    //    return saveItemDetails("#itemTable2");
                    //}).then(function () {
                    //    alert("StockJournal and all items updated successfully.");

                    //    // Refresh index page if needed
                    //    sessionStorage.setItem("refreshIndexPage", "true");

                    //    // Close or redirect
                    //    var referrerUrl = document.referrer;
                    //    window.location.href = referrerUrl;
                    //}).catch(function () {
                    //    alert("An error occurred while saving item details.");
                    //    window.formSubmitted = false; // allow retry
                    //});

                }).catch(function () {
                    alert("An error occurred while updating StockJournal.");
                    window.formSubmitted = false; // allow retry
                });

            },
            error: function () {
                alert("An error occurred while deleting existing BOMSubItems.");
                window.formSubmitted = false; // allow retry
            }
        });
    });

    function createStockJournal() {
        var formData = $('#bomForm').serialize();

        return $.ajax({
            type: 'POST',
            url: '@Url.Action("Edit", "StockJournal")',
            data: formData
        });
    }

     function saveItemDetails(tableId, type) {
        return new Promise(function (resolve, reject) {
            var tableData = [];
            var stockJournalDate = $("#StockJournalDate").val();

            $(tableId + " tbody tr").each(function () {
                var row = $(this);
                var itemName = row.find("td:eq(0)").text();
                var itemId = getSelectedItemId(itemName);

                var quantity = parseFloat(row.find("td:eq(3)").text().trim()) || 0;

                var InQty = null;
                var OutQty = null;

                if (type === "Inward") {
                    InQty = quantity;
                } else {
                    OutQty = quantity;
                }

                var rowData = {
                    ItemId: itemId,
                    ItemName: itemName,
                    ItemCode: row.find("td:eq(1)").text(),
                    GodownName: row.find("td:eq(2)").text(),
                    //Quantity: row.find("td:eq(3)").text(),
                    InQty: InQty,
                    OutQty: OutQty,
                    RatePerUnit: row.find("td:eq(4)").text(),
                    Amount: row.find("td:eq(5)").text(),
                    ItemType: row.find("td:eq(6)").text(),
                    VoucherNo: $("#StockJournalNo").val(),
                    VoucherDate: stockJournalDate
                };

                tableData.push(rowData);
            });

            $.ajax({
                url: '@Url.Action("AddSJSubItems", "StockJournal")',
                type: 'POST',
                data: JSON.stringify(tableData),
                contentType: 'application/json; charset=utf-8',
                success: function () {
                    console.log("Items saved for table: " + tableId);
                    resolve();
                    window.location.href = '@Url.Action("Index", "StockJournal")';
                },
                error: function () {
                    reject();
                }
            });
        });
    }



        function updateItemNamesToIds() {
            // Convert all item names to item IDs and update the mapping for InwardItems
            $("#itemTable1 tbody tr").each(function () {
                var row = $(this);
                var itemName = row.find("td:eq(0)").text();
                var itemId = getSelectedItemId(itemName); // Get the ItemId for the ItemName

                // Update the input field with the corresponding item ID
                row.find("input[name='ItemId']").val(itemId);

                // Update the mapping
                itemIdToNameMapping[itemId] = itemName;
            });

            // Repeat the same for the second table (#itemTable2) for OutwardItems
            $("#itemTable2 tbody tr").each(function () {
                var row = $(this);
                var itemName = row.find("td:eq(0)").text();
                var itemId = getSelectedItemId(itemName);

                row.find("input[name='ItemId']").val(itemId);
                itemIdToNameMapping[itemId] = itemName;
            });
        }


        function getSelectedItemId(itemName) {
            for (var itemId in itemIdToNameMapping) {
               if (itemIdToNameMapping[itemId] === itemName) {
                   return itemId;
               }
           }
           return null;
       }



           function updateTotalAmount() {
               var totalAmount = 0;

            $("#itemTable1 tbody tr").each(function () {
                var row = $(this);
                var rate = parseFloat(row.find("td:eq(5)").text()); // Assuming the rate is numeric

                if (!isNaN(rate)) {
                    totalAmount += rate;
                }
            });

            $("#TotInAmount").val(totalAmount);
        }
        function updateTotalAmount2() {
                                        var totalAmount = 0;

            $("#itemTable2 tbody tr").each(function () {
                var row = $(this);
                var rate = parseFloat(row.find("td:eq(5)").text()); // Assuming the rate is numeric

                if (!isNaN(rate)) {
                    totalAmount += rate;
                }
            });

            $("#TotOutAmount").val(totalAmount);
        }

    });


    $(document).ready(function () {
           var rateInput = $("#InRate");
           var subQuantityInput = $("#InQuantity");
           var amountInput = $("#InAmount");

           function updateAmount() {
               var rate = parseFloat(rateInput.val()) || 0;
               var subQuantity = parseFloat(subQuantityInput.val()) || 0;
               var amount = rate * subQuantity;
               amountInput.val(amount);
           }

           updateAmount();

           rateInput.on("input", updateAmount);
           subQuantityInput.on("input", updateAmount);
    });

    $(document).ready(function () {
