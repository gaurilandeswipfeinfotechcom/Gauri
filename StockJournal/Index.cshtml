<script>
                                $(function () {
                                $("#Search").click(function () {
                                var requestedPageNumber = parseInt($("#Page").val());
                                if (!isNaN(requestedPageNumber) && requestedPageNumber > 0 && requestedPageNumber <= @Model.PageCount) {
                                funPageNoClicked(requestedPageNumber);
                                }
                                });
                                });
</script>
<script>
    $(document).ready(function () {

        /*module button*/
        $.ajax({
            url: '/Settings/GetAllColors',
            type: 'GET',
            success: function (colors) {
                // Example: Apply Inner Button colors
                var bgColor5 = colors.InnerButtonColor; // inner
                var fontColor5 = colors.InnerButtonFontColor; // inner text

                // Example for all preview boxes (optional)
                $('.custo-inner').css('background', bgColor5);//  inner
                $('.custo-inner').css('color', fontColor5);// inner text
            },
            error: function () {
                console.error("Failed to load color settings.");
            }
        });

    });
</script>