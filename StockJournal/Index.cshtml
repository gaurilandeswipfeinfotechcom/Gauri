<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="d-flex" style="margin-top:-20px">
            <h4 class="route-path1">Inventory </h4>
            <h4 class="route-path2 " onclick="location.href='@Url.Action("Index","StockJournal")'">Stock Journal</h4>
        </div>
        <br />

        <div class="panel panel-default outer-main-container">
            <div class="form-group row main-heading">
                <div class="col-sm- col-lg-9 d-flex ">
                    <i class="material-icons" style="font-size: 32px; margin-right: 10px;">warehouse</i>
                    Stock Journal List
                </div>
                <div class="col-sm-4 col-lg-3">
                    <input type="button" id="CreateSalesOrder" value="Create" class="btn btn-success btn-round create-bttn custo-inner"  style="outline: none; margin-left: 75px;" onclick="location.href = '@Url.Action("Create", "StockJournal")'" />
                </div>
            </div>

            <div class="panel-body">
                @Html.TextBox("details", null, new { @onkeyup = "myFunction(this.id)", @class = "form-control", style = "display: none;" })
                @Html.TextBox("Edit", null, new { @onkeyup = "myFunction(this.id)", @class = "form-control", style = "display: none;" })
                @using (Html.BeginForm("Index", "StockJournal", FormMethod.Post, new { id = "StockJournal_Order_List" }))
                {
                    <div class="panel panel-success search-rectangle" style="margin-top:-15px">
                        <div class="panel-body">
                            <div class="form-group row" style="margin-top:-15px">
                                <div class="col-lg-2 col-sm-4 pb-3 pb-sm-0">
                                    <label id="label" class="mt-4">Search By :</label>
                                    <div class="form-group row">
                                        @Html.DropDownListFor(m => m.SortByColumnName, new List<SelectListItem>
                                                                 {
                                                                  new SelectListItem{ Text="Stock Journal No.", Value = "StockJournalNo" },
                                                                  new SelectListItem { Text="Stock Journal Date", Value ="StockJournalDate"},
                                                                    new SelectListItem{ Text="Total In Amount", Value = "TotInAmount" },
                                                                  new SelectListItem { Text="Total Out Amount", Value ="TotOutAmount"},
                                                                   new SelectListItem { Text="Remark", Value ="Remark"},
                                                                 }, new { @class = "form-control fs-4 pl-3 dropdown-textbox", style = "height:35px;margin-top:-2px" })
                                    </div>
                                </div>
                                <div class="col-lg-4 col-sm-8 ">
                                    <label id="label" class="mt-4">Find :</label>
                                    @Html.TextBoxFor(m => m.SearchByText, null, new
                               {
                                   @class = "form-control pl-3 fs-4 input-text-box",
                                   style = "height:35px",
                                   //@placeholder = "Sales Order No",
                                   @oninput = "searchStockJournalNo(this.id)",
                                   @list = "json-datalistStockJournalNo",
                                   autocomplete = "off" // Add this line to disable autocomplete
                               })
                                    <datalist id="json-datalistStockJournalNo"></datalist>
                                </div>
                                <div class="col-lg-4 row ">
                                    <div class="col-sm-4 p-3 pb-4 pb-sm-0">
                                        <label id="label">Sort:</label>
                                        <div class="form-group row mt-2">
                                            @Html.DropDownListFor(m => m.OrderByType, new List<SelectListItem>
                                                                  {
                                                                  //new SelectListItem{ Text="Please Select", Value = "Please Select" },
                                                                  new SelectListItem{ Text="Z-A", Value = "Z-A" },
                                                                  new SelectListItem{ Text="A-Z", Value = "A-Z" },
                                                                  }, new { @class = "form-control fs-4 pl-3 dropdown-textbox", style = "height:35px" })
                                        </div>
                                    </div>

                                    <div class="col-sm-4 p-3">
                                        <label id="label">Records:</label>
                                        @Html.TextBoxFor(m => m.RecordsPerPage, null, new
                                   {
                                       @class = "form-control pl-3 fs-4 input-text-box",
                                       style = "height:35px"
                                   })
                                    </div>
                                    <div class="col-sm-4 pt-md-3 p-3">
                                        <label id="label">Page No. :</label>
                                        @Html.TextBox("Page", null, new
                                   {
                                       @class = "form-control pl-3 fs-4 input-text-box",
                                       style = "height:35px",
                                       @id = "Page"
                                   })
                                    </div>
                                </div>
                                <div class="col-lg-2 align-items-end d-flex">
                                    <button type="submit" id="Search" value="Search" name="Search" style="outline: none" class="mb-4 btn btn-success btn-round search-bttn custo-inner">
                                        Search<i class="material-icons" style="font-size: 20px;padding-left:15px">search</i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-group row my-0 py-0">
                                <div class="col-lg-3 col-sm-6">
                                    <label id="label" >Stock Journal No. : </label>
                                    @Html.CheckBoxFor(m => m.StockJournalNo, true)
                                </div>
                                <div class="col-lg-3 col-sm-6">
                                    <label id="label" >Stock Journal Date : </label>
                                    @Html.CheckBoxFor(m => m.StockJournalDate, true)
                                </div>
                                <div class="col-lg-3 col-sm-6">
                                    <label id="label" >Total In Amount : </label>
                                    @Html.CheckBoxFor(m => m.TotInAmount, true)
                                </div>

                                <div class="col-lg-3 col-sm-6">
                                    <label id="label" >Total Out Amount :</label>
                                    @Html.CheckBoxFor(m => m.TotOutAmount, true)
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="panel panel-success" style="box-shadow:inset 4px 4px 4px gray;border-radius:10px">
                        <div class="panel-body">
                            <div class="table-responsive">
                                <table class="table">
                                    <tr style="font-size: small">
                                        <th width="5%" style="border-right: 2px solid #fff">
                                            No.
                                        </th>

                                        @if (Model.StockJournalNo == true)
                                        {
                                            <th width="14%" style=" border-right: 2px solid #fff">
                                                Stock Journal No.
                                            </th>
                                        }

                                        @if (Model.StockJournalDate == true)
                                        {
                                            <th width="16%" style="border-right: 2px solid #fff">
                                                Stock Journal Date
                                            </th>
                                        }
                                        @*ADDED BY CHANCHAL*@
                                       
                                    <th width="10%" style="border-right: 2px solid #fff">
                                        So. No.
                                    </th>
                                        

                                        @if (Model.TotInAmount == true)
                                        {
                                            <th width="14%" style=" border-right: 2px solid #fff">
                                                Total In Amount
                                            </th>
                                        }
                                        @if (Model.TotOutAmount == true)
                                        {
                                            <th width="15%" style=" border-right: 2px solid #fff">
                                                Total Out Amount
                                            </th>
                                        }
                                        @if (Model.Remark == true)
                                        {
                                            <th width="14%" style=" border-right: 2px solid #fff">
                                                Remark
                                            </th>
                                        }
                                        <th width="14%" style=" border-right: 2px solid #fff">Action</th>
                                    </tr>

                                    @{ int sno = (Model.RequestedPageNumber - 1) * Model.RecordsPerPage + 1;
                                        for (var i = 0; i < Model.StockJournalSearchedList.Count; i++)
                                        {
                                            var item = Model.StockJournalSearchedList[i];

                                                                        <tr>
                                                                            <td class="text-center">
                                                                                @sno
                                                                                @{ sno++; }
                                                                            </td>
                                                                            @if (Model.StockJournalNo == true)

                                                                            {
                                                                                <td class="text-center"> @Html.DisplayFor(modelItem => item.StockJournalNo)</td>
                                                                            }
                                                                            @if (Model.StockJournalDate == true)
                                                                            {
                                                                                <td class="text-center">

                                                                                    @Convert.ToString(string.Format("{0:dd/MM/yyyy HH:mm:ss}", item.StockJournalDate))

                                                                                </td>
                                                                            }
                                                                           

                                                                            
                                                                           <td class="text-center"> @Html.DisplayFor(modelItem => item.RefNo)</td>
                                                                            

                                                                            @if (Model.TotInAmount == true)

                                                                            {
                                                                                <td style="text-align:right"> @Html.DisplayFor(modelItem => item.TotInAmount)</td>
                                                                            }
                                                                            @if (Model.TotOutAmount == true)
                                                                            {
                                                                                <td style="text-align:right">
                                                                                    @Html.DisplayFor(modelItem => item.TotOutAmount)
                                                                                </td>
                                                                            }

                                                                            @if (Model.Remark == true)
                                                                            {
                                                                                <td class="text-center">
                                                                                    @Html.DisplayFor(modelItem => item.Remark)
                                                                                </td>
                                                                            }

                                                                            <td>
                                                                                <div style="text-align:center">



                                                                                    <span><i class="glyphicon glyphicon-edit" style="cursor:pointer" onclick="openEditForm('@Url.Action("Edit","StockJournal", new { sono = item.StockJournalNo })')"></i></span>


                                                                                    <span><i class="glyphicon glyphicon-list" style="cursor:pointer" onclick="location.href='@Url.Action("Details", new { sono = item.StockJournalNo })'"></i></span>

                                                                                    <span><i class="glyphicon glyphicon-trash text-danger" style="cursor:pointer" onclick="openDeleteForm('@Url.Action("Delete","StockJournal", new { sono = item.StockJournalNo })')"></i></span>

                                                                                </div>
                                                                            </td>

                                                                        </tr>

                                        }
                                    }
                                </table>
                            </div>
                        </div>
                    </div>
                    <button id="goBackButton" class="btn btn-success custo-inner  back-arrow-bttn" style="display:none">
                        <i class="material-icons" style="font-size: 20px;padding-right:15px">arrow_back</i>Back
                    </button>


                    <div class="table-responsive p-2">
                        <table align="center">
                            <tr class="page">
                                @if (Model.PageCount > 1)
                                {
                                    @Html.HiddenFor(m => m.PageCount)
                                    <td>
                                        @if (Model.RequestedPageNumber > 1)
                                        {
                                            <a id="FirstPage" href="#" class="btn btn-info custo-inner pageno-btn" style="border:none;margin-right:5px;box-shadow:none" onclick='funPageNoClicked(1);'>First</a>
                                        }
                                    </td>

                                    <td>
                                        @if (Model.RequestedPageNumber > 1)
                                        {
                                            <a id="PreviousPage" href="#" class="btn btn-info custo-inner pageno-btn" style="border:none;margin-right:10px;box-shadow:none" onclick='funPageNoClicked(@Model.RequestedPageNumber - 1);'><b><</b></a>
                                        }
                                    </td>

                                    {
                                        int startPage;
                                        int endPage;

                                        if (Model.PageCount <= 10)
                                        {
                                            startPage = 1;
                                            endPage = Model.PageCount;
                                        }
                                        else
                                        {
                                            if (Model.RequestedPageNumber <= 6)
                                            {
                                                startPage = 1;
                                                endPage = 10;
                                            }
                                            else if (Model.RequestedPageNumber >= Model.PageCount - 4)
                                            {
                                                startPage = Model.PageCount - 9;
                                                endPage = Model.PageCount;
                                            }
                                            else
                                            {
                                                startPage = Model.RequestedPageNumber - 5;
                                                endPage = Model.RequestedPageNumber + 4;
                                            }
                                        }

                                        for (int pgno = startPage; pgno <= endPage; pgno++)
                                        {
                                            <td>
                                                <a id="PageNo" href="#" class="btn btn-secondary btn-round @(pgno == Model.RequestedPageNumber ? "active" : "")" onclick='funPageNoClicked(@pgno);'>@pgno.ToString()</a>
                                            </td>
                                        }
                                    }

                                    <td>
                                        @if (Model.RequestedPageNumber < Model.PageCount)
                                        {
                                            <a id="NextPage" href="#" class="btn btn-info custo-inner pageno-btn" style="border:none;margin-left:10px;box-shadow:none" onclick='funPageNoClicked(@Model.RequestedPageNumber + 1);'><b>></b></a>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.RequestedPageNumber < Model.PageCount)
                                        {
                                            <a id="LastPage" href="#" class="btn btn-info custo-inner pageno-btn" style="border:none;margin-left:5px;box-shadow:none" onclick='funPageNoClicked(@Model.PageCount);'>Last</a>
                                        }
                                    </td>
                                }
                                @Html.HiddenFor(x => x.isPageNavigationRequested)
                                @Html.HiddenFor(x => x.RequestedPageNumber)
                            </tr>
                        </table>
                    </div>

                    @*<div>

                <table>
                    <tr>
                        @if (Model.PageCount > 1)
                        {
                            @Html.HiddenFor(m => m.PageCount)
                            for (int pgno = 1; pgno < 11; pgno++)
                            {
                                <td><a id="PageNo" href="" onclick='javascript:funPageNoClicked(@pgno);'>@pgno.ToString()</a></td>
                            }
                        }
                        @Html.HiddenFor(x => x.isPageNavigationRequested)
                        @Html.HiddenFor(x => x.RequestedPageNumber)
                    </tr>
                </table>
            </div>*@
                    {
                        <div class="pager">
                            @*@Html.PagedListPager(Model, page => Url.Action("Index", new
                    {
                        page,
                        SortBy = ViewBag.SortBy,
                        OrderBy = ViewBag.OrderBy,
                        RecordPerPage = ViewBag.RecordPerPage,
                        SaleOrderDate = ViewBag.SaleOrderDate,

                        PurchaseOrderNo = ViewBag.PurchaseOrderNo,
                        PurchaseOrderDate = ViewBag.PurchaseOrderDate,
                        CompanyName = ViewBag.CompanyName


                    }))Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount*@


                        </div>
                    }
                }


            </div>



        </div>


    </div>
</div>

