$(document).on(
    "click",
    "#btnApplySerials",
    function () {

        console.log("Apply button clicked");
        console.log("currentEditIndex:", window.currentEditIndex);
        console.log("Checked serials:", $(".serial-checkbox:checked").length);


        if (
            window.currentEditIndex === undefined ||
            window.currentEditIndex === null
        ) {

            alert("Please edit an item first.");
            return;

        }


        var item =
            orderItems[window.currentEditIndex];


        if (!item) {

            alert("Item not found.");
            return;

        }


        // =============================================
        // GET CHECKED SERIALS
        // =============================================

        var selectedSerials = [];

        $(".serial-checkbox:checked")
            .each(function () {

                selectedSerials.push(
                    String($(this).val())
                );

            });


        // =============================================
        // VALIDATE QUANTITY
        // =============================================

        var quantity =
            parseInt(item.Quantity) || 0;


        if (
            selectedSerials.length !== quantity
        ) {

            alert(
                "Please select exactly " +
                quantity +
                " serial number(s)."
            );

            return;

        }


        // =============================================
        // SORT + SEQUENCE CHECK (natural order, works for AB1001 style serials)
        // =============================================

        selectedSerials = window.sortSerials(selectedSerials);
        var nonSequential = !window.serialsAreSequential(selectedSerials);


        // =============================================
        // UPDATE ORDER ITEM
        // =============================================

        item.SerialNumbers =
            selectedSerials;

        item.StartSerialNo =
            selectedSerials[0];

        item.EndSerialNo =
            selectedSerials[
                selectedSerials.length - 1
            ];

        item.NonSequential =
            nonSequential;


        // =============================================
        // UPDATE SERIAL NO. BUTTON
        // =============================================

        SetSerialNoText(
            selectedSerials
        );


        // =============================================
        // REFRESH TABLE
        // =============================================

        GeneratedItemsTable();


        // =============================================
        // CLOSE POPUP
        // =============================================

        $("#serialNumbersModal")
            .modal("hide");

    }
);



