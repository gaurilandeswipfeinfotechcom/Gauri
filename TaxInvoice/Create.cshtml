                <div class="modal-header">
                    <button type="button"
                            class="close"
                            data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>

                    <h4 class="modal-title" id="serialNumbersModalLabel">
                        Select Serial Numbers
                    </h4>
                </div>

                <div class="modal-body">

                    <div class="row">
                        <div class="col-md-6">
                            <strong>Item:</strong>
                            <span id="serialModalItemName"></span>
                        </div>

                        <div class="col-md-3">
                            <strong>Required Qty:</strong>
                            <span id="serialModalRequiredQty"></span>
                        </div>

                        <div class="col-md-3">
                            <strong>Selected:</strong>
                            <span id="serialModalSelectedQty">0</span>
                        </div>
                    </div>

                    <hr />

                    <div style="max-height:400px; overflow-y:auto;">
                        <div id="serialCheckboxContainer"
                             class="row">
                        </div>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-default"
                            id="btnSelectAllSerials">
                        Select All
                    </button>

                    <button type="button"
                            class="btn btn-default"
                            id="btnClearSerials">
                        Clear
                    </button>
                    <input type="button" id="btnApplySerials" value="Apply" class="btn btn-success btn-round create-bttn custo-inner" style="outline:none" />
                    @*<button type="button"
                                class="btn btn-primary"
                                id="btnApplySerials">
                            Apply
                        </button>*@

                </div>

            </div>
        </div>
    </div>

</form>

<script>
    $(document).ready(function () {

        /*module button*/
        $.ajax({
            url: '/Settings/GetAllColors',
            type: 'GET',
            success: function (colors) {
                // Example: Apply Inner Button colors
                var bgColor5 = colors.InnerButtonColor; // inner
                var fontColor5 = colors.InnerButtonFontColor; // inner text

                // Example for all preview boxes (optional)
                $('.custo-inner').css('background', bgColor5);//  inner
                $('.custo-inner').css('color', fontColor5);// inner text
            },
            error: function () {
                console.error("Failed to load color settings.");
            }
        });

    });
</script>
<script src="@Url.Content("~/Scripts/serial-modal-extras.js")"></script>
