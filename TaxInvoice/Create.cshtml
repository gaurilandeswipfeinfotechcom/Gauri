function OpenSerialPopupForEdit(item) {

    currentSerialItem = item;
    currentSerialItemIndex = window.currentEditIndex;

    $.ajax({

        url: '@Url.Action("GetCode")',

        data: {
            ItemID: item.ItemID,
            legerid: $('#AddressTitleID').val().trim(),
            SONo: $('#SaleOrderNo').val().trim(),
            TaxInvoiceNo: ($('#TaxInvoiceNo').val() || '').trim()
        },

        type: "POST",
        dataType: "json",

        success: function (data) {

            if (!data || data.length === 0) {

                alert("No serial numbers found.");
                return;
            }

            var vdata = data[0];

            $("#serialModalItemName").text(
                item.ItemName || vdata.ItemName || ""
            );

            //$("#serialModalRequiredQty").text(
            //    item.Quantity || 0
            //);

            var quantity = parseInt($("#Quantity").val()) || 0;

            $("#serialModalRequiredQty").text(quantity);


            var $container =
                $("#serialCheckboxContainer");

            $container.empty();


            // =========================================
            // EXISTING SELECTED SERIALS
            // =========================================

            var selectedSerials = [];

            if (item.SerialNumbers) {

                selectedSerials =
                    item.SerialNumbers.map(function (x) {
                        return String(x);
                    });

            }


            // =========================================
            // AVAILABLE SERIALS
            // =========================================

            var availableSerials = [];

            if (vdata.SerialNumbers) {

                availableSerials =
                    vdata.SerialNumbers.map(function (x) {
                        return String(x);
                    });

            }


            // =========================================
            // KEEP EXISTING SERIALS
            // =========================================

            $.each(selectedSerials, function (i, serial) {

                if (
                    availableSerials.indexOf(serial) === -1
                ) {

                    availableSerials.push(serial);

                }

            });


            // =========================================
            // CREATE CHECKBOXES
            // =========================================

            $.each(
                availableSerials,
                function (i, serial) {

                    var checkboxId =
                        "edit_serial_" + i;

                    var $col = $("<div/>", {

                        "class":
                            "col-md-4 col-sm-6 col-xs-12",

                        "style":
                            "margin-bottom:10px;"

                    });


                    var $label = $("<label/>", {

                        "for": checkboxId,

                        "style":
                            "font-weight:normal; cursor:pointer;"

                    });


                    var $checkbox = $("<input/>", {

                        type: "checkbox",

                        id: checkboxId,

                        value: serial,

                        "class":
                            "serial-checkbox",

                        style:
                            "margin-right:6px;"

                    });


                    // =================================
                    // TICK EXISTING SERIALS
                    // =================================

                    if (
                        selectedSerials.indexOf(serial)
                        !== -1
                    ) {

                        $checkbox.prop(
                            "checked",
                            true
                        );

                    }


                    $label.append($checkbox);

                    $label.append(
                        document.createTextNode(serial)
                    );

                    $col.append($label);

                    $container.append($col);

                }
            );


            updateSelectedSerialCount();

            $("#serialNumbersModal").modal("show");

        },

        error: function () {

            alert("Unable to load serial numbers.");

        }

    });
}


