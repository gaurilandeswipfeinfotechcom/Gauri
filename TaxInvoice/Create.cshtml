   function GetCode(code)
   {
        $.ajax({
            url: '@Url.Action("GetCode")',
            data: { "ItemID": $('#ItemID').val().trim(), "legerid": $('#AddressTitleID').val().trim(), "SONo": $('#SaleOrderNo').val().trim(), "TaxInvoiceNo": ($('#TaxInvoiceNo').val() || '').trim() },
        type: "POST",
        dataType: "json",
        success: function (data) {
        if (data.length > 0) {
            var vdata = data[0];  // <-- IMPORTANT: pick first element
            console.log('serial no list', vdata.SerialNumbers);

            $('#SerialNo').empty().append('<option value="">Select Serial No.</option>');

            if (vdata.SerialNumbers && vdata.SerialNumbers.length > 0) {
                $.each(vdata.SerialNumbers, function (i, val) {
                    $('#SerialNo').append(
                        $('<option/>').val(val).text(val)
                    );
                });
            } else {
                console.warn("No serial numbers found");
            }

            // Optionally, populate ItemCode
            $("#ItemCode").val(vdata.ItemCode);
            $("#ItemCode").attr("disabled", true);
        } else {
            console.warn("No item data returned");
        }
    }
});
