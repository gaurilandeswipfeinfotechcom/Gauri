    function GetCompanyInfo(code) {
    $.ajax({
        url: '@Url.Action("GetCompanyInfo")',
        data: { "LedgerID": code },
        type: "POST",
        dataType: "json",
        async: false,

        success: function (result) {

            $("#AddressTitleID").html("");
            //$("#AddressTitleID").append('<option value="">Please Select</option>');

            $.each(result.d1, function (i, data) {
                // Show AddressTitle as display text, and AddressTitleID as value
                $('<option>', {
                    value: data.AddressTitleID,
                    text: data.AddressTitle
                }).appendTo("#AddressTitleID");
            });

            // Auto-select first address if available
            var firstAddressId = $("#AddressTitleID option:eq(1)").val(); // eq(1) skips "Please Select"
            if (firstAddressId) {
                $("#AddressTitleID").val(firstAddressId);

                // Call the next AJAX to fetch address details
                $.ajax({
                    url: '@Url.Action("getAddressInfo")',
                    data: JSON.stringify({ add: firstAddressId }),
                    type: "POST",
                    dataType: "json",
                    async: false,
                    contentType: "application/json; charset=utf-8",

                    success: function (result1) {
                        if (result1.length > 0) {
                            var vdata = result1[0];
                            $("#Address").val(vdata.Address);
                            $("#State").val(vdata.State);
                            $("#Pincode1").val(vdata.Pincode);
                            $("#Locality").val(vdata.Locality);
                            $("#Taluka").val(vdata.Taluka);
                            $("#Country").val(vdata.Country);
                            $("#District").val(vdata.District);

                            statename = vdata.State;
                            cityname = vdata.Taluka;
                            GSTRegistrationId = vdata.GSTRegistrationId;
                        }
                    },
                    error: function (response) {
                        alert("Address fetch error: " + response.responseText);
                    }
                });
            }
        },
        error: function (response) {
            alert("Company fetch error: " + response.responseText);
        }
    });
}

