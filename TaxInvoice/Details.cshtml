                        <div class="col-lg-2 col-md-4 col-sm-6 p-3">
                            <label id="label">Terms Of Delivery :</label>
                            @Html.TextBox("TermsOfDelivery", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "height:35px" })

                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-3 p-3">
                            <label id="label">Discount :</label>
                            @Html.EditorFor(model => model.DiscountPercent, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "height:35px;text-align:right" } })

                        </div>
                        <div class="col-lg-4 col-md-6 p-3">
                            <label id="label">Payment Term :</label>
                            @Html.TextBox("PaymentTerm", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "height:35px" })

