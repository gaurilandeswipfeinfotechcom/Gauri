                    <label id="label"> Code </label>
                    @Html.TextBox("CountryCode2", null, new { style = "background-color:gainsboro;", @class = "form-control", disabled = "true" })

                </div>
                <div class="col-lg-2">
                    <label id="label">Personal Mob. No</label>
                    @Html.TextBox("PersonalMobileNo", null, new { @class = "form-control", @disabled = true, style = "background-color:gainsboro" })
                </div>
                <div class="col-lg-4">
                    <label id="label">Personal Email</label>
