<script>

    function formatJsonDate(jsonDate) {
        if (!jsonDate) return "";

        var date = new Date(parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, "$1")));

        return date.toLocaleString('en-IN');
    }

    var orderItems = [];
    $(window).load(function () {

        var urlcurrent = $(location).attr('href');

        urlcurrent = unescape(urlcurrent);
        var i = urlcurrent.split("=");
        $.ajax({

            url: '@Url.Action("TIList")',
            data: { "tino": i[1] },

            type: "POST",
            dataType: "json",
            success: function (resultso) {

                if (resultso[0].SaleOrderNo == "" || resultso[0].SaleOrderNo == null)
                {
                    $.ajax({

                        url: '@Url.Action("DirectProductList")',
                        data: {  "tino": i[1] },

                        type: "POST",
                        dataType: "json",
                        success: function (result) {

                            var i;
                            for (i = 0; i < result.length; i++) {
                                orderItems.push({

                                    SrNo: i + 1,
                                    ItemID: result[i].ItemId,
                                    ItemName: result[i].ItemName,
                                    Quantity: result[i].Quantity,
                                    ItemCode: result[i].ItemCode,
                                    HSNCode: result[i].HSNCode,
                                    HSNClassification: result[i].HSNClassification,
                                    GSTRate: result[i].GSTRate,
                                    RatePerUnit: result[i].RatePerUnit,
                                    ApplicableRate: result[i].ApplicableRate,
                                    Amount: result[i].Amount,
                                    StartSerailNo: result[i].StartSerailNo,
                                    EndSerialNo: result[i].EndSerialNo,
                                });
                            }

                            GeneratedItemsTable();



                            $("#SaleOrderNo").val("Not Applicable");
                            $("#SaleOrderNo").attr("disabled", true);


                        },
                        error: function (reponse) {
                            alert("error : " + reponse);
                        }
                    });
                }

                else
                {

                        $.ajax({

                            url: '@Url.Action("DirectProductList")',
                            data: {  "tino": i[1] },

                            type: "POST",
                            dataType: "json",
                            success: function (result) {

                                var i;
                                for (i = 0; i < result.length; i++) {
                                    orderItems.push({

                                        SrNo: i + 1,
                                        ItemID: result[i].ItemId,
                                        ItemName: result[i].ItemName,
                                        Quantity: result[i].Quantity,
                                        ItemCode: result[i].ItemCode,
                                        HSNCode: result[i].HSNCode,
                                        HSNClassification: result[i].HSNClassification,
                                        GSTRate: result[i].GSTRate,
                                        RatePerUnit: result[i].RatePerUnit,
                                        ApplicableRate: result[i].ApplicableRate,
                                        Amount: result[i].Amount,
                                        StartSerailNo: result[i].StartSerailNo,
                                        EndSerialNo: result[i].EndSerialNo,

                                    });
                                }

                                GeneratedItemsTable();

                            },
                            error: function (reponse) {
                                alert("error : " + reponse);
                            }
                        });
                }

                $("#CountryCode1").val(resultso[0].CountryCode);
                $("#CountryCode2").val(resultso[0].CountryCode);

                if (resultso[0].ShippingAddSameAsBillAdd == "Yes") {
                    $("#shippAddress").hide();
                    $('input:radio[name="SendType"]').filter('[value="Yes"]').attr('checked', true);

                }
                else if (resultso[0].ShippingAddSameAsBillAdd == "No") {
                    $("#shippAddress").show();
                    $('input:radio[name="ShippAdd"]').filter('[value="No"]').attr('checked', true);
                    $("#ShippingAddress").val(resultso[0].ShippingAddress);



                }
                if (resultso[0].SendType == "By Hand") {
                    $("#CourierName option:eq(0)").attr('selected', true)

                    $('input:radio[name="SendType"]').filter('[value="By Hand"]').attr('checked', true);

                }
                else if (resultso[0].SendType == "By Courier") {

                    $("input:radio[name=RateType]").attr("disabled", false);

                    $('input:radio[name="SendType"]').filter('[value="By Courier"]').attr('checked', true);

                }

                if (resultso[0].RateType == "Air Rate") {

                    $('input:radio[name="RateType"]').filter('[value="Air Rate"]').attr('checked', true);

                }
                else if (resultso[0].RateType == "Surface Rate") {

                    $('input:radio[name="RateType"]').filter('[value="Surface Rate"]').attr('checked', true);

                }

                $("#CreatedBy").val(resultso[0].CreatedBy);
                //$("#EditedDate").val(result[0].EditedDate);
                //$("#PurInvoiceDate").val(result[0].PurInvoiceDate);
                $("#EditedDate").val(formatJsonDate(resultso[0].EditedDate));
                $("#EditedBy").val(resultso[0].EditedBy);

            }

        });

    });


    function ShowSerialPopup(itemID, itemName, quantity, startSerial, endSerial) {
        var soNo = $("#SaleOrderNo").val();

        $.ajax({
            url: '/TaxInvoice/GetSerialNumbers',
            type: 'POST',
            data: { ItemID: itemID, sono: soNo },
            success: function (data) {

                $('#SerialItemName').text(itemName);
                $('#SerialItemQty').text(quantity);

                $('#SerialNumbersList').empty();

                data.forEach(function (sn, index) {
                    $('#SerialNumbersList').append(
                        '<li>' + (index + 1) + '. ' + sn + '</li>'
                    );
                });

                openModal('invoiceModal', 'purchaseModalOverlay');
            },
            error: function (xhr) {
                console.error(xhr.responseText);
                alert("Error loading serial numbers.");
            }
        });
    }

    // Function to open the modal
    function openModal(modalId, overlayId) {
        document.getElementById(modalId).style.display = "block";
        document.getElementById(overlayId).style.display = "block";
    }

    // Function to close the modal
    function closeModal(modalId) {
        document.getElementById(modalId).style.display = "none";
        document.getElementById(modalId + "Overlay").style.display = "none";
    }

