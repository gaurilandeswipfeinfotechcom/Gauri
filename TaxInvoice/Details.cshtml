                @*//Courier Services Panel//*@
                <fieldset class="dshapefieldset">
                    <p class="field-heading pt-3">
                        <i class="material-icons">double_arrow</i>
                        Courier Services
                    </p>
                    <div class="form-group row px-3">
                        <div class="col-md-4 p-3">
                            <label id="label">Courier Name :</label>
                            @Html.EditorFor(model => model.TransporterName, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "height:35px" } })

                        </div>
                        <div class="col-md-4 col-sm-6 p-3">
                            <label id="label">Dispatch Mode :</label>
                            <div class="form-check pl-0">
                                <label class="form-check-label" id="label">
                                    <input class="form-check-input" type="radio" name="SendType" value="By Hand" id="ByHand" onchange="checksendtype(this.value);" disabled> By Hand
                                    <span class="circle">
                                        <span class="check"></span>
                                    </span>
                                </label>

                                <label class="form-check-label" id="label">
                                    <input class="form-check-input" type="radio" name="SendType" value="By Courier" id="ByCourier" onchange="checksendtype(this.value);" disabled> By Courier
                                    <span class="circle">
                                        <span class="check"></span>
                                    </span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6 p-3">
                            <label id="label">Transport Mode :</label>

                            <div class="form-check pl-0">
                                <label class="form-check-label" id="label">
                                    <input class="form-check-input" type="radio" name="RateType" value="Air Rate" id="AirRate" onchange="checkratetype(this.value);" disabled>By Air
                                    <span class="circle">
                                        <span class="check"></span>
                                    </span>
                                </label>

                                <label class="form-check-label" id="label">
                                    <input class="form-check-input" type="radio" name="RateType" value="Surface Rate" id="SurfaceRate" onchange="checkratetype(this.value);" disabled>By Surface
                                    <span class="circle">
                                        <span class="check"></span>
                                    </span>
                                </label>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">Total Weight<br /> In Kg :</label>
                            @Html.EditorFor(model => model.TotalWeightInKg, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.TotalWeightInKg, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">Docket <br />Charges :</label>
                            @Html.EditorFor(model => model.DocketCharges, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.DocketCharges, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">Fuel <br />Charges :</label>
                            @Html.EditorFor(model => model.FuelCharges, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.FuelCharges, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">Other <br />Charges :</label>
                            @Html.EditorFor(model => model.OtherCharges, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.OtherCharges, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">COD <br />Charges :</label>
                            @Html.EditorFor(model => model.CODCharges, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.CODCharges, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">FOV <br />Charges :</label>
                            @Html.EditorFor(model => model.FOV, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.FOV, "", new { @class = "text-danger" })
                        </div>

                    </div>
                </fieldset>

                <fieldset class="dshapefieldset">
                    <div class="form-group row px-3">
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">Product Sub Total :</label>
                            @Html.EditorFor(model => model.ProductSubTotal, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.ProductSubTotal, "", new { @class = "text-danger" })

                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">Freight Charges:</label>
                            @Html.EditorFor(model => model.FreightCharges, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.FreightCharges, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">IGST :</label>
                            @Html.EditorFor(model => model.IGST, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.IGST, "", new { @class = "text-danger" })

                        </div>
                        <div class="col-lg-2 col-sm-6 p-3">
                            <label id="label">CGST :</label>
                            @Html.EditorFor(model => model.CGST, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.CGST, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">SGST :</label>
                            @Html.EditorFor(model => model.SGST, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @disabled = true, style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.SGST, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-lg-2 col-sm-6 col-md-4 p-3">
                            <label id="label">Total Amount :</label>
                            @Html.EditorFor(model => model.TotalAmount, new { htmlAttributes = new { @class = "form-control bg-light fs-4 pl-3 input-text-box", @readonly = "readonly", style = "text-align:right;height:35px" } })
                            @Html.ValidationMessageFor(model => model.RoundOffTotalAmount, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </fieldset>

                <fieldset class="dshapefieldset">
                    <label id="label">Specific Instructions by Customer :</label>
                    <div class="form-group row px-3">
                        <div class="col-lg-12">
                            @Html.TextAreaFor(model => model.Note, new { rows = 2, cols = 120, disabled = "true", @class = " form-control bg-light fs-4 pl-3 input-text-box" })
                            @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </fieldset>

                <div class="form-group row ">
                    <div class="col-md-2 col-lg-2 p-4">
                        <input type="button" id="submit" value="Resend" class=" btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="Resend();" />
                    </div>

                    <div class="col-md-2 col-lg-2 p-4">
                        <input type="button" value="Back" class=" btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="location.href='@Url.Action("Index","TaxInvoice")'" />
                    </div>
                </div>


            </div>
            </div>
        </div>
    </div>

    <!-- Serial Numbers Modal -->
    <div class="modalOverlay" id="purchaseModalOverlay" onclick="closeModal('invoiceModal')"></div>

    <div class="modal" id="invoiceModal">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="SerialsModalLabel">Serial Numbers</h5>
                    <i class="material-icons" data-dismiss="modal" aria-label="Close" onclick="closeModal('invoiceModal')"
                       style="color: midnightblue; font-size: 30px; cursor: pointer;margin-top:-15px">cancel</i>
                </div>
                <div class="modal-body">
                    <p id="SerialsItemInfo"><strong>Item:</strong> <span id="SerialItemName"></span> | <strong>Quantity:</strong> <span id="SerialItemQty"></span></p>
                    <div style="max-height:300px; overflow-y:auto; border:1px solid #ccc; padding:10px;">
                        <ul id="SerialNumbersList" style="list-style-type:none; padding-left:0;"></ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success btn-round custo-inner" onclick="closeModal('invoiceModal')" style=" background-image: linear-gradient(to right,#35d3e1,midnightblue); color: white; font-family: Helvetica; box-shadow: -4px -4px 8px rgba(255, 255, 255, 0.7), 4px 4px 8px rgba(128, 128, 128, 0.7); outline-style: none; border: none; padding: 5px 20px 5px 20px;">Close</button>
                </div>
            </div>
        </div>
    </div>
</form>



