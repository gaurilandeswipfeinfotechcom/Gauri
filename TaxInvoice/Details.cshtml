    function GeneratedItemsTable() {
        if (orderItems.length > 0) {
            var $table = $('<table class="table table-bordered  text-left"/>');

            $table.append('<thead><tr><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;border-left: 2px solid #fff;">No.</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">Item Name</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">Start Serial No</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">End Serial No</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">Qty.</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">Item Code</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">HSN</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">GST</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">Rate</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">Appl. Rate</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">Amount</th><th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;">Serials</th></tr></thead>');

            var $tbody = $('<tbody/>');

            $.each(orderItems, function (i, val) {
                var $row = $('<tr/>');

                $row.append($('<td style="border-left: 2px solid #fff;"/>').html(val.SrNo));
                $row.append($('<td style="text-align:left;"/>').html(val.ItemName));
                $row.append($('<td style="text-align:center"/>').html(val.StartSerailNo || ''));
                $row.append($('<td style="text-align:center"/>').html(val.EndSerialNo || ''));
                $row.append($('<td style="text-align:right"/>').html(val.Quantity));
                $row.append($('<td style="text-align:center"/>').html(val.ItemCode));
                $row.append($('<td style="text-align:center"/>').html(val.HSNCode));
                $row.append($('<td style="text-align:right"/>').html(val.GSTRate));
                $row.append($('<td style="text-align:right"/>').html(val.RatePerUnit));
                $row.append($('<td style="text-align:right"/>').html(val.ApplicableRate));
                $row.append($('<td style="text-align:right"/>').html(val.Amount));

                // --- Always show serial button ---
                var $serialBtnCell = $('<td style="text-align:center"/>');
                var $btn = $('<button/>', {
                    type: 'button',
                    class: 'btn btn-info btn-sm',
                    text: 'View Serials',
                    click: function () {
                        // Pass start/end and item info to popup
                        ShowSerialPopup(val.ItemID, val.ItemName, val.Quantity, val.StartSerailNo, val.EndSerialNo);
                    }
                });
                $serialBtnCell.append($btn);
                $row.append($serialBtnCell);

                $tbody.append($row);
            });

            $table.append($tbody);
            $('#orderItems').html($table);
        } else {
            $('#orderItems').html('');
        }
    }


    function Resend() {

        $.ajax({

            url: '@Url.Action("Resend")',

            data: { "tno": $("#TaxInvoiceNo").val() },
            type: "POST",
            //dataType: "json",
            success: function (result) {
                    window.location.href = '/TaxInvoiceReport.aspx';
            },
            error: function (reponse) {
                alert("error : " + reponse);
            }
        });

    }

