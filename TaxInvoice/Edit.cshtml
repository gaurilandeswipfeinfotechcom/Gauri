    function AddProduct(nm, index = null) {

    var itid = $('#ItemID').val().trim();
    var itnm = $('#ItemID option:selected').text().trim();
    var quan = parseInt($('#Quantity').val().trim());

    var isAllValid = true;

    // Validation
    if (!itid) {
        $('#ItemID').siblings('span.error').css('visibility', 'visible');
        $("#reqitem").html('<span style="color:red">Item Name Required</span>').show();
        isAllValid = false;
    } else {
        $('#ItemID').siblings('span.error').css('visibility', 'hidden');
        $("#reqitem").hide();
    }

    if (!$('#Quantity').val().trim() || !/^\d+$/.test($('#Quantity').val().trim())) {
        $('#Quantity').siblings('span.error').css('visibility', 'visible');
        $("#regqty").html('<span style="color:red">Enter Valid Quantity</span>').show();
        isAllValid = false;
    } else {
        $('#Quantity').siblings('span.error').css('visibility', 'hidden');
        $("#regqty").hide();
    }

    // Duplicate check
    if (nm === "Add" && isAllValid) {
        for (var k = 0; k < orderItems.length; k++) {
            if (orderItems[k].ItemID.toString() === itid) {
                alert("Item already added!");
                isAllValid = false;
                break;
            }
        }
    }

    if (!isAllValid) return;

    // Get selected serial validation for selection of serial no.
    //var selectedSerial = $('#SerialNo').val();
    //if (!selectedSerial) {
    //    alert("Please select Serial Number");
    //    return;
    //}
        var selectedSerials = [];

        $(".serialChk:checked").each(function () {
            selectedSerials.push($(this).val());
        });

    // AJAX for item details
    $.ajax({
        url: '@Url.Action("GetCode")',
        data: { "ItemID": itid, "legerid": $('#AddressTitleID').val().trim() },
        type: "POST",
        dataType: "json",
        success: function (data) {

            if (data.length === 0) return;

            var item = data[0];

            var irate = item.RatePerUnit;
            var discount = parseFloat($("#Discount").val()) || 0;

            var apprate = item.hasPreferredItem
                ? parseFloat(irate).toFixed(2)
                : (discount > 0
                    ? (parseFloat(irate) * (1 - discount / 100)).toFixed(2)
                    : parseFloat(irate).toFixed(2));

            var amt = (apprate * quan).toFixed(2);

            // Serial logic
            //var serialList = item.SerialNumbers.map(String);
            //var startIndex = serialList.indexOf(selectedSerial);

            ////if (startIndex === -1) {
            ////    alert("Invalid Serial Selected");
            ////    return;
            ////}

            //if ((startIndex + quan) > serialList.length) {
            //    alert("Quantity exceeds available serial numbers.");
            //    return;
            //}

            //var selectedSerials = serialList.slice(startIndex, startIndex + quan);

            //var nonSequential = false;
            //for (var j = 1; j < selectedSerials.length; j++) {
            //    if (parseInt(selectedSerials[j]) !== parseInt(selectedSerials[j - 1]) + 1) {
            //        nonSequential = true;
            //        break;
            //    }
            //}



            // Serial logic
            var selectedSerials = [];

            $(".serialChk:checked").each(function () {
                selectedSerials.push($(this).val());
            });

            //if (selectedSerials.length === 0) {
            //    alert("Please select at least one serial number.");
             //   return;
            //}

            var nonSequential = false;

            for (var j = 1; j < selectedSerials.length; j++) {

                if (parseInt(selectedSerials[j]) !== parseInt(selectedSerials[j - 1]) + 1) {
                    nonSequential = true;
                    break;
                }
            }

            if (nm === "Add") {

                orderItems.push({
                    SaleOrderNo: $('#SaleOrderNo').val().trim(),
                    ItemID: parseInt(itid),
                    ItemName: itnm,
                    Quantity: quan,
                    ItemCode: item.ItemCode,
                    HSNCode: item.HSNCode,
                    HSNClassification: item.HSNClassification,
                    GSTRate: item.GSTRate,
                    RatePerUnit: item.RatePerUnit,
                    ApplicableRate: apprate,
                    Amount: amt,
                    WeightPerUnit: item.WeightPerUnit,
                    WeightOfPackingBox: item.WeightOfPackingBox,
                    StartSerialNo: selectedSerials[0],
                    EndSerialNo: (parseInt(quan) === 1)
                        ? selectedSerials[0]
                        : selectedSerials[selectedSerials.length - 1],
                    //StartSerialNo: selectedSerials[0],
                    //EndSerialNo: selectedSerials[selectedSerials.length - 1],
                    SerialNumbers: selectedSerials,
                    NonSequential: nonSequential
                });

            } else if (nm === "Update") {
                var idx = window.currentEditIndex;
                if (idx === undefined) return;

                orderItems[idx] = {
                    ...orderItems[idx],
                    ItemID: parseInt(itid),
                    ItemName: itnm,
                    Quantity: quan,
                    ApplicableRate: apprate,
                    Amount: amt,
                    StartSerialNo: selectedSerials[0],
                    EndSerialNo: (parseInt(quan) === 1)
                        ? selectedSerials[0]
                        : selectedSerials[selectedSerials.length - 1],
                    //StartSerialNo: selectedSerials[0],
                    //EndSerialNo: selectedSerials[selectedSerials.length - 1],
                    SerialNumbers: selectedSerials,
                    NonSequential: nonSequential
                };

                // Reset index
                window.currentEditIndex = undefined;
            }

            // Subtotal
            var subtot = orderItems.reduce((sum, x) => sum + parseFloat(x.Amount), 0);
            $("#ProductSubTotal").val(subtot.toFixed(2));

            // Weight
            var totalWeight = orderItems.reduce((sum, x) =>
                sum + (parseFloat(x.WeightPerUnit) + parseFloat(x.WeightOfPackingBox)) * parseInt(x.Quantity), 0);

            $("#TotalWeightInKg").val(totalWeight.toFixed(2));

            GeneratedItemsTable();

            checksendtype($('input[name=SendType]:checked').val());
            OtherCourier();
            calbyother();
            if (initratetype) checkratetype(initratetype);

            // Reset
            $("#add").val("Add");
            $('#ItemID').val('');
            $('#ItemCode').val('');
            $('#Quantity').val(1);
            $('#SerialNo').empty().append('<option value="">Select Serial No.</option>');
        }
    });
    }

    function GetSerialNumbers(item) {
        if (!item) return;

        var itemName = item.ItemName;
        var quantity = item.Quantity;

        // Use only the serials already selected for this item
        var selectedSerials = item.SerialNumbers || [];

        // Fill item info in modal
        $('#SerialItemName').text(itemName);
        $('#SerialItemQty').text(quantity);

        // Fill serial numbers list
        $('#SerialNumbersList').empty();
        selectedSerials.forEach(function (sn, index) {
            $('#SerialNumbersList').append(
                '<li>' + (index + 1) + '. ' + sn + '</li>'
            );
        });


        // Open modal
        openModal('invoiceModal', 'purchaseModalOverlay');
    }
