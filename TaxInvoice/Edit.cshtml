    function GeneratedItemsTable() {
        if (orderItems.length === 0) {
            $('#orderItems').html('');
            return;
        }

        var k = 1;
        var $table = $('<table/>').addClass('table table-bordered');
        $table.append('<thead><tr><th>No.</th><th>Item Name</th><th>Start Serial No.</th><th>End Serial No.</th><th>Qty.</th><th>Item Code</th><th>HSN</th><th>GST</th><th>Rate</th><th>Appl. Rate</th><th>Amount</th><th>Actions</th></tr></thead>');
        var $tbody = $('<tbody/>');

        $.each(orderItems, function (i, val) {
            var iname = val.ItemName;

            // AJAX call to get Item Name
            $.ajax({
                url: '@Url.Action("GetIName")',
                data: { "ItmID": val.ItemID },
                type: "POST",
                dataType: "json",
                async: false,
                success: function (data) {
                    if (data.length > 0) {
                        iname = data[0].ItemName;
                    }
                }
            });

            // Create table row with data-index
            var $row = $('<tr/>').attr('data-index', i);

            $row.append($('<td style="text-align:center"/>').html(k));
            $row.append($('<td style="text-align:left"/>').html(iname));

            // Serial number handling
            var $serialTdStart = $('<td style="text-align:right"/>');
            var $serialTdEnd = $('<td style="text-align:right"/>');



            if (val.SerialNumbers && val.SerialNumbers.length > 1) {
                var isSequential = true;
                for (var s = 1; s < val.SerialNumbers.length; s++) {
                    if (parseInt(val.SerialNumbers[s]) !== parseInt(val.SerialNumbers[s - 1]) + 1) {
                        isSequential = false;
                        break;
                    }
                }

                if (isSequential) {
                    $serialTdStart.html(val.StartSerialNo);
                    $serialTdEnd.html(val.EndSerialNo);
                } else {
                    $serialTdStart.html(val.StartSerialNo);
                    $serialTdEnd.html(val.EndSerialNo);
                    //var $btn = $('<a href="#" title="View All Serials"><i class="material-icons" style="color:blue">list_alt</i></a>');
                    //$btn.click(function (e) {
                    //    e.preventDefault();
                    //    GetSerialNumbers(val.ItemID);
                    //});
                    //$serialTdStart.append(' ').append($btn);

                    var $btn = $('<a href="#" title="View All Serials"><i class="material-icons" style="color:blue">list_alt</i></a>');
                    $btn.click(function (e) {
                        e.preventDefault();
                        GetSerialNumbers(val); // pass the whole item object
                    });
                    $serialTdStart.append(' ').append($btn);
                }
            }
            else if (val.SerialNumbers && val.SerialNumbers.length === 1) {
                $serialTdStart.html(val.SerialNumbers[0]);
                $serialTdEnd.html(val.SerialNumbers[0]);   // or val.EndSerialNo
            }
            //else if (val.SerialNumbers && val.SerialNumbers.length === 1) {
            //    $serialTdStart.html(val.SerialNumbers[0]);
            //    $serialTdEnd.html('');
            //}
            else {
                $serialTdStart.html(val.StartSerialNo || '');
                $serialTdEnd.html(val.EndSerialNo || '');
            }

            $row.append($serialTdStart);
            $row.append($serialTdEnd);

            $row.append($('<td style="text-align:center"/>').html(val.Quantity));
            $row.append($('<td style="text-align:center"/>').html(val.ItemCode));
            $row.append($('<td style="text-align:center"/>').html(val.HSNCode));
            $row.append($('<td style="text-align:right"/>').html(val.GSTRate));
            $row.append($('<td style="text-align:right"/>').html(val.RatePerUnit));
            $row.append($('<td style="text-align:right"/>').html(val.ApplicableRate));
            $row.append($('<td style="text-align:right"/>').html(val.Amount));

            // Remove button
            var $remove = $('<a href="#" title="Remove"><i class="material-icons text-danger">close</i></a>');
            $remove.click(function (e) {
                e.preventDefault();
                orderItems.splice(i, 1);
                GeneratedItemsTable();
                RecalculateTotals();
            });

            // Edit button
            var $Edit = $('<a href="#" title="Edit"><i class="material-icons">edit_note</i></a>');
            $Edit.click(function (e) {
                e.preventDefault();

                var rowIndex = $(this).closest("tr").data("index");
                var item = orderItems[rowIndex];
                if (!item) return;

                // Populate fields
                $("#ItemID").val(item.ItemID);
                $("#ItemCode").val(item.ItemCode).prop("disabled", true);
                $("#Quantity").val(item.Quantity);

                SelectedSerialNumbers = item.SerialNumbers || [];

                $("#SerialNoText").val(SelectedSerialNumbers.join(", "));

                $("#add").val("Update");
                window.currentEditIndex = rowIndex;

                // Open popup directly
                LoadSerialPopup(item.SerialNumbers);
            });


            var $actionTd = $('<td style="text-align:center"/>').append($Edit).append(' ').append($remove);
            $row.append($actionTd);

            $tbody.append($row);
            k++;
        });

        $table.append($tbody);
        $('#orderItems').html($table);
    }
