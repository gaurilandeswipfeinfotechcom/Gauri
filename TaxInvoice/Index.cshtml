<script type="text/javascript">

    $(window).load(function () {

        var b = '@Session["LoginUserId"]';
        //var b = 9;
        $.ajax({
            url: '@Url.Action("GetInfo")',
            data: { "userId": b },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {

                if (data.length > 0) {

                    for (var i = 0; i < data.length; i++) {

                        if (data[i].FormName == "TaxInvoice") {

                        if (data[i].Create == "Y") {


                            $('#CreateTaxInvoice').show();
                        }
                        else {

                            $('#CreateTaxInvoice').hide();

                        }
                   }

                }

                }

            }
        });
    });


    function searcTaxInvoiceNo(id) {
        var txt = document.getElementById(id);
        //txt.value = txt.value.replace(/\w\S*/g, function (txt) { return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase(); });

        // var txt = document.getElementById(id);
        //alert("hi");
        $.ajax({
            url: '/TaxInvoice/AutocompleteTaxInvoiceNo/',
            data: { "searchByText": txt.value, "sortBy": $('#SortByColumnName').val() },
            type: "POST",
            dataType: "json",

            success: function (data) {
                $('#json-datalistTaxInvoiceNo').empty();
                var jsonOptions = data;
                var dataList = document.getElementById('json-datalistTaxInvoiceNo');

                jsonOptions.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = item;
                    dataList.appendChild(option);
                });
            },
            error: function (xhr, status, error) {
                alert(xhr.responseText);
            }
        });
    } //end of searchTaxInvoiceNo

    function validate() {
        if ($('#SearchByText').val() != "") {
            $('#SortByColumnName').val('TaxInvoiceNo');

        }
        else if ($('#SortByColumnName').val() != "TaxInvoiceNo") {
            $('#SearchTaxInvoiceNo').val('');
        }
    }
    function funPageNoClicked(requestedPgNo) {
        $("#isPageNavigationRequested").val("true");
        $("#RequestedPageNumber").val(requestedPgNo);
        event.preventDefault();
        $("#Tax_Invoice_List").submit();
    }
    $(function () {
        $("#Search").click(function () {
            $("#isPageNavigationRequested").val("false");
        });
    });
    function openEditForm(editFormUrl) {
        var editTab = window.open(editFormUrl, '_blank');

        // Listen for the edit tab closure
        editTab.onbeforeunload = function () {
            // Refresh the index page when the edit tab is closed
            location.reload();
        };
    }


     function showInvoiceAndPrint(element) {
         var mgid = $(element).data("id");  // Get the 'data-id' value (MfgJournalID)
         var mfgJournalNo = $(element).data("mfgjournalno");  // Get the 'data-mfgjournalno' value

         console.log("mgid id: " + mgid);  // For debugging purposes

         // Step 1: AJAX call to fetch the Print page content and show in iframe
         $.ajax({
             url: '@Url.Action("Print")',  // Action to fetch print content
             data: { "id": mgid },  // Send the MfgJournalID to the server
             type: "GET",
             success: function (result) {
                 // Step 2: If the Print page returns successfully, set session in Prints action
                 $.ajax({
                     url: '@Url.Action("Prints")',  // Action to set session (use MfgJournalNo)
                     data: { "tino": mfgJournalNo },  // Send MfgJournalNo to the Prints action
                     type: "POST",
                     dataType: "json",
                     success: function (result) {
                         if (result.success) {
                             // Load the Print view content into iframe inside the modal
                             $('#invoiceIframe').attr('src', '/TaxInvoiceReportPrint.aspx');  // The URL of the print page (replace with correct URL)
                             openModal('invoiceModal', 'purchaseModalOverlay');  // Open the modal
                         } else {
                             alert("Error: " + result.message);  // Handle error from Prints action
                         }
                     },
                     error: function () {
                         alert('An error occurred while processing the Prints request.');
                     }
                 });
             },
             error: function () {
                 alert('An error occurred while processing the Print request.');
             }
         });
     }

    function showInvoicegst() {

         //console.log("mgid id: " + mgid);  // For debugging purposes
        openModal('gstModal', 'purchaseModalOverl');  // Open the modal
         // Step 1: AJAX call to fetch the Print page content and show in iframe

    }


    // Function to open the modal
    function openModal(modalId, overlayId) {
        document.getElementById(modalId).style.display = "block";
        document.getElementById(overlayId).style.display = "block";
    }

    // Function to close the modal
    function closeModal(modalId) {
        document.getElementById(modalId).style.display = "none";
        document.getElementById(modalId + "Overlay").style.display = "none";
    }


    document.addEventListener("DOMContentLoaded", function () {
        let currentYear = new Date().getFullYear();
        let dropdown = document.getElementById("businessYear");

        for (let i = currentYear - 5; i <= currentYear; i++) {
            let startYear = i;
            let endYear = i + 1;
            let option = document.createElement("option");
            option.value = `${startYear}-${endYear}`;
            option.textContent = `${startYear}-${endYear}`;
            dropdown.appendChild(option);
        }
    });


    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".month-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                let selectedMonth = this.getAttribute("data-month"); // Get selected month
                let year = document.getElementById("businessYear").value; // Get selected financial year

                if (!year) {
                    alert("Please select a financial year first.");
                    return;
                }

                let [startYear, endYear] = year.split("-"); // Extract start & end year
                let selectedYear = startYear; // Default to start year

                //  If month is Jan-Mar, assign to end year (next year)
                if (["January", "February", "March"].includes(selectedMonth)) {
                    selectedYear = endYear;
                }

                let financialYearMonth = `${selectedMonth} ${selectedYear}`;

                let periodDropdown = document.getElementById("period");

                //  Update the dropdown value and text
                periodDropdown.innerHTML = `
                <option value="${financialYearMonth}" selected>${financialYearMonth}</option>
                <option value="Select Month">Select Month</option>
                <option value="Q1">Q1 (Apr - Jun ${startYear})</option>
                <option value="Q2">Q2 (Jul - Sep ${startYear})</option>
                <option value="Q3">Q3 (Oct - Dec ${startYear})</option>
                <option value="Q4">Q4 (Jan - Mar ${endYear})</option>
                <option value="H1">Half Yearly-1 (Apr - Sep ${startYear})</option>
                <option value="H2">Half Yearly-2 (Oct ${startYear} - Mar ${endYear})</option>
                <option value="Yearly"> Yearly (Apr ${startYear} - Mar ${endYear})</option>

            `;

                //  Hide month list after selection
                document.getElementById("monthNavbar").style.display = "none";
            });
        });
    });


//  Show/Hide Month Selection List Based on Dropdown
function toggleMonthNavbar() {
    var periodDropdown = document.getElementById("period");
    var period = periodDropdown.value;
    var monthNavbar = document.getElementById("monthNavbar");

    if (period === "Select Month") {
        monthNavbar.style.display = "block"; //  Show month list
    } else {
        monthNavbar.style.display = "none"; //  Hide it when another option is selected
    }
}


  //  Populate Business Year Dropdown
function populateBusinessYears() {
    let yearDropdown = document.getElementById("businessYear");
    let currentYear = new Date().getFullYear();
    let startYear = 2015; // Start year for financial years

    yearDropdown.innerHTML = '<option value="">--Select Year--</option>'; // Reset dropdown

    for (let i = currentYear; i >= startYear; i--) {
        let financialYear = `${i}-${i + 1}`;
        let option = `<option value="${financialYear}">${financialYear}</option>`;
        yearDropdown.innerHTML += option;
    }
}

//  Update Period Dropdown Based on Financial Year
function updatePeriods() {
    let year = document.getElementById("businessYear").value;
    let periodDropdown = document.getElementById("period");

    if (!year) {
        periodDropdown.innerHTML = `<option value="select">Select Period</option>`;
        return;
    }

    let [startYear, endYear] = year.split("-"); // Extract start & end year

    periodDropdown.innerHTML = `
        <option value="select">Select Period</option>
        <option value="Select Month">Select Month</option>
        <option value="Q1">Q1 (Apr - Jun ${startYear})</option>
        <option value="Q2">Q2 (Jul - Sep ${startYear})</option>
        <option value="Q3">Q3 (Oct - Dec ${startYear})</option>
        <option value="Q4">Q4 (Jan - Mar ${endYear})</option>
        <option value="H1">Half Yearly-1 (Apr - Sep ${startYear})</option>
        <option value="H2">Half Yearly-2 (Oct ${startYear} - Mar ${endYear})</option>
        <option value="Yearly">Yearly (Apr ${startYear} - Mar ${endYear})</option>

    `;
}

//  Show Month Selection Only if "Select Month" is Chosen
function toggleMonthNavbar() {
    var period = document.getElementById("period").value;
    var monthNavbar = document.getElementById("monthNavbar");

    monthNavbar.style.display = period === "Select Month" ? "block" : "none";
}

    //  Handle Month Selection & Update Dropdown Correctly
    document.querySelectorAll(".month-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            let selectedMonth = this.getAttribute("data-month"); // Get selected month
            let year = document.getElementById("businessYear").value; // Get selected financial year

            if (!year) {
                alert("Please select a financial year first.");
                return;
            }

            let [startYear, endYear] = year.split("-"); // Extract start & end year
            let selectedYear = startYear; // Default to start year

            //  If month is Jan-Mar, use the next year (endYear)
            if (["January", "February", "March"].includes(selectedMonth)) {
                selectedYear = endYear;
            }

            let financialYearMonth = `${selectedMonth} ${selectedYear}`;

            //  Update dropdown with selected month in correct year
            let periodDropdown = document.getElementById("period");
            periodDropdown.innerHTML = `
            <option value="${financialYearMonth}" selected>${financialYearMonth}</option>
            <option value="Yearly">${year} - Yearly (Apr ${startYear} - Mar ${endYear})</option>
            <option value="Q1">Q1 (Apr - Jun ${startYear})</option>
            <option value="Q2">Q2 (Jul - Sep ${startYear})</option>
            <option value="Q3">Q3 (Oct - Dec ${startYear})</option>
            <option value="Q4">Q4 (Jan - Mar ${endYear})</option>
            <option value="H1">Half Yearly-1 (Apr - Sep ${startYear})</option>
            <option value="H2">Half Yearly-2 (Oct ${startYear} - Mar ${endYear})</option>
            <option value="Select Month">Select Month</option>
        `;

            document.getElementById("monthNavbar").style.display = "none"; // Hide month list after selection
        });
    });


function exportGstFile() {
    let period = document.getElementById("period").value;
    let financialYear = document.getElementById("businessYear").value; // Get full "2024-2025"

    if (!financialYear || period === "select") {
        alert("Please select a financial year and period before exporting.");
        return;
    }

    let url = '@Url.Action("ExportToExcel", "TaxInvoice")' + "?financialYear=" + encodeURIComponent(financialYear) + "&period=" + encodeURIComponent(period);
    window.location.href = url;
}


//  Load Business Years on Page Load
document.addEventListener("DOMContentLoaded", function () {
    populateBusinessYears();
});

</script>

