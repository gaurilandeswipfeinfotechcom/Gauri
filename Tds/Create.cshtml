@model ERPEntities.Tds

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}


<style>
    /*Adding some css for looks good*/
    #label {
        font-size: 15px;
        color: #0077B3;
        font-weight: 500
    }

    h4 {
        font-size: 18px;
        padding: 10px 0;
        font-weight: 600;
    }

    .form-head h4 {
        padding: 10px 10px;
        font-size: 16px;
        font-weight: 600;
        background-color: #C1D5BD;
    }


    .body-panel {
        border: 1px solid black;
        /*background-color: whitesmoke;*/
        margin-top: -10px;
        border-radius: 5px;
        background-color: floralwhite;
    }

    .submit-btn {
        display: inline-flex;
        padding: 7px;
    }


        .submit-btn button {
            border-radius: 30px;
            padding: 5px 5px;
        }



    .save-btn input {
        /*border-radius: 30px;*/
        font-size: 14px;
    }

    .tablecontainer table {
        width: 100%;
        border-collapse: collapse;
        border-top: 1px solid #fff;
        border-right: 1px solid #fff;
        background-color: #fff
    }

    .tablecontainer th {
        border-bottom: 2px solid #fff !important;
        background-color: lightblue;
        font-size: small;
        font-weight: normal;
        color: midnightblue;
        text-align: center;
        height: 30px;
    }

    .tablecontainer th, .tablecontainer td {
        /*text-align: left;*/
        border-left: 2px solid #fff;
        padding: 5px;
        border-bottom: 2px solid #fff;
        font-size: small;
    }


    fieldset {
        border: 1px solid #ddd !important;
        margin: 10px;
        padding: 5px;
        padding-left: 10px !important;
        padding-right: 10px !important;
        background-color: white;
    }


    .button {
        display: inline-block;
        /*padding: 5px 6px;*/
        /*font-size: 5px;*/
        padding: 20px;
        font-size: 16px;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        outline: none;
        border: none;
        box-shadow: 0 9px #999;
        height: 3px;
        width: auto;
        margin: 4px 2px;
    }

        .button:hover {
            /*background-color: #3e8e41*/
            background-color: cyan;
        }

        .button:active {
            background-color: cyan;
            box-shadow: 0 5px #666;
            transform: translateY(4px);
        }

    .button1 {
        border-radius: 50%;
    }

    span.error {
        display: block;
        visibility: hidden;
        color: red;
        font-size: 60px;
    }


    .ui-widget {
        font-size: 12px !important;
    }

    .reqError {
        color: #ff0000; /*Red Color*/
        font-weight: bold;
        font-size: 16px;
    }

    .backsubmitbtn {
        background-image: linear-gradient(to right,#35d3e1,midnightblue);
        padding: 5px 20px 5px 20px;
        color: white;
        font-family: Helvetica;
        box-shadow: -4px -4px 8px rgba(255, 255, 255, 0.7), 4px 4px 8px rgba(128, 128, 128, 0.7);
        outline-style: none;
        border: none
    }

    .dshapefieldset {
        background-color: #e5e6e7;
        border: 2px solid #ddd;
        border-radius: 0px 25px 25px 0px;
        margin-bottom: 20px
    }

    .field-heading {
        font-size: 18px;
        color: midnightblue;
        font-family: Helvetica;
        font-weight: bold;
        display: flex
    }

    .route-path1 {
        cursor: pointer;
        clip-path: polygon(0% 0%, 90% 0%, 100% 50%, 90% 100%, 0% 100%);
        background-color: #003399;
        color: white;
        padding: 5px 15px 5px 5px
    }

    .route-path2 {
        cursor: pointer;
        color: white;
        clip-path: polygon(91% 0%, 100% 50%, 91% 100%, 0% 100%, 9% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }

    .route-path3 {
        cursor: pointer;
        color: white;
        clip-path: polygon(90% 0%, 100% 50%, 90% 100%, 0% 100%, 10% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }

    .cross-btn {
        font-size: 30px;
        cursor: pointer;
        color: midnightblue;
        position: absolute;
        top: 35px;
        right: 15px;
    }
</style>
<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="Stylesheet" type="text/css" />
@*AP external CSS*@
<link href="~/Content/ERPStyle.css" rel="stylesheet" />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <form class="form-horizontal" action="#" method="">
            <div class="row clearfix">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="d-flex" style="margin-top:-20px">
                        <h4 class="route-path1" onclick="location.href='@Url.Action("Index","AccountInfo")'">Accounts </h4>
                        <h4 class="route-path2 " onclick="location.href='@Url.Action("Index","Tds")'">TDS List</h4>
                        <h4 class="route-path3 " onclick="location.reload()">Create</h4>
                    </div>
                    <br />

                    <div class="panel panel-default outer-main-container">
                        <div class=" main-heading">
                            <div class=" d-flex pr-5">
                                <i class="material-icons" style="font-size: 32px; margin-right: 10px;">feed</i>
                                TDS Creation
                                <i class="material-icons cross-btn" onclick="history.back()">cancel</i>
                            </div>
                        </div>
                        <div style="padding-inline:20px">
                            <fieldset class="dshapefieldset px-2">
                                <div class="form-group row px-4">
                                    <div class="col-sm-6 col-md-4 col-xl-3">
                                        <label id="label">Description :</label>
                                        @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 input-text-box", style = "height:35px" } })
                                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-sm-6 col-md-4 col-xl-2">
                                        <label id="label">Section :</label>
                                        @Html.EditorFor(model => model.Section, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 input-text-box", style = "height:35px" } })
                                        @Html.ValidationMessageFor(model => model.Section, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-sm-6 col-md-4 col-xl-2">
                                        <label id="label">Code :</label>
                                        @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 input-text-box", style = "height:35px" } })
                                        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-sm-6 col-md-4 col-xl-3">
                                        <label id="label">Amount Deduction :</label>
                                        @Html.EditorFor(model => model.AmountDeduction, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 input-text-box", style = "height:35px" } })
                                        @Html.ValidationMessageFor(model => model.AmountDeduction, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="col-sm-6 col-md-4 col-xl-2">
                                        <label id="label">Percents :</label>
                                        @Html.EditorFor(model => model.Percents, new { htmlAttributes = new { @class = "form-control fs-4 pl-3 input-text-box", style = "height:35px" } })
                                        @Html.ValidationMessageFor(model => model.Percents, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </fieldset>
                            <div class="form-group row px-2">
                                <div class="col-md-2 col-lg-2 col-sm-4 px-2">
                                    <input type="submit" value="Create" class=" btn btn-success btn-round create-bttn custo-inner" style="outline:none" />
                                </div>
                                <div class="col-md-2 col-lg-2 col-sm-4 px-2">
                                    <input type="button" value="Close" class=" btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="history.back();" />
                                </div>
                            </div>
                           
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
}

