@model ERPEntities.Tds

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}

<script src="http://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

<link href="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css"
      rel="Stylesheet" type="text/css" />

<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>


<style>
    #label {
        font-size: small;
        color: #0077B3;
    }

    h4 {
        font-size: 18px;
        padding: 10px 0;
        font-weight: 600;
    }

    .form-head h4 {
        padding: 10px 10px;
        font-size: 16px;
        font-weight: 600;
        background-color: #C1D5BD;
    }

    label {
        /*color: #3557B0;*/
        color: black;
    }

    .body-panel {
        border: 1px solid black;
        /*background-color: whitesmoke;*/
        margin-top: -10px;
        border-radius: 5px;
        background-color: floralwhite;
    }

    .submit-btn {
        display: inline-flex;
        padding: 7px;
    }

    .save-btn {
        padding-right: 5px;
    }

    .submit-btn button {
        border-radius: 30px;
        padding: 5px 5px;
    }

        .submit-btn button:hover {
            background-color: lightsalmon;
            transform: scale(1.1);
            color: white;
        }

    .save-btn input {
        /*border-radius: 30px;*/
        font-size: 12px;
    }

        .save-btn input:hover {
            background-color: Highlight;
            transform: scale(1.1);
        }

    fieldset {
        border: 1px solid #ddd !important;
        margin: 10px;
        /*max-width:0;*/
        padding: 5px;
        /* position:relative;*/
        padding-left: 10px !important;
        padding-right: 10px !important;
        background-color: whitesmoke;
    }

    legend {
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 0px;
        width: 50%;
        /*color: #3557B0;*/
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 3px 5px 3px 20px;
        background-color: lavender;
    }

    span.error {
        display: block;
        visibility: hidden;
        color: red;
        font-size: 50px;
    }


    .tablecontainer table {
        width: 100%;
        border-collapse: collapse;
        border-top: 1px solid #BFAEAE;
        border-right: 1px solid #BFAEAE;
    }

    .tablecontainer th {
        border-bottom: 2px solid #BFAEAE !important;
        background-color: gainsboro;
        font-size: small;
        text-align: center;
        height: 30px;
    }

    .tablecontainer th, .tablecontainer td {
        /*text-align: left;*/
        border-left: 1px solid #BFAEAE;
        padding: 5px;
        border-bottom: 1px solid #BFAEAE;
        font-size: small;
    }

    .ui-widget {
        font-size: 12px !important;
    }

    .reqError {
        color: #ff0000; /*Red Color*/
        font-weight: bold;
        font-size: 16px;
    }
</style>



@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <form class="form-horizontal" action="#" method="">
        <div class="row ">
            <div class="main-panel col-xs-12 col-sm-12 col-md-12 col-lg-12 ">

                <div class="body-panel">
                    <div class="couriertitle text-center bg-info">
                        <h4>TDS Deletion</h4>
                    </div>
                    <div class="">
                        <fieldset class="">
                            <legend class="">TDS</legend>
                            <div class="form-group row">
                                <div class="col-lg-4">
                                    <label id="label">Description</label>

                                    @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-4">
                                    <label id="label">Section</label>
                                    @Html.EditorFor(model => model.Section, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Section, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-lg-4">
                                    <label id="label">Code</label>
                                    @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-lg-3">
                                    <label id="label">AmountDeduction</label>
                                    @Html.EditorFor(model => model.AmountDeduction, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.AmountDeduction, "", new { @class = "text-danger" })
                                </div>


                                <div class="col-lg-3">
                                    <label id="label">Percents</label>
                                    @Html.EditorFor(model => model.Percents, new { htmlAttributes = new { @type = "date", @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Percents, "", new { @class = "text-danger" })
                                </div>



                            </div>

                        </fieldset>

                        <div class="form-group">
                            <div class="col-md-offset-1 col-md-10">


                                <input type="submit" id="deleteButton" value="Delete" class="btn btn-default" onclick="updateAndFlagRefresh()" />

                                <input type="button" value="Back to List" class="btn btn-success" style="border-radius:15px" onclick="window.history.back()" />





                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

}

<script>
    function updateAndFlagRefresh() {
        // Serialize the form data
        var formData = $("form").serialize();

        // Make an AJAX POST request
        $.ajax({
            type: "POST",
            url: "@Url.Action("Delete")",
            data: formData,
            success: function(result) {
                if (result.success) {
                    // Deletion was successful, close the window or perform other actions
                    sessionStorage.setItem("refreshIndexPage", "true");
                    window.close();
                } else {
                    // Show a popup message with the error message
                    alert(result.message);
                }
            },
            error: function() {
                console.log("AJAX request failed.");
            }
        });
    }
</script>

<script>
    $(document).ready(function () {
        // Attach a click event handler to the delete button
        $("#deleteButton").click(function (e) {
            e.preventDefault(); // Prevent the default form submission

            // Display a confirmation dialog
            var confirmDelete = confirm("Are you sure you want to delete this TDS?");

            if (confirmDelete) {
                // If the user confirms, submit the form
                $("form").submit();
            }
            // If the user cancels, do nothing
        });
    });
</script>
