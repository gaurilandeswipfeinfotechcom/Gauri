@*@using PagedList.Mvc*@
@using ERPModels
@model ERPModels.TdsSearchModel_Paging

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}


<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

<script src="http://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

<link href="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css"
      rel="Stylesheet" type="text/css" />

<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>


<script type="text/javascript">

    $(window).load(function () {

        var b = '@Session["LoginUserId"]';
        //var b = 9;
        $.ajax({
            url: '@Url.Action("GetInfo")',
            data: { "userId": b },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {

                if (data.length > 0) {

                    for (var i = 0; i < data.length; i++) {

                        if (data[i].FormName == "TDS") {

                        if (data[i].Create == "Y") {


                            $('#CreateTds').show();
                        }
                        else {

                            $('#CreateTds').hide();

                        }
                   }

                }

                }

            }
        });
    });


        function searchTds(id) {
        var txt = document.getElementById(id);
        //txt.value = txt.value.replace(/\w\S*/g, function (txt) { return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase(); });

        // var txt = document.getElementById(id);
        //alert("hi");
        $.ajax({
            url: '/Tds/AutocompleteTdsID/',
            data: { "searchByText": txt.value, "sortBy": $('#SortByColumnName').val() },
            type: "POST",
            dataType: "json",

            success: function (data) {
                $('#json-datalistTds').empty();
                var jsonOptions = data;
                var dataList = document.getElementById('json-datalistTds');

                jsonOptions.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = Tds;
                    dataList.appendChild(option);
                });
            },
            error: function (xhr, status, error) {
                alert(xhr.responseText);
            }
        });
    } //end of searchSalesOrderNo

    function validate() {
        if ($('#SearchByText').val() != "") {
            $('#SortByColumnName').val('Code');

        }
        else if ($('#SortByColumnName').val() != "Code") {
            $('#searchTds').val('');
        }
    }
    function funPageNoClicked(requestedPgNo) {
        $("#isPageNavigationRequested").val("true");
        $("#RequestedPageNumber").val(requestedPgNo);
        event.preventDefault();
        $("#Tds_List").submit();
    }
    $(function () {
        $("#Search").click(function () {
            $("#isPageNavigationRequested").val("false");
        });
    });
</script>

<style>
    #label {
        font-size: 15px;
        color: #0077B3;
        font-weight: 500
    }

    .table tr {
        border: 2px solid #fff;
        background-color: #e5e6eb
    }

    .panel .panel-body .table tr td {
        background-color: #e5e6eb;
        border-right: 2px solid #fff;
        border-top: 5px solid #fff;
    }

    .panel .panel-body .table tr th {
        border-bottom: 5px solid #fff;
    }

    table td {
        font-size: 13px;
    }

    .panel .panel-body .table tr td:hover {
        background-color: floralwhite
    }

    td span {
        border: none;
        background: none;
        color: blue;
        font-size: 15px;
    }

        td span i:hover {
            transform: scale(1.3);
            color: Highlight;
        }


    td .glyphicon-edit {
        color: green;
    }

    td .glyphicon-list {
        color: blue;
        padding: 0px 4px;
    }

    .table tr th {
        text-align: center;
        background-color: lightblue;
        font-family: Helvetica, sans-serif;
        color: midnightblue;
    }

    td .glyphicon-print {
        color: blueviolet;
    }

    .page td a {
        font-size: 12px;
    }

    .route-path1 {
        cursor: pointer;
        clip-path: polygon(0% 0%, 90% 0%, 100% 50%, 90% 100%, 0% 100%);
        background-color: #003399;
        color: white;
        padding: 5px 15px 5px 5px
    }

    .route-path2 {
        cursor: pointer;
        color: white;
        clip-path: polygon(91% 0%, 100% 50%, 91% 100%, 0% 100%, 9% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }
</style>


<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="Stylesheet" type="text/css" />
@*AP external CSS*@
<link href="~/Content/ERPStyle.css" rel="stylesheet" />

<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="d-flex" style="margin-top:-20px">
            <h4 class="route-path1" onclick="location.href='@Url.Action("Index","AccountInfo")'">Accounts </h4>
            <h4 class="route-path2 " onclick="location.href='@Url.Action("Index","Tds")'">TDS List</h4>
        </div>
        <br />

        <div class="panel panel-default outer-main-container">
            <div class="form-group row main-heading">
                <div class="col-lg-9 d-flex ">
                    <i class="material-icons" style="font-size: 32px; margin-right: 10px;">featured_play_list</i>
                    TDS List
                </div>
                <div class="col-lg-3">
                    <input type="button" id="CreateTds" value="Create" class="btn btn-success btn-round create-bttn courierCreate custo-inner" style="font-size:small;outline:none" onclick="location.href = '@Url.Action("Create", "Tds")'" />
                </div>
            </div>
            <div class="panel-body">
                @Html.TextBox("details", null, new { @onkeyup = "myFunction(this.id)", @class = "form-control", style = "display: none;" })
                @Html.TextBox("Edit", null, new { @onkeyup = "myFunction(this.id)", @class = "form-control", style = "display: none;" })
                @using (Html.BeginForm("Index", "Tds", FormMethod.Post, new { id = "Tds_List" }))
                {
                    <div class="panel panel-success search-rectangle" style="margin-top:-15px">
                        <div class="panel-body">
                            <div class="form-group row" style="margin-top:-15px">
                                <div class="col-lg-2 col-md-4 p-3">
                                    <label id="label" class="mt-4">Search By :</label>
                                    <div class="form-group row">
                                        @Html.DropDownListFor(m => m.SortByColumnName, new List<SelectListItem>
                                                                 {
                                                                  new SelectListItem{ Text="Code", Value = "Code" },
                                                                  new SelectListItem { Text="Section", Value ="Section"},
                                                                new SelectListItem { Text="Description", Value ="Description"},

                                                                 }, new { @class = "form-control fs-4 pl-3 dropdown-textbox", style = "height:35px;margin-top:-2px" })
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-8 p-3">
                                    <label id="label" class="mt-4">Find :</label>
                                    @Html.TextBoxFor(m => m.SearchByText, null, new
                               {
                                   @class = "form-control pl-3 fs-4 input-text-box",
                                   style = "height:35px",
                                   //@placeholder = "Sales Order No",
                                   @oninput = "searchTds(this.id)",
                                   @list = "json-datalistTds",
                                   autocomplete = "off" // Add this line to disable autocomplete
                               })
                                    <datalist id="json-datalistHSNCode"></datalist>
                                </div>
                                <div class="col-lg-4 row p-3">
                                    <div class="col-md-4 p-3 ">
                                        <label id="label">Sort:</label>
                                        <div class="form-group row">
                                            @Html.DropDownListFor(m => m.OrderByType, new List<SelectListItem>
                                                                     {
                                                                     //new SelectListItem{ Text="Please Select", Value = "Please Select" },
                                                                     new SelectListItem{ Text="Z-A", Value = "Z-A" },
                                                                     new SelectListItem{ Text="A-Z", Value = "A-Z" },
                                                                     }, new { @class = "form-control fs-4 pl-3 dropdown-textbox", style = "height:35px" })
                                        </div>
                                    </div>

                                    <div class="col-md-4 p-3">
                                        <label id="label">Records:</label>
                                        @Html.TextBoxFor(m => m.RecordsPerPage, null, new
                                   {
                                       @class = "form-control pl-3 fs-4 input-text-box",
                                       style = "height:35px"
                                   })
                                    </div>
                                    <div class="col-md-4 pt-md-3 p-3">
                                        <label id="label">Page No. :</label>
                                        @Html.TextBox("Page", null, new
                                   {
                                       @class = "form-control pl-3 fs-4 input-text-box",
                                       style = "height:35px"

                                   })
                                    </div>
                                </div>
                                <div class="col-lg-2 align-items-end d-flex">
                                    <button type="submit" id="Search" value="Search" name="Search" style="outline: none" class="mb-5 btn btn-success btn-round search-bttn custo-inner">
                                        Search<i class="material-icons" style="font-size: 20px;padding-left:15px">search</i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-group row" style="margin-top:-25px;margin-bottom:-15px">
                                <div class="col-sm-6 col-md-3 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Description :</label>
                                    @Html.CheckBoxFor(m => m.Description, true)
                                </div>
                                <div class="col-sm-6 col-md-2 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Section :</label>
                                    @Html.CheckBoxFor(m => m.Section, true)
                                </div>
                                <div class="col-sm-3 col-md-2 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Code :</label>
                                    @Html.CheckBoxFor(m => m.Code, true)
                                </div>
                                <div class="col-sm-6 col-md-3 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Amt.Deduction :</label>
                                    @Html.CheckBoxFor(m => m.AmountDeduction, true)
                                </div>
                                <div class="col-sm-3 col-md-2 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Percents :</label>
                                    @Html.CheckBoxFor(m => m.Percents, true)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="panel panel-success" style="box-shadow:inset 4px 4px 4px gray;border-radius:10px">
                        <div class="panel-body">
                            <div class="table-responsive">
                                <table id="stockTable" class="table">
                                    <tr style=" font-size: small">
                                        <th width="5%" style="border-right: 2px solid #fff">
                                            Sr No.
                                        </th>

                                        @if (Model.Description == true)
                                        {
                                            <th width="39%" style="border-right: 2px solid #fff" data-column="ItemCode">
                                                <!-- Add a data-column attribute -->
                                                Description
                                            </th>
                                        }

                                        @if (Model.Section == true)
                                        {
                                            <th width="10%" style="border-right: 2px solid #fff" data-column="ItemName">
                                                <!-- Add a data-column attribute -->
                                                Section
                                            </th>
                                        }

                                        @if (Model.Code == true)
                                        {
                                            <th width="10%" style="border-right: 2px solid #fff" data-column="RatePerUnit">
                                                <!-- Add a data-column attribute -->
                                                Code
                                            </th>
                                        }
                                        @if (Model.AmountDeduction == true)
                                        {
                                            <th width="13%" style="border-right: 2px solid #fff" data-column="UnitOfMeasure">
                                                <!-- Add a data-column attribute -->
                                                Amount Deduction
                                            </th>
                                        }
                                        @if (Model.Percents == true)
                                        {
                                            <th width="10%" style="border-right: 2px solid #fff" data-column="UnitOfMeasure">
                                                <!-- Add a data-column attribute -->
                                                Percents
                                            </th>
                                        }
                                        <th width="13%">Actions</th>
                                    </tr>

                                    @{ int sno = (Model.RequestedPageNumber - 1) * Model.RecordsPerPage + 1;
                                        foreach (var item in Model.TdsSearchedList)
                                        {
                                            <tr>
                                                <td class="text-center">
                                                    @sno
                                                    @{ sno++; }
                                                </td>

                                                @if (Model.Description == true)
                                                {
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Description)
                                                    </td>
                                                }
                                                @if (Model.Section == true)
                                                {
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.Section)
                                                    </td>
                                                }
                                                @if (Model.Code == true)
                                                {
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.Code)
                                                    </td>
                                                }
                                                @if (Model.AmountDeduction == true)
                                                {
                                                    <td align="right">
                                                        @Html.DisplayFor(modelItem => item.AmountDeduction)
                                                    </td>
                                                }
                                                @if (Model.Percents == true)
                                                {
                                                    <td class="text-center">
                                                        @Html.DisplayFor(modelItem => item.Percents)
                                                    </td>
                                                }
                                                <td>
                                                    <div class="text-center">
                                                        @if (Model.AllowEdit == true)
                                                        {
                                                            <span><i class="glyphicon glyphicon-edit" id="click" title="Edit" onclick="location.href = '@Url.Action("Edit", new { sono = item.TdsId })'"></i></span> }
                                                        else
                                                        {
                                                            <span><i class="glyphicon glyphicon-edit" style="display:none" title="Edit" onclick="location.href = '@Url.Action("edit", new { sono = item.TdsId })'"></i></span>}
                                                        @if (Model.AllowDetails == true)
                                                        {
                                                            <span><i class="glyphicon glyphicon-list" title="Details" onclick="location.href = '@Url.Action("Details",new {sono = item.TdsId })'"></i></span> }
                                                        else
                                                        {
                                                            <span><i class="glyphicon glyphicon-list" style="display:none" title="Details" onclick="location.href = '@Url.Action("Details",new {sono = item.TdsId })'"></i></span>}
                                                        @if (Model.AllowDelete == true)
                                                        {
                                                            <span><i class="glyphicon glyphicon-trash text-danger" title="Delete" onclick="location.href = '@Url.Action("Delete",new {sono = item.TdsId })'"></i></span> }
                                                        else
                                                        {
                                                            <span><i class="glyphicon glyphicon-trash text-danger" style="display:none" title="Delete" onclick="location.href = '@Url.Action("Delete",new {sono = item.TdsId })'"></i></span>}
                                                    </div>
                                                    @*<div class="row">
                                                <div class="col-lg-1">
                                                    <span><i class="glyphicon glyphicon-edit" style="cursor:pointer" onclick="openEditForm('@Url.Action("Edit", "Tds", new { sono = item.TdsId })')"></i></span>
                                                </div>
                                                <div class="col-lg-1">
                                                    <span><i class="glyphicon glyphicon-list" style="cursor:pointer" onclick="location.href='@Url.Action("Details", new { sono = item.TdsId })'"></i></span>
                                                </div>
                                                <div class="col-lg-1">
                                                    <span><i class="glyphicon glyphicon-trash" style="cursor:pointer" onclick="openDeleteForm('@Url.Action("Delete", "Tds", new { sono = item.TdsId })')"></i></span>
                                                </div>
                                            </div>*@
                                                </td>
                                            </tr>
                                        }
                                    }
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive p-2">
                        <table align="center">
                            <tr class="page">
                                @if (Model.PageCount > 1)
                                {
                                    @Html.HiddenFor(m => m.PageCount)
                                    <td>
                                        @if (Model.RequestedPageNumber > 1)
                                        {
                                            <a id="FirstPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-right: 5px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica " onclick='funPageNoClicked(1);'>First</a>
                                        }
                                    </td>

                                    <td>
                                        @if (Model.RequestedPageNumber > 1)
                                        {
                                            <a id="PreviousPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-right: 10px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica " onclick='funPageNoClicked(@Model.RequestedPageNumber - 1);'><b><</b></a>
                                        }
                                    </td>

                                    {
                                        int startPage;
                                        int endPage;

                                        if (Model.PageCount <= 10)
                                        {
                                            startPage = 1;
                                            endPage = Model.PageCount;
                                        }
                                        else
                                        {
                                            if (Model.RequestedPageNumber <= 6)
                                            {
                                                startPage = 1;
                                                endPage = 10;
                                            }
                                            else if (Model.RequestedPageNumber >= Model.PageCount - 4)
                                            {
                                                startPage = Model.PageCount - 9;
                                                endPage = Model.PageCount;
                                            }
                                            else
                                            {
                                                startPage = Model.RequestedPageNumber - 5;
                                                endPage = Model.RequestedPageNumber + 4;
                                            }
                                        }

                                        for (int pgno = startPage; pgno <= endPage; pgno++)
                                        {
                                            <td>
                                                <a id="PageNo" href="#" class="btn btn-secondary btn-round @(pgno == Model.RequestedPageNumber ? "active" : "")" onclick='funPageNoClicked(@pgno);'>@pgno.ToString()</a>
                                            </td>
                                        }
                                    }

                                    <td>
                                        @if (Model.RequestedPageNumber < Model.PageCount)
                                        {
                                            <a id="NextPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-left: 10px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica " onclick='funPageNoClicked(@Model.RequestedPageNumber + 1);'><b>></b></a>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.RequestedPageNumber < Model.PageCount)
                                        {
                                            <a id="LastPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-left: 5px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica " onclick='funPageNoClicked(@Model.PageCount);'>Last</a>
                                        }
                                    </td>
                                }
                                @Html.HiddenFor(x => x.isPageNavigationRequested)
                                @Html.HiddenFor(x => x.RequestedPageNumber)
                            </tr>
                        </table>
                    </div>

                    {
                        <div class="pager">
                            @*@Html.PagedListPager(Model, page => Url.Action("Index", new
                    {
                        page,
                        SortBy = ViewBag.SortBy,
                        OrderBy = ViewBag.OrderBy,
                        RecordPerPage = ViewBag.RecordPerPage,
                        SaleOrderDate = ViewBag.SaleOrderDate,

                        PurchaseOrderNo = ViewBag.PurchaseOrderNo,
                        PurchaseOrderDate = ViewBag.PurchaseOrderDate,
                        CompanyName = ViewBag.CompanyName


                    }))Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount*@


                        </div>
                    }
                }


            </div>



        </div>

        @*</div>
        </div>*@
    </div>
</div>

<script type="text/javascript">
    function openEditForm(editFormUrl) {
        var editTab = window.open(editFormUrl, '_blank');

        // Listen for the edit tab closure
        editTab.onbeforeunload = function () {
            // Refresh the index page when the edit tab is closed
            location.reload();
        };
    }
</script>
<script type="text/javascript">
    function openDeleteForm(deleteFormUrl) {
        var editTab = window.open(deleteFormUrl, '_blank');

        // Listen for the edit tab closure
        editTab.onbeforeunload = function () {
            // Refresh the index page when the edit tab is closed
            location.reload();
        };
    }
</script>
