<script type="text/javascript">
    function openEditForm(editFormUrl) {
        var editTab = window.open(editFormUrl, '_blank');

        // Listen for the edit tab closure
        editTab.onbeforeunload = function () {
            // Refresh the index page when the edit tab is closed
            location.reload();
        };
    }
</script>

<script type="text/javascript">
    function openDeleteForm(deleteFormUrl) {
        var editTab = window.open(deleteFormUrl, '_blank');

        // Listen for the edit tab closure
        editTab.onbeforeunload = function () {
            // Refresh the index page when the edit tab is closed
            location.reload();
        };
    }
</script>




