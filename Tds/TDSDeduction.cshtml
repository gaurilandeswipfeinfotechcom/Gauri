<script type="text/javascript">

    $(window).load(function () {

        var b = '@Session["LoginUserId"]';
        //var b = 9;
        $.ajax({
            url: '@Url.Action("GetInfo")',
            data: { "userId": b },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {

                if (data.length > 0) {

                    for (var i = 0; i < data.length; i++) {

                        if (data[i].FormName == "PurchaseInvocie") {

                        if (data[i].Create == "Y") {


                            $('#CreateTds').show();
                        }
                        else {

                            $('#CreateTds').hide();

                        }
                   }

                }

                }

            }
        });
    });


        function searchTds(id) {
        var txt = document.getElementById(id);
        //txt.value = txt.value.replace(/\w\S*/g, function (txt) { return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase(); });

        // var txt = document.getElementById(id);
        //alert("hi");
        $.ajax({
            url: '/Tds/AutocompleteTdsID/',
            data: { "searchByText": txt.value, "sortBy": $('#SortByColumnName').val() },
            type: "POST",
            dataType: "json",

            success: function (data) {
                $('#json-datalistTds').empty();
                var jsonOptions = data;
                var dataList = document.getElementById('json-datalistTds');

                jsonOptions.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = Tds;
                    dataList.appendChild(option);
                });
            },
            error: function (xhr, status, error) {
                alert(xhr.responseText);
            }
        });
    } //end of searchSalesOrderNo

    function validate() {
        if ($('#SearchByText').val() != "") {
            $('#SortByColumnName').val('Code');

        }
        else if ($('#SortByColumnName').val() != "Code") {
            $('#searchTds').val('');
        }
    }
    function funPageNoClicked(requestedPgNo) {
        $("#isPageNavigationRequested").val("true");
        $("#RequestedPageNumber").val(requestedPgNo);
        event.preventDefault();
        $("#Tds_List").submit();
    }
    $(function () {
        $("#Search").click(function () {
            $("#isPageNavigationRequested").val("false");
        });
    });


    window.onload = function () {
        const exportButton = document.getElementById("exportButton");
        const exportFormat = document.getElementById("exportFormat");
        const startDateInput = document.getElementById("startDate");
        const endDateInput = document.getElementById("endDate");

        exportButton.onclick = function () {
            const startDate = startDateInput.value;
            const endDate = endDateInput.value;
            const format = exportFormat.value;

            if (!startDate || !endDate) {
                alert("Please select both start and end dates.");
                return;
            }

            const url = `/Tds/ExportData?startDate=${startDate}&endDate=${endDate}&exportFormat=${format}`;

            fetch(url, {
                method: 'GET'
            })
                .then(response => {
                    if (!response.ok) throw new Error("Network error");
                    return response.blob();
                })
                .then(blob => {
                    const downloadUrl = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = downloadUrl;
                    a.download = `PurchaseInvoices.${format.toLowerCase()}`;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                })
                .catch(error => {
                    console.error("Export failed:", error);
                    alert("Export failed.");
                });
        };
    };



    function showInvoicegst() {

        //console.log("mgid id: " + mgid);  // For debugging purposes
        openModal('gstModal', 'purchaseModalOverl');  // Open the modal
        // Step 1: AJAX call to fetch the Print page content and show in iframe

    }


    // Function to open the modal
    function openModal(modalId, overlayId) {
        document.getElementById(modalId).style.display = "block";
        document.getElementById(overlayId).style.display = "block";
    }

    // Function to close the modal
    function closeModal(modalId) {
        document.getElementById(modalId).style.display = "none";
        document.getElementById(modalId + "Overlay").style.display = "none";
    }

</script>

