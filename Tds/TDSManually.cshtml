
@model ERPEntities.PurchaseInvoice
@{
    ViewBag.Title = "TDSManually";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}

<style>

    #label {
        font-size: small;
        color: #0077B3;
    }
    /*Adding some css for looks good*/
    h4 {
        font-size: 18px;
        padding: 10px 0;
        font-weight: 600;
    }

    .form-head h4 {
        padding: 10px 10px;
        font-size: 16px;
        font-weight: 600;
        background-color: #C1D5BD;
    }
    /*#label {
        font-size: small;
        color: #0077B3;
    }*/

    .body-panel {
        border: 1px solid black;
        /*background-color: whitesmoke;*/
        margin-top: -10px;
        border-radius: 5px;
        background-color: floralwhite;
    }

    .submit-btn {
        display: inline-flex;
        padding: 7px;
    }


        .submit-btn button {
            border-radius: 30px;
            padding: 5px 5px;
        }

            .submit-btn button:hover {
                background-color: lightsalmon;
                transform: scale(1.1);
                color: white;
            }

    .save-btn input {
        /*border-radius: 30px;*/
        font-size: 14px;
    }

        .save-btn input:hover {
            background-color: aqua;
            transform: scale(1.1);
        }

    .panel-field {
        border: 1px solid #ddd !important;
        margin: 10px;
        /*max-width:0;*/
        padding: 5px;
        /* position:relative;*/
        padding-left: 10px !important;
        padding-right: 10px !important;
        /*background-color: whitesmoke;*/
        /* background-color: white;*/
        background-color: #f0f5f5;
    }

    fieldset {
        border: 1px solid #ddd !important;
        margin: 10px;
        /*max-width:0;*/
        padding: 5px;
        /* position:relative;*/
        padding-left: 10px !important;
        padding-right: 10px !important;
        /*background-color: whitesmoke;*/
        /* background-color: white;*/
        background-color: white;
    }

    legend {
        font-size: 14px;
        font-weight: bold;
        margin-bottom: 0px;
        width: 50%;
        /*color: #3557B0;*/
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 3px 5px 3px 20px;
        background-color: lavender;
    }

    #label {
        font-size: small;
        color: #0077B3;
    }


    .button {
        display: inline-block;
        /*padding: 5px 6px;*/
        /*font-size: 5px;*/
        padding: 20px;
        font-size: 16px;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        outline: none;
        /*color: #fff;*/
        /*background-color: #4CAF50;*/
        /*background-color: cyan;*/
        border: none;
        border-radius: 15px;
        box-shadow: 0 9px #999;
        height: 3px;
        width: auto;
        background-color: deepskyblue;
        color: white;
        margin: 4px 2px;
    }

        .button:hover {
            /*background-color: #3e8e41*/
            background-color: cyan;
        }

        .button:active {
            background-color: cyan;
            box-shadow: 0 5px #666;
            transform: translateY(4px);
        }

    .button1 {
        border-radius: 50%;
    }

    span.error {
        display: block;
        visibility: hidden;
        color: red;
        font-size: 60px;
    }

    .tablecontainer table {
        width: 100%;
        border-collapse: collapse;
        border-top: 1px solid #BFAEAE;
        border-right: 1px solid #BFAEAE;
    }

    .tablecontainer th {
        border-bottom: 2px solid #BFAEAE !important;
        background-color: lightcyan;
        font-size: small;
        text-align: center;
        height: 30px;
    }

    .tablecontainer th, .tablecontainer td {
        /*text-align: left;*/
        border-left: 1px solid #BFAEAE;
        padding: 5px;
        border-bottom: 1px solid #BFAEAE;
        font-size: small;
    }

    .ui-widget {
        font-size: 12px !important;
    }

    .reqError {
        color: #ff0000; /*Red Color*/
        font-weight: bold;
        font-size: 16px;
    }
</style>

<script src="http://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

<link href="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css"
      rel="Stylesheet" type="text/css" />

<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>



@using (Html.BeginForm("TDSManually", "TDS", FormMethod.Post))
{
    @*@Html.ValidationSummary()*@

    <div class="row">
        <div class="main-panel col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <div class="body-panel">
                <div class="couriertitle text-center bg-info">
                    <h4>TDS Deduction Manually</h4>
                </div>

                <div class="form-group row" style="margin-left:7px">
                    <div class="col-lg-4">
                        @Html.HiddenFor(model => model.StatusId)
                        @Html.EditorFor(model => model.UserId, new { htmlAttributes = new { @class = "form-control", style = "display: none;" } })

                        <div class="">
                            <label id="label">Vendor Name</label>
                            <div class="form-group row">
                                @Html.DropDownList("BusinessEntityId", (IEnumerable<SelectListItem>)ViewBag.BusinessEntityId, "Please Select", new { @style = "font-size:small;height:35px", @class = "form-control" })
                            </div>
                        </div>
                        <br /><p id="companyType" style="color:darkblue"></p>
                    </div>



                    <div class="col-lg-2">
                        <label id="label">From</label>
                        <input type="date" id="Fromdate" class="form-control" />
                    </div>
                    <div class="col-lg-2">
                        <label id="label">To</label>
                        <input type="date" id="Todate" class="form-control" />
                    </div>
                    <div class="col-lg-2" id="periodtime">
                        <label id="label">Select Period</label>
                        <div>
                            <select class="" value="--Select Period--" name="cars" id="period" style="height:34px">
                                <option value="select">--Select Period--</option>
                                <option value="Last Month">Last Month</option>
                                @*<option value="Monthly">Monthly</option>
                                    <option value="Quarterly">Quarterly</option>
                                    <option value="Half Yearly">Half Yearly</option>*@
                                <option value="Last Year">Last Year</option>
                            </select>
                        </div>

                    </div>
                    <div class="col-lg-2">
                        <div class="form-group row ">
                            <input type="button" id="btnsearchdet" value="Search" name="btnsearchdet" class="btn btn-success btn-round" style="outline-style:none;border:none;margin-top:16px" onclick="GetDetailsByLedger();" />
                        </div>
                    </div>

                </div>


                <!-- Panel for Item Details -->
                <div class="panel panel-success" style="margin: 5px 5px;">
                    <div class="panel-heading" style="color:black;font-family:Helvetica;font-size:small;"><b>Purchase Invoice Details</b></div>
                    <div class="panel-body">

                        <div class="form-group row" style="margin-left:2px;margin-right:2px;">
                            <div class="col-md-12 col-md-12">
                                <label id="label"></label>
                                <div id="orderItems" class="tablecontainer">
                                    <!-- Table for displaying generated items -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    @*<input type="button" id="submit" value="Update" class="btn btn-info" onclick="UpdateStatus();">*@
                    @*<button id="deductTDS" class="btn btn-primary">Deduct</button>*@
                    <button id="deductTDS" type="button" class="btn btn-primary">Deduct</button>


                    <input type="button" id="submit" value="Clear" class="btn btn-success" onclick="location.reload();">
                    <input type="button" id="submit" value="Close" class="btn btn-success" onclick="location.href = '@Url.Action("TDSDeduction", "TDS")'">
                </div>
            </div>
        </div>
    </div>
}

<script>

    $(document).ready(function () {

        $("#period").change(function () {
            if ($(this).val() !== "select") {
                $("#Fromdate").val("");
                $("#Todate").val("");
            }
        });

        $("#Fromdate, #Todate").change(function () {
            if ($("#Fromdate").val() !== "" || $("#Todate").val() !== "") {
                $("#period").val("select");
            }
        });

    });

    // Handle Enter key press to trigger UpdateStatus function
    $('#BusinessEntityId').keypress(function (event) {
        if (event.which === 13) { // Check if Enter key is pressed
            event.preventDefault(); // Prevent default form submission behavior
            if ($('#BusinessEntityId').hasClass('input-validation-error')) {
                return; // Prevent submission if input is invalid
            }
            GetDetailsByLedger(); // Call your UpdateStatus function
        }
    });

    // Function to handle Update button click
    $('#submit').click(function () {
        if ($('#BusinessEntityId').hasClass('input-validation-error')) {
            return; // Prevent submission if input is invalid
        }
        GetDetailsByLedger(); // Call your UpdateStatus function
    });

    function GetDetailsByLedger() {
        var fromdate = $('#Fromdate').val();
        var todate = $('#Todate').val();
        var timeperiod = $('#period').val();

        $('#orderItems').empty();
        orderItems = [];
        console.log('Sending data to server:', { Sono: $('#BusinessEntityId').val().trim(), "FromDate": fromdate, "ToDate": todate, "TimePeriod": timeperiod });

        $.ajax({
            url: '/Tds/GetTDSDeduction/',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ Sono: $('#BusinessEntityId').val().trim(), "FromDate": fromdate, "ToDate": todate, "TimePeriod": timeperiod }),
            success: function (result) {
                console.log('Received response from server:', result);

                if (result.error) {
                    alert(result.error);
                    return;
                }

                if (result.length > 0) {
                    console.log('Company Type:', result[0].CompanyType);
                    $('#companyType').text("Type of Company: " + result[0].CompanyType); // Use .text() instead of .val()
                }

                orderItems = result || []; // Ensure result is an array
                GeneratedItemsTable();
            },
            error: function (xhr, status, error) {
                console.error('Error fetching data:', error);
            }
        });
    }

    function GeneratedItemsTable() {

        console.log('Generating items table with orderItems:', orderItems);

        if (!orderItems || orderItems.length === 0) {
            $('#orderItems').html('<p>No records found.</p>');
            return;
        }

        var totalProductSubTotal = 0;
        var totalTDSAmount = 0;

        var table = '<table class="table table-bordered table-striped">';
        table += '<thead>';
        table += '<tr>';
        table += '<th>S.No</th>';
        table += '<th>Check</th>';
        table += '<th>Purchase Invoice No</th>';
        table += '<th>Purchase Invoice Date</th>';
        table += '<th>Product Sub Total</th>';
        table += '<th>TDS Status</th>';
        table += '<th>TDS Deductable</th>';
        table += '</tr>';
        table += '</thead>';
        table += '<tbody>';

        $.each(orderItems, function (i, item) {

            var productSubTotal = parseFloat(item.ProductSubTotal) || 0;
            var tdsAmount = parseFloat(item.TDSAmount);

            totalProductSubTotal += productSubTotal;

            if (!isNaN(tdsAmount)) {
                totalTDSAmount += tdsAmount;
            }

            // Get applicability from backend
            var isApplicable =
                item.TDSApplicable &&
                item.TDSApplicable.toString().trim().toLowerCase() === "applicable";

            var tdsRateDisplay = isApplicable
                ? '<a href="#" class="apply-tds" data-index="' + i + '">Applicable</a>'
                : 'Not Applicable';

            var tdsAmountDisplay = isApplicable
                ? (isNaN(tdsAmount) ? 'Applicable' : tdsAmount.toFixed(2))
                : 'Not Applicable';

            var purValue = item.PUR || item.PurInvoiceNo || '';

            table += '<tr>';

            table += '<td>' + (i + 1) + '</td>';

            table += '<td>';
            table += '<input type="checkbox" class="tds-checkbox" data-pur="' + purValue + '" ' +
                (isApplicable ? '' : 'disabled') + '>';
            table += '</td>';

            table += '<td>' + purValue + '</td>';

            table += '<td>' +
                (item.PurInvoiceDate ? formatDate(item.PurInvoiceDate) : '') +
                '</td>';

            table += '<td style="text-align:right;">' +
                productSubTotal.toFixed(2) +
                '</td>';

            table += '<td style="text-align:center;">' +
                tdsRateDisplay +
                '</td>';

            table += '<td style="text-align:right;" class="tds-amount" data-index="' + i + '">' +
                tdsAmountDisplay +
                '</td>';

            table += '</tr>';
        });

        table += '<tr style="font-weight:bold;background:#f9f9f9;">';
        table += '<td colspan="4" style="text-align:right;">Total</td>';
        table += '<td style="text-align:right;">' + totalProductSubTotal.toFixed(2) + '</td>';
        table += '<td></td>';
        table += '<td style="text-align:right;">' + totalTDSAmount.toFixed(2) + '</td>';
        table += '</tr>';

        table += '</tbody>';
        table += '</table>';

        $('#orderItems').html(table);

        console.log('Generated table HTML:', table);
    }

    // Date formatting function for invoice date
    function formatDate(jsonDate) {
        if (!jsonDate) return '';
        var match = jsonDate.match(/\/Date\((\d+)\)\//);
        if (!match) return '';
        var date = new Date(parseInt(match[1]));
        var day = String(date.getDate()).padStart(2, '0');
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var year = date.getFullYear();
        return `${day}-${month}-${year}`;
    }

    // Handling clicking on "Applicable" link
    $(document).on('click', '.apply-tds', function (e) {
        e.preventDefault();
        var index = $(this).data('index');
        var item = orderItems[index];
        var productSubTotal = parseFloat(item.ProductSubTotal);

        console.log('TDS application clicked for invoice:', item.PUR, 'Amount:', productSubTotal);

        //if (productSubTotal < 30000) {
        //    alert('TDS not applicable for amount less than 30000');
        //    return;
        //}

        let companyTypeText = $('#companyType').text();
        let companyType = companyTypeText.replace('Type of Company: ', '').trim();
        // Fetch the TDS rate based on the amount
        $.ajax({
            url: '/TDS/GetTDSRateByAmount',
            type: 'GET',
            //data: { amount: productSubTotal },
            data: { companyType: companyType },
            success: function (response) {
                console.log('TDS Rate fetched:', response);

                var rate = response.Rate;
                var tdsId = response.TDSId;

                if (rate && !isNaN(rate)) {
                    var tdsAmount = (productSubTotal * rate) / 100;

                    // Update the orderItems with the new TDS values
                    item.TDSRate = rate + '%';
                    item.ProductSubTotal = productSubTotal,
                    item.TDSAmount = tdsAmount;
                    item.TDSId = tdsId;

                    console.log('Updated TDS info for invoice:', item.PUR, 'TDS Rate:', rate, 'TDS Amount:', tdsAmount);

                    // Re-generate the table to reflect changes
                    GeneratedItemsTable();
                } else {
                    alert('TDS rate not found.');
                }
            },
            error: function () {
                alert('Failed to fetch TDS rate.');
            }
        });
    });


    $('#deductTDS').on('click', function () {
        var selectedPeriod = $('#financialPeriod').val();
        let selectedPurNos = [];
        let itemsToUpdate = [];

        // ✅ Collect checked checkbox values
        $('.tds-checkbox:checked').each(function () {
            selectedPurNos.push($(this).data('pur')?.toString());
        });

        // ✅ Filter selected items from orderItems
        let selectedItems = orderItems.filter(item => {
            let pur = (item.PUR || item.PurInvoiceNo || '').toString();
            return selectedPurNos.includes(pur);
        });

        console.log('Selected Items:', selectedItems);

        let smallInvoices = orderItems.filter(item => parseFloat(item.ProductSubTotal) < 30000);
        let largeInvoices = orderItems.filter(item => parseFloat(item.ProductSubTotal) >= 30000);

        let totalLargeInvoicesAmount = largeInvoices.reduce((sum, item) => {
            let subTotal = parseFloat(item.ProductSubTotal);
            return !isNaN(subTotal) ? sum + subTotal : sum;
        }, 0);

        let totalOfSmallInvoices = smallInvoices.reduce((sum, item) => {
            let subTotal = parseFloat(item.ProductSubTotal);
            return !isNaN(subTotal) ? sum + subTotal : sum;
        }, 0);

        console.log('Total of large invoices:', totalLargeInvoicesAmount);
        console.log('Total of small invoices:', totalOfSmallInvoices);

        let companyTypeText = $('#companyType').text();
        let companyType = companyTypeText.replace('Type of Company: ', '').trim();

        // ✅ CASE 1: Proprietorship – Apply TDS only to selected invoices
        if (companyType === 'Proprietorship') {
            if (selectedItems.length === 0) {
                event.preventDefault();
                alert('Please select invoices to apply TDS.');
                return;
            }

            $.ajax({
                url: '/TDS/GetTDSRateByAmount',
                type: 'GET',
                data: { companyType: companyType },
                success: function (response) {
                    if (response && response.Rate && !isNaN(response.Rate)) {
                        let rate = response.Rate;
                        let tdsId = response.TDSId;

                        selectedItems.forEach(item => {
                            let subTotal = parseFloat(item.ProductSubTotal) || 0;
                            let tdsAmount = (subTotal * rate) / 100;

                            itemsToUpdate.push({
                                PurInvoiceNo: item.PUR || item.PurInvoiceNo,
                                TDSRate: rate,
                                ProductSubTotal: subTotal,
                                TDSAmount: tdsAmount,
                                TdsId: tdsId
                            });
                        });

                        console.log('itemsToUpdate before applyTDS:', itemsToUpdate);
                        applyTDS(itemsToUpdate, 'TDS applied to small invoices total ≥ ₹1,00,000.');
                    } else {
                        alert('No applicable TDS rate found.');
                    }
                },
                error: function () {
                    alert('Error while fetching TDS rate.');
                }
            });
        }

        // ✅ CASE 2: Company – Apply TDS if total of small invoices >= ₹1,00,000
        else if (companyType === 'Company' || companyType === 'Partnership / Firm') {
            //if (totalOfSmallInvoices < 100000) {
            //    alert('TDS not applicable: Total of small invoices is less than ₹1,00,000.');
            //    return;
            //}
            if (selectedItems.length === 0) {
                event.preventDefault();
                alert('Please select invoices to apply TDS.');
                return;
            }

            $.ajax({
                url: '/TDS/GetTDSRateByAmount',
                type: 'GET',
                data: { companyType: companyType },
                success: function (response) {
                    if (response && response.Rate && !isNaN(response.Rate)) {
                        let rate = response.Rate;
                        let tdsId = response.TDSId;

                        selectedItems.forEach(item => {
                            let subTotal = parseFloat(item.ProductSubTotal) || 0;
                            let tdsAmount = (subTotal * rate) / 100;

                            itemsToUpdate.push({
                                PurInvoiceNo: item.PUR || item.PurInvoiceNo,
                                TDSRate: rate,
                                ProductSubTotal:subTotal,
                                TDSAmount: tdsAmount,
                                TdsId: tdsId
                            });
                        });

                        console.log('itemsToUpdate before applyTDS:', itemsToUpdate);
                        applyTDS(itemsToUpdate, 'TDS applied successfully.');

                    } else {
                        alert('No applicable TDS rate found.');
                    }
                },
                error: function () {
                    alert('Error while fetching TDS rate.');
                }
            });
        } else {
            alert('No eligible invoices for TDS (none ≥ ₹30,000, and total < ₹100,000).');
        }

        // ✅ Shared AJAX call to update TDS
        function applyTDS(items, successMessage) {
            console.log('Sending the following data to server:', items);

            //var BusinessEntityId = $("#BusinessEntityId").val();
            //items.BusinessEntityId = BusinessEntityId;
            var BusinessEntityId = $("#BusinessEntityId").val();
            console.log('Sending businessentityid:', BusinessEntityId);
            // ✅ attach to each object
            items.forEach(function (item) {
                item.BusinessEntityId = BusinessEntityId;
            });

            $.ajax({
                url: '/TDS/UpdateTDSOnTrans',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(items),
                success: function () {
                    GeneratedItemsTable();
                    alert(successMessage);
                    window.location.href = '/TDS/TDSDeduction'; // 🔥 Redirect after success
                },
                error: function () {
                    alert('Failed to update TDS.');
                }
            });
        }
    });

</script>

