@model IEnumerable<ERPEntities.PaymentTerms>
@*@model ERPModels.TDSearchModel_Paging*@
@using System.Web.Optimization

@{
    ViewBag.Title = "Terms Of Delivery List";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">


<script type="text/javascript">
    $(window).load(function () {
        //var b = 9;
        var b = '@Session["LoginUserId"]';
        $.ajax({
            url: '@Url.Action("GetInfo")',
            data: { "userId": b },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {

                if (data.length > 0) {

                    for (var i = 0; i < data.length; i++) {

                        if (data[i].FormName == "TermsOfDelevary") {

                            if (data[i].Create == "Y") {

                                $('#CreateTD').show();
                            }
                            else {

                                $('#CreateTD').hide();
                            }
                            if (data[i].Edit == "Y") {

                                $('#Edit').show();
                            }
                            else {

                                $('#Edit').hide();
                            }
                            //if (data[i].Details == "Y") {

                            //    $('#Details').show();
                            //}
                            //else {

                            //    $('#Details').hide();
                            //}
                        }
                    }
                }
            }
        });
    });


</script>

<style>

    #label {
        font-size: 15px;
        color: #0077B3;
        font-weight: 500
    }

    .table tr {
        border: 5px solid #fff;
        background-color: #e5e6eb
    }

    .panel .panel-body .table tbody tr td {
        background-color: #e5e6eb;
        border-inline: 2px solid #fff;
        border-bottom: 5px solid #fff;
    }

    table td {
        font-size: 13px;
    }

    .panel .panel-body .table tbody tr td:hover {
        background-color: floralwhite
    }

    td a {
        border: none;
        background: none;
        color: blue;
        font-size: 15px;
    }

        td a i:hover {
            transform: scale(1.3);
            color: Highlight;
        }


    td .glyphicon-edit {
        color: green;
    }

    td .glyphicon-list {
        color: blue;
        padding: 0px 4px;
    }
    td .glyphicon-print {
        color: blueviolet;
    }

    .table thead tr th {
        text-align: center;
        background-color: lightblue;
        font-family: Helvetica, sans-serif;
        color: midnightblue;
        border-inline: 2px solid #fff;
        font-size: small;
        
    }

  


    .route-path1 {
        clip-path: polygon(0% 0%, 85% 0%, 100% 50%, 85% 100%, 0% 100%);
        background-color: #003399;
        color: white;
        padding: 5px 15px 5px 5px
    }

    .route-path2 {
        cursor: pointer;
        color: white;
        clip-path: polygon(95% 0%, 100% 50%, 95% 100%, 0% 100%, 5% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }
</style>


<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="Stylesheet" type="text/css" />
@*AP external CSS*@
<link href="~/Content/ERPStyle.css" rel="stylesheet" type="text/css" />

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="d-flex" style="margin-top:-20px">
            <h4 class="route-path1">Sales </h4>
            <h4 class="route-path2" onclick="location.href='@Url.Action("Index","TermsOfDelivery")'">Terms of Delivery</h4>
        </div>
        <br />
        <div class="panel panel-default outer-main-container">
            <div class="form-group row main-heading">
                <div class="col-lg-9 d-flex ">
                    <i class="material-icons" style="font-size: 32px; margin-right: 10px;">payments</i>
                    Terms Of Delivery List
                </div>
                <div class="col-lg-3">
                    <input type="button" id="CreatePurchaseOrder" value="Create" class="btn btn-success btn-round create-bttn courierCreate custo-inner" style="font-size:small;outline:none;" onclick="location.href = '@Url.Action("Create", "TermsOfDelivery")'" />
                </div>
            </div>

            <div style="padding-inline:20px">
            <div class="panel panel-success" style="box-shadow:inset 4px 4px 4px gray;border-radius:10px">
                <div class="panel-body">
                    <div class="table-responsive">
                        <table class="table" id="termsOfDeliveryTable">
                            <thead>
                                <tr>
                                    <th style="border-bottom: 10px solid #fff;text-align:center">Terms of Delivery</th>
                                    <th style=" border-bottom: 10px solid #fff; text-align: center">Actions</th>
                                </tr>
                            </thead>
                                <tbody >
                                    @foreach (var item in Model.Where(x => x.TermsOfDelivery != null))
                                    {
                                        <tr >
                                            <td style="text-align:center">@item.TermsOfDelivery</td>
                                           <td style="text-align:center" >

                                                <a href="@Url.Action("Edit", new { id = item.PaymentTermId })" class="text-warning" title="Edit" style="margin-right: 10px" id="Edit">
                                                    <i class="glyphicon glyphicon-edit"></i>
                                                </a>


                                                <a href="@Url.Action("Details", new { id = item.PaymentTermId })" class="text-info" title="Details" style="margin-right: 10px" id="Details;">
                                                    <i class="glyphicon glyphicon-list"></i>
                                                </a>
                                                <a href="@Url.Action("Delete", new { id = item.PaymentTermId })" class="text-danger" title="Delete" style="margin-right: 10px;">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </td>
                                        </tr>

                                    }
                                </tbody>
                            </table>
                    </div>
                </div>
            </div>
        </div></div>
    </div>
</div>

@Scripts.Render("~/bundles/jquery")
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
<script>
    $(document).ready(function () {
        $('#termsOfDeliveryTable').DataTable({
            "paging": true,
            "searching": true,
            "ordering": true,
            "lengthChange": true,
            "info": true
        });
    });
</script>
<style>
    .dataTables_length label{
        color:#000;
    }
        .dataTables_length .custom-select {
            font-size: small;
            box-shadow: inset 2px 2px 4px gray;
        }
    .dataTables_filter label {
        color: #000;
    }
        .dataTables_filter label span input {
            box-shadow: inset 2px 2px 5px gray;
            height: 35px
        }
    .dataTables_info {
        font-size: small;
    }
    #termsOfDeliveryTable_wrapper{
        padding:5px
    }
</style>
