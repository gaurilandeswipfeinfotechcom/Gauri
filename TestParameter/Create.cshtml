<script>
    //let extractedPh;
    //let extractedvdc;
    function GetCode(id) {

        var selectedText = $("#ItemId option:selected").text();

        //var match1 = selectedText.match(/(\d+)\s*Ph/);
        var match = selectedText.match(/(\d+)\s*(Ph|PH|ph)/i);
        //var itemName = selectedText.match(/(\d+)\s*Watt/);
        var itemNameLower = selectedText.toLowerCase();
        console.log('selected item is ', match);
        console.log('selected item is ', itemNameLower);

        // Allow null / undefined safely
        var extractedPh = match ? match[0] : null;
      
        if (extractedPh == '3 Ph' || extractedPh == '3 ph') {
            var match2 = selectedText.match(/Watt\s*(\d+)\s*\/\s*(\d+)/i);
            var supplyVolt1 = match2[1];
            var supplyVolt2 = match2[2];
            // show all 3-phase fieldsets
            $(".phase-3ph").removeClass("d-none");
            $(".phase-3ph1").removeClass("d-none");
            $('#SupplyVolt1').val(supplyVolt1);
            $('#SupplyVolt2').val(supplyVolt2);
            // hide all 1-phase fieldsets
            $(".phase-1ph").addClass("d-none");
            $(".resMinMax").addClass("d-none");
            $('#capacitorPara').removeClass("d-none");
        }
        else if (itemNameLower.includes("vdc")) {
            var match2 = itemNameLower.match(/watt\s*([\s\S]+?vdc)/i);

            var SupplyVolt1ph = match2[1];
            $('#SupplyVolt1').val(SupplyVolt1ph);
            // show all 1-phase fieldsets
            $(".phase-3ph1").removeClass("d-none");
            $(".resMinMax").removeClass("d-none");
            $(".phase-1ph").addClass("d-none");
            // hide all 3-phase fieldsets
            $(".phase-3ph").addClass("d-none");
            $('#capacitorPara').addClass("d-none");

            console.log('checking match2', SupplyVolt1ph);
        }
        else {
            var match2 = selectedText.match(/Watt\s*(\d+(\.\d+)?)/i);

            var SupplyVolt1ph = match2[1];
            $('#SupplyVolt1').val(SupplyVolt1ph);
            // show all 1-phase fieldsets
            $(".phase-3ph1").removeClass("d-none");
            $(".phase-1ph").removeClass("d-none");
            // hide all 3-phase fieldsets
            $(".phase-3ph").addClass("d-none");
            $(".resMinMax").addClass("d-none");
            $('#capacitorPara').removeClass("d-none");
        }
    }

    //$("#testParameterForm").submit(function (e) {
    //    e.preventDefault();  // this blocks the submission
    //});

    $(document).ready(function () {

        // On click Create button
        $("#btnCreate").click(function () {

            let errors = [];

            //const ledgerID = $('#editLedgerID').val();
            const RatedCurrent = $('#RatedCurrent').val();
            const ItemId = $('#ItemId').val();
            const Frequency = $('#Frequency').val();
            const Poles = $('#Poles').val();
            const Duty = $('#Duty').val();

            if (!ItemId) errors.push("Item must be selected.");
            if (!Frequency) errors.push("Please enter Frequency.");
            if (!Poles) errors.push("Please enter Poles.");
            if (!Duty) errors.push("Please enter Duty.");
            if (!ItemId) errors.push("Item must be selected.");
            if (!RatedCurrent) errors.push("Please enter Rated Current.");
            //if (!rate || isNaN(rate) || Number(rate) <= 0) errors.push("Rate must be a positive number.");

            if (errors.length > 0) {
                alert("Please fix the following issues:\n" + errors.join("\n"));
                return false;
            }
            /*var token = $('input[name="__RequestVerificationToken"]').val();*/
            var formData = $("#testParameterForm").serialize();
            // Prepare data for AJAX
            //var formData = $("#testParameterForm").serialize(); // includes AntiForgeryToken

            $.ajax({
                url: '/TestParameter/Create',
                type: 'POST',
                data: formData,
                //headers: { 'RequestVerificationToken': token },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        $("#testParameterForm")[0].reset();
                        window.location.href = '@Url.Action("Index", "TestParameter")';
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert("AJAX error: " + error);
                }
            });

        });

    });

   function loadParametersFromCopyItem(itemId) {
    if (!itemId) {
        alert("Please select a valid item to copy parameters.");
        return;
    }

    $.ajax({
        url: '@Url.Action("GetTestParametersByItemId", "TestParameter")',
        type: 'GET',
        data: { itemId: itemId },
        success: function (data) {
            if (data.length === 0) {
                alert("No parameters found for the selected item.");
                return;
            }
            $("#RatedCurrent").val(data[0].RatedCurrent);
            $("#Frequency").val(data[0].Frequency);
            $("#Poles").val(data[0].Poles);
            $("#InsulationClass").val(data[0].InsulationClass);
            $("#Duty").val(data[0].Duty);
            $("#Capacitor").val(data[0].Capacitor);

            $("#SupplyVolt1").val(data[0].SupplyVolt1);
            $("#TestFrequency1").val(data[0].TestFrequency1);
            $("#NoLoadCurrentU1").val(data[0].NoLoadCurrentU1);
            $("#NoLoadCurrentV1").val(data[0].NoLoadCurrentV1);
            $("#NoLoadCurrentW1").val(data[0].NoLoadCurrentW1);

            $("#SupplyVolt2").val(data[0].SupplyVolt2);
            $("#TestFrequency2").val(data[0].TestFrequency2);
            $("#NoLoadCurrentU2").val(data[0].NoLoadCurrentU2);
            $("#NoLoadCurrentV2").val(data[0].NoLoadCurrentV2);
            $("#NoLoadCurrentW2").val(data[0].NoLoadCurrentW2);

            $("#WindingResRedWhite").val(data[0].WindingResRedWhite);
            $("#WindingResYellowBlue").val(data[0].WindingResYellowBlue);
            $("#WindingResBlackBrown").val(data[0].WindingResBlackBrown);
            $("#WindingResBlackWhite").val(data[0].WindingResBlackWhite);
            $("#WindingResBlackRed").val(data[0].WindingResBlackRed);

        },
        error: function () {
            alert("Failed to load parameters. Please try again.");
        }
    });
}

</script>


