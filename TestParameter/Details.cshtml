
@model ERPEntities.TestParameter

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}

<style>
    /*Adding some css for looks good*/
    #label {
        font-size: 13px;
        color: #0077B3;
        font-weight: 500
    }

    h4 {
        font-size: 18px;
        padding: 10px 0;
        font-weight: 600;
    }

    .form-head h4 {
        padding: 10px 10px;
        font-size: 16px;
        font-weight: 600;
        background-color: #C1D5BD;
    }


    .body-panel {
        border: 1px solid black;
        /*background-color: whitesmoke;*/
        margin-top: -10px;
        border-radius: 5px;
        background-color: floralwhite;
    }

    .submit-btn {
        display: inline-flex;
        padding: 7px;
    }


        .submit-btn button {
            border-radius: 30px;
            padding: 5px 5px;
        }



    .save-btn input {
        /*border-radius: 30px;*/
        font-size: 14px;
    }



    fieldset {
        border: 1px solid #ddd !important;
        margin: 10px;
        /*max-width:0;*/
        padding: 5px;
        /* position:relative;*/
        padding-left: 10px !important;
        padding-right: 10px !important;
        /*background-color: whitesmoke;*/
        /* background-color: white;*/
        background-color: white;
    }


    .button {
        display: inline-block;
        /*padding: 5px 6px;*/
        /*font-size: 5px;*/
        padding: 20px;
        font-size: 16px;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        outline: none;
        border: none;
        box-shadow: 0 9px #999;
        height: 3px;
        width: auto;
        margin: 4px 2px;
    }

        .button:hover {
            /*background-color: #3e8e41*/
            background-color: cyan;
        }

        .button:active {
            background-color: cyan;
            box-shadow: 0 5px #666;
            transform: translateY(4px);
        }



    span.error {
        display: block;
        visibility: hidden;
        color: red;
        font-size: 60px;
    }


    .ui-widget {
        font-size: 12px !important;
    }

    .reqError {
        color: #ff0000; /*Red Color*/
        font-weight: bold;
        font-size: 16px;
    }

    .backsubmitbtn {
        background-image: linear-gradient(to right,#35d3e1,midnightblue);
        padding: 5px 20px 5px 20px;
        color: white;
        font-family: Helvetica;
        box-shadow: -4px -4px 8px rgba(255, 255, 255, 0.7), 4px 4px 8px rgba(128, 128, 128, 0.7);
        outline-style: none;
        border: none
    }

    .dshapefieldset {
        background-color: #e5e6e7;
        border: 2px solid #ddd;
        border-radius: 0px 25px 25px 0px;
        margin-bottom: 20px
    }

    .field-heading {
        font-size: 18px;
        color: midnightblue;
        font-family: Helvetica;
        font-weight: bold;
        display: flex
    }

    .route-path1 {
        cursor: pointer;
        clip-path: polygon(0% 0%, 90% 0%, 100% 50%, 90% 100%, 0% 100%);
        background-color: #003399;
        color: white;
        padding: 5px 15px 5px 5px
    }

    .route-path2 {
        cursor: pointer;
        color: white;
        clip-path: polygon(95% 0%, 100% 50%, 95% 100%, 0% 100%, 5% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }

    .route-path3 {
        cursor: pointer;
        color: white;
        clip-path: polygon(91% 0%, 100% 50%, 91% 100%, 0% 100%, 9% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }

    .cross-btn {
        font-size: 30px;
        cursor: pointer;
        color: midnightblue;
        position: absolute;
        top: 35px;
        right: 15px;
    }

    .material-icons {
        cursor: pointer
    }

    span i {
        padding: 5px
    }



    .textbox-with-unit {
        position: relative;
        display: inline-block;
    }

        .textbox-with-unit .unit {
            position: absolute;
            right: 10px;
            top: 8px;
            font-size: 14px;
            color: #666;
        }
</style>
<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="Stylesheet" type="text/css" />
@*AP external CSS*@
<link href="~/Content/ERPStyle.css" rel="stylesheet" type="text/css" />

<form id="testParameterForm" class="form-horizontal" action="/TestParameter/Create" method="post">
    @Html.AntiForgeryToken()
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="d-flex" style="margin-top:-20px">
                <h4 class="route-path1">Inventory </h4>
                <h4 class="route-path2 " onclick="location.href='@Url.Action("Index","TestParameter")'">Test Parameters</h4>
                <h4 class="route-path3" onclick="location.reload()">Create</h4>
            </div>
            <br />

            <div class="panel panel-default outer-main-container">
                <div class=" main-heading">
                    <div class=" d-flex ">
                        <i class="material-icons" style="font-size: 32px; margin-right: 10px;">feed</i>
                        Test Parameter 
                        <i class="material-icons cross-btn" onclick="history.back()">cancel</i>
                    </div>
                </div>
                <div class="" style="padding-inline:20px">
                    <div class="form-group row mx-0 mb-4">
                        <div class="col-12 col-md-6 col-lg-4 ">
                            <label id="label">Select Item :</label>
                            @Html.HiddenFor(m => m.TestParameterId)
                            <div class="form-group row m-0">
                                @Html.DropDownListFor(
                                    m => m.ItemId,
                                    (IEnumerable<SelectListItem>)ViewBag.Items,
                                    "Please Select",
                                    new { @class = "form-control fs-4 pl-3 dropdown-textbox", @onchange = "GetCode(this.value);", style = "height:35px;" }
                                )
                            </div>
                        </div>
                        
                    </div>
                    <fieldset class="dshapefieldset">
                        <div class="form-group row mx-0">
                            <div class="col-lg-2">
                                <label id="label">Rated Current :</label>
                                <div class="textbox-with-unit">
                                    @Html.TextBox("RatedCurrent", null, new
                               {
                                   @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                   //type = "number",
                                   style = "padding-right:45px; height:35px"
                               })
                                    <span class="unit">Amp</span>
                                </div>

                            </div>
                            <div class="col-lg-2">
                                <label id="label">Frequency :</label>
                                <div class="textbox-with-unit">
                                    @Html.TextBox("Frequency", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })
                                    <span class="unit">Hz</span>
                                </div>
                            </div>
                            <div class="col-lg-2">
                                <label id="label">Poles :</label>
                                @Html.TextBox("Poles", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", style = "height:35px" })

                            </div>
                            @*<div class="col-lg-1">
                                    <label id="label">Unit :</label>
                                    @Html.DropDownList("UnitId", (IEnumerable<SelectListItem>)ViewBag.Unit, "Select Unit", new { @class = "form-control mt-5", style = "font-size:small;height:35px;", id = "UnitId" })

                                </div>*@

                            <div class="col-lg-2">
                                <label for="InsulationClass" id="label">Insulation Class:</label><br />
                                @Html.TextBox("InsulationClass", null, new { @class = "form-control fs-4 input-text-box", @style = "pointer:cursor" })
                            </div>

                            <div class="col-lg-2">
                                <label id="label">Duty :</label>
                                @Html.TextBox("Duty", null, new { @class = "form-control fs-4 pl-3 input-text-box", style = "height:35px" })
                            </div>
                            <div class="col-lg-2">
                                <label id="label">Capacitor :</label>
                                @Html.TextBox("Capacitor", null, new { @class = "form-control fs-4 pl-3 input-text-box", style = "height:35px" })
                            </div>

                        </div>
                    </fieldset>

                    @*for 3 ph *@
                    <fieldset class="dshapefieldset d-none phase-3ph1">
                        <div class="form-group row mx-0">
                            <h4>First Testing</h4>
                            <div class="col-lg-2">
                                <label id="label">Supply Volt:</label>
                                <div class="textbox-with-unit">

                                    @Html.TextBox("SupplyVolt1", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })

                                    <span class="unit">Volt</span>
                                </div>
                                @*<span class="text-danger" id="SupplyVolt1"></span>*@

                            </div>
                            <div class="col-lg-2">
                                <label id="label">Frequency:</label>
                                <div class="textbox-with-unit">
                                    @Html.TextBox("TestFrequency1", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })
                                    <span class="unit">Hz</span>
                                </div>

                            </div>
                            <div class="col-lg-2">
                                <label id="label">NoLoad CurrentU:</label>
                                <div class="textbox-with-unit">
                                    @Html.TextBox("NoLoadCurrentU1", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })
                                    <span class="unit">Amp</span>
                                </div>
                            </div>


                            <div class="col-lg-2 ">
                                <label for="NoLoad CurrentV" id="label">NoLoad CurrentV:</label><br />
                                <div class="textbox-with-unit">
                                    @Html.TextBox("NoLoadCurrentV1", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })
                                    <span class="unit">Amp</span>
                                </div>
                            </div>

                            <div class="col-lg-2 phase-3ph">
                                <label id="label">NoLoad CurrentW:</label>
                                <div class="textbox-with-unit">
                                    @Html.TextBox("NoLoadCurrentW1", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })
                                    <span class="unit">Amp</span>
                                </div>
                            </div>


                        </div>
                    </fieldset>

                    <fieldset class="dshapefieldset d-none phase-3ph">
                        <div class="form-group row mx-0">
                            <h4>Second Testing</h4>
                            <div class="col-lg-2">
                                <label id="label">Supply Volt:</label>
                                <div class="textbox-with-unit">
                                    @Html.TextBox("SupplyVolt2", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })
                                    <span class="unit">Volt</span>
                                </div>


                            </div>
                            <div class="col-lg-2">
                                <label id="label">Frequency:</label>
                                <div class="textbox-with-unit">
                                    @Html.TextBox("TestFrequency2", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })
                                    <span class="unit">Hz</span>
                                </div>

                            </div>
                            <div class="col-lg-2">
                                <label id="label">NoLoad CurrentU:</label>
                                <div class="textbox-with-unit">
                                    @Html.TextBox("NoLoadCurrentU2", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })
                                    <span class="unit">Amp</span>
                                </div>
                            </div>


                            <div class="col-lg-2">
                                <label for="NoLoad CurrentV" id="label">NoLoad CurrentV:</label><br />
                                <div class="textbox-with-unit">
                                    @Html.TextBox("NoLoadCurrentV2", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })
                                    <span class="unit">Amp</span>
                                </div>
                            </div>

                            <div class="col-lg-2" id="3ph">
                                <label id="label">NoLoad CurrentW:</label>
                                <div class="textbox-with-unit">
                                    @Html.TextBox("NoLoadCurrentW2", null, new
                                    {
                                        @class = "form-control bg-light fs-4 pl-3 input-text-box has-unit",
                                        type = "number",
                                        style = "padding-right:45px; height:35px"
                                    })
                                    <span class="unit">Amp</span>
                                </div>
                            </div>


                        </div>
                    </fieldset>

                    <fieldset class="dshapefieldset d-none phase-3ph">
                        <div class="form-group row mx-0">
                            <div class="col-lg-2" id="3ph">
                                <label id="label">Winding Res. Red-White:</label>
                                @Html.TextBox("WindingResRedWhite", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", style = "height:35px" })
                                <span id="reqitem" class="fs-5"></span>
                                @*<span id="" class="fs-5">Volt</span>*@
                            </div>
                            <div class="col-lg-2" id="3ph">
                                <label id="label">Winding Res. Yellow-Blue:</label>
                                @Html.TextBox("WindingResYellowBlue", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", style = "height:35px" })
                            </div>
                            <div class="col-lg-2" id="3ph">
                                <label id="label">Winding Res. Black-Brown:</label>
                                @Html.TextBox("WindingResBlackBrown", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", style = "height:35px" })
                            </div>

                        </div>
                    </fieldset>
                    @*for 1ph*@


                    <fieldset class="dshapefieldset d-none phase-1ph">
                        <div class="form-group row mx-0">

                            <div class="col-lg-2">
                                <label for="NoLoad CurrentV" id="label">Winding Res. BlackWhite:</label><br />
                                @Html.TextBox("WindingResBlackWhite", null, new { @class = "form-control fs-4 input-text-box", @style = "pointer:cursor" })
                            </div>

                            <div class="col-lg-2">
                                <label id="label">Winding Res. BlackRed:</label>
                                @Html.TextBox("WindingResBlackRed", null, new { @class = "form-control fs-4 pl-3 input-text-box", style = "height:35px" })
                            </div>
                        </div>
                    </fieldset>


                    <div id="TestParametersHiddenFields"></div>
                    <div class="form-group row ">
                        
                        <div class="col-md-2 col-lg-2 col-sm-4 px-2">
                            <input type="button" value="Close" class=" btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="history.back()" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<script>

    $(document).ready(function () {

        var itemid = $("#ItemId").text();
        GetCode(itemid);
    })

    let extractedPh;
    function GetCode(id) {

        var selectedText = $("#ItemId option:selected").text();

        //var match1 = selectedText.match(/(\d+)\s*Ph/);
        var match = selectedText.match(/(\d+)\s*(Ph|PH|ph)/i);
        //var match2 = selectedText.match(/Watt\s*(\d+)\s*\/\s*(\d+)/i);
        //var match2 = selectedText.match(/Watt\s*(\d+)\s*\/\s*(\d+)/i);

        console.log('selected item is ', match);
        //console.log('volt is ', match2);


        extractedPh = match[0];
        if (extractedPh == '3 Ph' || extractedPh == '3 ph') {
            var match2 = selectedText.match(/Watt\s*(\d+)\s*\/\s*(\d+)/i);
            var supplyVolt1 = match2[1];
            var supplyVolt2 = match2[2];
            // show all 3-phase fieldsets
            $(".phase-3ph").removeClass("d-none");
            $(".phase-3ph1").removeClass("d-none");
            $('#SupplyVolt1').val(supplyVolt1);
            $('#SupplyVolt2').val(supplyVolt2);
            // hide all 1-phase fieldsets
            $(".phase-1ph").addClass("d-none");
        }
        else {
            var match2 = selectedText.match(/Watt\s*(\d+(\.\d+)?)/i);

            var SupplyVolt1ph = match2[1];
            $('#SupplyVolt1').val(SupplyVolt1ph);
            // show all 1-phase fieldsets
            $(".phase-3ph1").removeClass("d-none");
            $(".phase-1ph").removeClass("d-none");
            // hide all 3-phase fieldsets
            $(".phase-3ph").addClass("d-none");
        }
    }

    //$("#testParameterForm").submit(function (e) {
    //    e.preventDefault();  // this blocks the submission
    //});


</script>




