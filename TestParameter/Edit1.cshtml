<script>
    var rowCount = 0;
    var currentEditingRow = null;

    function AddParameters() {
        var data = getFormData();

        // 🌐 Basic Field Validations
        let isValid = true;
        let errorMsg = "";

        if (!$('#TestReportName').val().trim()) {
            isValid = false;
            errorMsg += "• Parameter is required.\n";
        }

        if (!$('#UnitDescription').val().trim()) {
            isValid = false;
            errorMsg += "• Description is required.\n";
        }

        if (!$('#MeasuringUnit').val().trim()) {
            isValid = false;
            errorMsg += "• Dimention is required.\n";
        }

        //if (!$('#UnitId').val()) {
        //    isValid = false;
        //    errorMsg += "• Unit is required.\n";
        //}

        if (!$('#Value').val().trim()) {
            isValid = false;
            errorMsg += "• Value is required/Should be in number only.\n";
        }


        if (!isValid) {
            alert("Please fill the following:\n\n" + errorMsg);
            return; // ❌ Stop execution
        }

        //if ($('#itemsTable').length === 0) {
        //    createTable();
        //}

        rowCount++;

        var newRow = `
            <tr>
                <td class="sno">${rowCount}</td>
                <td class="TestReportName">${data.TestReportName}</td>
                <td class="UnitDescription">${data.UnitDescription}</td>
                <td class="MeasuringUnit">${data.MeasuringUnit}</td>
                <td class="Value">${data.Value}</td>
                <td class="IsNumber">${data.IsNumber}</td> <!-- new column -->
                <td class="Remark">${data.Remark}</td>
                <td>
                    <button type="button" class="btn btn-warning btn-sm" onclick="editRow(this)">Edit</button>
                    <button type="button" class="btn btn-success btn-sm" onclick="insertRowBelow(this)">Insert</button>
                    <button type="button" class="btn btn-danger btn-sm" onclick="deleteRow(this)">Delete</button>
                </td>
            </tr>
        `;
        if (window.insertAfterRow) {
            // Insert below the specific row
            $(window.insertAfterRow).after(newRow);
            window.insertAfterRow = null; // reset
        } else {
            // Default: append at the end
            $('#itemsTable tbody').append(newRow);
        }

        updateSerialNumbers();
        clearForm();

        //$('#itemsTable tbody').append(newRow);
        //clearForm();
    }


    function editRow(btn) {
        var row = $(btn).closest('tr');
        currentEditingRow = row;
        $("input[name='TestReportName']").val(row.find('.TestReportName').text());
        $("input[name='UnitDescription']").val(row.find('.UnitDescription').text());
        $("input[name='MeasuringUnit']").val(row.find('.MeasuringUnit').text());
        $("input[name='Value']").val(row.find('.Value').text());



        // ✅ Handle IsNumber checkbox
        var isNumberValue = row.find('.IsNumber').text().trim().toUpperCase();
        $("#IsNumber").prop("checked", isNumberValue === "Y");
        $("input[name='Remark']").val(row.find('.Remark').text());

        $('#add').addClass('d-none');
        $('#update').removeClass('d-none');
    }

    function UpdateParameters() {
        if (currentEditingRow == null) return;

        var data = getFormData();

        // 🌐 Basic Field Validations
        let isValid = true;
        let errorMsg = "";

        if (!$('#UnitDescription').val().trim()) {
            isValid = false;
            errorMsg += "• Description is required.\n";
        }

        if (!$('#MeasuringUnit').val().trim()) {
            isValid = false;
            errorMsg += "• Dimention is required.\n";
        }

        //if (!$('#UnitId').val()) {
        //    isValid = false;
        //    errorMsg += "• Unit is required.\n";
        //}

        if (!$('#Value').val().trim()) {
            isValid = false;
            errorMsg += "• Value is required.\n";
        }


        if (!isValid) {
            alert("Please fill the following:\n\n" + errorMsg);
            return; // ❌ Stop execution
        }

        // Update row cells
        currentEditingRow.find('.TestReportName').text(data.TestReportName);
        currentEditingRow.find('.UnitDescription').text(data.UnitDescription);
        currentEditingRow.find('.MeasuringUnit').text(data.MeasuringUnit);
        currentEditingRow.find('.Value').text(data.Value); // ✅ ADD THIS LINE
        currentEditingRow.find('.IsNumber').text(data.IsNumber);
        currentEditingRow.find('.Remark').text(data.Remark);

        clearForm();

        // Reset buttons
        $('#add').removeClass('d-none');
        $('#update').addClass('d-none');
        currentEditingRow = null;
    }


    function deleteRow(btn) {
        $(btn).closest('tr').remove();
        updateSerialNumbers();
    }

    function updateSerialNumbers() {
        rowCount = 0;
        $('#itemsTable tbody tr').each(function () {
            rowCount++;
            $(this).find('.sno').text(rowCount);
        });

        if (rowCount === 0) {
            $('#orderItems').html('');
        }
    }


    function insertRowBelow(btn) {
        const currentRow = $(btn).closest("tr");

        // Store the next row's position
        const insertAfterRow = currentRow;

        // Fill form with the current row's values
        $("input[name='TestReportName']").val(currentRow.find('.TestReportName').text().trim());
        $("input[name='UnitDescription']").val(currentRow.find('.UnitDescription').text().trim());
        $("input[name='MeasuringUnit']").val(currentRow.find('.MeasuringUnit').text().trim());
        $("input[name='Value']").val(currentRow.find('.Value').text().trim());


        // Handle IsNumber checkbox
        var isNumberValue = currentRow.find('.IsNumber').text().trim().toUpperCase();
        $("#IsNumber").prop("checked", isNumberValue === "Y");
        // Remark
        $("input[name='Remark']").val(currentRow.find('.Remark').text().trim());

        //toggleTolerance1Visibility(); // If you have conditional logic

        // Set form state
        $('#add').removeClass('d-none');
        $('#update').addClass('d-none');

        // Optional: Scroll to form
        $('html, body').animate({
            scrollTop: $("#UnitDescription").offset().top - 100
        }, 300);

        // Set a global variable to know we are inserting below a specific row
        window.insertAfterRow = insertAfterRow;
    }

    function getFormData() {

        return {
            TestReportName: $("input[name='TestReportName']").val().trim(),
            UnitDescription: $("input[name='UnitDescription']").val().trim(),
            MeasuringUnit: $("input[name='MeasuringUnit']").val().trim(),
            //Unit: $("#Unit").val(),
            MeasuringUnit: $("input[name='MeasuringUnit']").val().trim(),
            //ToleranceValue: fullToleranceValue,
            //Value: $("input[name='Value']").val().trim(), //  NEW FIELD ADDED
            Value: parseFloat($("input[name='Value']").val()),
            Remark: $("input[name='Remark']").val().trim(),
            IsNumber: $("#IsNumber").is(":checked") ? "Y" : "N" //  this line added
        };
    }

    function clearForm() {
        // Clear all text and number inputs
        $("input[name='TestReportName'], input[name='UnitDescription'], input[name='MeasuringUnit'], input[name='Value'],input[name='Tolerance1Value'], input[name='Parameter2'], input[name='Parameter3'], input[name='Parameter4'], input[name='Parameter5'], input[name='Remark']").val('');

        // Reset dropdowns to default (first option)
        $("#ToleranceType").prop('selectedIndex', 0);
        $("#Tolerance1Type").prop('selectedIndex', 0);
        $("#UnitId").prop('selectedIndex', 0); // Only if Unit is a <select>
        // Reset the IsNumber checkbox (unchecked = "N" by default)
        $("#IsNumber").prop('checked', false);
    }


    function syncHiddenFieldsWithTable() {
        var container = $('#TestParametersHiddenFields');
        container.empty(); // Clear previous hidden fields

        $('#itemsTable tbody tr').each(function (i) {
            var row = $(this);

            container.append(`<input type="hidden" name="testParameters[${i}].UnitDescription" value="${row.find('.UnitDescription').text()}" />`);
            container.append(`<input type="hidden" name="testParameters[${i}].MeasuringUnit" value="${row.find('.MeasuringUnit').text()}" />`);
            container.append(`<input type="hidden" name="testParameters[${i}].ToleranceValue" value="${row.find('.ToleranceValue').text()}" />`);

            container.append(`<input type="hidden" name="testParameters[${i}].Remark" value="${row.find('.Remark').text()}" />`);
        });
    }


    function loadParametersFromCopyItem(itemId) {
    if (!itemId) {
        alert("Please select a valid item to copy parameters.");
        return;
    }

    $.ajax({
        url: '@Url.Action("GetTestParametersByItem", "TestParameter")',
        type: 'GET',
        data: { itemId: itemId },
        success: function (data) {
            if (data.length === 0) {
                alert("No parameters found for the selected item.");
                return;
            }

            $('#itemsTable tbody').empty(); // Clear previous rows
            rowCount = 0;

            data.forEach(function (param) {
                rowCount++;

                var newRow = `
                    <tr>
                        <td class="sno">${rowCount}</td>
                        <td class="TestReportName">${param.TestReportName || ''}</td>
                        <td class="UnitDescription">${param.UnitDescription || ''}</td>
                        <td class="MeasuringUnit">${param.MeasuringUnit || ''}</td>
                        <td class="Value">${param.Value || ''}</td>
                        <td class="IsNumber">${param.IsNumber === "Y" ? "Y" : "N"}</td> <!-- Added -->
                        <td class="Remark">${param.Remark || ''}</td>
                        <td>
                            <button type="button" class="btn btn-warning btn-sm" onclick="editRow(this)">Edit</button>
                            <button type="button" class="btn btn-success btn-sm" onclick="insertRowBelow(this)">Insert</button>
                            <button type="button" class="btn btn-danger btn-sm" onclick="deleteRow(this)">Delete</button>
                        </td>
                    </tr>
                `;
                $('#itemsTable tbody').append(newRow);
            });
        },
        error: function () {
            alert("Failed to load parameters. Please try again.");
        }
    });
}


</script>

<script>
    $(document).ready(function () {
        $('#ItemForm').submit(function () {
            syncHiddenFieldsWithTable(); // Sync table to hidden inputs before form posts
        });
    });

    function UpdateTestParameter() {
        // Get selected ItemId
        var itemId = $('#ItemId').val(); // or just $('select[name="ItemId"]').val()

        console.log('item id is ' + itemId);
        if (!itemId) {
            alert("Please select an item.");
            return;
        }

        // Prepare parameter list from hidden fields or table rows
        var parameters = [];

        $('#itemsTable tbody tr').each(function () {
            var row = $(this);
            var param = {
                TestReportName: row.find('.TestReportName').text().trim(),
                UnitDescription: row.find('.UnitDescription').text().trim(),
                MeasuringUnit: row.find('.MeasuringUnit').text().trim(),
                Value: row.find('.Value').text().trim(), //  ADDED LINE
                IsNumber: row.find('.IsNumber').text().trim().toUpperCase(), //  added line
                Remark: row.find('.Remark').text().trim()
            };
            parameters.push(param);
        });

        if (parameters.length === 0) {
            alert("Please add at least one test parameter.");
            return;
        }

        // Prepare data to send
        var dataToSend = {
            ItemId: itemId,
            TestParametersList: parameters
        };

        $.ajax({
            url: '@Url.Action("UpdateTestParameter", "TestParameter")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dataToSend),
            success: function(response) {
                if (response.success) {
                    alert(response.message);
                    // Reload the index page
                    window.location.reload();
                    window.location.href = '@Url.Action("Index", "TestParameters")';

                } else {
                    alert("Update failed: " + response.message);
                }
            },
            error: function(xhr) {
                alert("Error occurred: " + xhr.responseText);
            }
        });
    }

</script>

