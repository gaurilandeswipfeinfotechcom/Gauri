


@model IEnumerable<ERPEntities.ItemMaster>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}

<style>

    .table tr {
        border: 5px solid #fff;
        background-color: #e5e6eb
    }

    .panel .panel-body .table tr td {
        background-color: #e5e6eb;
        border-right: 2px solid #fff;
        border-top: 5px solid #fff;
    }

    .panel .panel-body .table tr th {
        border-bottom: 5px solid #fff;
    }

    table td {
        font-size: 13px;
    }

    .panel .panel-body .table tr td:hover {
        background-color: floralwhite
    }

    td span {
        border: none;
        background: none;
        color: blue;
        font-size: 15px;
    }

        td span i:hover {
            transform: scale(1.3);
            color: Highlight;
        }


    td .glyphicon-edit {
        color: green;
    }

    td .glyphicon-list {
        color: blue;
        padding: 0px 4px;
    }

    .table tr th {
        text-align: center;
        background-color: lightblue;
        font-family: Helvetica, sans-serif;
        color: midnightblue;
    }

    td .glyphicon-print {
        color: blueviolet;
    }

    .page td a {
        font-size: 12px;
    }

    .route-path1 {
        cursor: pointer;
        clip-path: polygon(0% 0%, 90% 0%, 100% 50%, 90% 100%, 0% 100%);
        background-color: #003399;
        color: white;
        padding: 5px 15px 5px 5px
    }

    .route-path2 {
        cursor: pointer;
        color: white;
        clip-path: polygon(94% 0%, 100% 50%, 94% 100%, 0% 100%, 6% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }
</style>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<!-- Bootstrap (if needed) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="Stylesheet" type="text/css" />
@*AP external CSS*@
<link href="~/Content/ERPStyle.css" rel="stylesheet" type="text/css" />


<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="d-flex" style="margin-top:-20px">
            <h4 class="route-path1">Inventory </h4>
            <h4 class="route-path2 " onclick="location.href='@Url.Action("Index","TestParameter")'">Test Parameters</h4>
        </div>
        <br />

        <div class="panel panel-default outer-main-container">
            <div class="form-group row main-heading mb-0">
                <div class="col-sm-8 col-lg-9 d-flex ">
                    <i class="material-icons" style="font-size: 32px; margin-right: 10px;">gradient</i>
                    Test Parameters List
                </div>
                <div class="col-sm-4 col-lg-3">
                    <input type="button" value="Create" class="btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="location.href = '@Url.Action("TestParameterOutward", "TestParameter")'" />
                </div>
            </div>
            <div class="panel-body">
                <div class="panel panel-success" style="box-shadow:inset 4px 4px 4px gray;border-radius:10px">
                    <div class="panel-body">
                        <div class="table-responsive">
                            <table id="testParamTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr style="font-size: small">
                                        <th style="border-right: 2px solid #fff">Sr. No.</th>
                                        <th style="border-right: 2px solid #fff">Item Name</th>
                                        <th style="border-right: 2px solid #fff">Item Code</th>
                                        <th style="border-right: 2px solid #fff">Item Location</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int serialNo = 1; }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td align="center">@serialNo</td>
                                            <td align="center">@item.ItemName</td>
                                            <td align="center">@item.ItemCode</td>
                                            <td align="center">@item.ItemLocation</td>
                                            <td align="center">
                                                <span>
                                                    <i class="glyphicon glyphicon-edit" title="Edit" style="cursor: pointer;"
                                                       onclick="openEditForm('@Url.Action("Edit1", new { id = item.ItemId })')">
                                                    </i>
                                                </span>
                                                <span>
                                                    <i class="glyphicon glyphicon-list" style="cursor:pointer"
                                                       onclick="location.href='@Url.Action("Details", new { id = item.ItemId })'">
                                                    </i>
                                                </span>

                                            </td>
                                        </tr>
                                        serialNo++;
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var table = $('#testParamTable').DataTable({
            pageLength: 10,
            ordering: true,
            searching: true,
            columnDefs: [
                { orderable: false, targets: 4 } // Disable sorting for "Action" column
            ]
        });

        // Dynamically update the serial numbers on every draw (paging, search, sort)
        table.on('order.dt search.dt draw.dt', function () {
            let pageInfo = table.page.info();
            table.column(0, { page: 'current' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1 + pageInfo.start;
            });
        }).draw();
    });


</script>

<script type="text/javascript">
    function openEditForm(editFormUrl) {
        var editTab = window.open(editFormUrl, '_blank');

        // Listen for messages from the edit tab
        window.addEventListener('message', function (event) {
            // Check if the message is from the edit tab and indicates closure
            if (event.source === editTab && event.data === 'editTabClosed') {
                // Refresh the index page
                location.reload();
            }
        });
    }
</script>


