<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="d-flex" style="margin-top:-20px">
            <h4 class="route-path1">Inventory </h4>
            <h4 class="route-path2 " onclick="location.href='@Url.Action("Index","TestParameters")'">Test Parameters</h4>
        </div>
        <br />

        <div class="panel panel-default outer-main-container">
            <div class="form-group row main-heading mb-0">
                <div class="col-sm-8 col-lg-9 d-flex ">
                    <i class="material-icons" style="font-size: 32px; margin-right: 10px;">gradient</i>
                    Test Parameters List
                </div>
                <div class="col-sm-4 col-lg-3">
                    <input type="button" value="Create" class="btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="location.href = '@Url.Action("TestParameter", "TestParameters")'" />
                </div>
            </div>
            <div class="panel-body">
                <div class="panel panel-success" style="box-shadow:inset 4px 4px 4px gray;border-radius:10px">
                    <div class="panel-body">
                        <div class="table-responsive">
                            <table id="testParamTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr style="font-size: small">
                                        <th style="border-right: 2px solid #fff; text-align: center">Sr. No.</th>
                                        <th style="border-right: 2px solid #fff; text-align:center">Item Name</th>
                                        <th style="border-right: 2px solid #fff; text-align: center">Item Code</th>
                                        <th style="border-right: 2px solid #fff; text-align: center">Item Location</th>
                                        <th style="text-align:center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int serialNo = 1; }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td align="center">@serialNo</td>
                                            <td align="center">@item.ItemName</td>
                                            <td align="center">@item.ItemCode</td>
                                            <td align="center">@item.ItemLocation</td>
                                            <td align="center">
                                                <span>
                                                    <i class="glyphicon glyphicon-edit" title="Edit" style="cursor: pointer;"
                                                       onclick="openEditForm('@Url.Action("Edit", new { id = item.ItemId })')">
                                                    </i>
                                                </span>
                                                <span>
                                                    <i class="glyphicon glyphicon-list" style="cursor:pointer"
                                                       onclick="location.href='@Url.Action("Details", new { id = item.ItemId })'">
                                                    </i>
                                                </span>

                                            </td>
                                        </tr>
                                        serialNo++;
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var table = $('#testParamTable').DataTable({
            pageLength: 10,
            ordering: true,
            searching: true,
            columnDefs: [
                { orderable: false, targets: 4 } // Disable sorting for "Action" column
            ]
        });

        // Dynamically update the serial numbers on every draw (paging, search, sort)
        table.on('order.dt search.dt draw.dt', function () {
            let pageInfo = table.page.info();
            table.column(0, { page: 'current' }).nodes().each(function (cell, i) {
                cell.innerHTML = i + 1 + pageInfo.start;
            });
        }).draw();
    });


</script>

<script type="text/javascript">
    function openEditForm(editFormUrl) {
        var editTab = window.open(editFormUrl, '_blank');

        // Listen for messages from the edit tab
        window.addEventListener('message', function (event) {
            // Check if the message is from the edit tab and indicates closure
            if (event.source === editTab && event.data === 'editTabClosed') {
                // Refresh the index page
                location.reload();
            }
        });
    }
</script>


