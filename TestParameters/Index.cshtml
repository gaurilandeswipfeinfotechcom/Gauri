<style>

    .table tr {
        border: 5px solid #fff;
        background-color: #e5e6eb
    }

    .panel .panel-body .table tr td {
        background-color: #e5e6eb;
        border-right: 2px solid #fff;
        border-top: 2px solid #fff;
    }

    .panel .panel-body .table tr th {
        border-bottom: 2px solid #fff;
    }

    table td {
        font-size: 13px;
    }

    .panel .panel-body .table tr td:hover {
        background-color: floralwhite
    }

    td span {
        border: none;
        background: none;
        color: blue;
        font-size: 15px;
    }

        td span i:hover {
            transform: scale(1.3);
            color: Highlight;
        }


    td .glyphicon-edit {
        color: green;
    }

    td .glyphicon-list {
        color: blue;
        padding: 0px 4px;
    }

    .table tr th {
        text-align: center;
        background-color: lightblue;
        font-family: Helvetica, sans-serif;
        color: midnightblue;
    }

    td .glyphicon-print {
        color: blueviolet;
    }

    .page td a {
