<form id="TypeValidation" class="form-horizontal" action="#" method="">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="d-flex" style="margin-top:-20px">
                <h4 class="route-path1">Inventory </h4>
                <h4 class="route-path2 " onclick="location.href='@Url.Action("Index","TestParameters")'">Test Parameters</h4>
                <h4 class="route-path3" onclick="location.reload()">Create</h4>
            </div>
            <br />

            <div class="panel panel-default outer-main-container">
                <div class=" main-heading">
                    <div class=" d-flex ">
                        <i class="material-icons" style="font-size: 32px; margin-right: 10px;">feed</i>
                        Test Parameter Create
                        <i class="material-icons cross-btn" onclick="history.back()">cancel</i>
                    </div>
                </div>
                <div class="" style="padding-inline:20px">
                    <div class="form-group row mx-0 mb-4">
                        <div class="col-12 col-md-6 col-lg-4 ">
                            <label id="label">Select Item :</label>
                            <div class="form-group row m-0">
                                @Html.DropDownList("ItemId", (IEnumerable<SelectListItem>)ViewBag.ItemID, "Please Select", new { @class = "form-control fs-4 pl-3 dropdown-textbox", @onchange = "GetCode(this.value);", style = "height:35px;" })
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-4 ">
                            <label id="label">Copy Parameter Item :</label>
                            <div class="form-group row m-0">
                                @Html.DropDownList("CopyItemId", (IEnumerable<SelectListItem>)ViewBag.ParameterItem, "Please Select copy item", new { @class = "form-control fs-4 pl-3 dropdown-textbox", @onchange = "loadParametersFromCopyItem(this.value);", style = "height:35px;" })
                            </div>
                        </div>
                    </div>
                    <fieldset class="dshapefieldset">
                        <div class="form-group row mx-0">
                            <div class="col-lg-2">
                                <label id="label">Description :</label>
                                @Html.TextBox("UnitDescription", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", style = "height:35px" })
                                <span id="reqitem" class="fs-5"></span>
                            </div>
                            <div class="col-lg-1">
                                <label id="label">Dimension :</label>
                                @Html.TextBox("MeasuringUnit", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", style = "height:35px" })
                            </div>
                            @*<div class="col-lg-1">
                    <label id="label">Unit :</label>
                    @Html.TextBox("Unit", null, new { @class = "form-control bg-light fs-4 pl-3 input-text-box", style = "height:35px" })
                </div>*@
                            <div class="col-lg-1">
                                <label id="label">Unit :</label>
                                @Html.DropDownList("UnitId", (IEnumerable<SelectListItem>)ViewBag.Unit, "Select Unit", new { @class = "form-control mt-5", style = "font-size:small;height:35px;", id = "UnitId" })

                            </div>

                            <!-- ToleranceValue (Primary) -->
                            <div class="col-lg-2">
                                <label id="label" for="ToleranceValue">Tolerance1 Value :</label>
                                <div style="position: relative;">
                                    <select id="ToleranceType" name="ToleranceType" style="position: absolute; top: 0; left: 0; height: 35px; width: 30px; border: none; background: transparent; font-size: 1.5rem; text-align: center; z-index: 2;">
                                        <option value="+">+</option>
                                        <option value="-">-</option>
                                        <option value="±">±</option>
                                    </select>

                                    @Html.TextBox("ToleranceValue", null, new
                                    {
                                        @type = "number",
                                        @class = "fs-4 pl-5 input-text-box text-start",
                                        style = "height: 35px; outline:none;border:none; width: 100%; position: relative; z-index: 1;"
                                    })
                                </div>
                            </div>

                            <!-- Tolerance1Value (Conditional) -->
                            <div class="col-lg-2" id="tolerance1Container">
                                <!-- 👈 This is what will be shown/hidden -->
                                <label id="label" for="Tolerance1Value">Tolerance2 Value :</label>
                                <div style="position: relative;">
                                    <select id="Tolerance1Type" name="Tolerance1Type" style="position: absolute; top: 0; left: 0; height: 35px; width: 30px; border: none; background: transparent; font-size: 1.5rem; text-align: center; z-index: 2;">
                                        <option value="+">+</option>
                                        <option value="-">-</option>
                                    </select>

                                    <input type="number" id="Tolerance1Value" name="Tolerance1Value" class="fs-4 pl-5 input-text-box text-start"
                                           style="height: 35px; outline: none; border: none; width: 100%; position: relative; z-index: 1;" />
                                </div>
                            </div>
                            <div class="col-lg-1">
                                <label for="IsNumber" id="label">IsNumber:</label><br />
                                @Html.CheckBox("IsNumber", false, new { @class = "form-check-input fs-2 ", @style = "pointer:cursor", id = "IsNumber" })
                            </div>

                            <div class="col-lg-2">
                                <label id="label">Remark :</label>
                                @Html.TextBox("Remark", null, new { @class = "form-control fs-4 pl-3 input-text-box", style = "height:35px" })
                            </div>
                            <div class="col-lg-1 align-items-end d-flex pt-2">
                                <input type="button" id="add" value="Add" class="mb-2 btn btn-success btn-round create-bttn custo-inner" style="outline-style: none; border: none;" onclick="AddParameters()" />
                                <input type="button" id="update" value="Update" class="mb-2 btn btn-success btn-round create-bttn custo-inner d-none" style="outline-style: none; border: none;" onclick="UpdateParameters()" />
                            </div>
                        </div>
                    </fieldset>
                    @*<fieldset class="dshapefieldset">*@
                        <div class="panel-body">
                            <div id="orderItems" class="table tablecontainer table-responsive table-bordered  text-left">

                                <table id="itemsTable" class="table table-bordered">
                                    <thead class="">
                                        <tr>
                                            <th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;border-left: 2px solid #fff;">S.No</th>
                                            <th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;border-left: 2px solid #fff;">Description</th>
                                            <th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;border-left: 2px solid #fff;">Dimension</th>
                                            <th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;border-left: 2px solid #fff;">Unit</th>
                                            <th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;border-left: 2px solid #fff;">Tolerance1</th>
                                            <th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;border-left: 2px solid #fff;">Tolerance2</th>
                                            <th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;border-left: 2px solid #fff;">IsNumber</th>
                                            <th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;border-left: 2px solid #fff;">Remark</th>
                                            <th style="background-color: lightblue; font-size: 14px; font-weight: bold; color: midnightblue; border-right: 2px solid #fff;border-left: 2px solid #fff;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int serialNo = 1;
                                        }
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td class="sno"style="border-left: 2px solid #fff;">@serialNo</td>
                                                <td class="UnitDescription">@item.UnitDescription</td>
                                                <td class="MeasuringUnit">@item.MeasuringUnit</td>
                                                @*<td class="Unit">@item.Unit</td>*@
                                                <td class="Unit" data-unit-id="@item.UnitId">@item.UnitId</td>

                                                <td class="ToleranceValue">@item.ToleranceValue</td>
                                                <td class="Tolerance1Value">@item.ToleranceValue2</td>  <!-- HERE -->
                                                <td class="Remark">@item.IsNumber</td>
                                                <td class="Remark">@item.Remark</td>
                                                <td>
                                                    <button type="button" class="btn btn-warning btn-sm" onclick="editRow(this)">Edit</button>
                                                    <button type="button" class="btn btn-danger btn-sm" onclick="deleteRow(this)">Delete</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                            <label></label>
                        </div>
                    @*</fieldset>*@
                    <div id="TestParametersHiddenFields"></div>
                    <div class="form-group row ">
                        <div class="col-md-2 col-lg-2 col-sm-4 px-2">
                            <input type="button" value="Create" class=" btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="CreateTestParameter()" />
                        </div>
                        <div class="col-md-2 col-lg-2 col-sm-4 px-2">
                            <input type="button" value="Close" class=" btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="history.back()" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>


<script>
    function toggleTolerance1Visibility() {
        var selected = document.getElementById("ToleranceType").value;
        var container = document.getElementById("tolerance1Container");

        if (selected === "±") {
            container.style.display = "none";
            document.getElementById("Tolerance1Value").value = ""; // Clear value if hidden
        } else {
            container.style.display = "block";
        }
    }

    // Wait for DOM to be ready
    document.addEventListener("DOMContentLoaded", function () {
        toggleTolerance1Visibility(); // Run on page load

        // Run whenever the dropdown changes
        document.getElementById("ToleranceType").addEventListener("change", toggleTolerance1Visibility);
    });
</script>


<script>
    var rowCount = 0;
    var currentEditingRow = null;

    function AddParameters() {
        var data = getFormData();

        // 🌐 Basic Field Validations
        let isValid = true;
        let errorMsg = "";

        if (!$('#UnitDescription').val().trim()) {
            isValid = false;
            errorMsg += "• Description is required.\n";
        }

        if (!$('#MeasuringUnit').val().trim()) {
            isValid = false;
            errorMsg += "• Dimention is required.\n";
        }

        if (!$('#UnitId').val()) {
            isValid = false;
            errorMsg += "• Unit is required.\n";
        }

        if (!$('#ToleranceValue').val().trim()) {
            isValid = false;
            errorMsg += "• Tolerance Value is required.\n";
        }


        if (!isValid) {
            alert("Please fill the following:\n\n" + errorMsg);
            return; // ❌ Stop execution
        }

        //if ($('#itemsTable').length === 0) {
        //    createTable();
        //}

        rowCount++;

        var newRow = `
    <tr>
        <td class="sno">${rowCount}</td>
        <td class="UnitDescription">${data.UnitDescription}</td>
        <td class="MeasuringUnit">${data.MeasuringUnit}</td>
        <td class="Unit">${data.Unit}</td>
        <td class="ToleranceValue">${data.ToleranceValue}</td>
        <td class="Tolerance1Value">${data.Tolerance1Value}</td> <!-- NEW COLUMN -->
        <td class="IsNumber">${data.IsNumber}</td> <!-- new column -->
        <td class="Remark">${data.Remark}</td>
        <td>
            <button type="button" class="btn btn-warning btn-sm" onclick="editRow(this)">Edit</button>
            <button type="button" class="btn btn-success btn-sm" onclick="insertRowBelow(this)">Insert</button>
            <button type="button" class="btn btn-danger btn-sm" onclick="deleteRow(this)">Delete</button>
        </td>
    </tr>
`;
        if (window.insertAfterRow) {
            // Insert below the specific row
            $(window.insertAfterRow).after(newRow);
            window.insertAfterRow = null; // reset
        } else {
            // Default: append at the end
            $('#itemsTable tbody').append(newRow);
        }

        updateSerialNumbers();
        clearForm();

        //$('#itemsTable tbody').append(newRow);
        //clearForm();
    }


    function editRow(btn) {
        var row = $(btn).closest('tr');
        currentEditingRow = row;

        $("input[name='UnitDescription']").val(row.find('.UnitDescription').text());
        $("input[name='MeasuringUnit']").val(row.find('.MeasuringUnit').text());
        //$("input[name='Unit']").val(row.find('.Unit').text());
        // Unit Dropdown
        //var unitId = row.find('.Unit').data('unit-id');
        //console.log("unitId:", unitId); //  Check what value you're getting

        //$("#UnitId").val(String(unitId)).change(); // Ensure it's string and triggers change
        //console.log("Dropdown value after setting:", $("#UnitId").val());



        // Get unit from table (text content)
        var unitText = row.find('.Unit').text().trim();
        var $dropdown = $("#UnitId");

        // Check if the unit exists in the dropdown
        if ($dropdown.find("option[value='" + unitText + "']").length === 0) {
            // If not, add it
            $dropdown.append(new Option(unitText, unitText));
            console.log("Unit added to dropdown:", unitText);
        }

        // Set the dropdown to that unit
        $dropdown.val(unitText).change();
        console.log("Unit set in dropdown:", $dropdown.val());


        // ----- ToleranceValue -----
        var fullTolerance = row.find('.ToleranceValue').text().trim();
        var type = '';
        var value = '';

        if (fullTolerance.startsWith('±')) {
            type = '±';
            value = fullTolerance.substring(1);
        } else if (fullTolerance.startsWith('+')) {
            type = '+';
            value = fullTolerance.substring(1);
        } else if (fullTolerance.startsWith('-')) {
            type = '-';
            value = fullTolerance.substring(1);
        }

        $("#ToleranceType").val(type);
        $("input[name='ToleranceValue']").val(value);

        // ----- Tolerance1Value (NEW SECTION) -----
        var fullTolerance1 = row.find('.Tolerance1Value').text().trim();
        var type1 = '';
        var value1 = '';

        if (fullTolerance1.startsWith('+')) {
            type1 = '+';
            value1 = fullTolerance1.substring(1);
        } else if (fullTolerance1.startsWith('-')) {
            type1 = '-';
            value1 = fullTolerance1.substring(1);
        }

        $("#Tolerance1Type").val(type1);
        $("#Tolerance1Value").val(value1);

        // Toggle visibility based on ToleranceType
        toggleTolerance1Visibility(); // Make sure this function exists as in previous steps
        // ✅ Handle IsNumber checkbox
        var isNumberValue = row.find('.IsNumber').text().trim().toUpperCase();
        $("#IsNumber").prop("checked", isNumberValue === "Y");
        $("input[name='Remark']").val(row.find('.Remark').text());

        $('#add').addClass('d-none');
        $('#update').removeClass('d-none');
    }

    function UpdateParameters() {
        if (currentEditingRow == null) return;

        var data = getFormData();

        // 🌐 Basic Field Validations
        let isValid = true;
        let errorMsg = "";

        if (!$('#UnitDescription').val().trim()) {
            isValid = false;
            errorMsg += "• Description is required.\n";
        }

        if (!$('#MeasuringUnit').val().trim()) {
            isValid = false;
            errorMsg += "• Dimention is required.\n";
        }

        if (!$('#UnitId').val()) {
            isValid = false;
            errorMsg += "• Unit is required.\n";
        }

        if (!$('#ToleranceValue').val().trim()) {
            isValid = false;
            errorMsg += "• Tolerance Value is required.\n";
        }


        if (!isValid) {
            alert("Please fill the following:\n\n" + errorMsg);
            return; // ❌ Stop execution
        }

        // Update row cells
        currentEditingRow.find('.UnitDescription').text(data.UnitDescription);
        currentEditingRow.find('.MeasuringUnit').text(data.MeasuringUnit);
        currentEditingRow.find('.Unit').text(data.Unit);
        currentEditingRow.find('.ToleranceValue').text(data.ToleranceValue);

        currentEditingRow.find('.Tolerance1Value').text(data.Tolerance1Value); // ✅ ADD THIS LINE
        currentEditingRow.find('.IsNumber').text(data.IsNumber);
        currentEditingRow.find('.Remark').text(data.Remark);

        clearForm();

        // Reset buttons
        $('#add').removeClass('d-none');
        $('#update').addClass('d-none');
        currentEditingRow = null;
    }


    function deleteRow(btn) {
        $(btn).closest('tr').remove();
        updateSerialNumbers();
    }

    function updateSerialNumbers() {
        rowCount = 0;
        $('#itemsTable tbody tr').each(function () {
            rowCount++;
            $(this).find('.sno').text(rowCount);
        });

        if (rowCount === 0) {
            $('#orderItems').html('');
        }
    }


    function insertRowBelow(btn) {
        const currentRow = $(btn).closest("tr");

        // Store the next row's position
        const insertAfterRow = currentRow;

        // Fill form with the current row's values
        $("input[name='UnitDescription']").val(currentRow.find('.UnitDescription').text().trim());
        $("input[name='MeasuringUnit']").val(currentRow.find('.MeasuringUnit').text().trim());

        //const unitId = currentRow.find('.Unit').data('unit-id');
        //$("#UnitId").val(String(unitId)).change(); // Ensure dropdown is set correctly
        // Get unit from table (text content)
        var unitText = currentRow.find('.Unit').text().trim();
        var $dropdown = $("#UnitId");

        // Check if the unit exists in the dropdown
        if ($dropdown.find("option[value='" + unitText + "']").length === 0) {
            // If not, add it
            $dropdown.append(new Option(unitText, unitText));
            console.log("Unit added to dropdown:", unitText);
        }

        // Set the dropdown to that unit
        $dropdown.val(unitText).change();
        console.log("Unit set in dropdown:", $dropdown.val());
        // Tolerance 1
        const fullTolerance = currentRow.find('.ToleranceValue').text().trim();
        let tolType = '';
        let tolVal = '';
        if (fullTolerance.startsWith('±')) {
            tolType = '±';
            tolVal = fullTolerance.substring(1);
        } else if (fullTolerance.startsWith('+')) {
            tolType = '+';
            tolVal = fullTolerance.substring(1);
        } else if (fullTolerance.startsWith('-')) {
            tolType = '-';
            tolVal = fullTolerance.substring(1);
        }
        $("#ToleranceType").val(tolType);
        $("input[name='ToleranceValue']").val(tolVal);

        // Tolerance 2
        const fullTolerance1 = currentRow.find('.Tolerance1Value').text().trim();
        let tol1Type = '';
        let tol1Val = '';
        if (fullTolerance1.startsWith('+')) {
            tol1Type = '+';
            tol1Val = fullTolerance1.substring(1);
        } else if (fullTolerance1.startsWith('-')) {
            tol1Type = '-';
            tol1Val = fullTolerance1.substring(1);
        }
        $("#Tolerance1Type").val(tol1Type);
        $("#Tolerance1Value").val(tol1Val);
        // Handle IsNumber checkbox
        var isNumberValue = currentRow.find('.IsNumber').text().trim().toUpperCase();
        $("#IsNumber").prop("checked", isNumberValue === "Y");
        // Remark
        $("input[name='Remark']").val(currentRow.find('.Remark').text().trim());

        toggleTolerance1Visibility(); // If you have conditional logic

        // Set form state
        $('#add').removeClass('d-none');
        $('#update').addClass('d-none');

        // Optional: Scroll to form
        $('html, body').animate({
            scrollTop: $("#UnitDescription").offset().top - 100
        }, 300);

        // Set a global variable to know we are inserting below a specific row
        window.insertAfterRow = insertAfterRow;
    }

