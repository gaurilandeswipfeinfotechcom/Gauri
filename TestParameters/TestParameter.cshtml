    function CreateTestParameter() {
        // Get selected ItemId
        var itemId = $('#ItemId').val(); // or just $('select[name="ItemId"]').val()

        console.log('item id is ' + itemId);
        if (!itemId) {
            alert("Please select an item.");
            return;
        }

        // Prepare parameter list from hidden fields or table rows
        var parameters = [];

        $('#itemsTable tbody tr').each(function () {
            var row = $(this);
            var param = {
                UnitDescription: row.find('.UnitDescription').text().trim(),
                MeasuringUnit: row.find('.MeasuringUnit').text().trim(),
                Unit: row.find('.Unit').text().trim(),
                //Unit: $("#UnitId option:selected").text().trim(),
                ToleranceValue: row.find('.ToleranceValue').text().trim(),
                Tolerance1Value: row.find('.Tolerance1Value').text().trim(), //  ADDED LINE
                IsNumber: row.find('.IsNumber').text().trim().toUpperCase(), //  added line
                Remark: row.find('.Remark').text().trim()
            };
            parameters.push(param);
        });

        if (parameters.length === 0) {
            alert("Please add at least one test parameter.");
            return;
        }

        // Prepare data to send
        var dataToSend = {
            ItemId: itemId,
            TestParametersList: parameters
        };

        // Send AJAX request to controller
        $.ajax({
            url: '@Url.Action("CreateTestParameter", "TestParameters")', // Adjust as needed
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dataToSend),
            success: function (response) {
                alert("Test parameter created successfully!");
                window.location.href = '@Url.Action("Index", "TestParameters")'; // redirect if needed
            },
            error: function (xhr) {
                alert("Error occurred: " + xhr.responseText);
            }
        });
    }

</script>