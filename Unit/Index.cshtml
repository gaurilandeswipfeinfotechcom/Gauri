<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="Stylesheet" type="text/css" />
@*AP external CSS*@
<link href="~/CSS/ERPStyle.css" rel="stylesheet" type="text/css" />

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="d-flex" style="margin-top:-20px">
            <h4 class="route-path1">Inventory </h4>
            <h4 class="route-path2 " onclick="location.href='@Url.Action("Index","Unit")'">Unit Master</h4>
        </div>
        <br />

        <div class="panel panel-default outer-main-container">
            <div class="form-group row main-heading">
                <div class="col-sm-8 col-lg-9 d-flex ">
                    <i class="material-icons" style="font-size: 32px; margin-right: 10px;">scale</i>
                    Unit Master
                </div>
                <div class="col-sm-4 col-lg-3">
                    <input type="button" id="CreateSalesOrder" value="Create" class="btn btn-success btn-round create-bttn custo-inner" style="outline:none" onclick="location.href = '@Url.Action("Create", "Unit")'" />
                </div>
            </div>
            <div class="panel-body">
                @Html.TextBox("details", null, new { @onkeyup = "myFunction(this.id)", @class = "form-control", style = "display: none;" })
                @Html.TextBox("Edit", null, new { @onkeyup = "myFunction(this.id)", @class = "form-control", style = "display: none;" })
                @using (Html.BeginForm("Index", "Unit", FormMethod.Post, new { id = "Unit_List" }))
                {
                    <div class="panel panel-success search-rectangle" style="margin-top:-15px">
                        <div class="panel-body">
                            <div class="form-group row" style="margin-top:-15px">
                                <div class="col-lg-2 col-sm-4 pb-3 pb-sm-0">
                                    <label id="label" class="mt-3">Search By :</label>
                                    <div class="form-group row">
                                        @Html.DropDownListFor(m => m.SortByColumnName, new List<SelectListItem>
                                                                 {
                                                                  new SelectListItem{ Text="Unit Type", Value = "UnitType" },
                                                                  new SelectListItem { Text="Unit Name", Value ="UnitName"},
                                                                 }, new { @class = "form-control fs-4 pl-3 dropdown-textbox", style = "height:35px;margin-top:-2px" })
                                    </div>
                                </div>
                                <div class="col-lg-4 col-sm-8 ">
                                    <label id="label" class="mt-3">Find :</label>
                                    @Html.TextBoxFor(m => m.SearchByText, null, new
                               {
                                   @class = "form-control pl-3 fs-4 input-text-box",
                                   style = "height:35px",
                                   @oninput = "searchUnitType(this.id)",
                                   @list = "json-datalistUnitType"
                               })
                                    <datalist id="json-datalistUnitType"></datalist>
                                </div>
                                <div class="col-lg-4 row ">
                                    <div class="col-sm-4 p-3 pb-4 pb-sm-0">
                                        <label id="label">Sort:</label>
                                        <div class="form-group row mt-2">
                                            @Html.DropDownListFor(m => m.OrderByType, new List<SelectListItem>
                                                                     {
                                                                     //new SelectListItem{ Text="Please Select", Value = "Please Select" },
                                                                     new SelectListItem{ Text="Z-A", Value = "Z-A" },
                                                                     new SelectListItem{ Text="A-Z", Value = "A-Z" },
                                                                     }, new { @class = "form-control fs-4 pl-3 dropdown-textbox", style = "height:35px" })
                                        </div>
                                    </div>
                                    <div class="col-sm-4 p-3">
                                        <label id="label">Records:</label>
                                        @Html.TextBoxFor(m => m.RecordsPerPage, null, new
                                   {
                                       @class = "form-control pl-3 fs-4 input-text-box",
                                       style = "height:35px"
                                   })
                                    </div>
                                    <div class="col-sm-4 pt-md-3 p-3">
                                        <label id="label">Page No. :</label>
                                        @Html.TextBox("Page", null, new
                                   {
                                       @class = "form-control pl-3 fs-4 input-text-box",
                                       style = "height:35px",
                                       @id = "Page"
                                   })
                                    </div>
                                </div>
                                <div class="col-lg-2 align-items-end d-flex">
                                    <button type="submit" id="Search" value="Search" name="Search" style="outline: none" class="mb-4 btn btn-success btn-round search-bttn custo-inner">
                                        Search<i class="material-icons" style="font-size: 20px;padding-left:15px">search</i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-group row my-0 py-0">
                                <div class="col-sm-6 col-md-4 col-lg-3 col-xxl-2">
                                    <label id="label">Unit Type :</label>
                                    @Html.CheckBoxFor(m => m.UnitType, true)
                                </div>
                                <div class="col-sm-6 col-md-4 col-lg-3 col-xxl-2">
                                    <label id="label">Unit Name :</label>
                                    @Html.CheckBoxFor(m => m.UnitName, true)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="panel panel-success" style="box-shadow:inset 4px 4px 4px gray;border-radius:10px">
                        <div class="panel-body">
                            <div class="table-responsive">
                                <table class="table">
                                    <tr style="font-size: small">
                                        <th width="5%" style="border-right: 2px solid #fff">
                                            No.
                                        </th>
                                        @if (Model.UnitType == true)
                                        {
                                            <th width="40%" style="border-right: 2px solid #fff">
                                                Unit Name
                                            </th>
                                        }
                                        @if (Model.UnitName == true)
                                        {
                                            <th width="40%" style="border-right: 2px solid #fff">
                                                 Unit Short Form
                                            </th>
                                        }
                                        <th width="15%">
                                            Actions
                                        </th>
                                    </tr>

                                    @foreach (var item in Model.UnitSearchedList)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                @sno
                                                @{ sno++; }
                                            </td>

                                            @if (Model.UnitType == true)
                                            {
                                                <td class="text-center">
                                                    @Html.DisplayFor(modelItem => item.UnitType)
                                                </td>
                                            }
                                            @if (Model.UnitName == true)
                                            {

                                                <td class="text-center"> @Html.DisplayFor(modelItem => item.UnitName)</td>
                                            }

                                            <td align="center">

                                                <span><i class="glyphicon glyphicon-edit" style="cursor:pointer" onclick="location.href='@Url.Action("Edit",new { sono = item.UnitId })'"></i></span>

                                                <span><i class="glyphicon glyphicon-list" style="cursor:pointer" onclick="location.href='@Url.Action("Details",new { sono = item.UnitId })'"></i></span>

                                                <span><i class="glyphicon glyphicon-trash" style="cursor:pointer" onclick="location.href='@Url.Action("Delete",new { sono = item.UnitId })'"></i></span>

                                            </td>
                                        </tr>

                                    }
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive p-2">
                        <table align="center">
                            <tr class="page">
                                @if (Model.PageCount > 1)
                                {
                                    @Html.HiddenFor(m => m.PageCount)

                                    <td>
                                        @if (Model.RequestedPageNumber > 1)
                                        {
                                            <a id="PreviousPage" href="#" class="btn btn-info custo-inner pageno-btn" style="border:none;margin-right:10px;box-shadow:none" onclick='funPageNoClicked(@Model.RequestedPageNumber - 1);'>Previous</a>
                                        }
                                    </td>

                                    for (int pgno = Math.Max(1, Model.RequestedPageNumber - 4); pgno <= Math.Min(Model.PageCount, Model.RequestedPageNumber + 5); pgno++)
                                    {
                                        <td>
                                            <a id="PageNo" href="#" class="btn btn-secondary btn-round @(pgno == Model.RequestedPageNumber ? "active" : "")" onclick='funPageNoClicked(@pgno);'>@pgno.ToString()</a>
                                        </td>
                                    }

                                    <td>
                                        @if (Model.RequestedPageNumber < Model.PageCount)
                                        {
                                            <a id="NextPage" href="#" class="btn btn-info custo-inner pageno-btn" style="border:none;margin-left:10px;box-shadow:none" onclick='funPageNoClicked(@Model.RequestedPageNumber + 1);'>Next</a>
                                        }
                                    </td>
                                }
                                @Html.HiddenFor(x => x.isPageNavigationRequested)
                                @Html.HiddenFor(x => x.RequestedPageNumber)
                            </tr>
                        </table>
                    </div>
                    {
                        <div class="pager">
                            @*@Html.PagedListPager(Model, page => Url.Action("Index", new
                                {
                                    page,
                                    SortBy = ViewBag.SortBy,
                                    OrderBy = ViewBag.OrderBy,
                                    RecordPerPage = ViewBag.RecordPerPage,
                                    SaleOrderDate = ViewBag.SaleOrderDate,

                                    PurchaseOrderNo = ViewBag.PurchaseOrderNo,
                                    PurchaseOrderDate = ViewBag.PurchaseOrderDate,
                                    CompanyName = ViewBag.CompanyName


                                }))Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount*@


                        </div>
                    }
                }


            </div>



        </div>

        @*</div>
            </div>*@
    </div>
</div>
