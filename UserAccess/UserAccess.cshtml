    function module() {

        var forms1 = ["AllowDevice", "CompanyConfiguration", "UserAccess", "AudioPlayList", "EmailTemplate", "EmailCampaning","UserRegistration"];
        var d;
        for (i = 0; i < forms1.length; ++i) {
           if (($("#Create" + forms1[i]).val() == "Y") || ($("#Edit" + forms1[i]).val() == "Y") || ($("#Delete" + forms1[i]).val() == "Y") || ($("#Details" + forms1[i]).val() == "Y") || ($("#Index" + forms1[i]).val() == "Y")) {
                d = "Y";
                break;
            }
            else {
                d = "N";
            }
        }

        var data = {
            UserId: $('#UserId').val().trim(),
            Admin: d

        }
        $.ajax({
            url: '/UserAccess/SaveModuleInfo',
            type: "POST",
            data: JSON.stringify(data),
            dataType: "JSON",
            contentType: "application/json",
            success: function (d) {


                if (d.status == true) {
                    alert("Access modified successfully");
                    // Refresh current page
                    location.reload();
                }
                else {
                    alert('Failed');
                }
                $('#submit').val('Save');
            },
            error: function () {
                alert('Error. Please try again.');
                $('#submit').val('Save');
            }
        });

    }

