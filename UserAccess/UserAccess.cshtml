    function toggleCheckboxes(groupName, selectAllCheckbox) {
        // Get all checkboxes that belong to the specified group
        var checkboxes = document.querySelectorAll(`input[name='${groupName}']`);

        // Set each checkbox's checked state based on the Select All checkbox
        checkboxes.forEach(function (checkbox) {
            checkbox.checked = selectAllCheckbox.checked;
