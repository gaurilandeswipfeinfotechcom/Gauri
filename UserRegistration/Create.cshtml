        /*padding: 5px 6px;*/
        /*font-size: 5px;*/
        padding: 20px;
        font-size: 16px;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        outline: none;
        border: none;
        box-shadow: 0 9px #999;
        height: 3px;
        width: auto;
        margin: 4px 2px;
    }

