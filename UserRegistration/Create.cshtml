<style>
    /*Adding some css for looks good*/
    #label {
        font-size: 15px;
        color: #0077B3;
        font-weight: 500
    }

    h4 {
        font-size: 18px;
        padding: 10px 0;
        font-weight: 600;
    }

    .form-head h4 {
        padding: 10px 10px;
        font-size: 16px;
        font-weight: 600;
        background-color: #C1D5BD;
    }


    .body-panel {
        border: 1px solid black;
        /*background-color: whitesmoke;*/
        margin-top: -10px;
        border-radius: 5px;
        background-color: floralwhite;
    }

    .submit-btn {
        display: inline-flex;
        padding: 7px;
    }


        .submit-btn button {
            border-radius: 30px;
            padding: 5px 5px;
        }



