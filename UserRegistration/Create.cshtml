    var jobProfileData = [];

    $('#DesignationId').change(function () {

        var designationId = $(this).val();

        $('#OfficialEmailTxt, #OfficialMobileTxt').val('').hide();
        $('#OfficialEmailDDL, #OfficialMobileDDL').empty().hide();

        if (!designationId) return;

        $.ajax({
            url: '/UserRegistration/GetJobProfileByDesignation',
            type: 'GET',
            data: { designationId: designationId },
            success: function (data) {

                jobProfileData = data;   // 👈 STORE FULL DATA

                if (data.length === 0) {
                    $('#OfficialEmailTxt').show();
                    $('#OfficialMobileTxt').show();
                }
                else if (data.length === 1) {

                    $('#OfficialEmailTxt').val(data[0].OfficialEmailId).show();
                    $('#OfficialMobileTxt').val(data[0].OfficialMobileNo).show();
                }
                else {

                    $('#OfficialEmailDDL')
                        .append('<option value="">Select Email</option>');

                    $.each(data, function (i, item) {
                        $('#OfficialEmailDDL').append(
                            `<option value="${item.OfficialEmailId}">
                            ${item.OfficialEmailId}
                         </option>`
                        );
                    });

                    $('#OfficialEmailDDL').show();
                    $('#OfficialMobileTxt').show(); // mobile auto fill
                }
            }
        });
    });
    $('#OfficialEmailDDL').change(function () {

        var selectedEmail = $(this).val();

        var selectedProfile = jobProfileData.find(x =>
            x.OfficialEmailId === selectedEmail
        );

        if (selectedProfile) {
            $('#OfficialMobileTxt')
                .val(selectedProfile.OfficialMobileNo)
                .show();
        } else {
            $('#OfficialMobileTxt').val('');
        }
    });
</script>
<script>
    var employeeData = [];

    $('#DesignationId').change(function () {

        var designationId = $(this).val();

        $('#FirstNameTxt, #LastNameTxt').val('').hide();
        $('#FirstNameDDL, #LastNameDDL').empty().hide();
        $('#EmployeeId').val('');

        if (!designationId) return;

        $.ajax({
            url: '/UserRegistration/GetEmployeesByDesignation',
            type: 'GET',
            data: { designationId: designationId },
            success: function (data) {

                employeeData = data;

                if (data.length === 0) {
                    $('#FirstNameTxt, #LastNameTxt').show();
                }
                //else if (data.length === 1) {

                //    $('#FirstNameTxt').val(data[0].FirstName).show();
                //    $('#LastNameTxt').val(data[0].LastName).show();
                //    $('#EmployeeId').val(data[0].EmployeeId);

                //}
                else if (data.length === 1) {

                    $('#FirstNameTxt').val(data[0].FirstName).show();
                    $('#LastNameTxt').val(data[0].LastName).show();
                    $('#EmployeeId').val(data[0].EmployeeId);
                    $('#TitleID').val(data[0].TitleID);   // 👈 auto select title
                }
                else {

                    $('#FirstNameDDL')
                        .append('<option value="">Select First Name</option>');

                    $.each(data, function (i, item) {
                        $('#FirstNameDDL').append(
                            `<option value="${item.EmployeeId}">${item.FirstName}</option>`
                        );
                    });

                    $('#FirstNameDDL').show();
                    $('#LastNameTxt').show(); // last name auto filled
                }
            }
        });
    });
  
    $('#FirstNameDDL').change(function () {

        var empId = $(this).val();
        $('#EmployeeId').val(empId);

        var selectedEmp = employeeData.find(x => x.EmployeeId == empId);

        if (selectedEmp) {
            $('#LastNameTxt').val(selectedEmp.LastName);
            $('#TitleID').val(selectedEmp.TitleID);   // 👈 set title
        } else {
            $('#LastNameTxt').val('');
            $('#TitleID').val('');
        }
    });
</script>











