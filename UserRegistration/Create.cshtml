<script>
    $(document).ready(function () {

        $('#Department').change(function () {

            var departmentName = $(this).val();

            $('#DesignationId').empty();
            $('#DesignationId').append('<option value="">Please Select</option>');

            if (departmentName === "" || departmentName === "Please Select") {
                return;
            }

            $.ajax({
                url: '/UserRegistration/GetDesignationsByDepartment',
                type: 'GET',
                data: { departmentName: departmentName },
                success: function (data) {

                    $.each(data, function (i, item) {
                        $('#DesignationId').append(
                            $('<option>', {
                                value: item.DesignationId,
                                text: item.Designation
                            })
                        );
                    });
                },
                error: function () {
                    alert('Error loading designations');
                }
            });
        });

    });
</script>
