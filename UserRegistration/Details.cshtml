<style>
    /*Adding some css for looks good*/
    #label {
        font-size: 15px;
        color: #0077B3;
        font-weight: 500
    }

    h4 {
        font-size: 18px;
        padding: 10px 0;
        font-weight: 600;
    }

    .form-head h4 {
        padding: 10px 10px;
        font-size: 16px;
        font-weight: 600;
        background-color: #C1D5BD;
    }


    .body-panel {
        border: 1px solid black;
        /*background-color: whitesmoke;*/
        margin-top: -10px;
        border-radius: 5px;
        background-color: floralwhite;
    }

    .submit-btn {
        display: inline-flex;
        padding: 7px;
    }


        .submit-btn button {
            border-radius: 30px;
            padding: 5px 5px;
        }



    .save-btn input {
        /*border-radius: 30px;*/
        font-size: 14px;
    }

    .tablecontainer table {
        width: 100%;
        border-collapse: collapse;
        border-top: 1px solid #fff;
        border-right: 1px solid #fff;
        background-color: #fff
    }

    .tablecontainer th {
        border-bottom: 2px solid #fff !important;
        background-color: lightblue;
        font-size: small;
        font-weight: normal;
        color: midnightblue;
        text-align: center;
        height: 30px;
    }

    .tablecontainer th, .tablecontainer td {
        /*text-align: left;*/
        border-left: 2px solid #fff;
        padding: 5px;
        border-bottom: 2px solid #fff;
        font-size: small;
    }


    fieldset {
        border: 1px solid #ddd !important;
        margin: 10px;
        /*max-width:0;*/
        padding: 5px;
        /* position:relative;*/
        padding-left: 10px !important;
        padding-right: 10px !important;
        /*background-color: whitesmoke;*/
        /* background-color: white;*/
        background-color: white;
    }


    .button {
        display: inline-block;
        /*padding: 5px 6px;*/
        /*font-size: 5px;*/
        padding: 20px;
        font-size: 16px;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        outline: none;
        border: none;
        box-shadow: 0 9px #999;
        height: 3px;
        width: auto;
        margin: 4px 2px;
    }

        .button:hover {
            /*background-color: #3e8e41*/
            background-color: cyan;
        }

        .button:active {
            background-color: cyan;
            box-shadow: 0 5px #666;
            transform: translateY(4px);
        }

    .button1 {
        border-radius: 50%;
    }

    span.error {
        display: block;
        visibility: hidden;
        color: red;
        font-size: 60px;
    }


    .ui-widget {
        font-size: 12px !important;
    }

    .reqError {
        color: #ff0000; /*Red Color*/
        font-weight: bold;
        font-size: 16px;
    }

    .backsubmitbtn {
        background-image: linear-gradient(to right,#35d3e1,midnightblue);
        padding: 5px 20px 5px 20px;
        color: white;
        font-family: Helvetica;
        box-shadow: -4px -4px 8px rgba(255, 255, 255, 0.7), 4px 4px 8px rgba(128, 128, 128, 0.7);
        outline-style: none;
        border: none
    }

    .dshapefieldset {
        background-color: #e5e6e7;
        border: 2px solid #ddd;
        border-radius: 0px 25px 25px 0px;
        margin-bottom: 20px
    }

    .field-heading {
        font-size: 18px;
        color: midnightblue;
        font-family: Helvetica;
        font-weight: bold;
        display: flex
    }

    .route-path1 {
        cursor: pointer;
        clip-path: polygon(0% 0%, 80% 0%, 100% 50%, 80% 100%, 0% 100%);
        background-color: #003399;
        color: white;
        padding: 5px 15px 5px 5px
    }

    .route-path2 {
        cursor: pointer;
        color: white;
        clip-path: polygon(92% 0%, 100% 50%, 92% 100%, 0% 100%, 8% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }

    .route-path3 {
        cursor: pointer;
        color: white;
        clip-path: polygon(90% 0%, 100% 50%, 90% 100%, 0% 100%, 10% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }

    .cross-btn {
        font-size: 30px;
        cursor: pointer;
        color: midnightblue;
        position: absolute;
        top: 35px;
        right: 15px;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>

