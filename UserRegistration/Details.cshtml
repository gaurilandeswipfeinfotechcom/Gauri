<link href="~/Content/ERPStyle.css" rel="stylesheet" type="text/css" />

@using (Html.BeginForm("Details", "UserRegistration", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <form id="TypeValidation" class="form-horizontal" action="#" method="">
        <div class="row clearfix">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="d-flex" style="margin-top:-20px">
                    <h4 class="route-path1">Admin</h4>
                    <h4 class="route-path2 " onclick="location.href='@Url.Action("Index","UserRegistration")'">ERP Registration</h4>
                    <h4 class="route-path3 " onclick="location.reload()">Details</h4>
                </div>
                <br />
                @*<div class="card" style="background-color:lightslategrey">

                    <div class="container-fluid">*@
            <div class="panel panel-default outer-main-container">
                <div class=" main-heading">
                    <div class=" d-flex pr-5">
                        <i class="material-icons" style="font-size: 32px; margin-right: 10px;">feed</i>
                        ERP Registration Form
                        <i class="material-icons cross-btn" onclick="history.back()">cancel</i>
                    </div>
                </div>

                <div class="panel-body">
                    <div class="form-group row">
                        <div class="col-lg-2">
                            <label id="label">Department :</label>


                            @Html.EditorFor(model => model.Department, new { htmlAttributes = new { @placeholder = "Department", @class = "form-control fs-4 pl-3 input-text-box", style = "background-color:gainsboro;font-size:small;height:30px;width:80%", disabled = "true" } })
                            @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
                           
                        </div>
                        <div class="col-lg-3">
                            <label id="label"> Designation :</label>
                            <div class="form-group row">
                                @Html.DropDownList("DesignationId", null, "Please Select", new { @class = "form-control fs-4 pl-3 input-text-box", disabled = "true", style = "background-color:gainsboro;font-size:small;height:30px;width:70%" })
                                <span id="errorDesignn"></span>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <label id="label">Email :</label>

                            @Html.EditorFor(model => model.LoginEmailId, new { htmlAttributes = new { @placeholder = "Email Name", @class = "form-control fs-4 pl-3 input-text-box", style = "background-color:gainsboro;font-size:small;height:30px;width:70%", disabled = "true" } })
                            @Html.ValidationMessageFor(model => model.LoginEmailId, "", new { @class = "text-danger" })

                        </div>
                        <div class="col-lg-3">
                            <label id="label">Office Mobile Number :</label>

                            @Html.EditorFor(model => model.MobileNo, new { htmlAttributes = new { @placeholder = "MobileNo", @class = "form-control fs-4 pl-3 input-text-box", style = "font-size:small;height:30px; width:70%;background-color:gainsboro", disabled = "true" } })
                            @Html.ValidationMessageFor(model => model.MobileNo, "", new { @class = "text-danger" })

                        </div>
                    </div>


                    <div class="form-group row">
                        <div class="col-lg-2">
                            <label id="label">Title :</label>
                            <div class="form-group row">
                                @*@Html.DropDownList("Title1", (IEnumerable<SelectListItem>)ViewBag.DDU, new { @class = "form-control", style = "font-size:small;height:30px" })*@
                                @Html.DropDownList("TitleID", (IEnumerable<SelectListItem>)ViewBag.Title1, new { @class = "form-control fs-4 pl-3 input-text-box", style = "font-size:small;height:30px; width:80%;background-color:gainsboro", disabled = "true" })
                            </div>
                            @*@Html.DropDownList("Title", (IEnumerable<SelectListItem>)ViewBag.Title, "Please Select", new { @class = "form-control", style = "font-size:small;height:30px" })*@
                            <br />
                            <span id="errorTitleID"></span>
                        </div>


                        @Html.HiddenFor(model => model.UserId)
                        @Html.HiddenFor(model => model.EmployeeId)
                        <div class="col-lg-3">
                            <label id="label">First Name :</label>

                            @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @placeholder = "First Name", @class = "form-control fs-4 pl-3 input-text-box", @onkeyup = "myFunction(this.id)", style = "background-color:gainsboro;font-size:small;height:30px;width:70%", disabled = "true" } })
                            @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })

                        </div>

                        <div class="col-lg-3">
                            <label id="label">Last Name :</label>

                            @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @placeholder = "Last Name", @class = "form-control fs-4 pl-3 input-text-box", @onkeyup = "myFunction(this.id)", style = "background-color:gainsboro;font-size:small;height:30px;width:70%", disabled = "true" } })
                            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })


                        </div>
                        <div class="col-lg-3">

                            <label id="label">Password :</label>

                            @Html.EditorFor(model => model.LoginPassword, new { htmlAttributes = new { @placeholder = "Password", @class = "form-control fs-4 pl-3 input-text-box", name = "LoginPassword", required = "true",  style = "background-color:gainsboro;font-size:small;height:30px;width:70%", disabled = "true" } })
                            @Html.ValidationMessageFor(model => model.LoginPassword, "", new { @class = "text-danger" })

                        </div>
                    </div>


                        <div class="form-group row">



                            
                            <div class="col-lg-2">
                                <label id="label">Zone :</label>

                                <div class="form-group">

                                    @Html.DropDownList("Zone", new List<SelectListItem>
                                            {
                                                new SelectListItem{ Text="South", Value = "South" },
                                                new SelectListItem{ Text="East", Value = "East" },
                                                new SelectListItem{ Text="West", Value = "West" },
                                                new SelectListItem{ Text="North", Value = "North" },
                                             }, new { @class = "form-control fs-4 pl-3 input-text-box", style = "background-color:gainsboro;font-size:small;height:30px;width:82%", disabled = "true" })

                                </div>
                            </div>
                            <div class="col-lg-2">
                                <label id="label">Sale Type :</label>
                                <div class="form-group">
                                    @Html.DropDownList("SaleType", new List<SelectListItem>
                                       {
                                       new SelectListItem{ Text="Please Select", Value = "Please Select" },
                                           new SelectListItem{ Text="Dependent", Value = "Dependent" },
                                           new SelectListItem{ Text="Independent", Value = "Independent" },

                                        }, new { @class = "form-control fs-4 pl-3 input-text-box", style = "font-size:small;height:30px; background-color:gainsboro;font-size:small;height:30px;width:109%", disabled = "true" })
                                </div>
                            </div>
                        </div>




                   

                    </div>

                    <div class="form-group row ">

                        <div class="col-md-2 col-lg-3 px-4">
                            <input type="button" value="Close" class=" btn btn-success btn-round create-bttn custo-inner" style="outline:none; border-radius:50px; padding:6px 20px;" onclick="history.back();" />
                        </div>
                    </div>
                  
                </div>
        </div>
        @*</div>*@
            </div>
    </form>
    
}

