<script>


    //Save button click function
    function UpdateUser() {
        var isAllValid = true;
        if ($('#FirstName').val().trim() == "") {
            $('#FirstName').siblings('span.error').css('visibility', 'visible');
            isAllValid = false;
            $('#FirstName').focus();
            $("#errorFirst1").html('<span style="color:red">Enter FirstName</span>');
            $("#errorFirst1").show();

        }
        else {
            $('#FirstName').siblings('span.error').css('visibility', 'hidden');
            $("#errorFirst1").html("");
            $("#errorFirst1").hide();
            var FirstName = /^[A-Za-z]+$/;
            if ($('#FirstName').val().match(FirstName)) {
                $('#FirstName').siblings('span.error').css('visibility', 'hidden');
                $("#emailerrorFirst1").html("");
                $("#emailerrorFirst1").hide();
                $("#errorFirst1").html("");
                $("#errorFirst1").hide();


            }
            else {
                $('#FirstName').siblings('span.error').css('visibility', 'visible');

                $("#emailerrorFirst1").html('<span style="color:red">Enter Only Character</span>');


                $("#emailerrorFirst1").show();
                $("#errorFirst1").html("");
                $("#errorFirst1").hide();

            }

        }



        if ($('#LastName').val().trim() == "") {
            $('#LastName').siblings('span.error').css('visibility', 'visible');
            isAllValid = false;
            $('#LastName').focus();
            $("#errorLast1").html('<span style="color:red">Enter LastName</span>');
            $("#errorLast1").show();

        }
        else {
            $('#LastName').siblings('span.error').css('visibility', 'hidden');
            $("#errorLast1").html("");
            $("#errorLast1").hide();

            var LastName = /^[A-Za-z]+$/;
            if ($('#LastName').val().match(LastName)) {
                $('#LastName').siblings('span.error').css('visibility', 'hidden');
                $("#emailerrorLast1").html("");
                $("#emailerrorLast1").hide();
                $("#errorLast1").html("");
                $("#errorLast1").hide();


            }
            else {
                $('#LastName').siblings('span.error').css('visibility', 'visible');

                $("#emailerrorLast1").html('<span style="color:red">Enter Only Character</span>');


                $("#emailerrorLast1").show();
                $("#errorLast1").html("");
                $("#errorLast1").hide();

            }

        }
        if ($('#LoginEmailId').val().trim() == "") {

            $('#LoginEmailId').siblings('span.error').css('visibility', 'hidden');
            isAllValid = false;
            $('#LoginEmailId').focus();
            $("#error1").html('<span style="color:red">Enter EmailID</span>');
            $("#error1").show();

        }
        else {
            if ($('#LoginEmailId').val().trim() != "") {
                $('#LoginEmailId').siblings('span.error').css('visibility', 'hidden');
                $("#error1").html("");
                $("#error1").hide();


                var EmailID = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
                if ($('#LoginEmailId').val().match(EmailID)) {

                    $('#LoginEmailId').siblings('span.error').css('visibility', 'hidden');
                    $("#error1").html("");
                    $("#error1").hide();
                    $("#emailerror1").html("");
                    $("#emailerror1").hide();


                }
                else {

                    $('#LoginEmailId').siblings('span.error').css('visibility', 'visible');
                    //$("#EmailID").siblings().after("<div class='validation' style='color:red;margin-bottom: 20px;'>Please enter Correct Email</div>");
                    $("#emailerror1").html('<span style="color:red">Invalid Email</span>');
                    isAllValid = false;
                    //$result.css("color", "red");
                    $("#emailerror1").show();
                    $("#error1").html("");
                    $("#error1").hide();


                }
            }
        }
        if ($('#DesignationId').val().trim() == "") {

            $('#DesignationId').siblings('span.error').css('visibility', 'visible');
            isAllValid = false;
            $("#errorDesignn").html('<span style="color:red">Select Designation</span>');
            $("#errorDesignn").show();

        }
        else {

            $('#DesignationId').siblings('span.error').css('visibility', 'hidden');

            $("#errorDesignn").html("");
            $("#errorDesignn").hide();
        }
        if ($('#TitleID').val().trim() == "") {

            $('#TitleID').siblings('span.error').css('visibility', 'visible');
            isAllValid = false;
            $("#errorTitleID").html('<span style="color:red">Select Designation</span>');
            $("#errorTitleID").show();

        }
        else {

            $('#TitleID').siblings('span.error').css('visibility', 'hidden');

            $("#errorTitleID").html("");
            $("#errorTitleID").hide();
        }

        if ($('#LoginPassword').val().trim() == "") {

            $('#LoginPassword').siblings('span.error').css('visibility', 'visible');
            isAllValid = false;
            $("#errorpass").html('<span style="color:red">Password Required</span>');
            $("#errorpass").show();

        }
        else {

            $('#LoginPassword').siblings('span.error').css('visibility', 'hidden');

            $("#errorpass").html("");
            $("#errorpass").hide();
        }

        if ($('#Department').val().trim() == "Please Select") {

            $('#Department').siblings('span.error').css('visibility', 'visible');
            isAllValid = false;
            $("#errorDept").html('<span style="color:red">Department Required</span>');
            $("#errorDept").show();

        }
        else {

            $('#Department').siblings('span.error').css('visibility', 'hidden');

            $("#errorDept").html("");
            $("#errorDept").hide();
        }

        if ($('#Zone').val().trim() == "Please Select") {

            $('#Zone').siblings('span.error').css('visibility', 'visible');
            isAllValid = false;
            $("#errorzn").html('<span style="color:red">Zone Required</span>');
            $("#errorzn").show();

        }
        else {

            $('#Zone').siblings('span.error').css('visibility', 'hidden');

            $("#errorzn").html("");
            $("#errorzn").hide();
        }

        //Save if valid
        if (isAllValid) {

            var data = {

                UserId: $('#UserId').val().trim(),
                //E_ID: $('#E_ID').val().trim(),
                FirstName: $('#FirstName').val().trim(),

                LastName: $('#LastName').val().trim(),
                LoginEmailId: $('#LoginEmailId').val().trim(),
                DesignationId: $('#DesignationId').val().trim(),
                TitleID: $('#TitleID').val().trim(), // Changed to match the DropDownList name
                MobileNo: $('#MobileNo').val().trim(),
                LoginPassword: $('#LoginPassword').val().trim(),
                Zone: $('#Zone').val().trim(),
                SaleType: $('#SaleType').val().trim(),
                Department: $('#Department').val().trim(),
                //WorkFunction: $('#WorkFunction').val().trim(),

                //To: $('#To').val().trim(),
                //From: $('#From').val().trim()

            }
            console.log(data);

            $(this).val('Please wait...');

            $.ajax({
                url: '/UserRegistration/UpdateUserform',
                type: "POST",
                data: JSON.stringify(data),
                dataType: "JSON",
                contentType: "application/json",
                success: function (d) {

                    //check is successfully save to database
                    if (d.status == true) {
                        //will send status from server side
                        alert('Updated Successfully');

                        $('#UserId').val('');
                        //$('#E_ID').val('');
                        $('#FirstName').val('');
                        $('#LastName').val('');
                        $('#LoginEmailId').val('');
                        $('#DesignationId').val('');
                        $('#Title1').val('');
                        $('#MobileNo').val('');
                        $('#LoginPassword').val('');
                        $('#Zone').val('');

                        $('#Department').val('');
                        //$('#WorkFunction').val('');
                        //$('#To').val('');
                        //$('#From').val('');

                        window.location.href = '/UserRegistration/Index';
                    }
                    else {
                        alert('Failed');
                    }
                    $('#submit').val('Save');
                },
                error: function () {
                    alert('Error. Please try again.');
                    $('#submit').val('Save');
                }
            });


        }
    }



    ///First Letter Uppercase
    function myFunction(id) {
        var txt = document.getElementById(id);
        txt.value = txt.value.replace(/\w\S*/g, function (txt) { return txt.charAt(0).toUpperCase() + txt.substr(1); });
    }


    /////punchuation marks after space and before remove space
    $(document).ready(function () {
        $('#FirstName,#LastName,#Company,#Designation').keyup(function () {
            str = this.value.replace(/(?=\S)[,.!?:;)](?=\S)/g, '$& ');

            str1 = this.value.replace(/\s+([,.!?:;)])/g, "$1");
            str2 = this.value.replace(/(?=\S)[&](?=\S)/g, ' & ', '$& ');
            str3 = this.value.replace(/\b[(]/g, ' (', "(");

            if (str != this.value) this.value = str;
            else
                if (str1 != this.value) this.value = str1;
                else
                    if (str2 != this.value) this.value = str2;
                    else
                        if (str3 != this.value) this.value = str3;


        });
    });


    ///textbox starting remove blank space
    $(function () {
        $('#FirstName,#LastName,#Company,#Designation').blur(function () {
            $(this).val(
                $.trim($(this).val())
            );
        });
    });


</script>
