                    <button id="goBackButton" class="btn btn-success" style="display:none;border-radius:30px;">Go Back</button>
                    <script>
                        $(document).ready(function () {
                            var table = $("#stockTable").DataTable({
                                // ... (your existing DataTable initialization code)
                            });

                            var searchInput = $("#SearchByText");
                            var goBackButton = $("#goBackButton");

                            // Check if the search input has a value when the page loads
                            if (searchInput.val()) {
                                goBackButton.show(); // Show the "GoBack" button if there's a value in the search input
                            }

                            // Handle the click event of the "GoBack" button
                            goBackButton.on("click", function () {
                                // Clear the value in the search input
                                searchInput.val('');

                                // Reload the page
                                location.reload();
                            });

                            // Rest of your existing code...
                        });
                    </script>
                    <table align="center">
                        <tr class="page">
                            @if (Model.PageCount > 1)
                            {
                                @Html.HiddenFor(m => m.PageCount)
                                <td>
                                    @if (Model.RequestedPageNumber > 1)
                                    {
                                        <a id="FirstPage" href="#" class="btn btn-info" onclick='funPageNoClicked(1);'>First</a>
                                    }
                                </td>

                                <td>
                                    @if (Model.RequestedPageNumber > 1)
                                    {
                                        <a id="PreviousPage" href="#" class="btn btn-info" onclick='funPageNoClicked(@Model.RequestedPageNumber - 1);'><<</a>
                                    }
                                </td>

                                {
                                    int startPage;
                                    int endPage;

                                    if (Model.PageCount <= 10)
                                    {
                                        startPage = 1;
                                        endPage = Model.PageCount;
                                    }
                                    else
                                    {
                                        if (Model.RequestedPageNumber <= 6)
                                        {
                                            startPage = 1;
                                            endPage = 10;
                                        }
                                        else if (Model.RequestedPageNumber >= Model.PageCount - 4)
                                        {
                                            startPage = Model.PageCount - 9;
                                            endPage = Model.PageCount;
                                        }
                                        else
                                        {
                                            startPage = Model.RequestedPageNumber - 5;
                                            endPage = Model.RequestedPageNumber + 4;
                                        }
                                    }

                                    for (int pgno = startPage; pgno <= endPage; pgno++)
                                    {
                                        <td>
                                            <a id="PageNo" href="#" class="btn btn-secondary @(pgno == Model.RequestedPageNumber ? "active" : "")" onclick='funPageNoClicked(@pgno);'>@pgno.ToString()</a>
                                        </td>
                                    }
                                }

                                <td>
                                    @if (Model.RequestedPageNumber < Model.PageCount)
                                    {
                                        <a id="NextPage" href="#" class="btn btn-info" onclick='funPageNoClicked(@Model.RequestedPageNumber + 1);'>>></a>
                                    }
                                </td>
                                <td>
                                    @if (Model.RequestedPageNumber < Model.PageCount)
                                    {
                                        <a id="LastPage" href="#" class="btn btn-info" onclick='funPageNoClicked(@Model.PageCount);'>Last</a>
                                    }
                                </td>
                            }
                            @Html.HiddenFor(x => x.isPageNavigationRequested)
                            @Html.HiddenFor(x => x.RequestedPageNumber)
                        </tr>
                    </table>




                    //if (Model.PageCount > 1)
                    //{
                    <div class="pager">

                    </div>
                }
                @*}*@

            </div>
        </div>

        @*</div>
            </div>*@
    </div>
</div>
<script type="text/javascript">
    var currentPageNumber;  // Variable to store the current page number

    function openEditForm(detailsFormUrl) {
        // Store the current page number before opening the edit form
        currentPageNumber = $("#Page").val();

        var editTab = window.open(detailsFormUrl, '_blank');

        // Listen for the edit tab closure
        window.addEventListener('beforeunload', function () {
            // Refresh the index page with the stored page number when the edit tab is closed
            if (window.opener && !window.opener.closed) {
                window.opener.location.href = window.opener.location.href + "?page=" + currentPageNumber;
            }
        });
    }
</script>

<script type="text/javascript">
    var currentPageNumber;  // Variable to store the current page number

    function openDeleteForm(deleteFormUrl) {
        // Store the current page number before opening the delete form
        currentPageNumber = $("#Page").val();

        var deleteTab = window.open(deleteFormUrl, '_blank');

        // Listen for the delete tab closure
        window.addEventListener('beforeunload', function () {
            // Refresh the index page with the stored page number when the delete tab is closed
            if (window.opener && !window.opener.closed) {
                window.opener.location.href = window.opener.location.href + "?page=" + currentPageNumber;
            }
        });
    }
</script>
<script>
                                $(function () {
                                $("#Search").click(function () {
                                var requestedPageNumber = parseInt($("#Page").val());
                                if (!isNaN(requestedPageNumber) && requestedPageNumber > 0 && requestedPageNumber <= @Model.PageCount) {
                                funPageNoClicked(requestedPageNumber);
                                }
                                });
                                });
</script>
