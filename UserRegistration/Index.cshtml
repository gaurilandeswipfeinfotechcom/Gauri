<script type="text/javascript">
    $(window).load(function () {
        //var b = 9;
        var b = '@Session["LoginUserId"]';
        $.ajax({
            url: '@Url.Action("GetInfo")',
            data: { "userId": b },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {

                if (data.length > 0) {

                    for (var i = 0; i < data.length; i++) {

                        if (data[i].FormName == "UserRegistration") {



                            if (data[i].Create == "Y") {


                                $('#CreateUserRegistration').show();
                            }
                            else {

                                $('#CreateUserRegistration').hide();

                            }

                        }

                    }

                }

            }


        });
    });

    function searchUserId(id) {
        var txt = document.getElementById(id);
        //txt.value = txt.value.replace(/\w\S*/g, function (txt) { return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase(); });

        $.ajax({
            url: '/UserRegistration/AutocompleteUser/',
            //data: { "Enq": txt.value },
            data: { "SearchByText": txt.value, "sortBy": $('#SortByColumnName').val() },
            type: "POST",
            dataType: "json",

            success: function (data) {
                $('#json-datalistUserId').empty();
                var jsonOptions = data;
                var dataList = document.getElementById('json-datalistUserId');

                jsonOptions.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = item;
                    dataList.appendChild(option);
                });
            },
            error: function (xhr, status, error) {
                alert(xhr.responseText);
            }
        });
    }

    function validate() {
        if ($('#SearchByText').val() != "") {
            $('#SortByColumnName').val('UserId');
            //$('#SortByColumnName').val('CompanyName');

        }
        else if ($('#SortByColumnName').val() != "UserId") {
            $('#searchUserId').val('');
        }
    }

        function funPageNoClicked(requestedPgNo) {
            $("#isPageNavigationRequested").val("true");
            $("#RequestedPageNumber").val(requestedPgNo);
            event.preventDefault();
            $("#User_List").submit();
        }
        $(function () {
            $("#Search").click(function () {
                $("#isPageNavigationRequested").val("false");
            });
        });

</script>

