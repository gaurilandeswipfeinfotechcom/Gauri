    // Customer Contact person data......
    $(document).on('click', '#update-contact-persons', function (e) {
        e.preventDefault();
        let errors = [];

        // Required field validations
        if (!$('#personFirstName').val().trim()) {
            errors.push("First name is required.");
        }
        if (!$('#personLastName').val().trim()) {
            errors.push("Last name is required.");
        }
        if (!$('#personDesignationId').val()) {
            errors.push("Designation is required.");
        }


        // ---------- CONDITIONAL REQUIRED VALIDATION ----------
        if ($("#OwnerDetails").val() !== "OwnerDetails") {

            if (!$('#personOfficeMobile').val().trim()) {
                errors.push("Office mobile number is required.");
            }

            if (!$('#personOfficeEmail').val().trim()) {
                errors.push("Office email is required.");
            }
        }

        // ---------- REGEX ----------
        const mobileRegex = /^(?:\+91)?[6-9]\d{9}$/;
        const emailRegex = /^[a-zA-Z0-9._%+-]+@@[a-zA-Z0-9.-]+\.[A-Za-z]{2,}$/;


        // ---------- FORMAT VALIDATION ----------
        const officeMobile = $('#personOfficeMobile').val().trim();
        const officeEmail = $('#personOfficeEmail').val().trim();

        const officeAltEmail = $('#personAltEmail').val().trim();
        const isCCChecked = $('#personAltCC').prop('checked');

        if (isCCChecked) {
            // CC checked → field required
            if (!officeAltEmail) {
                errors.push("Alternate email is required when CC is checked.");
            } else if (!emailRegex.test(officeAltEmail)) {
                errors.push("Alternate email is invalid.");
            }
        } else {
            // CC not checked → field optional, but must be valid if filled
            if (officeAltEmail && !emailRegex.test(officeAltEmail)) {
                errors.push("Alternate email is invalid.");
            }
        }


        if (officeMobile && !mobileRegex.test(officeMobile)) {
            errors.push("Office contact must be exactly 10 digits.");
        }

        if (officeEmail && !emailRegex.test(officeEmail)) {
            errors.push("Office email is invalid.");
        }

        // ---------- STOP IF ANY ERRORS ----------
