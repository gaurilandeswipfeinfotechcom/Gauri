    function toSentenceCaseLive(text) {
        return text
            .replace(/,{2,}/g, ',')
            .replace(/\s*,/g, ', ')
            .replace(/(,\s*){2,}$/g, ',')
            .toLowerCase()
            .replace(/(^|\s)([a-z])/g, function (match, space, letter) {
                return space + letter.toUpperCase();
            });
    }
    $(document).ready(function () {
        $('.sentence-case-input').each(function () {
            $(this).data('lastVal', $(this).val() || '');
        });

        $('.sentence-case-input').on('input', function () {
            const $this = $(this);
            const val = $this.val();
            const lastVal = $this.data('lastVal') || '';

            const isDeleting = val.length < lastVal.length;

            if (isDeleting) {
                $this.data('lastVal', val);
                return;
            }

            const el = this;
            const start = el.selectionStart;
            const end = el.selectionEnd;

            let newVal = toSentenceCaseLive(val);

            // Fix cursor position after fixing spaces after punctuation marks
            const beforeCursorOriginal = val.slice(0, start);
            const beforeCursorFixed = beforeCursorOriginal.replace(/([.!?,])\s*/g, '$1 ');
            const cursorDiff = beforeCursorFixed.length - beforeCursorOriginal.length;

            newVal = newVal.replace(/([.!?,])\s*/g, '$1 ');

            if (val !== newVal) {
                $this.val(newVal);
                el.setSelectionRange(start + cursorDiff, end + cursorDiff);
            }

            $this.data('lastVal', newVal);
        });
    });



</script>