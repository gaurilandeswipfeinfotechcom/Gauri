    function OwnerDetails(panno, owner) {
        if (owner === "OwnerDetails") {


            $('#addcontact').text("Add Owner Details");
            if (!panno || panno.length < 5) return;

            const fourthChar = panno.charAt(3).toUpperCase(); // PAN 4th char (index 3)
            const fifthChar = panno.charAt(4).toUpperCase();  // PAN 5th char (index 4)

            // Reset everything first
            $('#personDesignationId').prop('disabled', false);
            $('#personLastName').prop('readonly', false).off('input');

            switch (fourthChar) {
                case "C":
                    $('#personDesignationId').val(1).prop('disabled', true);
                    break;
                case "H":
                    $('#personDesignationId').val(2).prop('disabled', true);
                    break;
                case "F":
                    $('#personDesignationId').val(3).prop('disabled', true);
                    break;
                case "T":
                    $('#personDesignationId').val(6).prop('disabled', true);
                    break;
                case "A":
                case "G":
                    $('#personDesignationId').prop('disabled', false);
                    break;
                case "P":
                    $('#personDesignationId').val(4).prop('disabled', true);

                    // Enforce last name starting with 5th PAN char
                    $('#personLastName').prop('readonly', false).off('input').on('input', function () {
                        const currentVal = $(this).val();
                        if (currentVal.length === 0) return;

                        const firstChar = currentVal.charAt(0).toUpperCase();
                        if (firstChar !== fifthChar) {
                            alert(`Last Name must start with '${fifthChar}' as per PAN.`);
                            $(this).val('');
                        }
                    });
                    break;
                default:
                    $('#personDesignationId').prop('disabled', false);
            }
        }
        else {
            // Remove any locking logic
            $('#addcontact').text("Add Contact Person"); // reset default
            $('#personDesignationId').attr('disabled', false);
            $('#personLastName').off('input');
        }
    }


