    //Specific Instruction data
    $(document).ready(function () {

        const msmeInput = document.getElementById("MSMENumber");
        const msmeError = document.getElementById("msmeError");

        const validRegex = /^UDYAM-[A-Z]{2}-\d{2}-\d{7}$/;

        msmeInput.addEventListener("input", function () {
            let val = this.value.toUpperCase();

            // Remove anything not allowed (only UDYAM-XX-00-0000000)
            val = val.replace(/[^A-Z0-9-]/g, '');

            // Auto-format: force 'UDYAM-' prefix if not already
            if (!val.startsWith("UDYAM-")) {
                val = "UDYAM-";
            }

            // Prevent more than 2 letters after UDYAM-
            const parts = val.split('-');

            // Fix extra parts
            if (parts.length > 4) {
                parts.length = 4;
            }

            // Rebuild correctly formatted value
            val = parts[0] || "UDYAM";
            if (parts.length > 1) val += "-" + (parts[1].substring(0, 2).replace(/[^A-Z]/g, ''));
            if (parts.length > 2) val += "-" + (parts[2].substring(0, 2).replace(/\D/g, ''));
            if (parts.length > 3) val += "-" + (parts[3].substring(0, 7).replace(/\D/g, ''));

            this.value = val;

            // Final validation check
            if (validRegex.test(val)) {
                msmeError.style.display = "none";
            } else {
                msmeError.style.display = "inline";
            }
        });
    });

    function validateAndUpdateCompany() {

        clearValidationMessages();

        let isValid = true;

        const companyName =
            $("#editcompanyName").val().trim();

        const pan =
            $("#editcompanyPAN").val().toUpperCase().trim();

        // COMPANY NAME

        if (companyName === "") {

            $("#companyNameError").text(
                "❌ Vendor name is required."
            );

            isValid = false;
        }

        // PAN

        if (pan === "") {

            $("#panError").text(
                "❌ PAN is required."
            );

            isValid = false;

        } else {

            GSTPIN();

            if ($("#panError").text() !== "") {
                isValid = false;
            }

            if ($("#companyNameError").text() !== "") {
                isValid = false;
            }
        }

        // WEBSITE

        if (!validateWebsite()) {
            isValid = false;
        }

        // MSME

        const isMSMEChecked =
            $('#MSMECheckbox').prop('checked');

        const msmeNo =
            $('#MSMENumber').val().trim();

        const msmeRegex =
            /^UDYAM-[A-Z]{2}-\d{2}-\d{7}$/;

        if (isMSMEChecked) {

            if (!msmeNo) {

                $("#msmeError")
                    .text("❌ MSME number is required.")
                    .show();

                isValid = false;

            } else if (!msmeRegex.test(msmeNo)) {

                $("#msmeError")
                    .text("❌ Invalid MSME number format.")
                    .show();

                isValid = false;

            } else {

                $("#msmeError").hide();
            }

        } else {

            $("#msmeError").hide();
        }

        return isValid;
    }


$(document).ready(function () {

    $('#UpdateCompany').click(function () {

        if (!validateAndUpdateCompany()) return;

        var user = '@Session["LoginUserId"]';

        const ledgerID = $('#editLedgerN').val().trim();

        let formData = new FormData();

        formData.append("Section", "Company");
        formData.append("UserId", user);
        formData.append("BusinessEntityId", ledgerID);

        formData.append("EntityName", $('#editcompanyName').val());
        formData.append("PAN", $('#editcompanyPAN').val());
        formData.append("CIN", $('#editcompanyCIN').val());
        formData.append("TypeOfEntityId", $('#TypeOfCompanyID').val());
        formData.append("Website", $('#editcompanyWebsite').val());

        // MSME
        formData.append("MSMENo", $('#MSMENumber').val());
        formData.append(
            "IsMSMENo",
            $('#MSMECheckbox').prop('checked') ? "Y" : "N"
        );

        const MSMEFile = $('#MSMEInput')[0].files[0];

        if (MSMEFile) {
            formData.append("CustomPhotoFileMSME", MSMEFile);
        }

        console.log("🟢 LedgerID:", ledgerID);

        // CREATE
        if (ledgerID == null || ledgerID == "") {

            $.ajax({
                url: '/Vendor/CreateCustomerProfile',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,

                success: function (response) {

                    if (response.success) {

                        alert("✅ Created Successfully");

                        window.location.href =
                            `/Vendor/create/${response.ledgerId}`;

                    } else {
                        alert(response.message);
                    }
                },

                error: function (xhr, status, error) {
                    alert("Error: " + error);
                }
            });

        }

        // UPDATE
        else {

            $.ajax({
                url: '/Vendor/UpdateCustomerProfile',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,

                success: function (response) {

                    if (response.success) {

                        alert("✅ Updated Successfully");

                        location.reload();

                    } else {

                        alert("❌ Failed: " + response.message);
                    }
                },

                error: function (xhr, status, error) {
                    alert("❌ AJAX error: " + error);
                }
            });

        }

    });

});







