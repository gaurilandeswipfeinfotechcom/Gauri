    // 🔹 Dispatch Mode Change
    function checksendtype(code) {

        if (code === "By Hand") {

            // Set TOD to Self Pick Up
            $("#TermsOfDeliveryID option").filter(function () {
                return $(this).text().trim().toLowerCase() === "self pick up";
            }).prop("selected", true);

            $("#CourierID").val("");
            $("#CourierID").prop("disabled", true);
        }

        else if (code === "By Courier") {

            // Set TOD to Freight Paid (default for courier)
            $("#TermsOfDeliveryID option").filter(function () {
                return $(this).text().trim().toLowerCase() === "freight paid";
            }).prop("selected", true);

            $("#CourierID").prop("disabled", false);
        }

        // Important: trigger change so UI updates properly
        $("#TermsOfDeliveryID").trigger("change");
    }





    // 🔹 Terms Of Delivery Change
    function checkTODChange() {

        var selectedText = $("#TermsOfDeliveryID option:selected").text().trim().toLowerCase();

        if (selectedText === "self pick up") {

            $("#ByHand").prop("checked", true);
            $("#CourierID").val("");
            $("#CourierID").prop("disabled", true);

        } else {

            $("#ByCourier").prop("checked", true);
            $("#CourierID").prop("disabled", false);
        }
    }
    $(document).ready(function () {

