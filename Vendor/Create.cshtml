    // Validate website format
    function validateWebsite() {
        const website = $("#editcompanyWebsite").val().trim();
        const websiteRegex = /^(https?:\/\/)?(www\.)?[a-zA-Z0-9\-]+\.[a-z]{2,}(\.[a-z]{2,})?(\/.*)?$/;

        if (website && !websiteRegex.test(website)) {
            $("#websiteError").text("❌ Enter a valid website URL (e.g. https://example.com)");
            return false;
        }

        return true;
    }
    function validateCompanySuffix(companyName) {

        const trimmed = companyName.trim().replace(/\s+/g, ' ');
        const upper = trimmed.toUpperCase();

        $("#companyNameError").text("");
        $("#companySuggestion").text("");

        let isValid = false;

        // Only these exact endings are allowed
        const validRegex = /^(.*\s)?(PRIVATE LIMITED|PVT\. LTD\.|LIMITED|LTD\.)$/;

        if (validRegex.test(upper)) {

            // If "PVT" appears, it must be exactly "PVT. LTD."
            if (upper.includes("PVT") && !upper.endsWith("PVT. LTD.")) {
                isValid = false;
            } else {
                isValid = true;
            }

        }

        if (!isValid) {
            $("#companyNameError").text(
                "Company name must end with 'Private Limited', 'Pvt. Ltd.', 'Limited', or 'Ltd.'"
            );
        }

        return isValid;
    }
    function GSTPIN() {

        clearValidationMessages();

        const pan = $("#editcompanyPAN").val().toUpperCase().trim();
        const companyName = $("#editcompanyName").val().trim().toUpperCase();

        if (pan === "") {
            return;
        }

        const panRegex = /^[A-Z]{5}[0-9]{4}[A-Z]$/;

        if (!panRegex.test(pan)) {

            $("#panError").text(
                "❌ PAN format should be ABCDE1234F"
            );

            resetEntityAndCIN();
            return;
        }

        const fourthChar = pan.charAt(3);
        const fifthChar = pan.charAt(4);

        const firstCharCompany =
            companyName.charAt(0);

        // 5th character validation

        if (!["P", "H"].includes(fourthChar)) {

            if (fifthChar !== firstCharCompany) {

                $("#panError").text(
                    "❌ PAN 5th character must match company first letter."
                );

                resetEntityAndCIN();
                return;
            }
        }

        // COMPANY VALIDATION
        if (fourthChar === "C") {

            $("#CIN").removeClass("d-none");

            if (!validateCompanySuffix(companyName)) {
                resetEntityAndCIN();
                return;
            }

        } else {
            $("#CIN").addClass("d-none");
            $("#cinError").text("");
        }

        // ENTITY TYPE

        switch (fourthChar) {

            case "C":
                $("#TypeOfCompanyID").val("1");
                break;

            case "F":
                $("#TypeOfCompanyID").val("4");
                break;

            case "A":
                $("#TypeOfCompanyID").val("5");
                break;

            case "G":
                $("#TypeOfCompanyID").val("10");
                break;

            case "T":
                $("#TypeOfCompanyID").val("6");
                break;

            case "P":
                $("#TypeOfCompanyID").val("11");
                break;

            case "H":
                $("#TypeOfCompanyID").val("3");
                break;

            default:

                $("#panError").text(
                    "❌ Invalid PAN type."
                );

                resetEntityAndCIN();
        }
    }

    function resetEntityAndCIN() {
        $("#TypeOfCompanyID").val("");
