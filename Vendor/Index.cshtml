<script type="text/javascript">

    $(document).ready(function () {

        var b = '@Session["LoginUserId"]';
        //var b = 15;

        $.ajax({
            url: '@Url.Action("GetInfo")',
            data: { "userId": b },
            type: "POST",
            dataType: "json",
            async: false,
            success: function (data) {

                if (data.length > 0) {

                    for (var i = 0; i < data.length; i++) {

                        if (data[i].FormName == "PurchaseEntity") {

                            if (data[i].Create == "Y") {

                                $('#CreateLedger').show();
                            }
                            else {

                                $('#CreateLedger').hide();

                            }

                        }

                    }

                }

            }
        });
    });

    function searchCompanyName(id) {
        var txt = document.getElementById(id);
        //txt.value = txt.value.replace(/\w\S*/g, function (txt) { return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase(); });

        // var txt = document.getElementById(id);

        $.ajax({
            url: '/Vendor/AutocompleteCompany/',
            data: { "searchByText": txt.value, "sortBy": $('#SortByColumnName').val()},

            type: "POST",
            dataType: "json",

            success: function (data) {
                $('#json-datalistcomp').empty();
                var jsonOptions = data;
                var dataList = document.getElementById('json-datalistcomp');

                jsonOptions.forEach(function (item) {

                    var option = document.createElement('option');

                    option.value = item;

                    dataList.appendChild(option);
                });

            }
        });
    }


    function validate() {
        if ($('#SearchByText').val() != "") {
            $('#SortByColumnName').val('CompanyName');

        }
        else if ($('#SortByColumnName').val() != "CompanyName") {
            $('#SearchCompanyName').val('');
        }
    }

    function funPageNoClicked(requestedPgNo) {
        $("#isPageNavigationRequested").val("true");
        $("#RequestedPageNumber").val(requestedPgNo);
        event.preventDefault();
        $("#CompanyLedger_List").submit();
    }
    $(function () {
        $("#Search").click(function () {
            $("#isPageNavigationRequested").val("false");
        });
    });
    function openEditForm(editFormUrl) {
        var editTab = window.open(editFormUrl, '_blank');

        // Listen for the edit tab closure
        editTab.onbeforeunload = function () {
            // Refresh the index page when the edit tab is closed
            location.reload();
        };
    }
    $(document).ready(function () {
        var table = $("#ledger").DataTable({
            paging: true,
            searching: true, // Enable DataTables' built-in search
        });

        // Custom live search
        //$("#searchBox").on("input", function () {
        //    table.search(this.value).draw();
        //});
    });

    $(document).ready(function () {
        $('.sortable').click(function () {
            var table = $(this).parents('table').eq(0);
            var rows = table.find('tr:gt(0)').toArray().sort(comparer($(this).index()));
            this.asc = !this.asc;
            if (!this.asc) {
                rows = rows.reverse();
            }
            for (var i = 0; i < rows.length; i++) {
                table.append(rows[i]);
            }
        });

        function comparer(index) {
            return function (a, b) {
                var valA = getCellValue(a, index);
                var valB = getCellValue(b, index);
                return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB);
            };
        }

        function getCellValue(row, index) {
            return $(row).children('td').eq(index).text();
        }
    });

</script>


