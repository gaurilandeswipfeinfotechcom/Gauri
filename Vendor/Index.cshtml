@*AP external CSS*@
<link href="~/Content/ERPStyle.css" rel="stylesheet" type="text/css" />

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div class="d-flex" style="margin-top:-20px">
            <h4 class="route-path1">Purchase</h4>
            <h4 class="route-path2" onclick="location.href='@Url.Action("Dashboard","PurchaseDashboard")'">Purchase Dashboard</h4>
            <h4 class="route-path3 " onclick="location.reload()">Vendor Profiles</h4>
        </div>
        <br />

        <div class="panel panel-default outer-main-container">
            <div class="form-group row main-heading">
                <div class="col-lg-5 d-flex ">
                    <i class="material-icons" style="font-size: 36px; margin-right: 10px;">recent_actors</i>
                    Vendor Profiles List
                </div>
                <div class="col-lg-2  col-md-3">
                    <input type="button" id="CreateLedger" value="Create" class="btn btn-success btn-round create-bttn courierCreate custo-inner" style="font-size: small; outline: none" onclick="location.href = '@Url.Action("Create", "Vendor")'" />
                </div>


                @*<div class="col-lg-5 col-md-6">
                        <input type="button" value="Vendor Incomplete List" class="btn btn-success btn-round create-bttn courierCreate custo-inner" style="font-size: small; outline: none" onclick="location.href = '@Url.Action("Index1", "Vendor")'" />
                    </div>*@
            </div>


            <div class="panel-body">
                @Html.TextBox("Edit", null, new { @onkeyup = "myFunction(this.id)", @class = "form-control", style = "display: none;" })
                @Html.TextBox("details", null, new { @onkeyup = "myFunction(this.id)", @class = "form-control", style = "display: none;" })
                @Html.TextBox("delete", null, new
                   {
                       @onkeyup = "myFunction(this.id)",
                       @class = "form-control",
                       style = "display: none;"
                   })
                @using (Html.BeginForm("Index", "Vendor", FormMethod.Post, new { id = "CompanyLedger_List" }))
                {

                    //Finding Data

                    <div class="panel panel-success search-rectangle" style="margin-top:-30px">
                        <div class="">
                            <div class="form-group row" style="margin-top:-15px">
                                <div class="col-lg-2 col-md-4 p-3">
                                    <label id="label" class="mt-4">Search By :</label>
                                    <div class="form-group row">
                                        @Html.DropDownListFor(m => m.SortByColumnName, new List<SelectListItem>
                                     {
                                         //new SelectListItem{ Text="Date", Value = "Date" },
                                         new SelectListItem{ Text="Vendor Name", Value = "CompanyName" },
                                         new SelectListItem{ Text="Category", Value = "Category" },
                                          //new SelectListItem{ Text="CreatedBy", Value = "CreatedBy" },
                                          // new SelectListItem{ Text="EditedBy", Value = "EditedBy" },
                                         new SelectListItem{ Text="Pincode", Value = "Pincode" },
                                         new SelectListItem{ Text="GSTIN", Value = "GSTIN" },
                                         //new SelectListItem{ Text="Yearly Business", Value = "YearlyBusiness" },
                                         //new SelectListItem{ Text="Frequency Of Purchase", Value = "FrequencyOfPur" },

                                     }, new { @class = "form-control fs-4 pl-3 dropdown-textbox", style = "height:35px" })
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-8 p-3">
                                    <label id="label" class="mt-4">Find :</label>
                                    @Html.TextBoxFor(m => m.SearchByText, null, new
                               {
                                   @class = "form-control pl-3 fs-4 input-text-box",
                                   style = "height:35px",
                                   //@placeholder = "Comapany Name",
                                   @oninput = "searchCompanyName(this.id)",
                                   @list = "json-datalistcomp",

                               })
                                    <datalist id="json-datalistcomp"></datalist>
                                </div>
                                <div class="col-lg-4 row p-3">
                                    <div class="col-md-4 p-3 ">
                                        <label id="label">Sort:</label>
                                        <div class="form-group row">
                                            @Html.DropDownListFor(m => m.OrderByType, new List<SelectListItem>
                                         {
                                         //new SelectListItem{ Text="Please Select", Value = "Please Select" },
                                          new SelectListItem{ Text="Z-A", Value = "Z-A" },
                                         new SelectListItem{ Text="A-Z", Value = "A-Z" },
                                          }, new { @class = "form-control fs-4 pl-3 dropdown-textbox", style = "height:35px" })
                                        </div>
                                    </div>

                                    <div class="col-md-4 p-3">
                                        <label id="label">Records:</label>
                                        @Html.TextBoxFor(m => m.RecordsPerPage, null, new
                                   {
                                       @class = "form-control pl-3 fs-4 input-text-box",
                                       style = "height:35px"
                                   })
                                    </div>
                                    <div class="col-md-4 pt-md-3 p-3">
                                        <label id="label">Page No. :</label>
                                        @Html.TextBox("Page", null, new
                                   {
                                       @class = "form-control pl-3 fs-4 input-text-box",
                                       style = "height:35px"


                                   })
                                    </div>
                                </div>

                                <div class="col-lg-2 align-items-end d-flex">
                                    <button type="submit" id="Search" value="Search" name="Search" style="outline: none" class="mb-5 btn btn-success btn-round search-bttn custo-inner">
                                        Search<i class="material-icons" style="font-size: 20px;padding-left:15px">search</i>
                                    </button>
                                </div>
                            </div>

                            <div class="form-group row" style="margin-top:-25px;margin-bottom:-15px">

                                <div class="col-sm-4 col-lg-2 col-xl-2">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Category :</label>
                                    @Html.CheckBoxFor(m => m.CatName, true)
                                </div>
                                <div class="col-sm-4 col-lg-2 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Date :</label>
                                    @Html.CheckBoxFor(m => m.Date, true)
                                </div>
                                <div class="col-sm-4 col-lg-2 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Vendor Name: </label>
                                    @Html.CheckBoxFor(m => m.CompanyName, true)
                                </div>
                                <div class="col-sm-4 col-lg-2 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Address Title :</label>
                                    @Html.CheckBoxFor(m => m.AddressTitle, true)
                                </div>
                                <div class="col-sm-4 col-md-2 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Taluka :</label>
                                    @Html.CheckBoxFor(m => m.Taluka, true)
                                </div>
                                <div class="col-sm-4 col-md-2 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> Pincode :</label>
                                    @Html.CheckBoxFor(m => m.Pincode, true)
                                </div>
                                <div class="col-sm-4 col-md-3 ">
                                    <label id="label" style="color: #0077B3;  margin-top: 5px; font-weight: 500 "> GSTIN :</label>
                                    @Html.CheckBoxFor(m => m.GSTIN, true)
                                </div>


                            </div>
                        </div>
                    </div>
                    <div class="panel panel-success" style="box-shadow:inset 4px 4px 4px gray;border-radius:10px">
                        <div class="panel-body">
                            <div class="table-responsive">
                                <table class="table" id="ledger">
                                    <tr style=" font-size: small">
                                        <th width="5%" style="border-right: 2px solid #fff">
                                            Sr. No.
                                        </th>
                                        @if (Model.Date)
                                        {
                                            <th width="12%" class="sortable" style="border-right: 2px solid #fff">Created Date</th>
                                        }
                                        <th width="12%" class="sortable" style="border-right: 2px solid #fff; text-align:center">Last Edited</th>
                                        @if (Model.CompanyName == true)
                                        {
                                            <th width="27%" class="sortable" style="border-right: 2px solid #fff">
                                                Vendor Name
                                            </th>
                                        }
                                        @if (Model.AddressTitle == true)
                                        {
                                            <th width="6%" class="sortable" style="border-right: 2px solid #fff">
                                                Add Title
                                            </th>
                                        }
                                        @if (Model.Taluka == true)
                                        {
                                            <th width="11%" class="sortable" style="border-right: 2px solid #fff">
                                                Taluka
                                            </th>
                                        }
                                        @if (Model.Pincode == true)
                                        {
                                            <th width="5%" class="sortable" style="border-right: 2px solid #fff">
                                                Pincode
                                            </th>
                                        }
                                        @if (Model.GSTIN == true)
                                        {
                                            <th width="13%" class="sortable" style="border-right: 2px solid #fff">
                                                GSTIN
                                            </th>
                                        }

                                        @if (Model.CatName == true)
                                        {
                                            <th width="11%" class="sortable" style="border-right: 2px solid #fff">
                                                Category
                                            </th>
                                        }
                                        <th width="5%" style="border-right: 2px solid #fff">Zone</th>

                                        <th width="5%">Action</th>
                                    </tr>

                                    @{ int sno = (Model.RequestedPageNumber - 1) * Model.RecordsPerPage + 1;
                                        for (var i = 0; i < Model.CLSearchedList.Count; i++)
                                        {
                                            var item = Model.CLSearchedList[i];

                                            <tr>
                                                <td align="center">
                                                    @sno
                                                    @{ sno++;}

                                                </td>
                                                @if (Model.Date)
                                                {
                                                    <td align="center">

                                                        @Convert.ToString(string.Format("{00:dd/MM/yyyy hh:mm}", item.Date))
                                                    </td>
                                                }
                                                <td align="center">@Convert.ToString(string.Format("{00:dd/MM/yyyy hh:mm}", item.EditedDate))</td>
                                                @if (Model.CompanyName == true)
                                                {
                                                    <td align="center">
                                                        @Html.DisplayFor(modelItem => item.CompanyName)
                                                    </td>
                                                }
                                                @if (Model.AddressTitle == true)
                                                {
                                                    <td align="center">
                                                        @Html.DisplayFor(modelItem => item.AddressTitle)
                                                    </td>
                                                }
                                                @if (Model.Taluka == true)
                                                {
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Taluka)
                                                    </td>
                                                }
                                                @if (Model.Pincode == true)
                                                {
                                                    <td align="center">
                                                        @Html.DisplayFor(modelItem => item.Pincode)
                                                    </td>
                                                }
                                                @if (Model.GSTIN == true)
                                                {
                                                    <td align="center">
                                                        @Html.DisplayFor(modelItem => item.GSTIN)
                                                    </td>
                                                }

                                                @if (Model.CatName == true)
                                                {
                                                    <td align="center">
                                                        @Html.DisplayFor(modelItem => item.CatName)
                                                    </td>
                                                }
                                                <td align="center">
                                                    @Html.DisplayFor(modelItem => item.Zone)
                                                </td>

                                                <td class="text-center">
                                                    @if (Model.AllowEdit == true)
                                                    {
                                                        <span>
                                                            <i type="submit" value="edit" class="material-icons" id="click" title="Details & Edit" onclick="location.href = '@Url.Action("Details","Vendor", new { LedgerID = item.BusinessEntityId, id = item.BusinessEntityId })'">edit_square</i>
                                                        </span>

                                                    }

                                                </td>

                                            </tr>
                                        }
                                    }
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive p-2">
                        <table align="center">
                            <tr class="page">
                                @if (Model.PageCount > 1)
                                {
                                    @Html.HiddenFor(m => m.PageCount)
                                    <td>
                                        @if (Model.RequestedPageNumber > 1)
                                        {
                                            <a id="FirstPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-right: 5px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica " onclick='funPageNoClicked(1);'>First</a>
                                        }
                                    </td>

                                    <td>
                                        @if (Model.RequestedPageNumber > 1)
                                        {
                                            <a id="PreviousPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-right: 10px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica " onclick='funPageNoClicked(@Model.RequestedPageNumber - 1);'><b><</b></a>
                                        }
                                    </td>

                                    {
                                        int startPage;
                                        int endPage;

                                        if (Model.PageCount <= 10)
                                        {
                                            startPage = 1;
                                            endPage = Model.PageCount;
                                        }
                                        else
                                        {
                                            if (Model.RequestedPageNumber <= 6)
                                            {
                                                startPage = 1;
                                                endPage = 10;
                                            }
                                            else if (Model.RequestedPageNumber >= Model.PageCount - 4)
                                            {
                                                startPage = Model.PageCount - 9;
                                                endPage = Model.PageCount;
                                            }
                                            else
                                            {
                                                startPage = Model.RequestedPageNumber - 5;
                                                endPage = Model.RequestedPageNumber + 4;
                                            }
                                        }

                                        for (int pgno = startPage; pgno <= endPage; pgno++)
                                        {
                                            <td>
                                                <a id="PageNo" href="#" class="btn btn-secondary btn-round @(pgno == Model.RequestedPageNumber ? "active" : "")" onclick='funPageNoClicked(@pgno);'>@pgno.ToString()</a>
                                            </td>
                                        }
                                    }

                                    <td>
                                        @if (Model.RequestedPageNumber < Model.PageCount)
                                        {
                                            <a id="NextPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-right: 10px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica " onclick='funPageNoClicked(@Model.RequestedPageNumber + 1);'><b>></b></a>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.RequestedPageNumber < Model.PageCount)
                                        {
                                            <a id="LastPage" href="#" class="btn btn-info custo-inner"
                                               style="margin-right: 5px; background-image: linear-gradient(to right,#35d3e1,midnightblue); outline-style: none; border: none; padding: 5px 10px 5px 10px; color: #fff; font-size: 15px; font-family: helvetica " onclick='funPageNoClicked(@Model.PageCount);'>Last</a>
                                        }
                                    </td>
                                }
                                @Html.HiddenFor(x => x.isPageNavigationRequested)
                                @Html.HiddenFor(x => x.RequestedPageNumber)
                            </tr>
                        </table>
                    </div>
                    if (Model.PageCount > 1)
                    {
                        <div class="pager">

                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
<script>
    $(function () {
    $("#Search").click(function () {
    var requestedPageNumber = parseInt($("#Page").val());
    if (!isNaN(requestedPageNumber) && requestedPageNumber > 0 && requestedPageNumber <= @Model.PageCount) {
    funPageNoClicked(requestedPageNumber);
    }
    });
    });
</script>