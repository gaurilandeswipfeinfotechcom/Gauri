                <div id="ItemEditModal" class="modal">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content shadow-lg rounded-4">
                            <div class="modal-header m-3 p-3">
                                <h3 class="modal-title">Create Work Function </h3>
                                <i class="material-icons modal-cross" data-dismiss="modal" aria-label="Close" onclick="history.back()">cancel</i>
