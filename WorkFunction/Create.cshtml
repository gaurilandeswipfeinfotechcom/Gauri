                                    </div>

                                    <div class="col-md-3 col-sm-4">
                                        <label for="editReTime" id="label"> Approved Time Per No. :</label>
                                        <input id="editReTime" class="form-control input-text-box fs-4 pl-3" style="height:35px;" placeholder="Enter  Approved Time Per No." type="number" />
                                    </div>
                                    <div class="col-md-2 col-sm-4">
                                        <label id="label">Unit :</label>
                                        <div class="form-group row mt-2">
                                            @Html.DropDownList("UnitId", (IEnumerable<SelectListItem>)ViewBag.UnitId, "Please Select", new
                                            {
                                           @class = "form-control bg-light fs-4 pl-3 dropdown-textbox",
                                           @style = "height:35px",
                                                id = "UnitId1"
                                       })
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4">
                                        <label for="editSetupt" id="label">Set-Up Time Per No. :</label>
                                        <input id="editSetupt" class="form-control input-text-box fs-4 pl-3" style="height:35px;" placeholder="Enter Set-Up Time Per No" type="number" />
                                    </div>
                                    <div class="col-md-2 col-sm-4">
                                        <label id="label">Unit :</label>
                                        <div class="form-group row mt-2">
                                            @Html.DropDownList("UnitId", (IEnumerable<SelectListItem>)ViewBag.UnitId1, "Please Select", new
                                       {
                                           @class = "form-control bg-light fs-4 pl-3 dropdown-textbox",
                                           @style = "height:35px",
                                           id = "UnitId2"
                                       })
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4">
                                        <label for="editDept" id="label">Department :</label>
                                        @*<input id="editDept" class="form-control input-text-box fs-4 pl-3" style="height:35px;" placeholder="Enter Itemcode" oninput="this.value = this.value.toUpperCase()" />*@
                                        <div id="" class="form-group row mt-2">
                                            @Html.DropDownList("DepartmentName", (IEnumerable<SelectListItem>)ViewBag.DepartmentName, "Please Select", new
                                       {
                                           @class = "form-control bg-light fs-4 pl-3 dropdown-textbox",
                                           @style = "height:35px",
                                                id = "editDept"
                                       })
                                        </div>

                                    </div>
                                    <div class="row mt-4">
                                        <!-- DOCUMENT UPLOAD -->
                                        <div class="col-md-4">
                                            <div class="upload-box" onclick="$('#DocumentFile').click();">
                                                <i class="material-icons upload-icon">description</i>
                                                <h4>Upload Document</h4>
                                                <p>TXT / PDF / DOC / DOCX</p>
                                            </div>

                                            <div id="docSelectedName" class="selected-file-name">
                                                No document selected
                                            </div>

                                            <input type="file"
                                                   id="DocumentFile"
                                                   name="DocumentFile"
                                                   accept=".txt,.pdf,.doc,.docx"
                                                   hidden />
                                        </div>

                                        <!-- DOCUMENT UPLOAD -->
                                        <!--<div class="col-md-6">
                                            <div class="upload-box" onclick="$('#DocumentFile').click();">
                                                <i class="material-icons upload-icon">description</i>
                                                <h4>Upload Document</h4>
                                                <p>TXT / PDF / DOC / DOCX</p>
                                            </div>
                                            <input type="file"
                                                   id="DocumentFile"
                                                   name="DocumentFile"
                                                   accept=".txt,.pdf,.doc,.docx"
                                                   hidden />
                                        </div>-->
                                        <!-- VIDEO UPLOAD -->
                                        <!--<div class="col-md-6">
                                            <div class="upload-box" onclick="$('#VideoFile').click();">
                                                <i class="material-icons upload-icon">videocam</i>
                                                <h4>Upload Video</h4>
                                                <p>MP4 / AVI / MOV</p>
                                            </div>
                                            <input type="file"
                                                   id="VideoFile"
                                                   name="VideoFile"
                                                   accept="video/*"
                                                   hidden />
                                        </div>-->
                                        <!-- VIDEO UPLOAD -->
                                        <div class="col-md-4">
                                            <div class="upload-box" onclick="$('#VideoFile').click();">
                                                <i class="material-icons upload-icon">videocam</i>
                                                <h4>Upload Video</h4>
                                                <p>MP4 / AVI / MOV</p>
                                            </div>

                                            <div id="videoSelectedName" class="selected-file-name">
                                                No video selected
                                            </div>

                                            <input type="file"
                                                   id="VideoFile"
                                                   name="VideoFile"
                                                   accept="video/*"
                                                   hidden />
                                        </div>

                                    </div>
                                </div>
                                <div class="modal-footer ">
                                    <input type="button" value="Create" id="UpdateWorkCardFirst" class="btn btn-success btn-round create-bttn custo-inner" style="outline:none" />
                                    <button type="button" class="btn btn-success btn-round create-bttn custo-inner" onclick="history.back()" style="outline:none">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

}
<script>
    $(document).on('input', '#editWrkN', function () {
        let val = $(this).val()
            .toLowerCase()
            .replace(/\b\w/g, function (char) {
                return char.toUpperCase();
            });
        $(this).val(val);
    });
</script>
<script>
    // Show selected document name
    $('#DocumentFile').on('change', function () {
        if (this.files.length > 0) {
            $('#docSelectedName').text('📄 ' + this.files[0].name);
        } else {
            $('#docSelectedName').text('No document selected');
        }
    });

    // Show selected video name
    $('#VideoFile').on('change', function () {
        if (this.files.length > 0) {
            $('#videoSelectedName').text('🎥 ' + this.files[0].name);
        } else {
            $('#videoSelectedName').text('No video selected');
        }
    });
</script>
