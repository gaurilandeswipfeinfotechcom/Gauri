

@model ERPEntities.WorkFunction

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_SwipfeMaster.cshtml";
}
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js"></script>
<script src="http://ajax.aspnetcdn.com/ajax/jQuery/jquery-1.10.0.min.js" type="text/javascript"></script>
<script src="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/jquery-ui.min.js" type="text/javascript"></script>
<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

<link href="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.9.2/themes/blitzer/jquery-ui.css"
      rel="Stylesheet" type="text/css" />

<link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">

<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>

<style>
    /*Adding some css for looks good*/
    #label {
        font-size: medium;
        color: #0077B3;
        font-weight: normal
    }

    .zoom {
        transition: transform .1s;
    }

        .zoom:hover {
            -ms-transform: scale(1.5); /* IE 9 */
            -webkit-transform: scale(1.5); /* Safari 3-8 */
            transform: scale(1.02);
        }

    h3, h4 {
        color: midnightblue
    }

    input.error {
        border: 1px solid red;
    }

    .button:hover {
        /*background-color: #3e8e41*/
        background-color: cyan;
    }

    .button:active {
        background-color: cyan;
        box-shadow: 0 5px #666;
        transform: translateY(4px);
    }

    .button1 {
        border-radius: 50%;
    }

    span.error {
        display: block;
        visibility: hidden;
        color: red;
        font-size: 60px;
    }


    .ui-widget {
        font-size: 12px !important;
    }

    .reqError {
        color: #ff0000; /*Red Color*/
        font-weight: bold;
        font-size: 16px;
    }



    .save-btn input:hover {
        background-color: Highlight;
        transform: scale(1.1);
    }

    .cross-btn {
        font-size: 30px;
        cursor: pointer;
        color: midnightblue;
        position: absolute;
        top: 35px;
        right: 15px;
    }

    .modal {
        backdrop-filter: blur(1px);
        background: rgba(0, 0, 0, 0.5);
        opacity: 1;
    }

    .modal-header {
        background-color: #e5e6e7;
        box-shadow: 6px 6px 6px #bfc3cf;
    }

    .modal-title {
        font-family: Helvetica;
        color: midnightblue
    }

    .modal-cross {
        color: midnightblue;
        font-size: 25px;
        cursor: pointer;
    }

    .route-path1 {
        cursor: pointer;
        clip-path: polygon(0% 0%, 90% 0%, 100% 50%, 90% 100%, 0% 100%);
        background-color: #003399;
        color: white;
        padding: 5px 15px 5px 5px
    }

    .route-path2 {
        cursor: pointer;
        color: white;
        clip-path: polygon(93% 0%, 100% 50%, 93% 100%, 0% 100%, 7% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }

    .route-path3 {
        cursor: pointer;
        color: white;
        clip-path: polygon(90% 0%, 100% 50%, 90% 100%, 0% 100%, 10% 50%, 0% 0%);
        background-color: #003399;
        padding: 5px 15px 5px 15px;
    }
</style>
<!-- Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="Stylesheet" type="text/css" />
@*AP external CSS*@
<link href="~/Content/ERPStyle.css" rel="stylesheet" type="text/css" />
<script>

    $(document).ready(function () {

        const workId = decodeURIComponent(window.location.href).split("=")[1];

        $.ajax({
            type: "POST",
            url: '/WorkFunction/GetWorkFunction/',
            data: { 'WorkFunctionId': workId }, // send empty object as JSON
            //contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                var workfunction = data.WorkFunctionName.WorkFunctionName;
               /* var quantity = data.WorkFunctionName.Quantity;*/
                var recomtime = data.WorkFunctionName.RecommendedTime;
                var setuptime = data.WorkFunctionName.SetupTime;
                var dept = data.WorkFunctionName.Department;
                var setup = data.WorkFunctionName.SetUpUnitName;
                var recom = data.WorkFunctionName.RecommendedUnitName;
                var setupId = data.WorkFunctionName.SetUpUnitId;
                var recomId = data.WorkFunctionName.RecommendedUnitId;
                var docPath = data.WorkFunctionName.DocumentPath;
                var videoPath = data.WorkFunctionName.VideoPath;
                // ================= FILE SECTION =================
                var fileSection = '';

                /* 📄 DOCUMENT */
                if (docPath) {
                    let docName = getFileName(docPath);
                    fileSection += `
        <div class="mt-3">
            <b style="color:#0077B3">Document :</b>
            <a href="${docPath}"
               target="_blank"
               class="fs-4 text-decoration-underline">
               ${docName}
            </a>
        </div>`;
                }

                /* 🎥 VIDEO */
                if (videoPath) {
                    let videoName = getFileName(videoPath);
                    fileSection += `
        <div class="mt-3">
            <b style="color:#0077B3">Video :</b>
            <a href="${videoPath}"
               target="_blank"
               class="fs-4 text-decoration-underline">
               ${videoName}
            </a>
        </div>`;
                }



                // Create a row for the first card
                var row1 = $('<div class="row "></div>');
                var itemDetailsCard = $(`
                    <div class="col-12 card-1">
                        <div class="card zoom my-0" >
                             <div class="card-body text-center d-inline p-3 ">
                               <h3 class=" pl-0 pl-lg-2" style=" color: #0077B3; font-weight: bold">${workfunction}
                                <button type="button" class="edit-Item-btn text-end mx-3 p-2 " style="border:none;cursor:pointer" title="Edit Item Details"
                                       data-workidd="${workId}"
                                        data-workfunname="${workfunction}"

                                       data-recomtim="${recomtime}"
                                      data-settim="${setuptime}"
                                        data-dept="${dept}"
                                          data-setup="${setup}"
                                        data-recom="${recom}"
                                      data-setupid="${setupId}"
                                      data-recomid="${recomId}"
                                      title="Edit Item Details">
                                      <i class="material-icons fs-3 text-dark">edit_square</i>
                                 </button></h3>
                             <div class="fs-4">

                                  <span class="px-2 text-start"  style=" color: #0077B3;font-weight:500">Approved Time Per No. : <span class="text-dark">${recomtime || 'Not Avaliable!'}</span></span>
                                  <span class="px-2 text-start"  style=" color: #0077B3;font-weight:500">Unit : <span class="text-dark">${recom || 'Not Avaliable!'}</span></span>
                                  <span class="px-2 text-start"  style=" color: #0077B3;font-weight:500">Set-Up Time Per No. : <span class="text-dark">${setuptime || 'Not Avaliable!'}</span></span>
                                  <span class="px-2 text-start"  style=" color: #0077B3;font-weight:500">Unit : <span class="text-dark">${setup || 'Not Avaliable!'}</span></span>
                                  <span class="px-2 text-start"  style=" color: #0077B3;font-weight:500">Department : <span class="text-dark">${dept || 'Not Avaliable!'}</span></span>
                                </div>
${fileSection}
                            </div>
                        </div>
                    </div>`);
                row1.append(itemDetailsCard);
                $('#itemContainer').append(row1);

                /*DISPLAY DATA ON CARDS END*/

                /*PASSING DATA TO MODALS START*/

                $(document).on('click', '.edit-Item-btn', function () {
                    const button = $(this);
                    $('#passWorkiD').val(button.data('workidd'));
                    $('#editWrkNme').val(button.data('workfunname'));
                    /*$('#editQty').val(button.data('qty'));*/
                    $('#editReTime').val(button.data('recomtim'));
                    $('#editSetupt').val(button.data('settim'));
                    $('#editDept').val(button.data('dept'));
                    $('#editset').val(button.data('setupid'));
                    $('#editrec').val(button.data('recomid'));
                    const dept = button.data('dept');
                    loadDepartmentDropdown(function () {
                        $('#editDept').val(dept);
                    });
                    openModal('ItemEditModal', 'EditItemModalOverlay');
                    console.log("Modal 1st:", {
                        workID: button.data('workidd'),
                        workfunname: button.data('workfunname'),
                        qty: button.data('qty'),
                        recomtim: button.data('recomtim'),
                        settim: button.data('settim'),
                        dept: button.data('dept'),
                        set: button.data('setup'),
                        rec: button.data('recom'),
                    });
                });

                /*PASSING DATA TO MODALS END*/
            },
            error: function (xhr, status, error) {
                console.error("AJAX Error:", status, error);
            }
        });

    });

    function loadUnitsDropdown() {
        $.ajax({
            url: "/WorkFunction/GetUnits",
            type: "GET",
            success: function (units) {
                units.forEach(function (u) {
                    $("#editset").append(`<option value="${u.UnitId}">${u.UnitName}</option>`);
                    $("#editrec").append(`<option value="${u.UnitId}">${u.UnitName}</option>`);
                });
            }
        });
    }

    $(document).ready(function () {
        loadUnitsDropdown();
    });


    function loadDepartmentDropdown(callback) {
        $("#editDept").empty();
        $("#editDept").append(`<option value="">Select Department</option>`);

        $.ajax({
            url: "/WorkFunction/GetDepartments",
            type: "GET",
            success: function (deptList) {
                // ✅ Alphabetical sort
                deptList.sort(function (a, b) {
                    return a.DepartmentName.localeCompare(b.DepartmentName);
                });
                deptList.forEach(function (d) {
                    $("#editDept").append(`<option value="${d.DepartmentName}">${d.DepartmentName}</option>`);
                });

                if (callback) callback();
            }
        });
    }

    $(document).on('click', '#UpdateWorkCardFirst', function (e) {
        e.preventDefault();
        let errors = [];

        if (!$('#editWrkNme').val().trim()) {
            errors.push("Work Function name is required.");
        }

        if (!$('#editReTime').val().trim()) {
            errors.push("Approved Time Per No. is required.");
        }
        if (!$('#editSetupt').val().trim()) {
            errors.push("Set-Up Time Per No. is required.");
        }
        if (!$('#editDept').val().trim()) {
            errors.push("Department is required.");
        }
        if (!$('#editset').val().trim()) {
            errors.push("Unit is required.");
        }
        if (!$('#editrec').val().trim()) {
            errors.push("Unit is required.");
        }
        if (errors.length > 0) {
            alert(errors.join("\n"));  // display all errors in one alert
            return;  // stop function here
        }


        const data = {
            WorkFunctionId: $('#passWorkiD').val(),
            WorkFunctionName: $('#editWrkNme').val(),

            RecommendedTime: $('#editReTime').val(),
            SetupTime: $('#editSetupt').val(),
            Department: $('#editDept').val(),
            SetUpUnitId: $('#editset').val(),
            RecommendedUnitId: $('#editrec').val(),
        };

        UpdateItemMaster(data);
        console.log("🟢 Final Data Sent to Server:", JSON.stringify(data));

    });


    function UpdateItemMaster(data) {
        var formData = new FormData();

        for (var key in data) {
            formData.append(key, data[key]);
        }

        let doc = $('#EditDocumentFile')[0].files[0];
        let video = $('#EditVideoFile')[0].files[0];

        if (doc) formData.append("EditDocumentFile", doc);
        if (video) formData.append("EditVideoFile", video);

        $.ajax({
            url: '/WorkFunction/UpdateWorkFunction', // your correct URL
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.success) {
                    alert('Updated Successfully!');
                    location.reload();
                } else {
                    alert('Update failed: ' + response.message);
                }
            },
            error: function (xhr, status, error) {
                alert('Error: ' + error);
            }
        });
    }


    // Function to open the modal
    function openModal(modalId, overlayId) {
        document.getElementById(modalId).style.display = "block";
        document.getElementById(overlayId).style.display = "block";
    }

    // Function to close the modal
    function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        const overlay = document.getElementById(modalId + "Overlay");

        if (modal) modal.style.display = "none";
        if (overlay) overlay.style.display = "none";
    }
    function getFileName(path) {
        if (!path) return '';
        return path.split('/').pop();
    }
    @functions{
    string FileNameOnly(string path)
    {
        return string.IsNullOrEmpty(path) ? "" : System.IO.Path.GetFileName(path);
    }
}
</script>


<form id="TypeValidation" class="form-horizontal" action="#" method="">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="d-flex" style="margin-top:-20px">
                <h4 class="route-path1">HR </h4>
                <h4 class="route-path2 " onclick="location.href='@Url.Action("Index","WorkFunction")'">Work Function</h4>
                <h4 class="route-path3 " onclick="location.reload()">Details</h4>
            </div>
            <br />

            <div class="panel panel-default outer-main-container">
                <div class=" main-heading">
                    <div class=" d-flex ">
                        <i class="material-icons" style="font-size: 32px; margin-right: 10px;">info</i>
                        Work Function Details
                        <i class="material-icons cross-btn" onclick="goBackAndRefresh();">cancel</i>
                    </div>
                </div>
                <div class="px-5 ">
                    <div class="form-group row">
                        <div class="container " id="itemContainer"></div>
                    </div>
                    <input id="passWorkiD" class="d-none" />
                    <div class="form-group row p-5">
                        <div class="col-lg-3 col-sm-6 col-md-4 col-xxl-2">
                            <input type="button" value="Close" class="btn btn-success btn-round  create-bttn custo-inner w-auto" style="outline-style: none;" onclick="goBackAndRefresh()" />
                        </div>
                       
                    </div>
                </div>
            </div>


            <!--Item edit Modal -->
            <div class="modalOverlay" id="EditItemModalOverlay" onclick="closeModal('ItemEditModal')"></div>
            <div id="ItemEditModal" class="modal">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content shadow-lg rounded-4">
                        <div class="modal-header m-3 p-3">
                            <h3 class="modal-title">Edit Work Function </h3>
                            <i class="material-icons modal-cross" data-dismiss="modal" aria-label="Close" onclick="closeModal('ItemEditModal')">cancel</i>
                        </div>
                        <div class="modal-body p-4">
                            <!-- ROW 1 -->
                            <div class="row mx-0">

                                <div class="col-md-7 col-sm-4">
                                    <label for="editWrkNme">Work Function Name :</label>
                                    <input id="editWrkNme" class="form-control fs-4" style="height:35px" placeholder="Enter Work Function Name" />
                                </div>

                                <div class="col-md-3 col-sm-4">
                                    <label for="editReTime">Approved Time Per No. :</label>
                                    <input id="editReTime" class="form-control fs-4" style="height:35px" placeholder="Enter Approved Time Per No" type="number" />
                                </div>

                                <div class="col-md-2 col-sm-4">
                                    <label for="editrec">Unit :</label>
                                    <select id="editrec" class="form-control fs-4" style="height:35px"></select>
                                </div>

                            </div>

                            <!-- ROW 2 -->
                            <div class="row mx-0 mt-3">

                                <div class="col-md-4 col-sm-4">
                                    <label for="editSetupt">Set-Up Time Per No. :</label>
                                    <input id="editSetupt" class="form-control fs-4" style="height:35px" placeholder="Enter Set-Up Time Per No." type="number" />
                                </div>

                                <div class="col-md-2 col-sm-4">
                                    <label for="editset">Unit :</label>
                                    <select id="editset" class="form-control fs-4" style="height:35px"></select>
                                </div>

                                <div class="col-md-4 col-sm-4">
                                    <label for="editDept">Department :</label>
                                    <select id="editDept" class="form-control fs-4" style="height:35px" oninput="this.value"></select>
                                </div>
                                <hr />

                                <div class="row mt-3">

                                    <!-- Document -->
                                    <div class="col-md-6">
                                        <label>Document</label>
                                        <input type="file"
                                               id="EditDocumentFile"
                                               accept=".pdf,.doc,.docx,.txt"
                                               class="form-control fs-4" />
                                    </div>

                                    <!-- Video -->
                                    <div class="col-md-6">
                                        <label> Video</label>
                                        <input type="file"
                                               id="EditVideoFile"
                                               accept="video/*"
                                               class="form-control fs-4" />
                                    </div>

                                </div>
                            </div>
                           
                        
                        </div>
                        <div class="modal-footer">
                            <input type="button" value="Update" id="UpdateWorkCardFirst" class="btn btn-success btn-round create-bttn custo-inner" style="outline:none" />
                            <button type="button" class="btn btn-success btn-round create-bttn custo-inner" onclick="closeModal('ItemEditModal')" style="outline:none">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
<script>
    function goBackAndRefresh() {
        // store flag in localStorage (works even if sessionStorage fails)
        localStorage.setItem("forceRefresh", "true");
        history.back();
    }
</script>
<script>
    $(document).on('input', '#editWrkNme', function () {
        let val = $(this).val()
            .toLowerCase()
            .replace(/\b\w/g, function (char) {
                return char.toUpperCase();
            });
        $(this).val(val);
    });
</script>