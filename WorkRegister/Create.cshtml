<script>
    function addItemRow() {
        var html = $('.itemSection').first().clone();
        html.find('input, select').val('');
        $('#itemSectionContainer').append(html);
    }

    function removeItemRow(button) {
        if ($('#itemSectionContainer .itemSection').length > 1) {
            $(button).closest('.itemSection').remove();
            recalculateAmounts();
        }
    }
</script>
<script>
    function convertToMinutes(value, unit) {
        if (!value) return 0;

        unit = unit.toLowerCase();

        switch (unit) {
            case "minute":
            case "minutes":
            case "min":
                return value;

            case "hour":
            case "hours":
            case "hr":
                return value * 60;

            case "second":
            case "seconds":
            case "sec":
                return value / 60;

            case "day":
            case "days":
                return value * 1440;

            default:
                return value; // fallback
        }
    }
</script>
<script>
    $(document).on('change', '.itemName, .quantity', function () {

        let row = $(this).closest('.itemSection');
        let workFunction = row.find('.itemName').val();
        let qty = parseFloat(row.find('.quantity').val()) || 0;

        if (!workFunction || qty <= 0) return;

        $.getJSON('/WorkRegister/GetWorkFunctionDetails',
            { workFunctionName: workFunction },
            function (data) {

                if (!data) return;

                let recommendedMin =
                    convertToMinutes(data.RecommendedTime, data.RecommendedUnit);

                let setupMin =
                    convertToMinutes(data.SetupTime, data.SetupUnit);

                let totalMinutes =
                    (recommendedMin * qty) + setupMin;
                // 🔥 ROUND UP TIME (partial minute → full minute)
                row.find('.TotalWorkOutputTime')
                    .val(Math.ceil(totalMinutes));

                //row.find('.TotalWorkOutputTime')
                //    .val(totalMinutes.toFixed(2));

                calculateGrandTotal();
            });
    });
</script>
<script>
    function calculateGrandTotal() {
        let sum = 0;
        $('.TotalWorkOutputTime').each(function () {
            sum += parseFloat($(this).val()) || 0;
        });

        $('input[name="TotalWorkTimeInMins"]').val(sum.toFixed(2));
        // 🔥 calculate efficiency
        calculateEfficiency();
    }
</script>
<script>
    function calculateEfficiency() {
        let totalMinutes =
            parseFloat($('input[name="TotalWorkTimeInMins"]').val()) || 0;

        let efficiency =
            (totalMinutes / 480) * 100;

        $('input[name="EfficiencyofWorkInPercent"]')
            .val(efficiency.toFixed(2));
    }
</script>
@if (!ViewData.ModelState.IsValid)
{
    string error = null;

    foreach (var state in ViewData.ModelState.Values)
    {
        if (state.Errors.Count > 0)
        {
            error = state.Errors[0].ErrorMessage;
            break;
        }
    }

    if (!string.IsNullOrEmpty(error))
    {
        <script>
            Swal.fire({
                icon: 'warning',
                title: 'Duplicate Entry',
                text: '@error',
                confirmButtonText: 'OK'
            });
        </script>
    }
}